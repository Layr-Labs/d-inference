-@Suite("Qwen artifact-only phase wiring")
-struct Qwen35ArtifactOnlyPhaseTests {
-    private struct Run {
-        let hidden: MLXArray
-        let roots: [MLXArray]
-        let recurrent: [Int: CBv2RecurrentLayerState]
-        let cacheSnapshots: [(keys: MLXArray, values: MLXArray, offset: Int)]
-    }
-
-    private func run(
-        model: Qwen35TextModelInner,
-        config: Qwen35TextConfiguration,
-        phase: Qwen35CBv2ForwardPhase
-    ) throws -> Run {
-        let tokens = MLXArray([Int32(1), 7, 11])[.newAxis, .ellipsis]
-        let cachePairs = config.cbv2LayerKinds.map {
-            TinyArtifactQwen.cache(kind: $0, promptLength: 3)
-        }
-        let caches: [any CBv2AttendingLayerCache] = cachePairs.map(\.0)
-        let requestState = try CBv2RecurrentRequestState(
-            spec: config.cbv2RecurrentStateSpec(activationDType: .float32))
-        let transaction = try requestState.bind()
-        let hidden = model.cbv2Forward(
-            tokens,
-            caches: caches,
-            recurrentState: [transaction],
-            phase: phase)
-        let roots = try transaction.evaluate()
-        eval([hidden] + roots + cachePairs.flatMap { $0.0.innerState() })
-        try transaction.commit()
-
-        var recurrent: [Int: CBv2RecurrentLayerState] = [:]
-        for index in config.cbv2RecurrentStateSpec().modelLayerIndices {
-            recurrent[index] = requestState.state(modelLayerIndex: index)
-        }
-        let snapshots = cachePairs.map { pair in
-            let snapshot = pair.1.snapshot()
-            eval(snapshot.keys, snapshot.values)
-            return (snapshot.keys, snapshot.values, snapshot.offset)
-        }
-        return Run(
-            hidden: hidden,
-            roots: roots,
-            recurrent: recurrent,
-            cacheSnapshots: snapshots)
-    }
-
-    @Test func decodeAndMTPRemainTheSameFullModelPath() throws {
-        let config = try TinyArtifactQwen.configuration()
-        let environment = [
-            Qwen35CBv2PrefillLayerPolicy.enabledEnvironmentKey: "1",
-            Qwen35CBv2PrefillLayerPolicy.fullLayersEnvironmentKey: "0,7",
-        ]
-        MLXRandom.seed(0xA8_F0)
-        let model = Qwen35TextModelInner(config, environment: environment)
-        eval(model)
-
-        let decode = try run(model: model, config: config, phase: .decode)
-        let mtp = try run(model: model, config: config, phase: .mtp)
-        #expect(TinyArtifactQwen.identical(decode.hidden, mtp.hidden))
-        #expect(decode.roots.count == mtp.roots.count)
-        #expect(decode.cacheSnapshots.count == mtp.cacheSnapshots.count)
-
-        for index in decode.recurrent.keys.sorted() {
-            let lhs = try #require(decode.recurrent[index])
-            let rhs = try #require(mtp.recurrent[index])
-            #expect(
-                TinyArtifactQwen.identical(
-                    try #require(lhs.conv), try #require(rhs.conv)))
-            #expect(
-                TinyArtifactQwen.identical(
-                    try #require(lhs.ssm), try #require(rhs.ssm)))
-        }
-        for (lhs, rhs) in zip(decode.cacheSnapshots, mtp.cacheSnapshots) {
-            #expect(lhs.offset == rhs.offset)
-            #expect(TinyArtifactQwen.identical(lhs.keys, rhs.keys))
-            #expect(TinyArtifactQwen.identical(lhs.values, rhs.values))
-        }
-    }
-
-    @Test func explicitPrefillBuildsEveryCacheAndRecurrentRoot() throws {
-        let config = try TinyArtifactQwen.configuration()
-        let environment = [
-            Qwen35CBv2PrefillLayerPolicy.enabledEnvironmentKey: "1",
-            Qwen35CBv2PrefillLayerPolicy.fullLayersEnvironmentKey: "0,7",
-        ]
-        MLXRandom.seed(0xA8_F1)
-        let model = Qwen35TextModelInner(config, environment: environment)
-        eval(model)
