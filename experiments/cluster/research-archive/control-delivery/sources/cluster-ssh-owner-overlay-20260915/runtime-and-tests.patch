+        }
+    }
+    public func receiveWorkerEvent(until deadline: UInt64, cancelled: () -> Bool) throws -> ClusterWorkerEventFrame {
+        while DispatchTime.now().uptimeNanoseconds < deadline {
+            if cancelled() { throw ClusterWorkerOwnerError.cancelled }
