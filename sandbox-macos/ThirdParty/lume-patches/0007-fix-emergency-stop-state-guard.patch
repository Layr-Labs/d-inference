+@MainActor
+private func waitUntilReady(
+    timeout: Duration = .seconds(2),
+    _ condition: @escaping @MainActor () -> Bool
+) async throws {
+    let clock = ContinuousClock()
+    let deadline = clock.now.advanced(by: timeout)
+    while !condition() {
+        guard clock.now < deadline else {
+            Issue.record("Timed out waiting for asynchronous VM state")
+            return
+        }
+        try await Task.sleep(for: .milliseconds(10))
+    }
+}
+
+@MainActor
+private final class QuietDisplayPresenter: VMDisplayPresenter {
+    private(set) var showCount = 0
+    func show(context: VMDisplayContext) async throws { showCount += 1 }
+    func hide() {}
+}
+
+/// Builds a VM whose fail-stop is captured rather than fatal.
+@MainActor
+private func makeCapturingVM(
+    context: VMDirContext,
+    service: MockVMVirtualizationService,
+    terminalTimeout: Duration = .milliseconds(300),
+    reasons: @escaping @MainActor (VMOwnerFailStopReason) -> Void
+) -> MockVM {
+    MockVM(
+        vmDirContext: context,
+        virtualizationServiceFactory: { _ in service },
+        vncServiceFactory: { MockVNCService(vmDirectory: $0) },
+        displayPresenterFactory: { _, _ in QuietDisplayPresenter() },
+        ownerFailStopHandler: { reason in
+            reasons(reason)
+            return .retainAuthorityForTesting
+        },
+        // The production budget is 10s. Nothing here needs to wait it out: the
+        // point is which side of the wait the guest ends up on, not how long
+        // the wait is.
+        emergencyStopTerminalTimeout: terminalTimeout
+    )
+}
+
+@MainActor
+@Test("cancelling the run task and stopping together does not fail-stop")
+func concurrentCancelAndStopDoesNotFailStop() async throws {
+    let (root, context) = try makeEmergencyStopTestDirectory()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    let service = MockVMVirtualizationService()
+    var failStopReasons: [VMOwnerFailStopReason] = []
+    let vm = makeCapturingVM(context: context, service: service) {
+        failStopReasons.append($0)
+    }
+
+    let runTask = Task {
+        try await vm.run(displayMode: .none, sharedDirectories: [], mount: nil)
+    }
+    try await waitUntilReady { service.state == .running }
+
+    // Exactly what UnattendedInstaller.materializeFirstBootState does at
+    // :115-116 to end the first boot. Both calls are MainActor, so `stop`
+    // reaches the virtualization service before the cancelled task can resume;
+    // the task then wakes into the emergency path and sees `.stopping`.
+    runTask.cancel()
+    try? await vm.stop()
+    _ = try? await runTask.value
+
+    #expect(
+        failStopReasons.isEmpty,
+        """
+        The owner process was killed over a guest that was already stopping. \
+        Reasons: \(failStopReasons.map(\.serviceState))
+        """)
+    #expect(service.state == .stopped)
+    // The redundant second stop must never be issued at all.
+    #expect(service.stopRejectedCallCount == 0)
+}
