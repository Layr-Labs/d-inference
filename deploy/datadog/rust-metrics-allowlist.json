    "d_inference.rust.recovery.action": {"kind": "counter", "tags": ["kind", "operation", "outcome"]},
    "d_inference.rust.billing.external_unknown": {"kind": "counter", "tags": ["source"]},
    "d_inference.rust.outbox.state": {"kind": "gauge", "tags": ["kind", "state"]},
    "d_inference.rust.fee.state": {"kind": "gauge", "tags": ["kind", "state"]},
    "d_inference.rust.ownership.healthy": {"kind": "gauge", "tags": []},
