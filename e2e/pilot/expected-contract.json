      "statuses": [401],
      "headers": {"content-type": "application/json"},
      "body": {"kind": "json", "required": ["/error"]}
    },
    "chat_stream": {
      "statuses": [200],
      "headers": {"content-type": "text/event-stream"},
      "body": {"kind": "sse", "minimum_events": 2, "done": true, "content_matches": "content", "response_model": "trace_expected"}
    },
    "chat_alias_stream": {
      "statuses": [200],
      "headers": {"content-type": "text/event-stream"},
      "body": {"kind": "sse", "minimum_events": 2, "done": true, "content_matches": "content", "response_model": "trace_expected"}
    },
    "chat_nonstream": {
      "statuses": [200],
      "headers": {"content-type": "application/json"},
      "body": {"kind": "json", "required": ["/object", "/choices/0"], "response_model": "trace_expected"}
    },
    "unknown_model": {
      "statuses": [404],
      "headers": {"content-type": "application/json"},
      "body": {"kind": "json", "required": ["/error"]}
    },
    "malformed_json": {
      "statuses": [400],
      "headers": {"content-type": "application/json"},
      "body": {"kind": "json", "required": ["/error"]}
    },
    "route_not_found": {
      "statuses": [404],
      "headers": {"content-type": "application/json"},
      "body": {"kind": "json", "required": ["/error"]}
    },
    "method_not_allowed": {
      "statuses": [404],
      "headers": {"content-type": "application/json"},
      "body": {"kind": "json", "required": ["/error"]}
    },
    "session_replacement": {
      "statuses": [200],
      "headers": {"content-type": "text/event-stream"},
      "body": {"kind": "sse", "minimum_events": 2, "done": true, "content_matches": "content", "response_model": "trace_expected"}
