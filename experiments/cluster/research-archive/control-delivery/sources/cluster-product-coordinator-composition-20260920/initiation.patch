+func TestNativePairConfiguredDisconnectAndExpiryCannotFollowReplacement(t *testing.T) {
+	f := newNativePairFixture(t)
+	if e := f.c.Configure(f.n[0], configuredFixtureIntent(t, f, 0, nil)); e != nil {
