+@MainActor
+@Test("a guest that stopped with an error does not fail-stop")
+func fatalGuestStopDoesNotFailStop() async throws {
+    let (root, context) = try makeEmergencyStopTestDirectory()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    let service = MockVMVirtualizationService()
+    var failStopReasons: [VMOwnerFailStopReason] = []
+    let vm = makeCapturingVM(context: context, service: service) {
+        failStopReasons.append($0)
+    }
+
+    let runTask = Task {
+        try await vm.run(displayMode: .none, sharedDirectories: [], mount: nil)
+    }
+    try await waitUntilReady { service.state == .running }
+
+    // `didStopWithError` leaves the real machine in `.error`, which never
+    // becomes `.stopped`. There is no live guest to fail closed over.
+    service.simulateFatalStop()
+    _ = try? await runTask.value
+
+    #expect(
+        failStopReasons.isEmpty,
+        "A guest already dead in .error is not a guest left running")
+    #expect(service.state == .error)
+    #expect(service.stopCallCount == 0)
+}
