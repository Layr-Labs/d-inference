+                  BoundedProbeInput.integer(table["bits"]) == 4,
+                  BoundedProbeInput.integer(table["group_size"]) == 64,
+                  table["mode"] as? String == "affine",
+                  Set(table.keys) == Set(overrides.keys).union(["bits", "group_size", "mode"]) else {
