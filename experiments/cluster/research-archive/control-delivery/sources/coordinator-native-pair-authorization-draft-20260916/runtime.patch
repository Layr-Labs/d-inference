+		[]byte(strings.Replace(string(b), TypeNativePairHello, "native_pair_unknown", 1)),
+		append(append([]byte(nil), b...), b...),
+	}
+	for i, b := range cases {
+		if _, e := DecodeNativePairMessage(b); e == nil {
+			t.Fatalf("malformed case %d admitted", i)
+		}
+	}
