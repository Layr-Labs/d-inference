+/// Shared full-width tensor materialization after legacy or exact registered
+/// source validation. No gate is minted here; the caller owns the model and
+/// discards it on failure. The optional hook runs immediately before each read.
+func materializeVerifiedQwenDiagnostic(
+    model: any LanguageModel, prepared: PreparedQwenCheckpoint,
+    originalConfiguration: Data, storage: QwenDenseSourceReadPlan,
+    convertBF16: Bool, check: () throws -> Void,
+    beforeTensor: ((String, QwenCheckpointTensor) throws -> Void)? = nil
+) throws -> VerifiedQwenDiagnosticReceipt {
