+import Darwin
+import Foundation
+
+/// A durable fence for an interrupted root offline operation. Ordinary native
+/// commands only check absence; they never decode, repair or remove the record.
+enum DarkbloomOfflineOperation {
+    static let fileName = ".darkbloom-offline.json"
+
+    static func requireAbsent(in directory: URL) throws {
+        let path = directory.appendingPathComponent(fileName).path
+        var info = stat()
+        if lstat(path, &info) == 0 || errno != ENOENT {
+            throw PendingOfflineOperation(name: directory.lastPathComponent)
+        }
+    }
+
+    static func requireStoragePathsClear(_ paths: [Path]) throws {
+        for path in paths {
+            try requireAbsent(in: path.url.resolvingSymlinksInPath().deletingLastPathComponent())
+        }
+    }
+
+    struct PendingOfflineOperation: Error, LocalizedError {
+        let name: String
+        var errorDescription: String? {
+            "VM \(name) is fenced for pending offline maintenance; root recovery must prove cleanup"
+        }
+    }
+}
+
+extension VMDirectory {
+    func requireNoOfflineOperation() throws {
+        try DarkbloomOfflineOperation.requireAbsent(in: dir.url)
+    }
+
+    func withOfflineMutationGuard<T>(_ operation: () throws -> T) throws -> T {
+        guard let guardFile = try tryAcquireResizeGuard(exclusive: true) else {
+            throw DiskResizeError.vmRunning(name)
+        }
+        defer { try? guardFile.close() }
+        return try operation()
+    }
+}
