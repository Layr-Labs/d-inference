diff --git a/libs/lume/tests/RunLockLivenessTests.swift b/libs/lume/tests/RunLockLivenessTests.swift
new file mode 100644
index 00000000..55099e39
--- /dev/null
+++ b/libs/lume/tests/RunLockLivenessTests.swift
@@ -0,0 +1,697 @@
+import Darwin
+import Foundation
+import Testing
+
+@testable import lume
+
+enum LockChildMode: String {
+    case owner
+    case opener
+    case configOwner = "config-owner"
+    case recordOwner = "record-owner"
+}
+
+enum LockChildError: Error {
+    case systemCall(String, Int32)
+    case setupFailed
+    case helperResourceMissing
+    case helperCompilationFailed(Int32)
+}
+
+private enum GatedRunError: Error {
+    case released
+}
+
+@MainActor
+private final class RunEntryGate {
+    private var entered = false
+    private var entryWaiters:
+        [CheckedContinuation<Void, Never>] = []
+    private var releaseWaiter:
+        CheckedContinuation<Void, Never>?
+
+    func enterAndWait() async {
+        entered = true
+        let waiters = entryWaiters
+        entryWaiters.removeAll()
+        for waiter in waiters {
+            waiter.resume()
+        }
+        await withCheckedContinuation {
+            releaseWaiter = $0
+        }
+    }
+
+    func waitForEntry() async {
+        guard !entered else { return }
+        await withCheckedContinuation {
+            entryWaiters.append($0)
+        }
+    }
+
+    func release() {
+        releaseWaiter?.resume()
+        releaseWaiter = nil
+    }
+}
+
+@MainActor
+private final class GatedRunVM: MockVM {
+    let gate: RunEntryGate
+    private(set) var cacheWasPresentAtEntry: Bool?
+
+    init(
+        vmDirContext: VMDirContext,
+        gate: RunEntryGate
+    ) {
+        self.gate = gate
+        super.init(
+            vmDirContext: vmDirContext,
+            virtualizationServiceFactory: {
+                _ in MockVMVirtualizationService()
+            },
+            vncServiceFactory: {
+                MockVNCService(vmDirectory: $0)
+            })
+    }
+
+    override func run(
+        displayMode: DisplayMode = .vnc,
+        sharedDirectories: [SharedDirectory],
+        mount: Path?,
+        vncPort: Int = 0,
+        vncPassword: String? = nil,
+        recoveryMode: Bool = false,
+        usbMassStoragePaths: [Path]? = nil,
+        additionalDiskPaths: [Path]? = nil,
+        networkMode: NetworkMode? = nil,
+        clipboard: Bool = false,
+        vncPolicy: VNCPolicy = .enabled
+    ) async throws {
+        cacheWasPresentAtEntry =
+            SharedVM.shared.getVM(for: vmDirContext.dir)
+            != nil
+        await gate.enterAndWait()
+        throw GatedRunError.released
+    }
+}
+
+@MainActor
+private final class GatedRunVMFactory: VMFactory {
+    let gate = RunEntryGate()
+    private(set) var vm: GatedRunVM?
+
+    func createVM(
+        vmDirContext: VMDirContext,
+        imageLoader: ImageLoader?
+    ) throws -> VM {
+        let vm = GatedRunVM(
+            vmDirContext: vmDirContext,
+            gate: gate)
+        self.vm = vm
+        return vm
+    }
+}
+
+private final class StartWhileObservationGuardedProbe:
+    RunLockProbe, @unchecked Sendable
+{
+    private let attemptStart: () throws -> Void
+    private(set) var startWasBlocked = false
+    private(set) var unexpectedStartError: Error?
+
+    init(attemptStart: @escaping () throws -> Void) {
+        self.attemptStart = attemptStart
+    }
+
+    func acquireObservation(
+        configPath: String,
+        ownerLockPath: String
+    ) -> RunLockObservationLease {
+        let lease = SystemRunLockProbe().acquireObservation(
+            configPath: configPath,
+            ownerLockPath: ownerLockPath)
+        guard case .unlocked = lease.observation else {
+            unexpectedStartError = LockChildError.setupFailed
+            return lease
+        }
+        do {
+            try attemptStart()
+        } catch LockChildError.setupFailed {
+            startWasBlocked = true
+        } catch {
+            unexpectedStartError = error
+        }
+        return lease
+    }
+}
+
+final class LockTestHelper {
+    private let temporaryDirectory: URL
+    private let executable: URL
+
+    init() throws {
+        guard let source = Bundle.module.url(
+                  forResource: "RunLockTestHelper",
+                  withExtension: "c")
+        else {
+            throw LockChildError.helperResourceMissing
+        }
+
+        let temporaryDirectory =
+            FileManager.default.temporaryDirectory
+            .appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(
+            at: temporaryDirectory,
+            withIntermediateDirectories: false)
+        let executable =
+            temporaryDirectory.appendingPathComponent(
+                "run-lock-test-helper")
+
+        do {
+            let compiler = Process()
+            compiler.executableURL =
+                URL(fileURLWithPath: "/usr/bin/xcrun")
+            compiler.arguments = [
+                "--sdk", "macosx", "clang",
+                "-D_DARWIN_C_SOURCE",
+                "-std=c11", "-Wall", "-Wextra", "-Werror",
+                source.path,
+                "-o", executable.path,
+            ]
+            try compiler.run()
+            compiler.waitUntilExit()
+            guard compiler.terminationReason == .exit,
+                  compiler.terminationStatus == 0
+            else {
+                throw LockChildError.helperCompilationFailed(
+                    compiler.terminationStatus)
+            }
+        } catch {
+            try? FileManager.default.removeItem(
+                at: temporaryDirectory)
+            throw error
+        }
+
+        self.temporaryDirectory = temporaryDirectory
+        self.executable = executable
+    }
+
+    deinit {
+        try? FileManager.default.removeItem(
+            at: temporaryDirectory)
+    }
+
+    func spawn(
+        mode: LockChildMode,
+        configPath: String,
+        ownerLockPath: String
+    ) throws -> LockTestChild {
+        let process = Process()
+        process.executableURL = executable
+        process.arguments = [
+            mode.rawValue,
+            configPath,
+            ownerLockPath,
+        ]
+
+        let readyPipe = Pipe()
+        let releasePipe = Pipe()
+        process.standardInput = releasePipe
+        process.standardOutput = readyPipe
+        try process.run()
+        try? readyPipe.fileHandleForWriting.close()
+        try? releasePipe.fileHandleForReading.close()
+
+        let child = LockTestChild(
+            process: process,
+            releaseHandle: releasePipe.fileHandleForWriting)
+        var ready: UInt8 = 0
+        let readyCount = Darwin.read(
+            readyPipe.fileHandleForReading.fileDescriptor,
+            &ready,
+            1)
+        try? readyPipe.fileHandleForReading.close()
+        guard readyCount == 1, ready == 1 else {
+            child.terminate()
+            throw LockChildError.setupFailed
+        }
+        return child
+    }
+}
+
+final class LockTestChild {
+    let processIdentifier: pid_t
+    private let process: Process
+    private var releaseHandle: FileHandle?
+    private var reaped = false
+
+    init(process: Process, releaseHandle: FileHandle) {
+        self.process = process
+        self.processIdentifier = process.processIdentifier
+        self.releaseHandle = releaseHandle
+    }
+
+    func isAlive() -> Bool {
+        guard !reaped else { return false }
+        if !process.isRunning {
+            process.waitUntilExit()
+            reaped = true
+            return false
+        }
+        return true
+    }
+
+    func terminate() {
+        try? releaseHandle?.close()
+        releaseHandle = nil
+        guard !reaped else { return }
+        process.waitUntilExit()
+        reaped = true
+    }
+}
+
+@MainActor
+@Test("the controller does not cache a VM before VM.run enters")
+func controllerCacheBeginsInsideRunLifecycle() async throws {
+    let fixture = try makeLivenessFixture(
+        named: "cache-entry")
+    defer {
+        try? FileManager.default.removeItem(
+            at: fixture.storage)
+    }
+    let factory = GatedRunVMFactory()
+    let controller = LumeController(vmFactory: factory)
+
+    let runTask = Task {
+        try await controller.runVM(
+            name: fixture.directory.name,
+            noDisplay: true,
+            storage: fixture.storage.path,
+            vncPolicy: .disabled)
+    }
+    await factory.gate.waitForEntry()
+    let gatedVM = try #require(factory.vm)
+
+    #expect(gatedVM.cacheWasPresentAtEntry == false)
+    #expect(
+        SharedVM.shared.getVM(
+            for: fixture.directory) == nil)
+
+    factory.gate.release()
+    await #expect(throws: GatedRunError.self) {
+        try await runTask.value
+    }
+    #expect(
+        SharedVM.shared.getVM(
+            for: fixture.directory) == nil)
+}
+
+@MainActor
+@Test("status holds real proof locks through stopped classification")
+func statusStartRaceCannotClearLiveMarker() throws {
+    let fixture = try makeLivenessFixture(
+        named: "status-start-race")
+    defer {
+        try? FileManager.default.removeItem(
+            at: fixture.storage)
+    }
+    guard FileManager.default.createFile(
+              atPath:
+                  fixture.directory.runOwnerLockPath.path,
+              contents: Data()),
+          chmod(
+              fixture.directory.runOwnerLockPath.path,
+              mode_t(S_IRUSR | S_IWUSR)) == 0
+    else {
+        throw LockChildError.setupFailed
+    }
+
+    let helper = try LockTestHelper()
+    var owner: LockTestChild?
+    defer { owner?.terminate() }
+    let probe = StartWhileObservationGuardedProbe {
+        let startedOwner = try helper.spawn(
+            mode: .owner,
+            configPath:
+                fixture.directory.configPath.path,
+            ownerLockPath:
+                fixture.directory.runOwnerLockPath.path)
+        owner = startedOwner
+        let runIdentity = try identity(
+            for: startedOwner,
+            in: fixture.directory)
+        try fixture.directory.saveSession(
+            .active(
+                url: nil,
+                vncEnabled: false,
+                runIdentity: runIdentity))
+    }
+    let controller = LumeController(runLockProbe: probe)
+
+    let details = try controller.getDetails(
+        name: fixture.directory.name,
+        storage: fixture.storage.path)
+    if let unexpectedStartError = probe.unexpectedStartError {
+        throw unexpectedStartError
+    }
+    #expect(probe.startWasBlocked)
+    #expect(owner == nil)
+    #expect(details.status == "stopped")
+    #expect(!fixture.directory.sessionsPath.exists())
+
+    let startedOwner = try helper.spawn(
+        mode: .owner,
+        configPath: fixture.directory.configPath.path,
+        ownerLockPath:
+            fixture.directory.runOwnerLockPath.path)
+    owner = startedOwner
+    let runIdentity = try identity(
+        for: startedOwner,
+        in: fixture.directory)
+    try fixture.directory.saveSession(
+        .active(
+            url: nil,
+            vncEnabled: false,
+            runIdentity: runIdentity))
+    guard case .owned(let files, let process) =
+        SystemRunLockProbe().observeLock(
+            configPath:
+                fixture.directory.configPath.path,
+            ownerLockPath:
+                fixture.directory.runOwnerLockPath.path)
+    else {
+        Issue.record(
+            "The deterministic start did not retain its kernel locks")
+        return
+    }
+    #expect(files.matches(runIdentity.files))
+    #expect(process == runIdentity.process)
+    let runningDetails = try controller.getDetails(
+        name: fixture.directory.name,
+        storage: fixture.storage.path)
+    #expect(
+        runningDetails.status == "running",
+        "A start that acquires after status releases its guard must be visible to the next status call")
+    #expect(
+        fixture.directory.sessionsPath.exists(),
+        "Status must not clear the active owner's session marker")
+}
+
+@MainActor
+private func makeLivenessFixture(
+    named name: String
+) throws -> (storage: URL, directory: VMDirectory, vm: MockVM) {
+    let storage = FileManager.default.temporaryDirectory
+        .appendingPathComponent(UUID().uuidString)
+    let directory = VMDirectory(
+        Path(storage.path).directory(name))
+    try FileManager.default.createDirectory(
+        at: directory.dir.url,
+        withIntermediateDirectories: true)
+    try Data(repeating: 0, count: 1024)
+        .write(to: directory.diskPath.url)
+    try Data(repeating: 0, count: 1024)
+        .write(to: directory.nvramPath.url)
+
+    var config = try VMConfig(
+        os: "mock-os",
+        cpuCount: 1,
+        memorySize: 1024,
+        diskSize: 1024,
+        display: "1024x768")
+    config.setMacAddress("00:11:22:33:44:55")
+    try directory.saveConfig(config)
+
+    let context = VMDirContext(
+        dir: directory,
+        config: config,
+        home: Home(fileManager: .default),
+        storage: storage.path)
+    let vm = MockVM(
+        vmDirContext: context,
+        virtualizationServiceFactory: {
+            _ in MockVMVirtualizationService()
+        },
+        vncServiceFactory: {
+            MockVNCService(vmDirectory: $0)
+        })
+    return (storage, directory, vm)
+}
+
+private func identity(
+    for child: LockTestChild,
+    in directory: VMDirectory
+) throws -> RunSessionIdentity {
+    guard let process = RunLockProcessIdentity.read(
+              processIdentifier: child.processIdentifier),
+          let config = RunLockFileIdentity(
+              path: directory.configPath.path),
+          let ownerLock = RunLockFileIdentity(
+              path: directory.runOwnerLockPath.path)
+    else {
+        throw LockChildError.setupFailed
+    }
+    return RunSessionIdentity(
+        process: process,
+        files: RunLockFilesIdentity(
+            config: config,
+            ownerLock: ownerLock))
+}
+
+@MainActor
+private func expectLivenessInconclusive(
+    named expectedName: String,
+    operation: @MainActor () async throws -> Void
+) async {
+    do {
+        try await operation()
+        Issue.record(
+            "Expected liveness-inconclusive failure")
+    } catch VMError.livenessInconclusive(let name) {
+        #expect(name == expectedName)
+    } catch {
+        Issue.record(
+            "Expected liveness-inconclusive failure, got \(error)")
+    }
+}
+
+@MainActor
+@Test("cross-process stop never signals a locked owner or generic opener")
