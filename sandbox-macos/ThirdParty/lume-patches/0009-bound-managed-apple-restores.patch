diff --git a/libs/lume/src/VM/ManagedRestoreContext.swift b/libs/lume/src/VM/ManagedRestoreContext.swift
new file mode 100644
index 0000000..0affcd4
--- /dev/null
+++ b/libs/lume/src/VM/ManagedRestoreContext.swift
@@ -0,0 +1,73 @@
+import Foundation
+
+/// Explicit broker-only raw restore mode. Ordinary standalone/unattended create
+/// remains separate; no device/readiness policy is disabled for a tenant VM.
+@MainActor
+final class ManagedRestoreContext {
+    static let profileKey = "DARKBLOOM_RESTORE_PROFILE"
+    private(set) static var current: ManagedRestoreContext?
+    let lifecycle: BrokerLifecycleCapability
+    private let cleanupProof = ManagedRestoreCleanupProof()
+
+    private init(lifecycle: BrokerLifecycleCapability) { self.lifecycle = lifecycle }
+
+    static func validateInvocation(profile: String?, os: String, unattended: Bool,
+                                   hasAuthority: Bool, hasLifecycle: Bool, hasDeviceProfile: Bool) throws -> Bool {
+        guard let profile else {
+            guard !hasAuthority, !hasLifecycle else {
+                throw VMError.internalError("restore capabilities require the managed raw restore profile")
+            }
+            return false
+        }
+        guard profile == "apple-v1", os.lowercased() == "macos", !unattended,
+              hasAuthority, hasLifecycle, !hasDeviceProfile else {
+            throw VMError.internalError("invalid managed raw restore invocation")
+        }
+        return true
+    }
+
+    static func inherited(os: String, unattended: Bool) throws -> ManagedRestoreContext? {
+        let environment = ProcessInfo.processInfo.environment
+        guard try validateInvocation(profile: environment[profileKey], os: os, unattended: unattended,
+            hasAuthority: environment[DarkbloomRuntimeAuthority.environmentVariable] != nil,
+            hasLifecycle: environment[BrokerLifecycleCapability.environmentVariable] != nil,
+            hasDeviceProfile: environment["DARKBLOOM_VM_PROFILE"] != nil) else { return nil }
+        guard current == nil else { throw VMError.internalError("managed restore is already active") }
+        unsetenv(profileKey)
+        try DarkbloomRuntimeAuthority.retainInheritedForManagedRestore()
+        guard let lifecycle = try BrokerLifecycleCapability.inherited() else {
+            throw VMError.internalError("managed restore requires broker lifecycle ownership")
+        }
+        let context = ManagedRestoreContext(lifecycle: lifecycle)
+        current = context
+        try checkCancellation()
+        return context
+    }
+
+    static func checkCancellation() throws {
+        try Task.checkCancellation()
+        if current?.lifecycle.isStopRequested == true { throw CancellationError() }
+    }
+
+    static var mayRemoveCreatedFiles: Bool { current?.cleanupProof.isSafeToRemove ?? true }
+
+    func retainInstallation(_ owner: AnyObject) { cleanupProof.retain(owner) }
+    func recordStoppedInstallation() { cleanupProof.recordStopped() }
+
+    func finishCommand() {
+        lifecycle.clearStopHandler()
+        if Self.mayRemoveCreatedFiles { lifecycle.cancelFailStopAfterTerminalCleanup() }
+        // The context and inherited EX descriptor remain process-owned. If VZ
+        // stop was unproven, retain its owner and watchdog until process exit.
+    }
+}
+
+/// Separates framework completion from a proved stopped owner. A failed stop
+/// deliberately leaves the actual service retained until command process exit.
+@MainActor
+final class ManagedRestoreCleanupProof {
+    private var owner: AnyObject?
+    var isSafeToRemove: Bool { owner == nil }
+    func retain(_ owner: AnyObject) { self.owner = owner }
+    func recordStopped() { owner = nil }
+}
diff --git a/libs/lume/src/Virtualization/MacOSInstallationOperation.swift b/libs/lume/src/Virtualization/MacOSInstallationOperation.swift
new file mode 100644
index 0000000..dcf94b5
--- /dev/null
+++ b/libs/lume/src/Virtualization/MacOSInstallationOperation.swift
@@ -0,0 +1,86 @@
+import Foundation
+
+protocol MacOSInstallationDriver: AnyObject {
+    var progress: Progress { get }
+    func install(completion: @escaping @Sendable (Result<Void, Error>) -> Void)
+}
+
+/// All installer access occurs on its VZ queue. Cancellation is sticky before
+/// registration, but Progress.cancel is never called before install() starts.
+final class MacOSInstallationOperation: @unchecked Sendable {
+    private let queue: DispatchQueue
+    private let makeDriver: @Sendable () throws -> any MacOSInstallationDriver
+    private let progressHandler: (@Sendable (Double) -> Void)?
+    private let cancellationLock = NSLock()
+    private var cancellationRequested = false
+    private var completionReceived = false
+    // The following fields are confined to queue.
+    private var driver: (any MacOSInstallationDriver)?
+    private var observation: NSKeyValueObservation?
+    private var continuation: CheckedContinuation<Void, Error>?
+    private var started = false
+    private var finished = false
+    private var cancellationDelivered = false
+
+    init(queue: DispatchQueue, makeDriver: @escaping @Sendable () throws -> any MacOSInstallationDriver,
+         progressHandler: (@Sendable (Double) -> Void)? = nil) {
+        self.queue = queue; self.makeDriver = makeDriver; self.progressHandler = progressHandler
+    }
+
+    func run() async throws {
+        try await withTaskCancellationHandler {
+            try await withCheckedThrowingContinuation { continuation in
+                queue.async { self.begin(continuation) }
+            }
+        } onCancel: { self.requestCancellation() }
+    }
+
+    func requestCancellation() {
+        cancellationLock.lock(); cancellationRequested = true; cancellationLock.unlock()
+        queue.async { self.deliverCancellationIfStarted() }
+    }
+
+    private var isCancellationRequested: Bool {
+        cancellationLock.lock(); defer { cancellationLock.unlock() }
+        return cancellationRequested
+    }
+
+    private func begin(_ continuation: CheckedContinuation<Void, Error>) {
+        guard !started, !finished, self.continuation == nil else {
+            continuation.resume(throwing: VMError.internalError("installation operation already used")); return
+        }
+        self.continuation = continuation
+        if isCancellationRequested { complete(.failure(CancellationError())); return }
+        do {
+            let driver = try makeDriver(); self.driver = driver
+            if let progressHandler {
+                observation = driver.progress.observe(\.fractionCompleted, options: [.initial, .new]) { progress, _ in
+                    progressHandler(progress.fractionCompleted)
+                }
+            }
+            driver.install { result in
+                self.cancellationLock.lock(); self.completionReceived = true; self.cancellationLock.unlock()
+                self.queue.async { self.complete(result) }
+            }
+            started = true
+            deliverCancellationIfStarted()
+        } catch { complete(.failure(error)) }
+    }
+
+    private func deliverCancellationIfStarted() {
+        cancellationLock.lock()
+        let shouldCancel = cancellationRequested && !completionReceived
+        cancellationLock.unlock()
+        guard started, !finished, !cancellationDelivered, shouldCancel else { return }
+        cancellationDelivered = true
+        driver?.progress.cancel()
+    }
+
+    private func complete(_ result: Result<Void, Error>) {
+        guard !finished else { return }
+        finished = true; observation = nil; driver = nil
+        let pending = continuation; continuation = nil
+        if isCancellationRequested { pending?.resume(throwing: CancellationError()) }
+        else { pending?.resume(with: result) }
+    }
+}
