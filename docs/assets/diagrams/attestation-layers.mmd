%% Provider trust stack as built at 5d400cf75. Source of truth for attestation-layers.svg;
%% re-render after editing: mmdc -i attestation-layers.mmd -o attestation-layers.svg
%% MDA and code identity are flags carried alongside the level, not levels themselves.
flowchart TB
    subgraph L0["Level: untrusted (TrustNone)"]
        A0["No valid SE attestation, or MarkUntrusted<br/>(3 hard challenge failures, runtime claim mismatch)"]
    end
    subgraph L1["Level: self_signed (TrustSelfSigned)"]
        A1["Registration blob signed by SE P-256 key<br/>verifyProviderAttestation → SetAttested(true)"]
        A2["Periodic challenge every DefaultChallengeInterval = 5 min<br/>30 s reply timeout · fresh reply ≤ 16 min for routing"]
    end
    subgraph L2["Level: hardware (TrustHardware)"]
        A3["MDM SecurityInfo cross-check (per connection)<br/>sip=true · secure_boot=full · serial matches SE blob<br/>GrantHardwareEvidenceAtEpochIfNotUntrusted"]
    end
    subgraph F["Flags carried alongside the level"]
        B1["mda_verified — Apple DevicePropertiesAttestation<br/>SetMDAProofIfHardwareBound (needs hardware first)"]
        B2["code_attested — APNs code-identity challenge<br/>GrantProcessCodeAttested (needs same K + APNs token)"]
    end
    A0 -->|"SE blob verifies"| A1
    A1 --> A2
    A2 -->|"SecurityInfo passes"| A3
    A3 --> B1
    A3 --> B2
    A2 -->|"3 hard failures"| A0
    A3 -->|"posture mismatch / SE key change"| A1
    G["Routing private text requires: hardware ∧ fresh challenge ∧ code_attested (when enforced)<br/>providerLivenessGateReasonLocked → providerSupportsPrivateTextLocked"]
    A3 --> G
    B2 --> G
