+// KVCommitOnlyV2.swift
+//
+// Cache-only CBv2 prompt artifact construction.
+
+import MLX
+
+/// A storage-owning CBv2 cache that can commit projected K/V without
+/// constructing queries or evaluating attention.
+///
+/// The `KVCache` refinement is intentional: when a model passes hidden state
+/// through, no output tensor depends on this update. The engine therefore
+/// evaluates `innerState()` as the write root at the step fence.
+public protocol CBv2KVCommitOnlyLayerCache: CBv2AttendingLayerCache, KVCache {
+    /// Commit a complete `[B, kvHeads, L, headDim]` rectangle and advance
+    /// every row's absolute/device offset by `L`.
+    func commitKVOnly(keys: MLXArray, values: MLXArray)
+}
