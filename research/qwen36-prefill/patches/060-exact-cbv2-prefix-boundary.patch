@@ -0,0 +1,235 @@
+import Foundation
+import MLX
+import XCTest
+
+@testable import MLXLMCommon
+
+final class CBv2ExactPrefixCacheTests: XCTestCase {
+    private let layerKind = CBv2LayerKind(
+        attention: .full, headDim: 1, kvHeads: 1, queryHeads: 1)
+
+    private var recurrentSpec: CBv2RecurrentStateSpec {
+        CBv2RecurrentStateSpec(layers: [
+            CBv2RecurrentLayerStateSpec(
+                modelLayerIndex: 0,
+                convShape: [1, 1, 1], convDType: .float32,
+                ssmShape: [1, 1, 1, 1], ssmDType: .float32)
+        ])
+    }
+
+    private func snapshot(
+        tokenCount: Int = 4, value: Float = 3
+    ) throws -> CBv2ExactPrefixSnapshot {
+        let keys = MLXArray(
+            (0 ..< tokenCount).map { value + Float($0) * 0.25 }
+        ).reshaped([1, 1, tokenCount, 1])
+        let values = MLXArray(
+            (0 ..< tokenCount).map { value - Float($0) * 0.125 }
+        ).reshaped([1, 1, tokenCount, 1])
+        let attention = try CBv2ExactAttentionSnapshot(
+            keys: keys, values: values, offset: tokenCount, detaching: true)
+        let recurrent = try CBv2RecurrentStateSnapshot(
+            spec: recurrentSpec,
+            layers: [
+                0: CBv2RecurrentLayerState(
+                    conv: MLXArray.full(
+                        [1, 1, 1], values: MLXArray(value), dtype: .float32),
+                    ssm: MLXArray.full(
+                        [1, 1, 1, 1], values: MLXArray(value + 1), dtype: .float32))
+            ],
+            detaching: true)
+        let result = try CBv2ExactPrefixSnapshot(
+            tokenCount: tokenCount,
+            modelPosition: tokenCount,
+            attention: [attention],
+            recurrentState: recurrent,
+            frontierLogits: MLXArray([value, -value]),
+            detachingFrontier: true)
+        eval(result.evaluationArrays)
+        return result
+    }
+
+    private func lookup(
+        _ cache: ExactPrefixCacheV2,
+        tokens: [Int],
+        salt: String? = "tenant-a"
+    ) -> CBv2ExactPrefixSnapshot? {
+        cache.lookupExact(
+            requestID: CBv2RequestID(99),
+            tokens: tokens,
+            layerKinds: [layerKind],
+            recurrentStateSpec: recurrentSpec,
+            cacheSalt: salt)
+    }
+
+    func testKeyBindsExactTokensScopeModelAndPolicy() throws {
+        let tokens = [7, 11, 13, 17]
+        let first = try snapshot()
+        let cache = ExactPrefixCacheV2(
+            config: .init(
+                modelIdentity: "qwen-test|weights-a|template-a",
+                policyIdentity: "contiguous|fp32|exact-v1",
+                scopeID: "fallback",
+                maxBytes: first.byteCount * 2))
+        cache.donateExact(
+            requestID: CBv2RequestID(1),
+            tokens: tokens,
+            snapshot: first,
+            layerKinds: [layerKind],
+            cacheSalt: "tenant-a")
+
+        let hit = try XCTUnwrap(lookup(cache, tokens: tokens))
+        XCTAssertEqual(hit.tokenCount, tokens.count)
+        XCTAssertEqual(hit.modelPosition, tokens.count)
+        cache.endAdoption(
+            requestID: CBv2RequestID(99),
+            tokens: tokens,
+            matched: tokens.count,
+            cacheSalt: "tenant-a")
+
+        XCTAssertNil(lookup(cache, tokens: [7, 11, 13, 19]))
+        XCTAssertNil(lookup(cache, tokens: tokens, salt: "tenant-b"))
+        let wrongSpec = CBv2RecurrentStateSpec(layers: [
+            CBv2RecurrentLayerStateSpec(
+                modelLayerIndex: 9,
+                convShape: [1, 1, 1], convDType: .float32,
+                ssmShape: [1, 1, 1, 1], ssmDType: .float32)
+        ])
+        XCTAssertNil(
+            cache.lookupExact(
+                requestID: CBv2RequestID(100),
+                tokens: tokens,
+                layerKinds: [layerKind],
+                recurrentStateSpec: wrongSpec,
+                cacheSalt: "tenant-a"))
+
+        let otherModel = ExactPrefixCacheV2(
+            config: .init(
+                modelIdentity: "qwen-test|weights-b|template-a",
+                policyIdentity: "contiguous|fp32|exact-v1",
+                scopeID: "fallback",
+                maxBytes: first.byteCount * 2))
+        XCTAssertNil(lookup(otherModel, tokens: tokens))
+
+        let stats = cache.stats()
+        XCTAssertEqual(stats.hits, 1)
+        XCTAssertEqual(stats.misses, 3)
+        XCTAssertEqual(stats.tokensSaved, tokens.count)
+        XCTAssertEqual(stats.donations, 1)
+        XCTAssertEqual(stats.entryCount, 1)
+        XCTAssertEqual(stats.bytesInUse, first.byteCount)
+    }
+
+    func testLRUEvictionPinsAdoptersAndNeverExceedsHardBudget() throws {
+        let stored = try snapshot()
+        let budget = stored.byteCount * 2
+        let cache = ExactPrefixCacheV2(
+            config: .init(modelIdentity: "qwen-test", maxBytes: budget))
+        let a = [1, 2, 3, 4]
+        let b = [2, 3, 4, 5]
+        let c = [3, 4, 5, 6]
+        let d = [4, 5, 6, 7]
+
+        for (id, tokens) in [(1, a), (2, b)] {
+            cache.donateExact(
+                requestID: CBv2RequestID(UInt64(id)),
+                tokens: tokens,
+                snapshot: stored,
+                layerKinds: [layerKind],
+                cacheSalt: nil)
+        }
+        XCTAssertEqual(cache.bytesInUse, budget)
+
+        // Pin A and make it most recent. C must evict unpinned B.
+        XCTAssertNotNil(lookup(cache, tokens: a, salt: nil))
+        cache.donateExact(
+            requestID: CBv2RequestID(3),
+            tokens: c,
+            snapshot: stored,
+            layerKinds: [layerKind],
+            cacheSalt: nil)
+        XCTAssertNil(lookup(cache, tokens: b, salt: nil))
+        XCTAssertNotNil(lookup(cache, tokens: c, salt: nil))
+        XCTAssertEqual(cache.bytesInUse, budget)
+
+        // A and C are both pinned. A fourth donation is dropped instead of
+        // crossing the hard ceiling or evicting an active adopter.
+        cache.donateExact(
+            requestID: CBv2RequestID(4),
+            tokens: d,
+            snapshot: stored,
+            layerKinds: [layerKind],
+            cacheSalt: nil)
+        XCTAssertLessThanOrEqual(cache.bytesInUse, budget)
+        XCTAssertNil(lookup(cache, tokens: d, salt: nil))
+
+        cache.evict(toFit: 0)
+        XCTAssertEqual(cache.bytesInUse, budget, "pinned entries cannot be evicted")
+        cache.endAdoption(tokens: c, matched: c.count, cacheSalt: nil)
+        cache.evict(toFit: 0)
+        XCTAssertEqual(cache.bytesInUse, stored.byteCount)
+        cache.endAdoption(tokens: a, matched: a.count, cacheSalt: nil)
+        cache.evict(toFit: 0)
+        XCTAssertEqual(cache.bytesInUse, 0)
+
+        let stats = cache.stats()
+        XCTAssertEqual(stats.donations, 3)
+        XCTAssertEqual(stats.donationsDropped, 1)
+        XCTAssertEqual(stats.evictions, 3)
+        XCTAssertEqual(stats.entryCount, 0)
+    }
+
+    func testRestoredAttentionAndRecurrentStateAreRequestOwned() throws {
+        let stored = try snapshot()
+        let recurrentA = try CBv2RecurrentRequestState(restoring: stored.recurrentState)
+        let recurrentB = try CBv2RecurrentRequestState(restoring: stored.recurrentState)
+        XCTAssertNotEqual(ObjectIdentifier(recurrentA), ObjectIdentifier(recurrentB))
+
+        let evaluation = try recurrentA.bind()
+        let previous = try XCTUnwrap(evaluation.inputState(modelLayerIndex: 0))
+        try evaluation.stage(
+            modelLayerIndex: 0,
+            conv: try XCTUnwrap(previous.conv) + 10,
+            ssm: try XCTUnwrap(previous.ssm) + 20)
+        eval(try evaluation.evaluate())
+        try evaluation.commit()
+
+        XCTAssertEqual(
+            recurrentA.state(modelLayerIndex: 0)?.conv?[0, 0, 0].item(Float.self), 13)
+        XCTAssertEqual(
+            recurrentB.state(modelLayerIndex: 0)?.conv?[0, 0, 0].item(Float.self), 3)
+        XCTAssertEqual(
+            stored.recurrentState.layers[0]?.conv?[0, 0, 0].item(Float.self), 3)
+        try recurrentA.release()
+        XCTAssertEqual(
+            recurrentB.state(modelLayerIndex: 0)?.ssm?[0, 0, 0, 0].item(Float.self), 4)
+
+        let attention = try XCTUnwrap(stored.attention[0])
+        let capability = CBv2PrefixReuseCapability.derive(
+            layerKinds: [layerKind],
+            backend: .contiguousUnquantized)
+        let plan = try XCTUnwrap(
+            capability.plan(
+                matchedBoundary: stored.tokenCount,
+                exactStagedFullKVBytes: attention.byteCount,
+                maximumSequenceLength: 8,
+                nominalFullKVBytesPerToken: 8))
+        let backend = CBv2ContiguousKVBackend(
+            config: .init(bytesCapacity: 1 << 20, kvDType: .float32))
+        let prefix = [(keys: attention.keys, values: attention.values, offset: attention.offset)]
+        let attentionA = try backend.makeSequenceState(
+            adopting: prefix, plan: plan, layerKinds: [layerKind], maxLength: 8)
+        let attentionB = try backend.makeSequenceState(
+            adopting: prefix, plan: plan, layerKinds: [layerKind], maxLength: 8)
+        let append = MLXArray([Float(99)]).reshaped([1, 1, 1, 1])
+        _ = attentionA[0]?.update(keys: append, values: append)
+        XCTAssertEqual(attentionA[0]?.absoluteOffset, 5)
+        XCTAssertEqual(attentionB[0]?.absoluteOffset, 4)
+        XCTAssertEqual(attention.offset, 4)
+        XCTAssertEqual(attention.keys.dim(2), 4)
+
+        backend.release(attentionA)
+        backend.release(attentionB)
+        try recurrentB.release()
+    }
+}
