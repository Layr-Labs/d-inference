diff --git a/python/tests/test_quantized.py b/python/tests/test_quantized.py
index 2850c7c3..107e1573 100644
--- a/python/tests/test_quantized.py
+++ b/python/tests/test_quantized.py
@@ -287,6 +287,66 @@ class TestQuantized(mlx_tests.MLXTestCase):
                 tol = 1e-3 if dtype == mx.float32 else 1.5e-3
                 self.assertLess((y_q - y_hat).abs().max(), tol)
 
+    def test_bfloat16_affine_qmm_dequantizes_in_float32(self):
+        # For scale=0.0185546875, bias=-1.9921875, and code=15, doing
+        # multiply/add in bfloat16 produces -1.71875. Float32 arithmetic
+        # followed by one bfloat16 store produces -1.7109375. A 64-element
+        # dot with ones therefore distinguishes the paths exactly:
+        # -110.0 before the float32-dequant change, -109.5 after it.
+        group_size, bits = 64, 4
+        M, N, K = 32, 32, 64
+        packed_k = K * bits // 32
+        scale = 0.0185546875
+        bias = -1.9921875
+        expected_value = -109.5
+
+        packed_code = mx.array(0xFFFFFFFF, dtype=mx.uint32)
+        weights = mx.broadcast_to(packed_code, (N, packed_k))
+        scales = mx.full((N, K // group_size), scale, dtype=mx.bfloat16)
+        biases = mx.full((N, K // group_size), bias, dtype=mx.bfloat16)
+        x = mx.ones((M, K), dtype=mx.bfloat16)
+        expected = mx.full((M, N), expected_value, dtype=mx.bfloat16)
+
+        actual = mx.quantized_matmul(
+            x,
+            weights,
+            scales,
+            biases,
+            transpose=True,
+            group_size=group_size,
+            bits=bits,
+        )
+        self.assertTrue(mx.array_equal(actual, expected))
+
+        # Exercise the sorted-RHS gather path that serves MoE prefill. Exact
+        # Qwen E=256 K/N route coverage remains in the downstream Swift tests.
+        E, assignments = 2, 32
+        expert_weights = mx.broadcast_to(packed_code, (E, N, packed_k))
+        expert_scales = mx.full(
+            (E, N, K // group_size), scale, dtype=mx.bfloat16
+        )
+        expert_biases = mx.full(
+            (E, N, K // group_size), bias, dtype=mx.bfloat16
+        )
+        expert_indices = mx.array([0] * 16 + [1] * 16, dtype=mx.uint32)
+        gather_x = mx.ones((assignments, 1, K), dtype=mx.bfloat16)
+        gather_expected = mx.full(
+            (assignments, 1, N), expected_value, dtype=mx.bfloat16
+        )
+
+        gather_actual = mx.gather_qmm(
+            gather_x,
+            expert_weights,
+            expert_scales,
+            expert_biases,
+            rhs_indices=expert_indices,
+            transpose=True,
+            group_size=group_size,
+            bits=bits,
+            sorted_indices=True,
+        )
+        self.assertTrue(mx.array_equal(gather_actual, gather_expected))
+
     def test_qmm_large_dims(self):
         # Regression test for an int16 overflow in the NAX qmm kernels:
