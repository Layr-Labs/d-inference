# Coordinator API. The base URL is optional; production is the default.
DARKBLOOM_API_BASE_URL=https://api.darkbloom.dev/v1
DARKBLOOM_CONSOLE_STATS_URL=https://console.darkbloom.dev/api/stats

# Server-only service credential for the public homepage chat demo.
# Never prefix this variable with NEXT_PUBLIC_.
DARKBLOOM_API_KEY=
DARKBLOOM_CHAT_MODEL=gpt-oss-20b

# Homepage safety limits. The coordinator applies its own authoritative account
# limits as well; these keep a single public visitor from consuming the budget.
DARKBLOOM_CHAT_RPM=6
DARKBLOOM_CHAT_MAX_OUTPUT_TOKENS=300
DARKBLOOM_CHAT_TIMEOUT_MS=45000

# Optional separate salt for stable, non-reversible provider pseudonyms. When
# omitted, the server-only API key is used as the HMAC secret.
DARKBLOOM_PROVIDER_ID_SALT=

# HTTPS endpoint owned by Eigen Labs that accepts validated provider stories.
DARKBLOOM_STORY_WEBHOOK_URL=
# Optional bearer token sent to the endpoint above.
DARKBLOOM_STORY_WEBHOOK_TOKEN=
