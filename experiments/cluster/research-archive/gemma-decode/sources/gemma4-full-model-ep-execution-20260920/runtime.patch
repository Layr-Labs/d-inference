+            } else {
+                peer = try receiveRows(rows: scope.assignmentCounts[0], layerScope: scopeSHA, check: check)
+                localSHA = try sendRows(localRows, rows: scope.assignmentCounts[1], layerScope: scopeSHA, check: check)
+            }
