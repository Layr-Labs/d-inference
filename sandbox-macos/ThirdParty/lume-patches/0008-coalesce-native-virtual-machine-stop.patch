diff --git a/libs/lume/tests/VMStopCoordinatorTests.swift b/libs/lume/tests/VMStopCoordinatorTests.swift
new file mode 100644
index 000000000..8b8bff354
--- /dev/null
+++ b/libs/lume/tests/VMStopCoordinatorTests.swift
@@ -0,0 +1,110 @@
+import Foundation
+import Testing
+@testable import lume
+
+@Suite("Coalesced native VM stop")
+@MainActor
+struct VMStopCoordinatorTests {
+    @Test func concurrentAndCancelledCallersShareOneNativeStop() async throws {
+        let coordinator = VMStopCoordinator(), backend = StopBackend()
+        let first = Task { try await coordinator.stop(operation: backend.begin) }
+        await backend.waitForStarts(1)
+        first.cancel()
+        var joined = false
+        let second = Task {
+            joined = true
+            try await coordinator.stop(operation: backend.begin)
+        }
+        while !joined { await Task.yield() }
+        #expect(backend.starts == 1)
+        backend.finish(.success(()))
+        try await first.value
+        try await second.value
+        try await coordinator.stop(operation: backend.begin)
+        #expect(backend.starts == 1, "a proven stopped service is idempotent")
+    }
+
+    @Test func actualCallbackFailurePermitsOneNewAttempt() async throws {
+        let coordinator = VMStopCoordinator(), backend = StopBackend()
+        let first = Task { try await coordinator.stop(operation: backend.begin) }
+        await backend.waitForStarts(1)
+        var joined = false
+        let second = Task {
+            joined = true
+            try await coordinator.stop(operation: backend.begin)
+        }
+        while !joined { await Task.yield() }
+        backend.finish(.failure(StopBackend.Failure.native))
+        for task in [first, second] {
+            do { try await task.value; Issue.record("failed native callback must fail every waiter") }
+            catch { #expect(error as? StopBackend.Failure == .native) }
+        }
+        #expect(backend.starts == 1)
+        let retry = Task { try await coordinator.stop(operation: backend.begin) }
+        await backend.waitForStarts(2)
+        backend.finish(.success(()))
+        try await retry.value
+        #expect(backend.starts == 2)
+    }
+
+    @Test func timedOutCallbackRetainsItsAttemptAndCannotIssueAnotherStop() async throws {
+        let coordinator = VMStopCoordinator(timeoutSeconds: 0.03), backend = StopBackend()
+        let first = Task { try await coordinator.stop(operation: backend.begin) }
+        await backend.waitForStarts(1)
+        first.cancel()
+        do { try await first.value; Issue.record("missing callback must time out") }
+        catch { #expect(error as? VMStopError == .callbackTimedOut) }
+        do { try await coordinator.stop(operation: backend.begin); Issue.record("unresolved stop must stay failed closed") }
+        catch { #expect(error as? VMStopError == .callbackTimedOut) }
+        #expect(backend.starts == 1)
+        // Only a real callback failure permits retry after the deadline.
+        backend.finish(.failure(StopBackend.Failure.native))
+        let retry = Task { try await coordinator.stop(operation: backend.begin) }
+        await backend.waitForStarts(2)
+        backend.finish(.success(()))
+        try await retry.value
+    }
+
+    @Test func lateSuccessfulCallbackProvidesTerminalProofWithoutSecondNativeStop() async throws {
+        let coordinator = VMStopCoordinator(timeoutSeconds: 0.03), backend = StopBackend()
+        let first = Task { try await coordinator.stop(operation: backend.begin) }
+        await backend.waitForStarts(1)
+        do { try await first.value; Issue.record("terminal state is not proven before the callback") }
+        catch { #expect(error as? VMStopError == .callbackTimedOut) }
+        backend.finish(.success(()))
+        try await coordinator.stop(operation: backend.begin)
+        #expect(backend.starts == 1)
+    }
+
+    @Test func unprovenTerminalStateIsNotCachedAsSuccess() async throws {
+        let coordinator = VMStopCoordinator(), backend = StopBackend()
+        let first = Task { try await coordinator.stop(operation: backend.begin) }
+        await backend.waitForStarts(1)
+        backend.finish(.failure(VMStopError.terminalStateUnproven))
+        do { try await first.value; Issue.record("nonterminal state must fail") }
+        catch { #expect(error as? VMStopError == .terminalStateUnproven) }
+        let retry = Task { try await coordinator.stop(operation: backend.begin) }
+        await backend.waitForStarts(2)
+        backend.finish(.success(()))
+        try await retry.value
+    }
+}
+
+@MainActor
+private final class StopBackend {
+    enum Failure: Error { case native }
+    private(set) var starts = 0
+    private var completion: (@Sendable (Result<Void, Error>) -> Void)?
+    func begin(_ completion: @escaping @Sendable (Result<Void, Error>) -> Void) {
+        starts += 1
+        self.completion = completion
+    }
+    func finish(_ result: Result<Void, Error>) {
+        let completion = self.completion
+        self.completion = nil
+        completion?(result)
+    }
+    func waitForStarts(_ count: Int) async {
+        while starts < count { await Task.yield() }
+    }
+}
