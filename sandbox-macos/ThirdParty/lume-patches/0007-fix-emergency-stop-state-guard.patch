+@MainActor
+@Test("a stop that lands while the guest is still stopping is awaited, not repeated")
+func stoppingGuestIsAwaitedRatherThanStoppedTwice() async throws {
+    let (root, context) = try makeEmergencyStopTestDirectory()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    let service = MockVMVirtualizationService()
+    var failStopReasons: [VMOwnerFailStopReason] = []
+    let vm = makeCapturingVM(context: context, service: service) {
+        failStopReasons.append($0)
+    }
+
+    let runTask = Task {
+        try await vm.run(displayMode: .none, sharedDirectories: [], mount: nil)
+    }
+    try await waitUntilReady { service.state == .running }
+
+    // Pin the machine in `.stopping` so the emergency path is guaranteed to
+    // observe it there rather than racing past it.
+    service.holdStopUntilReleased()
+    let stopTask = Task { try? await vm.stop() }
+    try await waitUntilReady { service.state == .stopping }
+
+    runTask.cancel()
+    try await Task.sleep(for: .milliseconds(50))
+    service.releaseStop()
+    _ = await stopTask.value
+    _ = try? await runTask.value
+
+    #expect(failStopReasons.isEmpty)
+    #expect(service.stopCallCount == 1, "the guest must be stopped once, not twice")
+    #expect(service.state == .stopped)
+}
