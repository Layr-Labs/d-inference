@@ -1,119 +0,0 @@
-import Foundation
-
-/// The Qwen target phases that traverse the CBv2 decoder stack.
-///
-/// Keeping this explicit prevents a multi-token MTP verify from being
-/// mistaken for prefill based on tensor shape.
-public enum Qwen35CBv2ForwardPhase: Equatable, Sendable {
-    case prefill
-    case decode
-    case mtp
-}
-
-public enum Qwen35CBv2PrefillLayerMode: Equatable, Sendable {
-    case full
-    case artifactOnly
-}
-
-/// Default-off artifact-only experiment for Qwen3.5/3.6 TEXT prefill.
-///
-/// Full layers execute the checkpoint function. Every other layer constructs
-/// only the persistent artifact decode needs (GDN terminal state or attention
-/// K/V) and passes its hidden input through. Decode and MTP always execute the
-/// full checkpoint function.
-public struct Qwen35CBv2PrefillLayerPolicy: Equatable, Sendable {
-    public static let enabledEnvironmentKey =
-        "DARKBLOOM_QWEN35_PREFILL_ARTIFACT_ONLY"
-    public static let fullLayersEnvironmentKey =
-        "DARKBLOOM_QWEN35_PREFILL_FULL_LAYERS"
-    public static let defaultFullLayerSelection = "0-3,36-39"
-
-    public static let disabled = Qwen35CBv2PrefillLayerPolicy()
-
-    public let layerCount: Int
-    public let fullLayers: Set<Int>
-    public let isEnabled: Bool
-
-    private init(
-        layerCount: Int = 0,
-        fullLayers: Set<Int> = [],
-        isEnabled: Bool = false
-    ) {
-        self.layerCount = layerCount
-        self.fullLayers = fullLayers
-        self.isEnabled = isEnabled
-    }
-
-    /// Resolve the process-start experiment knobs.
-    ///
-    /// The explicit enable flag is required. A malformed flag or layer
-    /// selection, including an empty/out-of-range selection, fails closed to
-    /// the full checkpoint. When enabled without an override, the registered
-    /// 40-layer artifact-eight profile (`0-3,36-39`) is selected.
-    public static func fromEnvironment(
-        _ environment: [String: String] = ProcessInfo.processInfo.environment,
-        layerCount: Int
-    ) -> Qwen35CBv2PrefillLayerPolicy {
-        guard
-            layerCount > 0,
-            let rawEnabled = environment[enabledEnvironmentKey],
-            parseEnabled(rawEnabled)
-        else {
-            return .disabled
-        }
-
-        let rawLayers =
-            environment[fullLayersEnvironmentKey] ?? defaultFullLayerSelection
-        guard
-            let fullLayers = Qwen35LayerSelectionParser.parse(
-                rawLayers, layerCount: layerCount, allowsEmpty: false),
-            !fullLayers.isEmpty
-        else {
-            return .disabled
-        }
-
-        return Qwen35CBv2PrefillLayerPolicy(
-            layerCount: layerCount,
-            fullLayers: fullLayers,
-            isEnabled: true)
-    }
-
-    /// Resolve one model layer for an explicitly supplied engine phase.
-    ///
-    /// Unknown indices and every non-prefill phase fail closed to the full
-    /// checkpoint path.
-    public func mode(
-        layerIndex: Int,
-        phase: Qwen35CBv2ForwardPhase
-    ) -> Qwen35CBv2PrefillLayerMode {
-        guard
-            isEnabled,
-            phase == .prefill,
-            (0 ..< layerCount).contains(layerIndex)
-        else {
-            return .full
-        }
-        return fullLayers.contains(layerIndex) ? .full : .artifactOnly
-    }
-
-    public var skippedLayers: Set<Int> {
-        guard isEnabled else { return [] }
-        return Set(0 ..< layerCount).subtracting(fullLayers)
-    }
-
-    public var descriptor: String {
-        guard isEnabled else { return "disabled" }
-        let full = fullLayers.sorted().map(String.init).joined(separator: ",")
-        let artifact = skippedLayers.sorted().map(String.init).joined(separator: ",")
-        return "artifact_only=1;full=\(full);artifact=\(artifact)"
-    }
-
-    private static func parseEnabled(_ raw: String) -> Bool {
-        switch raw.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() {
-        case "1", "true", "yes", "on":
-            true
-        default:
-            false
-        }
-    }
-}
