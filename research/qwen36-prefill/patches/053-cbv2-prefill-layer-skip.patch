diff --git a/Tests/MLXLMTests/Qwen35CBv2PrefillLayerPolicyTests.swift b/Tests/MLXLMTests/Qwen35CBv2PrefillLayerPolicyTests.swift
new file mode 100644
index 0000000..e003982
--- /dev/null
+++ b/Tests/MLXLMTests/Qwen35CBv2PrefillLayerPolicyTests.swift
@@ -0,0 +1,113 @@
+import Testing
+
+@testable import MLXLLM
+
+struct Qwen35CBv2PrefillLayerPolicyTests {
+    private let allLayers = Set(0 ..< 40)
+
+    @Test func absentConfigurationExecutesEveryLayerInEveryPhase() {
+        let policy = Qwen35CBv2PrefillLayerPolicy.fromEnvironment(
+            [:], layerCount: 40)
+
+        #expect(policy == .disabled)
+        #expect(policy.descriptor == "disabled")
+        for phase in [
+            Qwen35CBv2ForwardPhase.prefill,
+            .decode,
+            .mtp,
+        ] {
+            #expect(executedLayers(policy, phase: phase) == allLayers)
+        }
+    }
+
+    @Test func strideAndExplicitListSelectOnlyTheirPrefillUnion() {
+        let policy = Qwen35CBv2PrefillLayerPolicy.fromEnvironment(
+            [
+                Qwen35CBv2PrefillLayerPolicy.keepStrideEnvironmentKey: "4",
+                Qwen35CBv2PrefillLayerPolicy.keepLayersEnvironmentKey:
+                    "3, 7-8, 39",
+            ],
+            layerCount: 40)
+
+        let expected = Set(stride(from: 0, to: 40, by: 4))
+            .union([3, 7, 8, 39])
+        #expect(policy.isEnabled)
+        #expect(policy.keepStride == 4)
+        #expect(policy.explicitKeepLayers == Set([3, 7, 8, 39]))
+        #expect(policy.keptLayers == expected)
+        #expect(executedLayers(policy, phase: .prefill) == expected)
+        #expect(policy.skippedLayers == allLayers.subtracting(expected))
+    }
+
+    @Test func enabledPolicyCannotSkipDecodeOrMTP() {
+        let policy = Qwen35CBv2PrefillLayerPolicy.fromEnvironment(
+            [Qwen35CBv2PrefillLayerPolicy.keepLayersEnvironmentKey: "0,39"],
+            layerCount: 40)
+
+        #expect(executedLayers(policy, phase: .prefill) == Set([0, 39]))
+        #expect(executedLayers(policy, phase: .decode) == allLayers)
+        #expect(executedLayers(policy, phase: .mtp) == allLayers)
+        #expect(policy.shouldExecute(layerIndex: -1, phase: .prefill))
+        #expect(policy.shouldExecute(layerIndex: 40, phase: .prefill))
+    }
+
+    @Test func strideOneIsAnExplicitAllLayerPrefillControl() {
+        let policy = Qwen35CBv2PrefillLayerPolicy.fromEnvironment(
+            [Qwen35CBv2PrefillLayerPolicy.keepStrideEnvironmentKey: "1"],
+            layerCount: 40)
+
+        #expect(policy.isEnabled)
+        #expect(executedLayers(policy, phase: .prefill) == allLayers)
+        #expect(policy.skippedLayers.isEmpty)
+    }
+
+    @Test func malformedConfigurationFailsClosedAsOnePolicy() {
+        let invalidEnvironments: [[String: String]] = [
+            [Qwen35CBv2PrefillLayerPolicy.keepStrideEnvironmentKey: ""],
+            [Qwen35CBv2PrefillLayerPolicy.keepStrideEnvironmentKey: "0"],
+            [Qwen35CBv2PrefillLayerPolicy.keepStrideEnvironmentKey: "41"],
+            [Qwen35CBv2PrefillLayerPolicy.keepStrideEnvironmentKey: "four"],
+            [Qwen35CBv2PrefillLayerPolicy.keepLayersEnvironmentKey: ""],
+            [Qwen35CBv2PrefillLayerPolicy.keepLayersEnvironmentKey: "3-"],
+            [Qwen35CBv2PrefillLayerPolicy.keepLayersEnvironmentKey: "5-3"],
+            [Qwen35CBv2PrefillLayerPolicy.keepLayersEnvironmentKey: "40"],
+            [Qwen35CBv2PrefillLayerPolicy.keepLayersEnvironmentKey: "1,"],
+            [
+                Qwen35CBv2PrefillLayerPolicy.keepStrideEnvironmentKey: "4",
+                Qwen35CBv2PrefillLayerPolicy.keepLayersEnvironmentKey: "bad",
+            ],
+        ]
+
+        for environment in invalidEnvironments {
+            let policy = Qwen35CBv2PrefillLayerPolicy.fromEnvironment(
+                environment, layerCount: 40)
+            #expect(policy == .disabled)
+            #expect(executedLayers(policy, phase: .prefill) == allLayers)
+        }
+
+        #expect(
+            Qwen35CBv2PrefillLayerPolicy.fromEnvironment(
+                [Qwen35CBv2PrefillLayerPolicy.keepStrideEnvironmentKey: "1"],
+                layerCount: 0) == .disabled)
+    }
+
+    @Test func descriptorIsStableAndReportsKeptAndSkippedLayers() {
+        let policy = Qwen35CBv2PrefillLayerPolicy.fromEnvironment(
+            [
+                Qwen35CBv2PrefillLayerPolicy.keepStrideEnvironmentKey: "3",
+                Qwen35CBv2PrefillLayerPolicy.keepLayersEnvironmentKey: "5",
+            ],
+            layerCount: 8)
+
+        #expect(
+            policy.descriptor
+                == "keep=0,3,5,6;skip=1,2,4,7;stride=3;list=5")
+    }
+
+    private func executedLayers(
+        _ policy: Qwen35CBv2PrefillLayerPolicy,
+        phase: Qwen35CBv2ForwardPhase
+    ) -> Set<Int> {
+        Set((0 ..< 40).filter { policy.shouldExecute(layerIndex: $0, phase: phase) })
+    }
+}
