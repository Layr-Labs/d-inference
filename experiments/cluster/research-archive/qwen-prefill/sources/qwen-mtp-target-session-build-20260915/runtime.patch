+                        } else if kind == "pending-snapshot" {
+                            _ = try victim.snapshot(check: value.resources.requireLive)
+                        } else if kind == "pending-decode" {
+                            _ = try victim.decode(seed, offset: 5, check: value.resources.requireLive)
+                        } else {
