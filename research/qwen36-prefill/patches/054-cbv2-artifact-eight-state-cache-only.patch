+    /// Commit a prompt rectangle without constructing an attention result.
+    ///
+    /// This is intentionally separate from `updateAndAttend`: artifact-only
+    /// model layers must not need a dummy query whose projection/attention
+    /// graph could accidentally become live. `innerState()` exposes both the
+    /// row storage and offset chain to the engine's step fence.
+    public func commitKVOnly(keys: MLXArray, values: MLXArray) {
+        precondition(
+            kind.sharesKVWithLayer == nil,
+            "CBv2LayerCache: KV-shared layer \(layerIndex) owns no storage to commit")
+        precondition(
+            keys.ndim == 4 && values.ndim == 4,
+            "CBv2LayerCache: cache-only K/V must be rank four")
+        precondition(
+            !rows.isEmpty
+                && keys.dim(0) == rows.count
+                && values.dim(0) == rows.count,
+            "CBv2LayerCache: cache-only K/V batch does not match bound rows")
+        precondition(
+            keys.dim(1) == kind.kvHeads
+                && values.dim(1) == kind.kvHeads
+                && keys.dim(2) > 0
+                && keys.dim(2) == values.dim(2)
+                && keys.dim(3) == kind.headDim
+                && values.dim(3) == kind.headDim,
+            "CBv2LayerCache: cache-only K/V geometry does not match the layer")
+
+        for (index, row) in rows.enumerated() {
+            _ = row.update(
+                keys: keys[index ..< index + 1],
+                values: values[index ..< index + 1])
+        }
+        cachedPositionOffsets = cachedPositionOffsets + Int32(keys.dim(2))
+    }
