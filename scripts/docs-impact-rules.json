        "coordinator/mediafetch/**",
        "coordinator/internal/mediafetch/**"
      ],
      "docs_any_of": [
        "docs/architecture/security/encryption.md"
      ]
    },
    {
      "name": "billing and accounting",
      "source_patterns": [
        "coordinator/api/billing/**",
