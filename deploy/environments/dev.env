# Development coordinator reference. Nothing reads this file. The live file is
# /etc/d-inference/env on the VM, seeded from deploy/gcp/dev/env-overrides
# (which also holds the dev host names) by deploy/gcp/dev/seed-env.sh.
# GCP project: darkbloom-dev, provisioned by Layr-Labs/darkbloom-devnet-infra.

ENVIRONMENT=dev
EIGENINFERENCE_DEPLOYMENT_ENVIRONMENT=development

# Trust & attestation. MicroMDM runs in the container with BoltDB state on the
# persistent disk. Dev has no Apple credentials yet, so the trust floor is
# self_signed.
MIN_TRUST=self_signed
MDM_ENABLED=true

# Billing uses Stripe plus the internal micro-USD ledger. The separately stored
# dev mnemonic is only the coordinator X25519 identity seed.
BILLING_MOCK=false

# Release distribution — separate R2 bucket, never mixed with prod artifacts
R2_BUCKET=d-inf-app-dev
APPLE_TEAM_ID=SLDQ2GJ6TL
APPLE_SIGNING_IDENTITY=Developer ID Application: Eigen Labs, Inc. (SLDQ2GJ6TL)

# GCP
GCP_PROJECT=darkbloom-dev
GCP_REGION=us-east4
GCP_ZONE=us-east4-a
ARTIFACT_REGISTRY_REPO=us-east4-docker.pkg.dev/darkbloom-dev/coordinator
# Coordinator: GCE VM (needs persistent disk for MicroMDM BoltDB state)
GCE_INSTANCE=d-inference-dev
GCE_MACHINE_TYPE=c3d-highcpu-4
GCE_BOOT_DISK_SIZE=20GB
GCE_DATA_DISK=d-inference-dev-data
GCE_DATA_DISK_SIZE=30GB
GCE_DATA_MOUNT=/mnt/disks/userdata
# Console UI runs on Vercel (separate dev project there).
CONSOLE_VERCEL_PROJECT=darkbloom-console-dev
CLOUD_SQL_INSTANCE=d-inference-dev-db

# Fleet
PROVIDER_VERSION_GATE=latest
