+@Test("the health check authenticates as the identity that was created")
+func healthCheckFollowsTheBootstrapIdentity() throws {
+    // Every built-in preset ships this: a health check naming lume/lume.
+    // Because it is non-nil, a `?? HealthCheck(...)` fallback never fires, and
+    // a per-sandbox guest was verified against an account it does not have.
+    let preset = HealthCheck(
+        type: "ssh",
+        user: "lume",
+        password: "lume",
+        timeout: 5,
+        retries: 60,
+        retryDelay: 5
+    )
+
+    let identity = try GuestIdentity(
+        bootstrap: GuestUser(
+            username: "db-abc123",
+            realName: "db-abc123",
+            password: "s3cret",
+            uid: "501",
+            gid: "20"
+        )
+    )
+    let resolved = UnattendedInstaller.resolveHealthCheck(
+        configured: preset,
+        identity: identity
+    )
+    #expect(resolved.user == "db-abc123")
+    #expect(resolved.password == "s3cret")
+    // The preset's own timings survive; only the credentials are overridden.
+    #expect(resolved.type == "ssh")
+    #expect(resolved.retries == 60)
+    #expect(resolved.retryDelay == 5)
+}
+
+@Test("a default identity leaves the configured health check untouched")
+func healthCheckIsUnchangedForTheDefaultIdentity() throws {
+    let preset = HealthCheck(
+        type: "ssh", user: "someone", password: "else",
+        timeout: 9, retries: 3, retryDelay: 1
+    )
+    let resolved = UnattendedInstaller.resolveHealthCheck(
+        configured: preset,
+        identity: try GuestIdentity()
+    )
+    // An ordinary `lume create` must behave exactly as before, including
+    // honouring a hand-written health_check block.
+    #expect(resolved.user == "someone")
+    #expect(resolved.password == "else")
+    #expect(resolved.timeout == 9)
+}
