+@Test("finalization takes ownership the offline patcher cannot set")
+func finalizationChownsTheAgent() throws {
+    let (root, binary) = try makeExecutable()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    let install = try makeInstall(executable: binary)
+    let script = UnattendedInstaller.guestAgentFinalizationCommands(install)
+
+    // launchd refuses a daemon plist that is not root:wheel, and nothing in
+    // the patcher can set an owner.
+    #expect(script.contains("chown root:wheel /usr/local/libexec/darkbloom-guest-agent"))
+    #expect(script.contains("chown root:wheel /Library/LaunchDaemons/\(install.label).plist"))
+    #expect(script.contains("chmod 755 /usr/local/libexec/darkbloom-guest-agent"))
+    // The log directory goes to the tenant, not root: see the EX_CONFIG note.
+    #expect(script.contains("chown sandbox \(install.logDirectory)"))
+    #expect(script.contains("launchctl enable system/\(install.label)"))
+}
