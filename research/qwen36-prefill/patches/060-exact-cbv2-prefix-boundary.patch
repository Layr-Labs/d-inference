+import Foundation
+import MLX
+import XCTest
+
+@testable import MLXLMCommon
+
+/// Tiny fixed-function hybrid model: one full-attention row plus one
+/// request-owned recurrent layer. Its greedy continuation depends on both
+/// states, so restoring only K/V or only recurrence does not pass parity.
+private final class CBv2ExactHybridFixtureModel: CBv2RecurrentSteppableModel {
+    let recurrentStateSpec: CBv2RecurrentStateSpec? = CBv2RecurrentStateSpec(layers: [
+        CBv2RecurrentLayerStateSpec(
+            modelLayerIndex: 0,
+            convShape: [1, 1, 1], convDType: .float32,
+            ssmShape: [1, 1, 1, 1], ssmDType: .float32)
+    ])
+    let cbv2Capabilities: CBv2ModelCapabilities = {
+        var capabilities = CBv2ModelCapabilities.initialRecurrentTarget
+        capabilities.supportsExactStatePrefixReuse = true
+        return capabilities
+    }()
+
+    private let counterLock = NSLock()
+    private var _prefillRows = 0
+
+    var prefillRows: Int {
+        counterLock.lock()
+        defer { counterLock.unlock() }
+        return _prefillRows
+    }
+
+    func forward(tokens: MLXArray, caches: [CBv2AttendingLayerCache]) -> MLXArray {
+        preconditionFailure("fixture requires request-owned recurrent state")
+    }
+
+    func forward(
+        tokens: MLXArray,
+        caches: [CBv2AttendingLayerCache],
+        recurrentState: [CBv2RecurrentStateEvaluation]
+    ) -> MLXArray {
+        let batch = tokens.dim(0)
+        let length = tokens.dim(1)
+        precondition(caches.count == 1)
+        precondition(recurrentState.count == batch)
+        if length > 1 {
+            counterLock.lock()
+            _prefillRows += batch
+            counterLock.unlock()
+        }
+
+        let tokenValues = tokens.asType(.float32)
+        let queries = (tokenValues + 1).reshaped([batch, 1, length, 1])
+        let keys = (tokenValues * 0.125 + 0.25).reshaped([batch, 1, length, 1])
+        let values = (tokenValues * 0.25 - 0.5).reshaped([batch, 1, length, 1])
+        let attended = caches[0].updateAndAttend(
+            queries: queries,
+            keys: keys,
+            values: values,
+            scale: 1,
+            sinks: nil)
+
+        var rowStates: [MLXArray] = []
+        rowStates.reserveCapacity(batch)
+        for row in 0 ..< batch {
+            let evaluation = recurrentState[row]
+            let previous = evaluation.inputState(modelLayerIndex: 0)
+            let previousConv = previous?.conv ?? MLXArray.zeros([1, 1, 1])
+            let previousSSM = previous?.ssm ?? MLXArray.zeros([1, 1, 1, 1])
+            let finalToken = tokenValues[row, length - 1].reshaped([1, 1, 1])
+            let tokenSum = tokenValues[row].sum().reshaped([1, 1, 1, 1])
+            let conv = tanh(previousConv * 0.5 + finalToken * 0.125)
+            let ssm = tanh(
+                previousSSM * 0.75
+                    + tokenSum * 0.0625
+                    + conv.reshaped([1, 1, 1, 1]) * 0.25)
+            try! evaluation.stage(modelLayerIndex: 0, conv: conv, ssm: ssm)
+            rowStates.append(ssm.reshaped([1]))
+        }
+
+        let recurrentSignal = broadcast(
+            concatenated(rowStates, axis: 0).reshaped([batch, 1, 1]),
+            to: [batch, length, 1])
+        let attentionSignal = attended.transposed(0, 2, 1, 3)
+            .reshaped([batch, length, 1])
+        let tokenSignal = tokenValues.reshaped([batch, length, 1])
+        let score = sin(
+            tokenSignal * 0.71
+                + recurrentSignal * 1.31
+                + attentionSignal * 0.17)
+        return concatenated([score, -score], axis: -1)
+    }
+}
+
+final class CBv2ExactPrefixEngineTests: XCTestCase {
+    private struct Stack {
+        let engine: EngineV2
+        let model: CBv2ExactHybridFixtureModel
+        let cache: ExactPrefixCacheV2
+    }
+
+    private let kind = CBv2LayerKind(
+        attention: .full, headDim: 1, kvHeads: 1, queryHeads: 1)
+    private let prompt = [7, 2, 5, 1, 6, 3, 4, 0, 7]
+    private let completionTokens = 8
+
+    private func makeStack() -> Stack {
+        let model = CBv2ExactHybridFixtureModel()
+        let cache = ExactPrefixCacheV2(
+            config: .init(
+                modelIdentity: "tiny-hybrid|fixed-weights|tokenizer-v1",
+                policyIdentity: "contiguous-fp32|exact-full-prompt-v1",
+                maxBytes: 1 << 20))
+        let backend = CBv2ContiguousKVBackend(
+            config: .init(bytesCapacity: 1 << 24, kvDType: .float32))
+        let engine = EngineV2(
+            model: model,
+            layerKinds: [kind],
+            backend: backend,
+            cacheProvider: CBv2LayerCacheBank(layerKinds: [kind]),
+            sampler: CBv2GreedySampler(),
+            schedulerConfig: CBv2SchedulerConfig(
+                maxConcurrentRequests: 8,
+                maxBatchedTokensPerStep: 256,
+                prefillChunkSize: 64,
+                maxWaiting: 16,
+                enablePrefixCache: true),
+            admissionConfig: .init(watermarkFraction: 0, elementBytes: 4),
+            prefixCache: cache)
+        return Stack(engine: engine, model: model, cache: cache)
+    }
+
+    private func request(id: UInt64, maxTokens: Int? = nil) -> CBv2Request {
+        CBv2Request(
+            id: CBv2RequestID(id),
+            promptTokens: prompt,
+            sampling: CBv2SamplingParams(temperature: 0),
+            maxTokens: maxTokens ?? completionTokens,
+            cacheSalt: "tenant-a")
+    }
+
+    func testB1RepeatUsesCachedFrontierAndExactHybridState() async throws {
+        let stack = makeStack()
+        let cold = await cbv2SchedCollect(
+            try stack.engine.submit(request(id: 1)))
+        let repeated = await cbv2SchedCollect(
+            try stack.engine.submit(request(id: 2)))
+        await stack.engine.shutdown()
+
+        XCTAssertEqual(cold.finishReason, .length)
+        XCTAssertEqual(repeated.finishReason, .length)
+        XCTAssertEqual(repeated.tokens, cold.tokens)
+        XCTAssertEqual(cold.usage?.prefixCacheOutcome, .miss)
+        XCTAssertEqual(repeated.usage?.prefixCacheOutcome, .hit)
+        XCTAssertEqual(repeated.usage?.prefixCacheMatchedTokens, prompt.count)
+        XCTAssertEqual(repeated.usage?.prefixCachePrefillTokensSaved, prompt.count)
+        XCTAssertEqual(repeated.usage?.prefixCacheReplayTokens, 0)
+        XCTAssertEqual(repeated.usage?.prefixCacheStrategy, .direct)
+        XCTAssertEqual(stack.model.prefillRows, 1, "repeat must not execute another prefill row")
+
+        let stats = stack.cache.stats()
+        XCTAssertEqual(stats.donations, 1)
+        XCTAssertEqual(stats.hits, 1)
+        XCTAssertEqual(stats.tokensSaved, prompt.count)
+    }
+
+    func testWarmB2AndB4ShareOnePrefillWithIndependentDecodeRows() async throws {
+        for width in [2, 4] {
+            let stack = makeStack()
+            let donor = await cbv2SchedCollect(
+                try stack.engine.submit(request(id: UInt64(100 * width))))
+            XCTAssertEqual(donor.finishReason, .length)
+
+            var streams: [AsyncStream<CBv2Event>] = []
+            for row in 0 ..< width {
+                streams.append(
+                    try stack.engine.submit(
+                        request(id: UInt64(100 * width + row + 1))))
+            }
+            var results: [CBv2SchedCollected] = []
+            for stream in streams {
+                results.append(await cbv2SchedCollect(stream))
+            }
+            await stack.engine.shutdown()
+
+            for (row, result) in results.enumerated() {
+                XCTAssertEqual(result.finishReason, .length, "B\(width) row \(row)")
+                XCTAssertEqual(
+                    result.tokens, donor.tokens,
+                    "B\(width) row \(row) diverged from its cold donor")
+                XCTAssertEqual(result.usage?.prefixCacheOutcome, .hit)
+                XCTAssertEqual(result.usage?.prefixCachePrefillTokensSaved, prompt.count)
+            }
+            XCTAssertEqual(
+                stack.model.prefillRows, 1,
+                "B\(width) warm cohort must reuse the donor's single prefill")
+            XCTAssertEqual(stack.cache.stats().hits, width)
+            XCTAssertEqual(stack.cache.stats().donations, 1)
+            XCTAssertTrue(stack.engine.loopForTesting.recurrentStates.isEmpty)
+        }
+    }
+
+    func testCancellingOneAdopterCannotPoisonTheCachedBoundary() async throws {
+        let stack = makeStack()
+        let donor = await cbv2SchedCollect(
+            try stack.engine.submit(request(id: 1)))
+
+        let victimID = CBv2RequestID(2)
+        let victim = try stack.engine.submit(request(id: 2, maxTokens: 100))
+        var victimReason: CBv2FinishReason?
+        var cancelled = false
+        for await event in victim {
+            switch event {
+            case .delta:
+                if !cancelled {
+                    cancelled = true
+                    stack.engine.cancel(victimID)
+                }
+            case .finished(let reason, _):
+                victimReason = reason
+            }
+        }
+        XCTAssertTrue(cancelled)
+        XCTAssertEqual(victimReason, .cancelled)
+
+        let survivor = await cbv2SchedCollect(
+            try stack.engine.submit(request(id: 3)))
+        await stack.engine.shutdown()
+
+        XCTAssertEqual(survivor.finishReason, .length)
+        XCTAssertEqual(survivor.tokens, donor.tokens)
+        XCTAssertEqual(survivor.usage?.prefixCacheOutcome, .hit)
+        XCTAssertEqual(stack.model.prefillRows, 1)
+        XCTAssertEqual(stack.cache.stats().hits, 2)
+        XCTAssertEqual(stack.cache.stats().entryCount, 1)
+    }
+}
