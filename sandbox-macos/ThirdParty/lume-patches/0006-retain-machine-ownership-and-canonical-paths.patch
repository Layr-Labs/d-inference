@@ -0,0 +1,101 @@
+import Darwin
+import Foundation
+import Testing
+@testable import lume
+
+@Suite("Darkbloom inherited machine runtime authority")
+struct DarkbloomRuntimeAuthorityTests {
+    @Test func validLeaseIsCloseOnExecAndRetainsExclusiveOwnership() throws {
+        let fixture = try Fixture()
+        defer { fixture.remove() }
+        let descriptor = try fixture.openLock()
+        let lease = try DarkbloomRuntimeLease(adopting: descriptor, authorityDirectory: fixture.directory.path,
+                                             testOwner: geteuid(), testGroup: getegid())
+        #expect(fcntl(descriptor, F_GETFD) & FD_CLOEXEC != 0)
+        let competitor = try fixture.openLock()
+        defer { close(competitor) }
+        #expect(flock(competitor, LOCK_SH | LOCK_NB) != 0)
+        try lease.validate()
+        withExtendedLifetime(lease) {}
+    }
+
+    @Test func closingChildCopyDoesNotUnlockBrokerCopy() throws {
+        let fixture = try Fixture()
+        defer { fixture.remove() }
+        let broker = try fixture.openLock()
+        defer { close(broker) }
+        #expect(flock(broker, LOCK_EX | LOCK_NB) == 0)
+        let child = fcntl(broker, F_DUPFD_CLOEXEC, 64)
+        #expect(child >= 0)
+        var lease: DarkbloomRuntimeLease? = try DarkbloomRuntimeLease(
+            adopting: child, authorityDirectory: fixture.directory.path,
+            testOwner: geteuid(), testGroup: getegid())
+        try lease?.validate()
+        lease = nil
+        let competitor = try fixture.openLock()
+        defer { close(competitor) }
+        #expect(flock(competitor, LOCK_SH | LOCK_NB) != 0)
+    }
+
+    @Test func sharedInferencePreventsIsolatedVMOwnership() throws {
+        let fixture = try Fixture()
+        defer { fixture.remove() }
+        let inference = try fixture.openLock()
+        defer { close(inference) }
+        #expect(flock(inference, LOCK_SH | LOCK_NB) == 0)
+        #expect(throws: (any Error).self) {
+            try DarkbloomRuntimeLease(adopting: fixture.openLock(), authorityDirectory: fixture.directory.path,
+                                      testOwner: geteuid(), testGroup: getegid())
+        }
+    }
+
+    @Test func mismatchedInodeAndUnsafePermissionsAreRejected() throws {
+        let fixture = try Fixture()
+        defer { fixture.remove() }
+        let old = try fixture.openLock()
+        try FileManager.default.moveItem(at: fixture.lock, to: fixture.directory.appendingPathComponent("old.lock"))
+        try fixture.createLock()
+        #expect(throws: (any Error).self) {
+            try DarkbloomRuntimeLease(adopting: old, authorityDirectory: fixture.directory.path,
+                                      testOwner: geteuid(), testGroup: getegid())
+        }
+        #expect(chmod(fixture.lock.path, 0o666) == 0)
+        #expect(throws: (any Error).self) {
+            try DarkbloomRuntimeLease(adopting: fixture.openLock(), authorityDirectory: fixture.directory.path,
+                                      testOwner: geteuid(), testGroup: getegid())
+        }
+    }
+
+    @Test func validatesNamespaceAgainBeforeUse() throws {
+        let fixture = try Fixture()
+        defer { fixture.remove() }
+        let lease = try DarkbloomRuntimeLease(adopting: fixture.openLock(), authorityDirectory: fixture.directory.path,
+                                             testOwner: geteuid(), testGroup: getegid())
+        try FileManager.default.moveItem(at: fixture.lock, to: fixture.directory.appendingPathComponent("old.lock"))
+        try fixture.createLock()
+        #expect(throws: (any Error).self) { try lease.validate() }
+    }
+
+    private struct Fixture {
+        let directory: URL
+        var lock: URL { directory.appendingPathComponent("ownership.lock") }
+        init() throws {
+            directory = FileManager.default.temporaryDirectory.appendingPathComponent("lume-runtime-\(UUID().uuidString)")
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false,
+                                                     attributes: [.posixPermissions: 0o700])
+            try createLock()
+        }
+        func createLock() throws {
+            let descriptor = open(lock.path, O_CREAT | O_EXCL | O_RDWR | O_CLOEXEC, 0o660)
+            guard descriptor >= 0 else { throw POSIXError(.EIO) }
+            defer { close(descriptor) }
+            guard fchmod(descriptor, 0o660) == 0, fchown(descriptor, geteuid(), getegid()) == 0 else { throw POSIXError(.EIO) }
+        }
+        func openLock() throws -> Int32 {
+            let descriptor = open(lock.path, O_RDWR | O_CLOEXEC | O_NOFOLLOW)
+            guard descriptor >= 0 else { throw POSIXError(.EIO) }
+            return descriptor
+        }
+        func remove() { try? FileManager.default.removeItem(at: directory) }
+    }
+}
