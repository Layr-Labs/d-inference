+        publishEvidence: (Data, () throws -> Void) throws -> Void
+    ) throws -> QwenResidentGenerationCompletion {
+        guard protectedBudget != nil else { throw ProbeError("Private protected export requires the native protected owner") }
+        return try execute(requestID: requestID, mode: .recording, onCommittedToken: onCommittedToken) { completion, evidence in
+            guard self.protectedBudget != nil, let evidence, let reserved = self.reservation,
+                  reserved.request.requestID == requestID, let charge = reserved.recordingCharge,
