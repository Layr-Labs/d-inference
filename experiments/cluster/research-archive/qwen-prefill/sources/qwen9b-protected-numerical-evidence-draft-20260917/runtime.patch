+            let total = try QwenLongPrefillCheckedBytes.sum([charge.reservedBytes, self.protectedReservedBytes])
+            func check() throws {
+                try self.control.check(deadline: reserved.deadline)
+                try self.requireProtectedLive(reserved.allowance, prefill: nil, capture: charge)
+                try self.control.check(deadline: reserved.deadline)
+            }
+            try QwenProtectedEvidenceExport.publish(evidence, request: reserved.request,
+                totalReservedBytes: total, to: publishEvidence, check: check)
