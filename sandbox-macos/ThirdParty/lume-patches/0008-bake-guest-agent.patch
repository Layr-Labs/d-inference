+@Test("the daemon log is somewhere the tenant can actually write")
+func daemonLogIsNotUnderVarLog() throws {
+    let (root, binary) = try makeExecutable()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    let install = try makeInstall(executable: binary)
+    let plist = install.daemonPlist()
+
+    // launchd opens the job's stdout as the job's user before the program
+    // runs. With the log under /var/log a daemon running as an unprivileged
+    // tenant dies EX_CONFIG (78) and respawns forever while writing no log at
+    // all -- the diagnostic that would explain it is the thing that cannot be
+    // created. Measured on a real guest at 45 respawns and climbing.
+    let out = plist["StandardOutPath"] as? String
+    #expect(out == install.logPath)
+    #expect(out?.hasPrefix("/var/log") == false)
+    #expect(plist["StandardErrorPath"] as? String == out)
+}
