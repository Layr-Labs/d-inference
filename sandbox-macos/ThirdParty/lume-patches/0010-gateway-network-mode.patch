diff --git a/libs/lume/src/VM/NetworkGatewayCapability.swift b/libs/lume/src/VM/NetworkGatewayCapability.swift
new file mode 100644
index 0000000..b4f3bf6
--- /dev/null
+++ b/libs/lume/src/VM/NetworkGatewayCapability.swift
@@ -0,0 +1,86 @@
+import Darwin
+import Foundation
+import Virtualization
+
+/// A pre-spawn datagram descriptor carrying the guest's Ethernet frames.
+///
+/// `VZFileHandleNetworkDeviceAttachment` exchanges data "at the level of the
+/// data link layer" over a handle that "must hold a connected datagram socket"
+/// — so the peer is a userspace gateway, not a kernel NAT, and every frame the
+/// guest emits is delivered to whoever holds the other end.
+///
+/// The descriptor is inherited rather than opened here for the same reason the
+/// guest channel is: only the spawning process can create the pair and keep the
+/// peer, and passing a number through the environment is the one mechanism that
+/// survives `POSIX_SPAWN_CLOEXEC_DEFAULT`.
+enum NetworkGatewayCapability {
+    static let environmentVariable = "DARKBLOOM_LUME_NETWORK_FD"
+
+    /// Apple's header: `SO_RCVBUF` is "expected to be at least double the value
+    /// of `SO_SNDBUF`, and for optimal performance ... four times". Both must
+    /// be set explicitly; the defaults are far too small for 1500-byte frames
+    /// at link rate and silently drop them.
+    static let sendBufferBytes: Int32 = 1 * 1024 * 1024
+    static let receiveBufferBytes: Int32 = 4 * sendBufferBytes
+
+    /// The inherited descriptor, or nil when no gateway was attached.
+    static func inheritedDescriptor() throws -> Int32? {
+        let environment = ProcessInfo.processInfo.environment
+        guard let value = environment[environmentVariable] else {
+            return nil
+        }
+        unsetenv(environmentVariable)
+        guard let descriptor = Int32(value),
+              descriptor > STDERR_FILENO,
+              fcntl(descriptor, F_GETFD) >= 0
+        else {
+            throw VMError.internalError("Invalid network gateway capability")
+        }
+
+        // A stream socket here would be accepted by the initialiser and then
+        // fail as corrupt frames, because a stream has no datagram boundaries
+        // and the attachment treats each datagram as exactly one frame.
+        var socketType: Int32 = 0
+        var length = socklen_t(MemoryLayout<Int32>.size)
+        guard getsockopt(
+            descriptor, SOL_SOCKET, SO_TYPE, &socketType, &length
+        ) == 0, socketType == SOCK_DGRAM else {
+            throw VMError.internalError(
+                "Network gateway capability is not a datagram socket"
+            )
+        }
+        return descriptor
+    }
+
+    /// Builds the attachment, sizing the socket buffers first.
+    static func attachment(
+        forDescriptor descriptor: Int32
+    ) throws -> VZFileHandleNetworkDeviceAttachment {
+        try setBuffer(SO_SNDBUF, sendBufferBytes, on: descriptor)
+        try setBuffer(SO_RCVBUF, receiveBufferBytes, on: descriptor)
+        // Owns the descriptor from here: the handle closes it on deinit, and
+        // the VM configuration holds the attachment for the life of the run.
+        return VZFileHandleNetworkDeviceAttachment(
+            fileHandle: FileHandle(fileDescriptor: descriptor, closeOnDealloc: true)
+        )
+    }
+
+    private static func setBuffer(
+        _ option: Int32,
+        _ bytes: Int32,
+        on descriptor: Int32
+    ) throws {
+        var value = bytes
+        guard setsockopt(
+            descriptor,
+            SOL_SOCKET,
+            option,
+            &value,
+            socklen_t(MemoryLayout<Int32>.size)
+        ) == 0 else {
+            throw VMError.internalError(
+                "Could not size the network gateway socket buffers"
+            )
+        }
+    }
+}
