diff --git a/Tests/MLXLMTests/CBv2ExactPrefixCacheTests.swift b/Tests/MLXLMTests/CBv2ExactPrefixCacheTests.swift
index 7c9e838..f10cdb8 100644
--- a/Tests/MLXLMTests/CBv2ExactPrefixCacheTests.swift
+++ b/Tests/MLXLMTests/CBv2ExactPrefixCacheTests.swift
@@ -330,4 +330,39 @@ final class CBv2ExactPrefixCacheTests: XCTestCase {
         XCTAssertEqual(cache.stats().donations, 4)
         XCTAssertLessThanOrEqual(cache.bytesInUse, cache.config.maxBytes)
     }
+
+    func testPendingDonationReservationsShareTheHardCeiling() throws {
+        let snapshot = try snapshot(tokenCount: 4, value: 4)
+        let budget = snapshot.byteCount * 2
+        let cache = ExactPrefixCacheV2(config: .init(
+            modelIdentity: "pending-donation-budget",
+            blockSize: 4,
+            maxBytes: budget))
+        cache.donateExact(
+            requestID: CBv2RequestID(90),
+            tokens: [1, 2, 3, 4],
+            snapshot: snapshot,
+            layerKinds: [layerKind],
+            cacheSalt: "tenant-a")
+        XCTAssertEqual(cache.bytesInUse, snapshot.byteCount)
+
+        XCTAssertTrue(cache.reserveExactDonation(
+            requestID: CBv2RequestID(91), byteCount: snapshot.byteCount))
+        XCTAssertTrue(cache.reserveExactDonation(
+            requestID: CBv2RequestID(92), byteCount: snapshot.byteCount))
+        XCTAssertEqual(cache.bytesInUse, budget)
+        XCTAssertFalse(cache.reserveExactDonation(
+            requestID: CBv2RequestID(93), byteCount: snapshot.byteCount))
+
+        cache.cancelExactDonationReservation(requestID: CBv2RequestID(91))
+        XCTAssertEqual(cache.bytesInUse, snapshot.byteCount)
+        cache.donateExact(
+            requestID: CBv2RequestID(92),
+            tokens: [5, 6, 7, 8],
+            snapshot: snapshot,
+            layerKinds: [layerKind],
+            cacheSalt: "tenant-a")
+        XCTAssertEqual(cache.bytesInUse, snapshot.byteCount)
+        XCTAssertLessThanOrEqual(cache.bytesInUse, cache.config.maxBytes)
+    }
 }
