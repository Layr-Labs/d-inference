[Unit]
Description=Darkbloom coordinator serving owner
After=docker.service network-online.target cloud-sql-proxy.service datadog-agent.service
Requires=docker.service
Wants=network-online.target datadog-agent.service

[Service]
Type=simple
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=5
TimeoutStartSec=10min
TimeoutStopSec=60
SyslogIdentifier=d-inference-coordinator
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/bin/d-inference-run.sh
ExecStop=-/usr/bin/docker stop -t 45 d-inference-coordinator

[Install]
WantedBy=multi-user.target
