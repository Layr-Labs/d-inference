+@MainActor
+@Test("guest finalization names the bootstrap account, not a fixed one")
+func guestFinalizationUsesTheBootstrapAccount() throws {
+    // Finalization rewrites loginwindow for a specific account. With the name
+    // baked in, a renamed bootstrap account left the guest autologging into a
+    // user that does not exist.
+    let identity = try GuestIdentity(
+        bootstrap: GuestUser(
+            username: "sandbox-admin",
+            realName: "sandbox admin",
+            password: "s3cret",
+            uid: "501",
+            gid: "20"
+        )
+    )
+    let script = UnattendedInstaller.guestFinalizationScript(for: identity.bootstrap)
+
+    #expect(script.contains("autoLoginUser -string sandbox-admin"))
+    #expect(script.contains("lastUserName -string sandbox-admin"))
+    #expect(!script.contains("-string lume"))
+}
