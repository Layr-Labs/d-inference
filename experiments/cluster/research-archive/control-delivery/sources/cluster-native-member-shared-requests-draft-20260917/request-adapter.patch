+    }
+    func localCommand(lifetime: UInt64, now: UInt64) throws -> (ClusterWorkerCommandFrame, UInt64) {
+        guard kind == .command, lifetime > deliverySlack, lifetime-deliverySlack > now else { throw NativePairMemberError.deadline }
