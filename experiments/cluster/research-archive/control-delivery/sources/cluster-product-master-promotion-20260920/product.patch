+    /// The live recheck and native enqueue share the same lock as invalidate.
+    /// Parsing outside this lock cannot preserve permission across cancellation.
+    static func deliverWhileLive(_ condition: NSCondition, invalid: () -> Bool,
+                                 _ send: () throws -> Void) throws {
+        condition.lock(); defer { condition.unlock() }
+        guard !invalid() else { throw NativePairMemberError.inactive }
+        try send()
+    }
