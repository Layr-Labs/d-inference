+import Darwin
+import Foundation
+import Testing
+
+@testable import lume
+
+private enum LockChildMode: Equatable {
+    case owner
+    case opener
+}
+
+private enum LockChildError: Error {
+    case systemCall(String, Int32)
+    case setupFailed
+}
+
+private enum GatedRunError: Error {
+    case released
+}
+
+@MainActor
+private final class RunEntryGate {
+    private var entered = false
+    private var entryWaiters:
+        [CheckedContinuation<Void, Never>] = []
+    private var releaseWaiter:
+        CheckedContinuation<Void, Never>?
+
+    func enterAndWait() async {
+        entered = true
+        let waiters = entryWaiters
+        entryWaiters.removeAll()
+        for waiter in waiters {
+            waiter.resume()
+        }
+        await withCheckedContinuation {
+            releaseWaiter = $0
+        }
+    }
+
+    func waitForEntry() async {
+        guard !entered else { return }
+        await withCheckedContinuation {
+            entryWaiters.append($0)
+        }
+    }
+
+    func release() {
+        releaseWaiter?.resume()
+        releaseWaiter = nil
+    }
+}
+
+@MainActor
+private final class GatedRunVM: MockVM {
+    let gate: RunEntryGate
+    private(set) var cacheWasPresentAtEntry: Bool?
+
+    init(
+        vmDirContext: VMDirContext,
+        gate: RunEntryGate
+    ) {
+        self.gate = gate
+        super.init(
+            vmDirContext: vmDirContext,
+            virtualizationServiceFactory: {
+                _ in MockVMVirtualizationService()
+            },
+            vncServiceFactory: {
+                MockVNCService(vmDirectory: $0)
+            })
+    }
+
+    override func run(
+        displayMode: DisplayMode = .vnc,
+        sharedDirectories: [SharedDirectory],
+        mount: Path?,
+        vncPort: Int = 0,
+        vncPassword: String? = nil,
+        recoveryMode: Bool = false,
+        usbMassStoragePaths: [Path]? = nil,
+        additionalDiskPaths: [Path]? = nil,
+        networkMode: NetworkMode? = nil,
+        clipboard: Bool = false,
+        vncPolicy: VNCPolicy = .enabled
+    ) async throws {
+        cacheWasPresentAtEntry =
+            SharedVM.shared.getVM(for: vmDirContext.dir)
+            != nil
+        await gate.enterAndWait()
+        throw GatedRunError.released
+    }
+}
+
+@MainActor
+private final class GatedRunVMFactory: VMFactory {
+    let gate = RunEntryGate()
+    private(set) var vm: GatedRunVM?
+
+    func createVM(
+        vmDirContext: VMDirContext,
+        imageLoader: ImageLoader?
+    ) throws -> VM {
+        let vm = GatedRunVM(
+            vmDirContext: vmDirContext,
+            gate: gate)
+        self.vm = vm
+        return vm
+    }
+}
+
+private final class LockTestChild {
+    let processIdentifier: pid_t
+    private var releaseDescriptor: Int32
+    private var reaped = false
+
+    init(processIdentifier: pid_t, releaseDescriptor: Int32) {
+        self.processIdentifier = processIdentifier
+        self.releaseDescriptor = releaseDescriptor
+    }
+
+    func isAlive() -> Bool {
+        guard !reaped else { return false }
+        var status: Int32 = 0
+        let result = waitpid(processIdentifier, &status, WNOHANG)
+        if result == processIdentifier || (result == -1 && errno == ECHILD) {
+            reaped = true
+            return false
+        }
+        return result == 0
+    }
+
+    func terminate() {
+        if releaseDescriptor >= 0 {
+            Darwin.close(releaseDescriptor)
+            releaseDescriptor = -1
+        }
+        guard !reaped else { return }
+
+        var status: Int32 = 0
+        while waitpid(processIdentifier, &status, 0) == -1 {
+            guard errno == EINTR else {
+                break
+            }
+        }
+        reaped = true
+    }
+}
+
+@MainActor
+@Test("the controller does not cache a VM before VM.run enters")
+func controllerCacheBeginsInsideRunLifecycle() async throws {
+    let fixture = try makeLivenessFixture(
+        named: "cache-entry")
+    defer {
+        try? FileManager.default.removeItem(
+            at: fixture.storage)
+    }
+    let factory = GatedRunVMFactory()
+    let controller = LumeController(vmFactory: factory)
+
+    let runTask = Task {
+        try await controller.runVM(
+            name: fixture.directory.name,
+            noDisplay: true,
+            storage: fixture.storage.path,
+            vncPolicy: .disabled)
