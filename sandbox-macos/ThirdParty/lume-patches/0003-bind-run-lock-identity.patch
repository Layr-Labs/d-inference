+@MainActor
+@Test("the controller does not cache a VM before VM.run enters")
+func controllerCacheBeginsInsideRunLifecycle() async throws {
+    let fixture = try makeLivenessFixture(
+        named: "cache-entry")
+    defer {
+        try? FileManager.default.removeItem(
+            at: fixture.storage)
+    }
+    let factory = GatedRunVMFactory()
+    let controller = LumeController(vmFactory: factory)
+
+    let runTask = Task {
+        try await controller.runVM(
+            name: fixture.directory.name,
+            noDisplay: true,
+            storage: fixture.storage.path,
+            vncPolicy: .disabled)
+    }
+    await factory.gate.waitForEntry()
+    let gatedVM = try #require(factory.vm)
+
+    #expect(gatedVM.cacheWasPresentAtEntry == false)
+    #expect(
+        SharedVM.shared.getVM(
+            for: fixture.directory) == nil)
+
+    factory.gate.release()
+    await #expect(throws: GatedRunError.self) {
+        try await runTask.value
+    }
+    #expect(
+        SharedVM.shared.getVM(
+            for: fixture.directory) == nil)
+}
