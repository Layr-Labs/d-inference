{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkbloom.dev/schemas/qwen-quality-report-v1.json",
  "title": "Darkbloom Qwen quality corpus report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmark",
    "tokenChecksumAlgorithm",
    "run",
    "model",
    "corpus",
    "hardware",
    "engine",
    "generation",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "benchmark": {
      "const": "qwen-quality-corpus"
    },
    "tokenChecksumAlgorithm": {
      "const": "fnv1a64-le-i64-v1"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "createdAtUTC"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "createdAtUTC": {"type": "string", "format": "date-time"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "artifactSHA256", "modelType"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "artifactSHA256": {"$ref": "#/$defs/sha256"},
        "modelType": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "maximumContextTokens": {"type": "integer", "minimum": 1}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "caseCount",
        "license",
        "provenance"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "caseCount": {"type": "integer", "minimum": 1, "maximum": 512},
        "license": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machineModel", "chipName", "memoryGB", "gpuCores"],
      "properties": {
        "machineModel": {"type": "string"},
        "chipName": {"type": "string"},
        "memoryGB": {"type": "integer", "minimum": 0},
        "gpuCores": {"type": "integer", "minimum": 0}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factory",
        "kvBackendSelection",
        "resolvedKVBackend",
        "maxConcurrentRequests",
        "requestsExecutedSequentially",
        "prefixCacheEnabled",
        "warmupPerformed",
        "policyEnvironment"
      ],
      "properties": {
        "factory": {
          "const": "EngineV2Factory.makeProductionBuild", "$comment": "pragma: allowlist secret"
        },
        "kvBackendSelection": {"enum": ["auto", "contiguous", "paged"]},
        "resolvedKVBackend": {"type": "string", "minLength": 1},
        "maxConcurrentRequests": {"const": 1},
        "requestsExecutedSequentially": {"const": true},
        "prefixCacheEnabled": {"const": false},
        "warmupPerformed": {"type": "boolean"},
        "policyEnvironment": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "topP",
        "topK",
        "maximumTokens",
        "minimumRequiredTokens",
        "stopPolicy"
      ],
      "properties": {
        "temperature": {"const": 0},
        "topP": {"const": 1},
        "topK": {"const": 0},
        "maximumTokens": {"type": "integer", "minimum": 32, "maximum": 4096},
        "minimumRequiredTokens": {"const": 32},
        "stopPolicy": {"const": "fixed-length-no-stop-tokens"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/caseResult"}
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "prompt",
        "promptTokenCount",
        "timeToFirstTokenMs",
        "estimatedPrefillTokensPerSecond",
        "totalTimeMs",
        "generatedTokenCount",
        "generatedTokenIDs",
        "tokenChecksum",
        "text",
        "finishReason"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "promptTokenCount": {"type": "integer", "minimum": 1},
        "timeToFirstTokenMs": {"type": "number", "minimum": 0},
        "estimatedPrefillTokensPerSecond": {"type": "number", "minimum": 0},
        "totalTimeMs": {"type": "number", "minimum": 0},
        "generatedTokenCount": {"type": "integer", "minimum": 32, "maximum": 4096},
        "generatedTokenIDs": {
          "type": "array",
          "minItems": 32,
          "maxItems": 4096,
          "items": {"type": "integer", "minimum": 0}
        },
        "tokenChecksum": {"$ref": "#/$defs/checksum"},
        "text": {"type": "string"},
        "finishReason": {"const": "length"}
      }
    },
    "comparisonCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "promptTokenCountMatches",
        "tokenIDsMatch",
        "commonPrefixTokenCount",
        "baselineGeneratedTokenCount",
        "candidateGeneratedTokenCount",
        "baselineTokenChecksum",
        "candidateTokenChecksum"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "promptTokenCountMatches": {"type": "boolean"},
        "tokenIDsMatch": {"type": "boolean"},
        "commonPrefixTokenCount": {"type": "integer", "minimum": 0},
        "firstMismatchTokenIndex": {"type": "integer", "minimum": 0},
        "baselineGeneratedTokenCount": {"type": "integer", "minimum": 32},
        "candidateGeneratedTokenCount": {"type": "integer", "minimum": 32},
        "baselineTokenChecksum": {"$ref": "#/$defs/checksum"},
        "candidateTokenChecksum": {"$ref": "#/$defs/checksum"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineLabel",
        "candidateLabel",
        "comparedCaseCount",
        "exactMatchCaseCount",
        "exactMatchRate",
        "totalComparedTokenPositions",
        "matchingTokenPositions",
        "tokenPositionAgreementRate",
        "cases"
      ],
      "properties": {
        "baselineLabel": {"type": "string"},
        "candidateLabel": {"type": "string"},
        "comparedCaseCount": {"type": "integer", "minimum": 1},
        "exactMatchCaseCount": {"type": "integer", "minimum": 0},
        "exactMatchRate": {"type": "number", "minimum": 0, "maximum": 1},
        "totalComparedTokenPositions": {"type": "integer", "minimum": 1},
        "matchingTokenPositions": {"type": "integer", "minimum": 0},
        "tokenPositionAgreementRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/comparisonCase"}
        }
      }
    }
  }
}
