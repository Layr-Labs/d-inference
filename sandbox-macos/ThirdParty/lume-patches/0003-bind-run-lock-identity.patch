--- /dev/null
+++ b/libs/lume/src/VM/VMOwnerFailStopPolicy.swift
@@ -0,0 +1,35 @@
+import Darwin
+import Foundation
+
+struct VMOwnerFailStopReason: Equatable, Sendable {
+    let vmName: String
+    let runError: String
+    let stopError: String
+    let serviceState: String
+}
+
+/// Production never returns from a failed emergency stop. Tests may inject the
+/// retaining disposition; VM then keeps every run authority until a later
+/// same-process stop proves the virtualization service is terminal.
+enum VMOwnerFailStopDisposition: Sendable {
+    case retainAuthorityForTesting
+}
+
+typealias VMOwnerFailStopHandler =
+    @MainActor (VMOwnerFailStopReason) -> VMOwnerFailStopDisposition
+
+@MainActor
+func terminateOwnerProcessAfterFailedEmergencyStop(
+    _ reason: VMOwnerFailStopReason
+) -> VMOwnerFailStopDisposition {
+    Logger.error(
+        "Emergency VM stop failed; terminating the owner process",
+        metadata: [
+            "name": reason.vmName,
+            "runError": reason.runError,
+            "stopError": reason.stopError,
+            "serviceState": reason.serviceState,
+        ])
+    Darwin._exit(70)
+    fatalError("Darwin._exit unexpectedly returned")
+}
