+        } catch { phase = .failed; progress.poison(); throw error }
+    }
+    func prepared(_ value: Gemma4PreparedForwardModel) throws {
+        do {
+            guard phase == .constructing, value.source.plan.fingerprint == budget.planSHA256 else {
