+@Test("guest paths under /var land where the guest can see them")
+func logDirectoryMapsOntoTheDataVolume() throws {
+    let (root, binary) = try makeExecutable()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    let install = try makeInstall(executable: binary)
+
+    // /var is a symlink to private/var on a running system, but the mounted
+    // data volume has no such link. Writing to the guest's spelling creates a
+    // directory the guest cannot see, and the only symptom is a first-boot
+    // chown failing on a path that looks perfectly correct. This was a real
+    // failure: `chown: /var/db/darkbloom: No such file or directory`.
+    #expect(install.logDirectory == "/var/db/darkbloom")
+    #expect(install.logDirectoryVolumePath == "private/var/db/darkbloom")
+
+    #expect(GuestAgentInstall.volumeRelativePath("/etc/foo") == "private/etc/foo")
+    #expect(GuestAgentInstall.volumeRelativePath("/tmp") == "private/tmp")
+    // Paths that are not symlinked keep their spelling, and none of them gain
+    // a leading slash that would escape the mount point when joined.
+    #expect(GuestAgentInstall.volumeRelativePath("/Library/LaunchDaemons")
+        == "Library/LaunchDaemons")
+    #expect(GuestAgentInstall.volumeRelativePath("/usr/local/libexec")
+        == "usr/local/libexec")
+    // A directory merely starting with the same letters is not rewritten.
+    #expect(GuestAgentInstall.volumeRelativePath("/variable") == "variable")
+}
