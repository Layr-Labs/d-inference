diff --git a/Libraries/MLXLMCommon/ContinuousBatchingV2/PromptForkV2.swift b/Libraries/MLXLMCommon/ContinuousBatchingV2/PromptForkV2.swift
new file mode 100644
index 0000000..ce94c9c
--- /dev/null
+++ b/Libraries/MLXLMCommon/ContinuousBatchingV2/PromptForkV2.swift
@@ -0,0 +1,353 @@
+// PromptForkV2.swift
+//
+// Exact, simultaneous prompt-prefix coalescing primitives. This is deliberately
+// separate from the durable prefix cache:
+//  - the donor remains live while every follower is forked;
+//  - the fork happens only at a finalized engine-step boundary;
+//  - every follower receives request-owned KV and recurrent wrappers before it
+//    is allowed to schedule again.
+//
+// The experiment is default-off. Unknown models/backends fail closed.
+
+import Foundation
+import MLX
+
+// MARK: - Exact KV snapshot/fork contract
+
+/// One quiescent request's exact per-layer KV state at a uniform token
+/// boundary. Snapshot arrays are immutable views owned by the live donor until
+/// every destination has been constructed.
+public struct CBv2KVForkSnapshot {
+    public let tokenCount: Int
+    public let layers: [(keys: MLXArray, values: MLXArray, offset: Int)?]
+
+    public init(
+        tokenCount: Int,
+        layers: [(keys: MLXArray, values: MLXArray, offset: Int)?]
+    ) {
+        self.tokenCount = tokenCount
+        self.layers = layers
+    }
+}
+
+/// Optional backend refinement for exact live-row forking. Conformance is an
+/// explicit proof: ordinary `CBv2KVBackend` implementations never inherit
+/// support merely because they expose prefix-cache snapshots.
+public protocol CBv2ExactKVForkingBackend: CBv2KVBackend {
+    /// Capture a uniform, finalized boundary from `state`. Must reject
+    /// layouts whose complete live state cannot be represented exactly.
+    func makeForkSnapshot(
+        of state: [CBv2SequenceKV?],
+        layerKinds: [CBv2LayerKind]
+    ) throws -> CBv2KVForkSnapshot
+
+    /// Construct independent request-owned rows from `snapshot`. A later
+    /// write or release of either donor or destination must not alter the
+    /// other.
+    func makeSequenceState(
+        forking snapshot: CBv2KVForkSnapshot,
+        layerKinds: [CBv2LayerKind],
+        maxLength: Int
+    ) throws -> [CBv2SequenceKV?]
+}
+
+/// Default-off simultaneous prompt coalescing experiment.
+///
+/// `enabled: nil` reads `DARKBLOOM_CBV2_PROMPT_FORK`; an absent or
+/// unrecognized value is false. Tests and controlled callers can pass an
+/// explicit value without mutating process-global environment state.
+public struct CBv2PromptForkConfig: Sendable, Equatable {
+    public var enabled: Bool
+    public var minimumPrefixTokens: Int
+
+    public init(enabled: Bool? = nil, minimumPrefixTokens: Int = 32) {
+        self.enabled = enabled ?? CBv2PromptForkExperiment.environmentEnabled()
+        self.minimumPrefixTokens = max(1, minimumPrefixTokens)
+    }
+}
+
+// MARK: - Experiment capability and activity
+
+public struct CBv2PromptForkActivity: Sendable, Equatable {
+    public let isEnabled: Bool
+    public let isSupported: Bool
+    public let cohortsFormed: Int
+    public let cohortsForked: Int
+    public let cohortsAbandoned: Int
+    public let followerRowsForked: Int
+    public let followerRowsFellBack: Int
+    public let prefillTokensSaved: Int
+    /// Cumulative logical bytes installed into follower-owned KV/recurrent
+    /// wrappers at the fork boundary. Recurrent roots may initially be shared
+    /// immutably, but admission still charges every row's independent future
+    /// generations, so this deliberately reports the conservative logical
+    /// ownership charge.
+    public let logicalStateBytesForked: Int
+
+    public init(
+        isEnabled: Bool,
+        isSupported: Bool,
+        cohortsFormed: Int = 0,
+        cohortsForked: Int = 0,
+        cohortsAbandoned: Int = 0,
+        followerRowsForked: Int = 0,
+        followerRowsFellBack: Int = 0,
+        prefillTokensSaved: Int = 0,
+        logicalStateBytesForked: Int = 0
+    ) {
+        self.isEnabled = isEnabled
+        self.isSupported = isSupported
+        self.cohortsFormed = cohortsFormed
+        self.cohortsForked = cohortsForked
+        self.cohortsAbandoned = cohortsAbandoned
+        self.followerRowsForked = followerRowsForked
+        self.followerRowsFellBack = followerRowsFellBack
+        self.prefillTokensSaved = prefillTokensSaved
+        self.logicalStateBytesForked = logicalStateBytesForked
+    }
+}
+
+enum CBv2PromptForkExperiment {
+    static let environmentKey = "DARKBLOOM_CBV2_PROMPT_FORK"
+
+    static func environmentEnabled(
+        _ environment: [String: String] = ProcessInfo.processInfo.environment
+    ) -> Bool {
+        guard let raw = environment[environmentKey]?.trimmingCharacters(in: .whitespacesAndNewlines)
+            .lowercased()
+        else { return false }
+        return ["1", "true", "yes", "on"].contains(raw)
+    }
+
+    static func isSupported(
+        model: CBv2SteppableModel,
+        layerKinds: [CBv2LayerKind],
+        backend: CBv2KVBackend
+    ) -> Bool {
+        guard
+            (model as? any CBv2ModelCapabilityProviding)?
+                .cbv2Capabilities.supportsPromptStateForking == true,
+            (model as? any CBv2RecurrentSteppableModel)?.recurrentStateSpec != nil,
+            backend is any CBv2ExactKVForkingBackend,
+            !layerKinds.isEmpty
+        else { return false }
+
+        // Qwen 3.5/3.6 exposes only its ten owning full-attention rows here;
+        // all other transformer layers live in the recurrent state object.
+        // Refuse windowed and KV-borrowing layouts until their exact live-row
+        // snapshots have an equally explicit fork contract.
+        return layerKinds.allSatisfy { kind in
+            kind.sharesKVWithLayer == nil && kind.attention == .full
+        }
+    }
+}
+
+// MARK: - Pure cohort planning
+
+struct CBv2PromptForkCandidate {
+    let id: CBv2RequestID
+    let promptTokens: [Int]
+    let priority: Int
+    let cacheSalt: String?
+}
+
+struct CBv2PromptForkPlan {
+    let leader: CBv2RequestID
+    let followers: [CBv2RequestID]
+    let forkTokens: Int
+}
+
+enum CBv2PromptForkPlanner {
+    private struct ExactKey: Hashable {
+        let promptTokens: [Int]
+        let priority: Int
+        let cacheSalt: String?
+    }
+
+    /// Deepest-first exact planning:
+    ///  1. identical prompts form their own cohorts at `P - 1`;
+    ///  2. remaining rows greedily take the deepest pairwise common prefix,
+    ///     then absorb every row sharing that same prefix.
+    ///
+    /// Leaving one prompt token after the boundary is load-bearing: followers
+    /// never inherit a sampled token or sampler transaction. They resume with
+    /// their own final/shared-or-divergent prompt token and sample
+    /// independently through the ordinary rectangular decode path.
+    static func plan(
+        _ input: [CBv2PromptForkCandidate],
+        minimumTokens: Int
+    ) -> [CBv2PromptForkPlan] {
+        let minimumTokens = max(1, minimumTokens)
+        var remaining = input
+        var plans: [CBv2PromptForkPlan] = []
+
+        var exact: [ExactKey: [CBv2PromptForkCandidate]] = [:]
+        var exactOrder: [ExactKey] = []
+        for candidate in remaining {
+            let key = ExactKey(
+                promptTokens: candidate.promptTokens,
+                priority: candidate.priority,
+                cacheSalt: candidate.cacheSalt)
+            if exact[key] == nil { exactOrder.append(key) }
+            exact[key, default: []].append(candidate)
+        }
+        var consumed = Set<CBv2RequestID>()
+        for key in exactOrder {
+            guard let group = exact[key], group.count > 1 else { continue }
+            let forkTokens = key.promptTokens.count - 1
+            guard forkTokens >= minimumTokens else { continue }
+            plans.append(
+                CBv2PromptForkPlan(
+                    leader: group[0].id,
+                    followers: group.dropFirst().map(\.id),
+                    forkTokens: forkTokens))
+            consumed.formUnion(group.map(\.id))
+        }
+        remaining.removeAll { consumed.contains($0.id) }
+
+        while remaining.count > 1 {
+            var best: (first: Int, second: Int, tokens: Int)?
+            for first in 0 ..< remaining.count {
+                for second in (first + 1) ..< remaining.count {
+                    guard compatible(remaining[first], remaining[second]) else { continue }
+                    let tokens = forkableCommonPrefix(
+                        remaining[first].promptTokens,
+                        remaining[second].promptTokens)
+                    guard tokens >= minimumTokens else { continue }
+                    if best == nil || tokens > best!.tokens {
+                        best = (first, second, tokens)
+                    }
+                }
+            }
+            guard let best else { break }
+
+            let seed = remaining[best.first]
+            let prefix = Array(seed.promptTokens.prefix(best.tokens))
+            let members = remaining.enumerated().compactMap {
+                index, candidate -> (Int, CBv2PromptForkCandidate)? in
+                guard compatible(seed, candidate),
+                    candidate.promptTokens.count > best.tokens,
+                    candidate.promptTokens.starts(with: prefix)
+                else { return nil }
+                return (index, candidate)
+            }
+            guard members.count > 1 else {
+                // Defensive: the best pair itself must always be present.
+                remaining.remove(at: best.second)
+                continue
+            }
+            plans.append(
+                CBv2PromptForkPlan(
+                    leader: members[0].1.id,
+                    followers: members.dropFirst().map(\.1.id),
+                    forkTokens: best.tokens))
+            let memberIDs = Set(members.map(\.1.id))
+            remaining.removeAll { memberIDs.contains($0.id) }
+        }
+        return plans
+    }
+
+    static func forkableCommonPrefix(_ lhs: [Int], _ rhs: [Int]) -> Int {
+        let upperBound = min(lhs.count, rhs.count)
+        var count = 0
+        while count < upperBound, lhs[count] == rhs[count] { count += 1 }
+        // Every row must retain one ordinary prompt input after the fork.
+        return min(count, max(0, upperBound - 1))
+    }
+
+    static func compatible(
+        _ lhs: CBv2PromptForkCandidate,
+        _ rhs: CBv2PromptForkCandidate
+    ) -> Bool {
+        lhs.priority == rhs.priority && lhs.cacheSalt == rhs.cacheSalt
+    }
+}
+
+// MARK: - Engine-owned cohort state
+
+struct CBv2PromptForkCohort {
+    let leader: CBv2RequestID
+    var followers: [CBv2RequestID]
+    let forkTokens: Int
+}
+
+final class CBv2PromptForkCoordinator: @unchecked Sendable {
+    let isEnabled: Bool
+    let isSupported: Bool
+    let minimumTokens: Int
+
+    // Engine-thread confined.
+    var cohortsByLeader: [CBv2RequestID: CBv2PromptForkCohort] = [:]
+    var leaderByFollower: [CBv2RequestID: CBv2RequestID] = [:]
+    /// Boundary-only test hook. The live path leaves this nil. It runs after
+    /// follower state publication and accounting, before ordinary scheduling
+    /// resumes, so tests can inspect an exact quiescent fork boundary.
+    var onForkForTesting:
+        ((CBv2RequestID, [CBv2RequestID], Int) -> Void)?
+
+    // Cross-thread activity reads.
+    private let activityLock = NSLock()
+    private var cohortsFormed = 0
+    private var cohortsForked = 0
+    private var cohortsAbandoned = 0
+    private var followerRowsForked = 0
+    private var followerRowsFellBack = 0
+    private var prefillTokensSaved = 0
+    private var logicalStateBytesForked = 0
+
+    init(isEnabled: Bool, isSupported: Bool, minimumTokens: Int) {
+        self.isEnabled = isEnabled
+        self.isSupported = isSupported
+        self.minimumTokens = max(1, minimumTokens)
+    }
+
+    var isActive: Bool { isEnabled && isSupported }
+
+    func recordFormed() {
+        activityLock.lock()
+        cohortsFormed += 1
+        activityLock.unlock()
+    }
+
+    func recordFork(followers: Int, tokensSaved: Int, logicalBytes: Int) {
+        activityLock.lock()
+        cohortsForked += 1
+        followerRowsForked += followers
+        prefillTokensSaved = saturatingAdd(prefillTokensSaved, tokensSaved)
+        logicalStateBytesForked = saturatingAdd(logicalStateBytesForked, logicalBytes)
+        activityLock.unlock()
+    }
+
+    func recordFallback(rows: Int) {
+        guard rows > 0 else { return }
+        activityLock.lock()
+        followerRowsFellBack += rows
+        activityLock.unlock()
+    }
+
+    func recordAbandoned() {
+        activityLock.lock()
+        cohortsAbandoned += 1
+        activityLock.unlock()
+    }
+
+    func activity() -> CBv2PromptForkActivity {
+        activityLock.lock()
+        defer { activityLock.unlock() }
+        return CBv2PromptForkActivity(
+            isEnabled: isEnabled,
+            isSupported: isSupported,
+            cohortsFormed: cohortsFormed,
+            cohortsForked: cohortsForked,
+            cohortsAbandoned: cohortsAbandoned,
+            followerRowsForked: followerRowsForked,
+            followerRowsFellBack: followerRowsFellBack,
+            prefillTokensSaved: prefillTokensSaved,
+            logicalStateBytesForked: logicalStateBytesForked)
+    }
+
+    private func saturatingAdd(_ lhs: Int, _ rhs: Int) -> Int {
+        let (sum, overflow) = lhs.addingReportingOverflow(rhs)
+        return overflow ? Int.max : sum
+    }
+}
