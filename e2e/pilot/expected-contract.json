{
  "schema_version": 1,
  "oracle_version": 1,
  "contracts": {
    "health": {
      "statuses": [200],
      "headers": {"content-type": "application/json"},
      "body": {"kind": "json", "required": ["/status"], "equals": {"/status": "ok"}}
    },
    "models_authorized": {
      "statuses": [200],
      "headers": {"content-type": "application/json"},
      "body": {"kind": "json", "required": ["/object", "/data"], "equals": {"/object": "list"}}
    },
    "models_unauthorized": {
      "statuses": [401],
      "headers": {"content-type": "application/json"},
      "body": {"kind": "json", "required": ["/error"]}
    },
    "models_invalid_auth": {
      "statuses": [401],
      "headers": {"content-type": "application/json"},
      "body": {"kind": "json", "required": ["/error"]}
    },
