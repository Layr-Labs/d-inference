diff --git a/libs/lume/src/Unattended/GuestIdentity.swift b/libs/lume/src/Unattended/GuestIdentity.swift
new file mode 100644
index 0000000..509a283
--- /dev/null
+++ b/libs/lume/src/Unattended/GuestIdentity.swift
@@ -0,0 +1,121 @@
+import Foundation
+
+/// A guest account created offline on the installed macOS data volume.
+struct GuestUser: Equatable, Sendable {
+    let username: String
+    let realName: String
+    let password: String
+    let uid: String
+    let gid: String
+
+    var homeDirectory: String { "/Users/\(username)" }
+
+    init(username: String, realName: String, password: String, uid: String, gid: String) {
+        self.username = username
+        self.realName = realName
+        self.password = password
+        self.uid = uid
+        self.gid = gid
+    }
+}
+
+/// The set of accounts an unattended install creates.
+///
+/// Lume shipped one account, `lume`/`lume`, hardcoded and administrative. That
+/// is fine for a developer VM and wrong for a multi-tenant one: the credential
+/// is shared across every guest, and the account can rewrite its own launchd
+/// metadata and SSH startup files, so a tenant command running as it can
+/// tamper with the control path that supervises it.
+///
+/// This splits the two roles. The bootstrap account keeps administrative
+/// rights, autologin and SSH so the installer can finish the job. The tenant
+/// account, when present, is a plain unprivileged user with no group
+/// membership, no autologin and no login credential — it exists only to be the
+/// identity tenant work runs under.
+struct GuestIdentity: Equatable, Sendable {
+    /// Administrator used for bootstrap: autologin, SSH, and sudo during
+    /// finalization.
+    let bootstrap: GuestUser
+
+    /// Unprivileged account for tenant work. `nil` preserves the
+    /// single-account layout, which is what an ordinary `lume create` gets.
+    let tenant: GuestUser?
+
+    /// The credential Lume has always used. Kept as the default so an
+    /// unmodified `lume create` behaves exactly as before.
+    static let defaultBootstrap = GuestUser(
+        username: "lume",
+        realName: "lume",
+        password: "lume",
+        uid: "501",
+        gid: "20"
+    )
+
+    enum ValidationError: Error, CustomStringConvertible {
+        case emptyUsername
+        case emptyPassword
+        case duplicateUsername(String)
+        case duplicateUID(String)
+        case invalidUID(String)
+        case invalidUsername(String)
+
+        var description: String {
+            switch self {
+            case .emptyUsername: return "guest username must not be empty"
+            case .emptyPassword: return "guest password must not be empty"
+            case .duplicateUsername(let name):
+                return "tenant account must not reuse the bootstrap username '\(name)'"
+            case .duplicateUID(let uid):
+                return "tenant account must not reuse the bootstrap uid \(uid)"
+            case .invalidUID(let uid):
+                return "guest uid '\(uid)' is not a positive integer"
+            case .invalidUsername(let name):
+                return "guest username '\(name)' contains characters that are not [a-z0-9_-]"
+            }
+        }
+    }
+
+    /// The historical single-account layout, for callers that cannot throw.
+    static let legacy = GuestIdentity(unchecked: GuestIdentity.defaultBootstrap)
+
+    private init(unchecked bootstrap: GuestUser) {
+        self.bootstrap = bootstrap
+        self.tenant = nil
+    }
+
+    init(bootstrap: GuestUser = GuestIdentity.defaultBootstrap, tenant: GuestUser? = nil) throws {
+        try Self.validate(bootstrap)
+        if let tenant {
+            try Self.validate(tenant, requiresPassword: false)
+            // A shared username or uid would not fail loudly: the patcher's
+            // uid check runs per account, so the second write would quietly
+            // overwrite the first and the tenant would inherit admin rights.
+            guard tenant.username != bootstrap.username else {
+                throw ValidationError.duplicateUsername(bootstrap.username)
+            }
+            guard tenant.uid != bootstrap.uid else {
+                throw ValidationError.duplicateUID(bootstrap.uid)
+            }
+        }
+        self.bootstrap = bootstrap
+        self.tenant = tenant
+    }
+
+    private static func validate(
+        _ user: GuestUser,
+        requiresPassword: Bool = true
+    ) throws {
+        guard !user.username.isEmpty else { throw ValidationError.emptyUsername }
+        guard user.username.allSatisfy({
+            $0.isLowercase && $0.isLetter || $0.isNumber || $0 == "_" || $0 == "-"
+        }) else {
+            throw ValidationError.invalidUsername(user.username)
+        }
+        if requiresPassword, user.password.isEmpty {
+            throw ValidationError.emptyPassword
+        }
+        guard let uid = Int(user.uid), uid > 0 else {
+            throw ValidationError.invalidUID(user.uid)
+        }
+    }
+}
