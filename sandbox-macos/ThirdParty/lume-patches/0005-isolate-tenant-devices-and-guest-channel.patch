index 000000000..14bdfc39a
--- /dev/null
+++ b/libs/lume/tests/DarkbloomGuestRelayTests.swift
@@ -0,0 +1,130 @@
+import Darwin
+import Foundation
+import Testing
+@testable import lume
+
+private final class RelaySocketPair: @unchecked Sendable {
+    let first: Int32
+    let second: Int32
+    private let lock = NSLock()
+    private var secondOpen = true
+    init() throws {
+        var descriptors: [Int32] = [-1, -1]
+        guard socketpair(AF_UNIX, SOCK_STREAM, 0, &descriptors) == 0 else { throw POSIXError(.EIO) }
+        first = descriptors[0]; second = descriptors[1]
+        for fd in descriptors {
+            var timeout = timeval(tv_sec: 5, tv_usec: 0)
+            var noSignal: Int32 = 1
+            setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, socklen_t(MemoryLayout<timeval>.size))
+            setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, socklen_t(MemoryLayout<timeval>.size))
+            setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &noSignal, socklen_t(MemoryLayout<Int32>.size))
+        }
+    }
+    func closeSecond() { lock.withLock { if secondOpen { close(second); secondOpen = false } } }
+    deinit { close(first); if secondOpen { close(second) } }
+}
+
+@Suite("Darkbloom guest relay")
+struct DarkbloomGuestRelayTests {
+    @Test func flushesLargeLastFrameBeforeFINAndKeepsReverseDirectionAlive() throws {
+        let client = try RelaySocketPair(), guest = try RelaySocketPair()
+        let relay = DispatchGroup(), writer = DispatchGroup()
+        relay.enter()
+        DispatchQueue.global().async {
+            DarkbloomGuestRelay.run(client: client.first, guest: guest.first, timeoutNanoseconds: 5_000_000_000)
+            relay.leave()
+        }
+        let payload = Data(repeating: 0x81, count: 512 * 1024)
+        writer.enter()
+        DispatchQueue.global().async {
+            try? Self.writeAll(guest.second, payload)
+            shutdown(guest.second, SHUT_WR)
+            writer.leave()
+        }
+        #expect(try Self.readToEOF(client.second) == payload)
+        #expect(writer.wait(timeout: .now() + 5) == .success)
+        let acknowledgement = Data("last response received".utf8)
+        try Self.writeAll(client.second, acknowledgement)
+        shutdown(client.second, SHUT_WR)
+        #expect(try Self.readToEOF(guest.second) == acknowledgement)
+        #expect(relay.wait(timeout: .now() + 5) == .success)
+    }
+
+    @Test func fullPeerHangupDoesNotDiscardTheLastBufferedResponse() throws {
+        let client = try RelaySocketPair(), guest = try RelaySocketPair(), relay = DispatchGroup()
+        relay.enter()
+        DispatchQueue.global().async {
+            DarkbloomGuestRelay.run(client: client.first, guest: guest.first, timeoutNanoseconds: 5_000_000_000)
+            relay.leave()
+        }
+        let payload = Data(repeating: 0x44, count: 16384)
+        try Self.writeAll(guest.second, payload)
+        guest.closeSecond()
+        #expect(try Self.readToEOF(client.second) == payload)
+        shutdown(client.second, SHUT_WR)
+        #expect(relay.wait(timeout: .now() + 5) == .success)
+    }
+
+    @Test func cancellationStopsRelayWithoutClosingCallerOwnedDescriptors() throws {
+        let client = try RelaySocketPair(), guest = try RelaySocketPair(), signal = Flag()
+        let complete = DispatchGroup()
+        complete.enter()
+        DispatchQueue.global().async {
+            DarkbloomGuestRelay.run(client: client.first, guest: guest.first, shouldStop: { signal.value })
+            complete.leave()
+        }
+        signal.set()
+        #expect(complete.wait(timeout: .now() + 2) == .success)
+        #expect(fcntl(client.first, F_GETFD) >= 0 && fcntl(guest.first, F_GETFD) >= 0)
+    }
+
+    @Test func lateConnectAfterStopCannotCloseReusedDescriptorOrFinishTwice() throws {
+        let sockets = try RelaySocketPair(), guest = try RelaySocketPair(), finish = Counter()
+        // Give the client its own duplicate; the socketpair retains its originals.
+        let owned = dup(sockets.first)
+        #expect(owned >= 0)
+        let client = DarkbloomGuestClient(descriptor: owned) { finish.increment() }
+        client.stop()
+        #expect(finish.value == 1)
+        let replacement = dup(sockets.first)
+        defer { close(replacement) }
+        #expect(replacement == owned)
+        client.connected(.success(DarkbloomGuestEndpoint(descriptor: guest.first, owner: guest)))
+        client.stop()
+        #expect(finish.value == 1)
+        #expect(fcntl(replacement, F_GETFD) >= 0)
+        var byte: UInt8 = 7
+        #expect(write(replacement, &byte, 1) == 1)
+        #expect(read(sockets.second, &byte, 1) == 1)
+    }
+
+    private final class Flag: @unchecked Sendable {
+        private let lock = NSLock(); private var flag = false
+        var value: Bool { lock.withLock { flag } }
+        func set() { lock.withLock { flag = true } }
+    }
+    private final class Counter: @unchecked Sendable {
+        private let lock = NSLock(); private var count = 0
+        var value: Int { lock.withLock { count } }
+        func increment() { lock.withLock { count += 1 } }
+    }
+    private static func writeAll(_ fd: Int32, _ data: Data) throws {
+        try data.withUnsafeBytes { raw in
+            var offset = 0
+            while offset < raw.count {
+                let written = write(fd, raw.baseAddress!.advanced(by: offset), raw.count - offset)
+                guard written > 0 else { throw POSIXError(.EIO) }
+                offset += written
+            }
+        }
+    }
+    private static func readToEOF(_ fd: Int32) throws -> Data {
+        var result = Data(), bytes = [UInt8](repeating: 0, count: 8192)
+        while true {
+            let count = read(fd, &bytes, bytes.count)
+            if count == 0 { return result }
+            guard count > 0 else { throw POSIXError(.EIO) }
+            result.append(contentsOf: bytes.prefix(count))
+        }
+    }
+}
