# Sanitized production reference for the GCE coordinator in darkbloom-mainnet.
# This is not consumed directly and contains no secret values. The authoritative
# runtime file is /etc/d-inference/env; deploy/gcp/prod/refresh-env.sh preserves
# custom values, exact-migrates only explicitly retired defaults, and adds
# absent release defaults.

ENVIRONMENT=prod
COORDINATOR_URL=https://api.darkbloom.dev
COORDINATOR_WS_URL=wss://api.darkbloom.dev/ws/provider
CONSOLE_URL=https://console.darkbloom.dev
BASE_URL=https://api.darkbloom.dev

# Trust & attestation
MIN_TRUST=hardware
MDM_ENABLED=true
EIGENINFERENCE_ALLOW_UNSIGNED_PROFILES=false

# Release distribution
R2_BUCKET=d-inf-app
APPLE_TEAM_ID=SLDQ2GJ6TL
APPLE_SIGNING_IDENTITY=Developer ID Application: Eigen Labs, Inc. (SLDQ2GJ6TL)

# Fleet
EIGENINFERENCE_MIN_PROVIDER_VERSION=0.7.5
EIGENINFERENCE_HEALTH_EJECTION=on
EIGENINFERENCE_COLD_DISPATCH=false
EIGENINFERENCE_DEDICATED_MODELS=gemma-4
EIGENINFERENCE_MIN_DECODE_TPS=15
EIGENINFERENCE_QUEUE_BEFORE_SHED=true
EIGENINFERENCE_QUEUE_MAX_DEPTH=8
EIGENINFERENCE_QUEUE_MAX_WAIT=6s
EIGENINFERENCE_SERVABILITY_GATE=true
EIGENINFERENCE_PREFILL_DECODE_RATIO=12
EIGENINFERENCE_PREFILL_KEEPALIVE_INTERVAL=5s
EIGENINFERENCE_PROMPT_CALIBRATION=gpt-oss:1.3

# Per-model solo decode rate for the quality-concurrency admission cap.
#
# REQUIRED before raising engine_v2_max_concurrent to 8. The provider never
# sends decode_tps, so without a seed the cap is computed from
# resolvedDecodeTPS's sqrt(memory_bandwidth) proxy — 16-28 tok/s across Apple
# silicon, a model-agnostic number ~4x under the engine's measured ~99.5 tok/s
# gemma solo. That proxy caps gemma at 2 no matter what the provider reports,
# because the reported concurrency is only the MIN's base operand. Gated solo
# samples cannot rescue it: ingest needs the whole box at exactly one running
# and zero waiting requests at heartbeat time, which a box running at B=8
# essentially never is.
#
# The 70 tok/s figure is a MEASUREMENT OF ONE CHIP CLASS: the M4 Max gate box
# (gemma-4 99.5 paged / 101.8 eager, gpt-oss-20b 88.5 paged). The fleet is
# heterogeneous and the registry's own tests document gemma solo at 10-18
# tok/s on slower classes, so applying 70 fleet-wide would grant an M1/M2 box
# cap 8 while it actually decodes ~14 tok/s — ~3.4 tok/s per request at B=8,
# far under the 15 floor. Over-admission on the slowest boxes is exactly what
# this cap exists to prevent, so the fast seed is SCOPED to the class it came
# from.
#
# Keys take an optional "@<ChipFamily>|<ChipTier>" qualifier (the
# coordinator's chipClassKey, the same vocabulary the solo-sample store uses).
# A provider takes the entry for its OWN class when one exists; otherwise the
# unqualified entry, which the coordinator further clamps to the slowest class
# named here. An unrecognized chip reports class "Unknown|Unknown" and so
# always lands on the conservative unqualified value — never on M4|Max's.
#
# M4|Max, gemma: 70 reaches 8 on strict quality merit rather than via the
# overcommit rounding: floor((70/15-1)/0.39) = 9, ceil(9 x 1.2) = 11,
# min(11, 8) = 8, with projected per-request decode at B=8 of 17.0 tok/s —
# above the 15 floor. It also clears the threshold at the previous load factor
# (39.3 tok/s at k=0.27, 50.1 at k=0.39), so the seed and the k re-fit are
# INDEPENDENT: neither depends on the other having landed.
#
# Everything else, gemma: 14 tok/s, the low end of the observed slow-class
# range -> floor((14/15-1)/0.39) < 1 -> quality batch 1, ceil(1 x 1.2) = 2.
# Cap 2, the same answer the sqrt(memory_bandwidth) proxy gave before any seed
# existed, so no slower class is admitted more freely than it was.
#
# Everything else, gpt-oss-20b: 30 tok/s -> floor((30/15-1)/0.39) = 2,
# ceil(2 x 1.2) = 3. Well under the 58-93 tok/s registration benchmarks the
# fleet reports for this model, and it only ever TIGHTENS: gpt-oss is not a
# dedicated model, so without a seed it sits at the flat 24.
#
# Each class-scoped rate is retired the moment that class accumulates
# EIGENINFERENCE_QUALITY_CAP_SOLO_MIN_SAMPLES gated solo samples of its own.
EIGENINFERENCE_MODEL_SOLO_TPS_SEED=gemma-4-26b-qat-4bit=14,gemma-4-26b-qat-4bit@M4|Max=70,gpt-oss-20b=30,gpt-oss-20b@M4|Max=70

# TTFT and warm-pool tuning observed on 2026-07-17.
EIGENINFERENCE_TTFT_ADMISSION_MODE=shadow
EIGENINFERENCE_TTFT_HARD_REJECT=true
EIGENINFERENCE_TTFT_LIVE_DEADLINE_BASE_MS=9000
EIGENINFERENCE_TTFT_OCCUPANCY_ALPHA=50
EIGENINFERENCE_WARM_POOL_ENABLED=true
EIGENINFERENCE_WARM_POOL_OBSERVE_ONLY=false
EIGENINFERENCE_WARM_POOL_INTERVAL=30s
EIGENINFERENCE_WARM_POOL_MIN_DWELL=1m
EIGENINFERENCE_WARM_POOL_MIN_WARM=gpt-oss-20b=16,gemma-4-26b-qat-4bit=32
EIGENINFERENCE_WARM_POOL_QUEUE_AGE_THRESHOLD=5s
EIGENINFERENCE_WARM_POOL_CAPACITY_REJECT_THRESHOLD=1
EIGENINFERENCE_WARM_POOL_COLD_DISPATCH_THRESHOLD=1
EIGENINFERENCE_WARM_POOL_LOAD_DURATION_THRESHOLD=20s
EIGENINFERENCE_WARM_POOL_MAX_GLOBAL_PENDING_LOADS=16
EIGENINFERENCE_WARM_POOL_MAX_LOADS_PER_TICK=8
EIGENINFERENCE_WARM_POOL_SPECULATIVE_START_THRESHOLD=2
EIGENINFERENCE_WARM_POOL_SPECULATIVE_WIN_THRESHOLD=1
EIGENINFERENCE_WARM_POOL_TTFT_MISS_THRESHOLD=1
EIGENINFERENCE_WARM_POOL_WARM_SATURATION_THRESHOLD=0.8

# v0.7.13 adds provider cache telemetry; fresh environments still start routing off.
EIGENINFERENCE_CACHE_ROUTING_MODE=off
# Keep the product switch binary. These independent operational caps make the
# first later activation a deterministic 1% cohort with at most one new plan
# per second; increasing either value is a separate, observed rollout action.
EIGENINFERENCE_CACHE_ROUTING_PERCENT=1
EIGENINFERENCE_CACHE_ROUTING_MAX_PLAN_QPS=1
EIGENINFERENCE_PROMPT_SIDECAR_ENABLED=true
EIGENINFERENCE_PROMPT_SIDECAR_BINARY=/usr/local/bin/promptsidecar
EIGENINFERENCE_PROMPT_SIDECAR_SOCKET=/run/darkbloom/promptsidecar.sock
EIGENINFERENCE_PROMPT_SIDECAR_ARTIFACT_ROOT=/mnt/disks/userdata/prompt-contracts
EIGENINFERENCE_PROMPT_SIDECAR_HEALTH_TIMEOUT_MS=250
EIGENINFERENCE_PROMPT_SIDECAR_PRELOAD_TIMEOUT_MS=120000
EIGENINFERENCE_PROMPT_SIDECAR_STARTUP_TIMEOUT_MS=120000
EIGENINFERENCE_PROMPT_SIDECAR_HEALTH_INTERVAL_MS=1000
EIGENINFERENCE_PROMPT_SIDECAR_HEALTH_FAILURE_THRESHOLD=5
EIGENINFERENCE_PROMPT_SIDECAR_RESTART_WINDOW_MS=60000
EIGENINFERENCE_PROMPT_SIDECAR_RESTART_MAX_IN_WINDOW=3
EIGENINFERENCE_PROMPT_SIDECAR_RESTART_COOLDOWN_MS=30000
EIGENINFERENCE_PROMPT_SIDECAR_STDERR_MAX_BYTES=16384

# Coordinator-side remote media (image_url / video_url) resolution. Enabled is
# the incident rollback lever: setting it false restores the previous 400 for
# remote URLs. Like every variable in this file it is read at process start, so
# the container must be recreated for a change to take effect. Every other
# EIGENINFERENCE_MEDIA_FETCH_* knob keeps its code default; the two SSRF
# overrides (ALLOW_PRIVATE_IPS, ALLOW_NONSTANDARD_PORTS) must stay unset here.
EIGENINFERENCE_MEDIA_FETCH_ENABLED=true
