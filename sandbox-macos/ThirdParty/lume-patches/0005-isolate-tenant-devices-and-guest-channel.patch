+import Darwin
+import Foundation
+import Testing
+import Virtualization
+@testable import lume
+
+@Suite("Darkbloom isolated device policy")
+@MainActor
+struct DarkbloomDevicePolicyTests {
+    private let environment = [DarkbloomDevicePolicy.environmentKey: DarkbloomDevicePolicy.isolatedProfile]
+
+    private final class Fixture {
+        let root: URL
+        let boot: Path
+        let control: Path
+        let workspace: Path
+        init() throws {
+            root = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".db-device-\(UUID().uuidString)")
+            try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+            let guest = root.appendingPathComponent(".darkbloom-guest")
+            try FileManager.default.createDirectory(at: guest, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+            boot = Path(root.appendingPathComponent("disk.img").path)
+            control = Path(guest.appendingPathComponent("control.cdr").path)
+            workspace = Path(guest.appendingPathComponent("workspace.cdr").path)
+            for (path, mode) in [(boot, 0o600), (control, 0o400), (workspace, 0o600)] {
+                FileManager.default.createFile(atPath: path.path, contents: Data(repeating: 0, count: 512), attributes: [.posixPermissions: mode])
+            }
+        }
+        deinit { try? FileManager.default.removeItem(at: root) }
+        func context(shared: [SharedDirectory]? = nil, recovery: Bool = false, usb: [Path]? = nil) -> VMVirtualizationServiceContext {
+            VMVirtualizationServiceContext(cpuCount: 2, memorySize: 4 << 30,
+                display: "1024x768", sharedDirectories: shared, mount: control,
+                hardwareModel: nil, machineIdentifier: nil, macAddress: "02:00:00:00:00:01",
+                diskPath: boot, nvramPath: Path(root.appendingPathComponent("nvram.bin").path),
+                recoveryMode: recovery, usbMassStoragePaths: usb, additionalDiskPaths: [workspace], networkMode: .nat)
+        }
+        func storage() throws -> [VZStorageDeviceConfiguration] {
+            try [(boot, false), (control, true), (workspace, false)].map {
+                VZVirtioBlockDeviceConfiguration(attachment: try VZDiskImageStorageDeviceAttachment(url: $0.0.url, readOnly: $0.1))
+            }
+        }
+    }
+
+    @Test func stripsHostDevicesAndPreservesExactReadOnlyControlDisk() throws {
+        let fixture = try Fixture(), config = VZVirtualMachineConfiguration()
+        config.storageDevices = try fixture.storage()
+        config.networkDevices = [VZVirtioNetworkDeviceConfiguration()]
+        config.audioDevices = [VZVirtioSoundDeviceConfiguration()]
+        config.consoleDevices = [VZVirtioConsoleDeviceConfiguration()]
+        config.keyboards = [VZUSBKeyboardConfiguration()]
+        config.pointingDevices = [VZUSBScreenCoordinatePointingDeviceConfiguration()]
+        config.directorySharingDevices = [VZVirtioFileSystemDeviceConfiguration(tag: "test")]
+        try DarkbloomDevicePolicy.apply(to: config, context: fixture.context(), environment: environment)
+        #expect(config.networkDevices.isEmpty && config.audioDevices.isEmpty)
+        #expect(config.consoleDevices.isEmpty && config.serialPorts.isEmpty)
+        #expect(config.directorySharingDevices.isEmpty && config.keyboards.isEmpty && config.pointingDevices.isEmpty)
+        #expect(config.socketDevices.count == 1)
+        #expect(config.socketDevices.first is VZVirtioSocketDeviceConfiguration)
+        #expect(config.storageDevices.count == 3)
+        let control = (config.storageDevices[1] as? VZVirtioBlockDeviceConfiguration)?.attachment as? VZDiskImageStorageDeviceAttachment
+        #expect(control?.isReadOnly == true)
+    }
+
+    @Test func rejectsUnsafeControlModeAndExtraDevices() throws {
+        let fixture = try Fixture(), config = VZVirtualMachineConfiguration()
+        config.storageDevices = try fixture.storage()
+        #expect(chmod(fixture.control.path, 0o600) == 0)
+        #expect(throws: DarkbloomDevicePolicyError.self) {
+            try DarkbloomDevicePolicy.apply(to: config, context: fixture.context(), environment: environment)
+        }
+        #expect(chmod(fixture.control.path, 0o400) == 0)
+        config.storageDevices.append(config.storageDevices[0])
+        #expect(throws: DarkbloomDevicePolicyError.self) {
+            try DarkbloomDevicePolicy.apply(to: config, context: fixture.context(), environment: environment)
+        }
+    }
+
+    @Test func rejectsSharedDirectoriesUSBRecoveryAndStorageAliases() throws {
+        let fixture = try Fixture(), config = VZVirtualMachineConfiguration()
+        config.storageDevices = try fixture.storage()
+        let shared = SharedDirectory(hostPath: fixture.root.path, tag: "leak", readOnly: true)
+        for context in [fixture.context(shared: [shared]), fixture.context(recovery: true), fixture.context(usb: [fixture.control])] {
+            #expect(throws: DarkbloomDevicePolicyError.self) {
+                try DarkbloomDevicePolicy.apply(to: config, context: context, environment: environment)
+            }
+        }
+        #expect(throws: DarkbloomDevicePolicyError.self) {
+            try DarkbloomDevicePolicy.validateStorage(boot: fixture.boot, control: fixture.control, disks: [fixture.control])
+        }
+    }
+
+    @Test func requiresBrokerAndRefusesNetworkClipboardOrDetach() throws {
+        let fixture = try Fixture()
+        for violation in 0..<5 {
+            #expect(throws: DarkbloomDevicePolicyError.self) {
+                try DarkbloomDevicePolicy.validateInvocation(hasBrokerLifecycle: violation != 0,
+                    detached: violation == 1, displayDisabled: true, vncDisabled: true,
+                    clipboard: violation == 2, recovery: false, sharedDirectoryCount: 0, usbCount: 0,
+                    networkOverride: violation == 3, control: violation == 4 ? nil : fixture.control,
+                    disks: [fixture.workspace], environment: environment)
+            }
+        }
+    }
+
+    @Test func unknownProfileFailsClosed() {
+        #expect(throws: DarkbloomDevicePolicyError.self) {
+            try DarkbloomDevicePolicy.isIsolated(environment: [DarkbloomDevicePolicy.environmentKey: "typo"])
+        }
+    }
+
+    @Test func ordinaryBaseImageBootRetainsItsConfiguration() throws {
+        let fixture = try Fixture(), config = VZVirtualMachineConfiguration()
+        config.networkDevices = [VZVirtioNetworkDeviceConfiguration()]
+        try DarkbloomDevicePolicy.apply(to: config, context: fixture.context(), environment: [:])
+        #expect(config.networkDevices.count == 1)
+        #expect(config.socketDevices.isEmpty)
+    }
+}
