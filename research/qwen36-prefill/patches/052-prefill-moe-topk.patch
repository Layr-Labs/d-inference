diff --git a/Tests/MLXLMTests/Qwen35PrefillMoERoutingPolicyTests.swift b/Tests/MLXLMTests/Qwen35PrefillMoERoutingPolicyTests.swift
new file mode 100644
--- /dev/null
+++ b/Tests/MLXLMTests/Qwen35PrefillMoERoutingPolicyTests.swift
@@ -0,0 +1,90 @@
+import Testing
+
+@testable import MLXLLM
+
+struct Qwen35PrefillMoERoutingPolicyTests {
+    @Test func absentKnobPreservesCheckpointRouting() {
+        let policy = Qwen35PrefillMoERoutingPolicy.fromEnvironment(
+            [:], modelTopK: 8, layerCount: 40)
+
+        #expect(policy == .disabled)
+        #expect(
+            policy.routedTopK(layerIndex: 0, isPrefill: true, modelTopK: 8)
+                == 8)
+        #expect(policy.descriptor == "disabled")
+    }
+
+    @Test func topFourAppliesOnlyToSelectedPrefillLayers() {
+        let policy = Qwen35PrefillMoERoutingPolicy.fromEnvironment(
+            [
+                Qwen35PrefillMoERoutingPolicy.topKEnvironmentKey: "4",
+                Qwen35PrefillMoERoutingPolicy.fullLayersEnvironmentKey:
+                    "0, 3-5, 39",
+            ],
+            modelTopK: 8,
+            layerCount: 40)
+
+        #expect(policy.reducedTopK == 4)
+        #expect(policy.fullTopKLayers == Set([0, 3, 4, 5, 39]))
+        #expect(
+            policy.routedTopK(layerIndex: 1, isPrefill: true, modelTopK: 8)
+                == 4)
+        #expect(
+            policy.routedTopK(layerIndex: 3, isPrefill: true, modelTopK: 8)
+                == 8)
+        #expect(
+            policy.routedTopK(layerIndex: 39, isPrefill: true, modelTopK: 8)
+                == 8)
+    }
+
+    @Test func topTwoNeverChangesDecodeOrUnlabelledBlocks() {
+        let policy = Qwen35PrefillMoERoutingPolicy.fromEnvironment(
+            [Qwen35PrefillMoERoutingPolicy.topKEnvironmentKey: "2"],
+            modelTopK: 8,
+            layerCount: 40)
+
+        #expect(
+            policy.routedTopK(layerIndex: 12, isPrefill: true, modelTopK: 8)
+                == 2)
+        #expect(
+            policy.routedTopK(layerIndex: 12, isPrefill: false, modelTopK: 8)
+                == 8)
+        #expect(
+            policy.routedTopK(layerIndex: nil, isPrefill: true, modelTopK: 8)
+                == 8)
+    }
+
+    @Test func malformedSettingsFailClosedAsOnePolicy() {
+        let invalidEnvironments: [[String: String]] = [
+            [Qwen35PrefillMoERoutingPolicy.topKEnvironmentKey: "0"],
+            [Qwen35PrefillMoERoutingPolicy.topKEnvironmentKey: "8"],
+            [Qwen35PrefillMoERoutingPolicy.topKEnvironmentKey: "four"],
+            [
+                Qwen35PrefillMoERoutingPolicy.topKEnvironmentKey: "4",
+                Qwen35PrefillMoERoutingPolicy.fullLayersEnvironmentKey: "3-",
+            ],
+            [
+                Qwen35PrefillMoERoutingPolicy.topKEnvironmentKey: "4",
+                Qwen35PrefillMoERoutingPolicy.fullLayersEnvironmentKey: "40",
+            ],
+            [
+                Qwen35PrefillMoERoutingPolicy.topKEnvironmentKey: "4",
+                Qwen35PrefillMoERoutingPolicy.fullLayersEnvironmentKey: "5-3",
+            ],
+        ]
+
+        for environment in invalidEnvironments {
+            let policy = Qwen35PrefillMoERoutingPolicy.fromEnvironment(
+                environment, modelTopK: 8, layerCount: 40)
+            #expect(policy == .disabled)
+            #expect(
+                policy.routedTopK(
+                    layerIndex: 1, isPrefill: true, modelTopK: 8) == 8)
+        }
+
+        let invalidDirect = Qwen35PrefillMoERoutingPolicy(reducedTopK: 0)
+        #expect(
+            invalidDirect.routedTopK(
+                layerIndex: 1, isPrefill: true, modelTopK: 8) == 8)
+    }
+}
