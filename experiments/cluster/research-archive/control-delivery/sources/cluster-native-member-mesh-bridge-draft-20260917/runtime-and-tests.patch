+    private static func value(rank: Int, round: UInt8) -> Data {
+        if round == 0 { return Data([2,0,0,0]) }
+        if round == 1 { return Data(repeating: UInt8(rank + 20), count: 64) }
+        return Data([0,0,0,0])
