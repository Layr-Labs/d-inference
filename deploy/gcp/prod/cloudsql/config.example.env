# Copy this file outside source control. Do not add secrets.

PROJECT_ID=darkbloom-mainnet
INSTANCE_NAME=darkbloom
REGION=us-east4
DATABASE_VERSION=POSTGRES_16
EDITION=enterprise

# Confirm against observed production CPU, memory, storage, and connection load.
TIER=db-custom-2-7680
STORAGE_SIZE_GB=100
STORAGE_TYPE=SSD

# VPC containing the production coordinator VM.
NETWORK=default

# Existing or new private services access allocation.
PRIVATE_SERVICE_RANGE=google-managed-services-default
PRIVATE_SERVICE_PREFIX_LENGTH=16

AVAILABILITY_TYPE=REGIONAL
BACKUP_START_TIME=03:00
BACKUP_LOCATION=us
RETAINED_BACKUPS_COUNT=30
RETAINED_TRANSACTION_LOG_DAYS=7

# 1=Monday through 7=Sunday; hour is UTC.
MAINTENANCE_WINDOW_DAY=7
MAINTENANCE_WINDOW_HOUR=4

PASSWORD_MIN_LENGTH=16
PASSWORD_REUSE_INTERVAL=5

# Enabling the pgAudit flag is low-risk on a new empty instance but pgAudit also
# requires CREATE EXTENSION in each database and an approved pgaudit.log scope.
ENABLE_PGAUDIT=false

