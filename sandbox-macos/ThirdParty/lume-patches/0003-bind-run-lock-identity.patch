diff --git a/libs/lume/tests/RunLockTestHelper.c b/libs/lume/tests/RunLockTestHelper.c
new file mode 100644
index 00000000..f906149c
--- /dev/null
+++ b/libs/lume/tests/RunLockTestHelper.c
@@ -0,0 +1,105 @@
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static bool write_ready(uint8_t value) {
+    ssize_t result;
+    do {
+        result = write(STDOUT_FILENO, &value, sizeof(value));
+    } while (result < 0 && errno == EINTR);
+    return result == sizeof(value);
+}
+
+static void reset_termination_signals(void) {
+    (void)signal(SIGINT, SIG_DFL);
+    (void)signal(SIGTERM, SIG_DFL);
+
+    sigset_t signal_mask;
+    (void)sigemptyset(&signal_mask);
+    (void)sigaddset(&signal_mask, SIGINT);
+    (void)sigaddset(&signal_mask, SIGTERM);
+    (void)sigprocmask(SIG_UNBLOCK, &signal_mask, NULL);
+}
+
+int main(int argc, char *argv[]) {
+    if (argc != 4) {
+        (void)write_ready(0);
+        return 1;
+    }
+
+    const bool owns_locks = strcmp(argv[1], "owner") == 0;
+    const bool owns_config_lock =
+        owns_locks || strcmp(argv[1], "config-owner") == 0;
+    const bool owns_record_lock =
+        owns_locks || strcmp(argv[1], "record-owner") == 0;
+    const bool opens_only = strcmp(argv[1], "opener") == 0;
+    if (!owns_config_lock && !owns_record_lock && !opens_only) {
+        (void)write_ready(0);
+        return 1;
+    }
+
+    reset_termination_signals();
+
+    const int config_descriptor =
+        owns_config_lock || opens_only
+            ? open(
+                  argv[2],
+                  (owns_config_lock ? O_RDWR : O_RDONLY)
+                      | O_CLOEXEC | O_NOFOLLOW)
+            : -1;
+    int owner_descriptor = -1;
+    bool setup_succeeded =
+        (!owns_config_lock && !opens_only)
+        || config_descriptor >= 0;
+
+    if (setup_succeeded && owns_record_lock) {
+        owner_descriptor =
+            open(
+                argv[3],
+                O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW,
+                S_IRUSR | S_IWUSR);
+        setup_succeeded = owner_descriptor >= 0;
+    }
+    if (setup_succeeded && owns_config_lock) {
+        setup_succeeded =
+            flock(config_descriptor, LOCK_EX | LOCK_NB) == 0;
+    }
+    if (setup_succeeded && owns_record_lock) {
+        struct flock lock = {
+            .l_start = 0,
+            .l_len = 0,
+            .l_pid = 0,
+            .l_type = F_WRLCK,
+            .l_whence = SEEK_SET,
+        };
+        setup_succeeded =
+            fcntl(owner_descriptor, F_SETLK, &lock) == 0;
+    }
+
+    if (!write_ready(setup_succeeded ? 1 : 0)) {
+        setup_succeeded = false;
+    }
+    (void)close(STDOUT_FILENO);
+
+    if (setup_succeeded) {
+        uint8_t release = 0;
+        while (read(STDIN_FILENO, &release, sizeof(release)) < 0
+               && errno == EINTR) {
+        }
+    }
+
+    if (owner_descriptor >= 0) {
+        (void)close(owner_descriptor);
+    }
+    if (config_descriptor >= 0) {
+        (void)close(config_descriptor);
+    }
+    return setup_succeeded ? 0 : 1;
+}
