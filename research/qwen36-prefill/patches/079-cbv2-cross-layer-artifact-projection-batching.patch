@@ -0,0 +1,525 @@
+import MLX
+import MLXNN
+import MLXRandom
+import Testing
+
+@testable import MLXLLM
+@testable import MLXLMCommon
+
+@Suite("Qwen cross-layer artifact projection batching")
+struct Qwen35ArtifactProjectionBatchTests {
+    private struct Fixture {
+        let cache: CBv2LayerCache
+        let rows: [CBv2FullSequenceKV]
+        let recurrent: [CBv2RecurrentRequestState]
+    }
+
+    private struct RecurrentSnapshot {
+        let conv: MLXArray
+        let ssm: MLXArray
+    }
+
+    @Test func policyIsDefaultOffAndMalformedBudgetsFailClosed() {
+        #expect(
+            Qwen35ArtifactProjectionBatchPolicy.fromEnvironment([:])
+                == .disabled)
+        #expect(
+            Qwen35ArtifactProjectionBatchPolicy.fromEnvironment([
+                Qwen35ArtifactProjectionBatchPolicy.enabledEnvironmentKey:
+                    "artifact"
+            ]) == .disabled)
+
+        for value in ["", "0", "15", "513", "192.5", "many"] {
+            let policy =
+                Qwen35ArtifactProjectionBatchPolicy.fromEnvironment([
+                    Qwen35ArtifactProjectionBatchPolicy.enabledEnvironmentKey:
+                        "1",
+                    Qwen35ArtifactProjectionBatchPolicy
+                        .transientMiBEnvironmentKey: value,
+                ])
+            #expect(policy == .disabled)
+        }
+
+        let enabled =
+            Qwen35ArtifactProjectionBatchPolicy.fromEnvironment([
+                Qwen35ArtifactProjectionBatchPolicy.enabledEnvironmentKey:
+                    " ON "
+            ])
+        #expect(enabled.isEnabled)
+        #expect(
+            enabled.maximumTransientBytes
+                == 192 * 1_024 * 1_024)
+        #expect(enabled.descriptor == "gather_qmm=1;transient_mib=192")
+    }
+
+    @Test func e51B1x512FitsOneBatchAndLargerRectanglesMustChunk() throws {
+        let b1 = try #require(
+            Qwen35ArtifactProjectionWeightBank.estimatedTransientBytes(
+                batchSize: 1,
+                historyTokenCount: 320,
+                hiddenSize: 2_048,
+                gdnLayerCount: 27,
+                gdnQKVDimensions: 8_192,
+                gdnAuxDimensions: 32,
+                attentionLayerCount: 9,
+                attentionKVDimensions: 512,
+                dtypeSize: 2))
+        #expect(b1 == 195_747_840)
+        #expect(
+            b1
+                < Qwen35ArtifactProjectionBatchPolicy
+                    .defaultMaximumTransientMiB * 1_024 * 1_024)
+
+        let b4 = try #require(
+            Qwen35ArtifactProjectionWeightBank.estimatedTransientBytes(
+                batchSize: 4,
+                historyTokenCount: 320,
+                hiddenSize: 2_048,
+                gdnLayerCount: 27,
+                gdnQKVDimensions: 8_192,
+                gdnAuxDimensions: 32,
+                attentionLayerCount: 9,
+                attentionKVDimensions: 512,
+                dtypeSize: 2))
+        #expect(b4 == 4 * b1)
+        #expect(
+            b4
+                > Qwen35ArtifactProjectionBatchPolicy
+                    .defaultMaximumTransientMiB * 1_024 * 1_024)
+    }
+
+    @Test func gatheredQuantizedFamiliesMatchSequentialProjectionsAndDoNotReplaceWeights()
+        throws
+    {
+        let config = try TinyArtifactQwen.configuration()
+        MLXRandom.seed(0xB4_71)
+        let layers = makeQuantizedLayers(config)
+        let parametersBefore = parameterIdentity(layers)
+        let bank = try #require(Qwen35ArtifactProjectionWeightBank(
+            layers: layers,
+            maximumStackedWeightBytes:
+                Qwen35ArtifactProjectionBatchPolicy
+                .maximumStackedWeightBytes))
+        #expect(bank.stackedWeightBytes > 0)
+
+        let history = MLXRandom.normal([2, 5, config.hiddenSize])
+        let prepared = try #require(bank.prepare(
+            hiddenHistory: history,
+            candidateLayerIndices: Array(layers.indices),
+            maximumTransientBytes: 192 * 1_024 * 1_024))
+
+        var roots: [MLXArray] = []
+        for (modelLayerIndex, layer) in layers.enumerated() {
+            let normalized = layer.inputLayerNorm(history)
+            let projection = try #require(
+                prepared.projections[modelLayerIndex])
+            if let gdn = layer.linearAttn {
+                guard case .gdn(let actual) = projection else {
+                    Issue.record("GDN layer received attention artifact")
+                    continue
+                }
+                let expected = (
+                    qkv: gdn.inProjQKV(normalized),
+                    a: gdn.inProjA(normalized),
+                    b: gdn.inProjB(normalized))
+                roots += [
+                    actual.qkv, actual.a, actual.b,
+                    expected.qkv, expected.a, expected.b,
+                ]
+            } else if let attention = layer.selfAttn {
+                guard case .attention(let actual) = projection else {
+                    Issue.record("attention layer received GDN artifact")
+                    continue
+                }
+                let expected = (
+                    keys: attention.kProj(normalized),
+                    values: attention.vProj(normalized))
+                roots += [
+                    actual.keys, actual.values,
+                    expected.keys, expected.values,
+                ]
+            }
+        }
+        eval(roots)
+
+        for (modelLayerIndex, layer) in layers.enumerated() {
+            let normalized = layer.inputLayerNorm(history)
+            let projection = try #require(
+                prepared.projections[modelLayerIndex])
+            switch projection {
+            case .gdn(let actual):
+                let gdn = try #require(layer.linearAttn)
+                #expect(artifactClose(actual.qkv, gdn.inProjQKV(normalized)))
+                #expect(artifactClose(actual.a, gdn.inProjA(normalized)))
+                #expect(artifactClose(actual.b, gdn.inProjB(normalized)))
+            case .attention(let actual):
+                let attention = try #require(layer.selfAttn)
+                #expect(artifactClose(
+                    actual.keys, attention.kProj(normalized)))
+                #expect(artifactClose(
+                    actual.values, attention.vProj(normalized)))
+            }
+        }
+
+        let parametersAfter = parameterIdentity(layers)
+        #expect(parametersAfter.count == parametersBefore.count)
+        for (key, before) in parametersBefore {
+            #expect(
+                parametersAfter[key] === before,
+                Comment(rawValue: "projection batching replaced \(key)"))
+        }
+    }
+
+    @Test(arguments: [1, 2, 4])
+    func b1B2B4ArtifactsOffsetsStateRollbackAndCancellationMatchSequential(
+        batchSize: Int
+    ) throws {
+        let config = try TinyArtifactQwen.configuration()
+        MLXRandom.seed(UInt64(0xB4_80 + batchSize))
+        let layers = makeQuantizedLayers(config)
+        let bank = try #require(Qwen35ArtifactProjectionWeightBank(
+            layers: layers,
+            maximumStackedWeightBytes:
+                Qwen35ArtifactProjectionBatchPolicy
+                .maximumStackedWeightBytes))
+        let skippedLayers = [4, 5, 6, 7]
+        let recurrentLayers = [4, 5, 6]
+        let promptLength = 6
+        let candidate = try fixture(
+            config: config,
+            batchSize: batchSize,
+            promptLength: promptLength,
+            recurrentLayers: recurrentLayers)
+        let reference = try fixture(
+            config: config,
+            batchSize: batchSize,
+            promptLength: promptLength,
+            recurrentLayers: recurrentLayers)
+
+        let prefix = MLXRandom.normal([batchSize, 2, config.hiddenSize])
+        let candidatePrefix = try executeArtifactOnly(
+            layers: layers,
+            layerIndices: skippedLayers,
+            fixture: candidate,
+            hidden: prefix,
+            bank: bank,
+            usesProjectionBatch: true)
+        let referencePrefix = try executeArtifactOnly(
+            layers: layers,
+            layerIndices: skippedLayers,
+            fixture: reference,
+            hidden: prefix,
+            bank: bank,
+            usesProjectionBatch: false)
+        eval(candidatePrefix.roots + referencePrefix.roots)
+        for transaction in candidatePrefix.transactions {
+            try transaction.commit()
+        }
+        for transaction in referencePrefix.transactions {
+            try transaction.commit()
+        }
+        assertFixtureEquivalent(candidate, reference)
+        #expect(candidate.cache.offset == 2)
+        #expect(reference.cache.offset == 2)
+
+        let beforeCandidate = try recurrentSnapshots(
+            candidate, layerIndices: recurrentLayers)
+        let beforeReference = try recurrentSnapshots(
+            reference, layerIndices: recurrentLayers)
+        let boundary = MLXRandom.normal([batchSize, 4, config.hiddenSize])
+        let candidateBoundary = try executeFrontier(
+            layers: layers,
+            layerIndices: skippedLayers,
+            fixture: candidate,
+            hidden: boundary,
+            frontierTokenCount: 3,
+            bank: bank,
+            usesProjectionBatch: true)
+        let referenceBoundary = try executeFrontier(
+            layers: layers,
+            layerIndices: skippedLayers,
+            fixture: reference,
+            hidden: boundary,
+            frontierTokenCount: 3,
+            bank: bank,
+            usesProjectionBatch: false)
+        eval(
+            [candidateBoundary.hidden, referenceBoundary.hidden]
+                + candidateBoundary.roots
+                + referenceBoundary.roots)
+        #expect(artifactClose(
+            candidateBoundary.hidden, referenceBoundary.hidden))
+        #expect(candidate.cache.offset == promptLength)
+        #expect(reference.cache.offset == promptLength)
+        #expect(candidate.rows.allSatisfy {
+            $0.absoluteOffset == promptLength
+        })
+        #expect(reference.rows.allSatisfy {
+            $0.absoluteOffset == promptLength
+        })
+
+        let cancelledIndex = batchSize / 2
+        for row in 0 ..< batchSize {
+            if row == cancelledIndex {
+                try candidateBoundary.transactions[row].rollback()
+                try referenceBoundary.transactions[row].rollback()
+            } else {
+                try candidateBoundary.transactions[row].commit()
+                try referenceBoundary.transactions[row].commit()
+            }
+        }
+
+        for row in 0 ..< batchSize {
+            for (ordinal, layerIndex) in recurrentLayers.enumerated() {
+                let candidateState = try #require(
+                    candidate.recurrent[row].state(
+                        modelLayerIndex: layerIndex))
+                let referenceState = try #require(
+                    reference.recurrent[row].state(
+                        modelLayerIndex: layerIndex))
+                let candidateConv = try #require(candidateState.conv)
+                let candidateSSM = try #require(candidateState.ssm)
+                let referenceConv = try #require(referenceState.conv)
+                let referenceSSM = try #require(referenceState.ssm)
+                #expect(artifactClose(candidateConv, referenceConv))
+                #expect(artifactClose(candidateSSM, referenceSSM))
+
+                if row == cancelledIndex {
+                    #expect(TinyArtifactQwen.identical(
+                        candidateConv,
+                        beforeCandidate[row][ordinal].conv))
+                    #expect(TinyArtifactQwen.identical(
+                        candidateSSM,
+                        beforeCandidate[row][ordinal].ssm))
+                    #expect(TinyArtifactQwen.identical(
+                        referenceConv,
+                        beforeReference[row][ordinal].conv))
+                    #expect(TinyArtifactQwen.identical(
+                        referenceSSM,
+                        beforeReference[row][ordinal].ssm))
+                }
+            }
+        }
+
+        assertFixtureEquivalent(candidate, reference)
+        candidate.cache.removeRow(at: cancelledIndex)
+        reference.cache.removeRow(at: cancelledIndex)
+        #expect(candidate.cache.rows.count == batchSize - 1)
+        #expect(reference.cache.rows.count == batchSize - 1)
+        assertFixtureEquivalent(candidate, reference)
+    }
+
+    private func makeQuantizedLayers(
+        _ config: Qwen35TextConfiguration
+    ) -> [Qwen35DecoderLayer] {
+        let layers = (0 ..< 8).map {
+            Qwen35DecoderLayer(config, layerIdx: $0)
+        }
+        for layer in layers {
+            if let gdn = layer.linearAttn {
+                gdn.inProjQKV = QuantizedLinear(
+                    gdn.inProjQKV,
+                    groupSize: 32,
+                    bits: 4,
+                    mode: .affine)
+                gdn.inProjA = QuantizedLinear(
+                    gdn.inProjA,
+                    groupSize: 32,
+                    bits: 4,
+                    mode: .affine)
+                gdn.inProjB = QuantizedLinear(
+                    gdn.inProjB,
+                    groupSize: 32,
+                    bits: 4,
+                    mode: .affine)
+            } else if let attention = layer.selfAttn {
+                attention.kProj = QuantizedLinear(
+                    attention.kProj,
+                    groupSize: 32,
+                    bits: 4,
+                    mode: .affine)
+                attention.vProj = QuantizedLinear(
+                    attention.vProj,
+                    groupSize: 32,
+                    bits: 4,
+                    mode: .affine)
+            }
+            eval(layer)
+        }
+        return layers
+    }
+
+    private func fixture(
+        config: Qwen35TextConfiguration,
+        batchSize: Int,
+        promptLength: Int,
+        recurrentLayers: [Int]
+    ) throws -> Fixture {
+        let kind = try #require(config.cbv2LayerKinds.last)
+        let cache = TinyArtifactQwen.batchCache(
+            kind: kind,
+            batchSize: batchSize,
+            promptLength: promptLength)
+        let spec = TinyArtifactQwen.recurrentSpec(
+            config, layers: recurrentLayers)
+        return Fixture(
+            cache: cache.0,
+            rows: cache.1,
+            recurrent: try (0 ..< batchSize).map { _ in
+                try CBv2RecurrentRequestState(spec: spec)
+            })
+    }
+
+    private func executeArtifactOnly(
+        layers: [Qwen35DecoderLayer],
+        layerIndices: [Int],
+        fixture: Fixture,
+        hidden: MLXArray,
+        bank: Qwen35ArtifactProjectionWeightBank,
+        usesProjectionBatch: Bool
+    ) throws -> (
+        transactions: [CBv2RecurrentStateEvaluation],
+        roots: [MLXArray]
+    ) {
+        let transactions = try fixture.recurrent.map { try $0.bind() }
+        let prepared = usesProjectionBatch
+            ? try #require(bank.prepare(
+                hiddenHistory: hidden,
+                candidateLayerIndices: layerIndices,
+                maximumTransientBytes: 192 * 1_024 * 1_024))
+            : nil
+        var current = hidden
+        for modelLayerIndex in layerIndices {
+            let layer = layers[modelLayerIndex]
+            current = try #require(layer.cbv2PrefillArtifactOnly(
+                current,
+                modelLayerIndex: modelLayerIndex,
+                attentionCache: layer.isLinear ? nil : fixture.cache,
+                recurrentState: transactions,
+                positionIds: nil,
+                artifactProjection:
+                    prepared?.projections[modelLayerIndex]))
+        }
+        let roots = try transactions.flatMap { try $0.evaluate() }
+        eval([current] + roots + fixture.cache.innerState())
+        return (transactions, roots)
+    }
+
+    private func executeFrontier(
+        layers: [Qwen35DecoderLayer],
+        layerIndices: [Int],
+        fixture: Fixture,
+        hidden: MLXArray,
+        frontierTokenCount: Int,
+        bank: Qwen35ArtifactProjectionWeightBank,
+        usesProjectionBatch: Bool
+    ) throws -> (
+        hidden: MLXArray,
+        transactions: [CBv2RecurrentStateEvaluation],
+        roots: [MLXArray]
+    ) {
+        let historyCount = hidden.dim(1) - frontierTokenCount
+        let transactions = try fixture.recurrent.map { try $0.bind() }
+        let prepared = usesProjectionBatch
+            ? try #require(bank.prepare(
+                hiddenHistory: hidden[
+                    0..., 0 ..< historyCount, 0...],
+                candidateLayerIndices: layerIndices,
+                maximumTransientBytes: 192 * 1_024 * 1_024))
+            : nil
+        var current = hidden
+        for modelLayerIndex in layerIndices {
+            let layer = layers[modelLayerIndex]
+            current = try #require(
+                layer.cbv2PrefillFrontierStateRiver(
+                    current,
+                    modelLayerIndex: modelLayerIndex,
+                    attentionCache:
+                        layer.isLinear ? nil : fixture.cache,
+                    recurrentState: transactions,
+                    positionIds: nil,
+                    frontierTokenCount: frontierTokenCount,
+                    usePrefillMoERoutingPolicy: false,
+                    artifactProjection:
+                        prepared?.projections[modelLayerIndex]))
+        }
+        let roots = try transactions.flatMap { try $0.evaluate() }
+        eval([current] + roots + fixture.cache.innerState())
+        return (current, transactions, roots)
+    }
+
+    private func recurrentSnapshots(
+        _ fixture: Fixture,
+        layerIndices: [Int]
+    ) throws -> [[RecurrentSnapshot]] {
+        let result = try fixture.recurrent.map { state in
+            try layerIndices.map { layerIndex in
+                let layerState = try #require(
+                    state.state(modelLayerIndex: layerIndex))
+                let conv = try #require(layerState.conv)
+                let ssm = try #require(layerState.ssm)
+                return RecurrentSnapshot(
+                    conv: conv + MLXArray.zeros(
+                        conv.shape, dtype: conv.dtype),
+                    ssm: ssm + MLXArray.zeros(
+                        ssm.shape, dtype: ssm.dtype))
+            }
+        }
+        eval(result.flatMap { $0 }.flatMap { [$0.conv, $0.ssm] })
+        return result
+    }
+
+    private func assertFixtureEquivalent(
+        _ candidate: Fixture,
+        _ reference: Fixture
+    ) {
+        #expect(candidate.cache.offset == reference.cache.offset)
+        #expect(candidate.cache.rows.count == reference.cache.rows.count)
+        for (candidateRow, referenceRow) in zip(
+            candidate.cache.rows, reference.cache.rows)
+        {
+            guard
+                let candidateRow = candidateRow as? CBv2FullSequenceKV,
+                let referenceRow = referenceRow as? CBv2FullSequenceKV
+            else {
+                Issue.record("unexpected Qwen cache row type")
+                continue
+            }
+            let lhs = candidateRow.snapshot()
+            let rhs = referenceRow.snapshot()
+            eval(lhs.keys, lhs.values, rhs.keys, rhs.values)
+            #expect(lhs.offset == rhs.offset)
+            #expect(artifactClose(lhs.keys, rhs.keys))
+            #expect(artifactClose(lhs.values, rhs.values))
+        }
+    }
+
+    private func parameterIdentity(
+        _ layers: [Qwen35DecoderLayer]
+    ) -> [String: MLXArray] {
+        Dictionary(uniqueKeysWithValues: layers.enumerated().flatMap {
+            ordinal, layer in
+            layer.parameters().flattened().map {
+                ("\(ordinal).\($0.0)", $0.1)
+            }
+        })
+    }
+
+    private func artifactClose(
+        _ lhs: MLXArray,
+        _ rhs: MLXArray
+    ) -> Bool {
+        guard lhs.shape == rhs.shape else { return false }
+        let close = allClose(
+            lhs,
+            rhs,
+            rtol:
+                Qwen35ArtifactProjectionBatchPolicy
+                .artifactRelativeTolerance,
+            atol:
+                Qwen35ArtifactProjectionBatchPolicy
+                .artifactAbsoluteTolerance)
+        eval(close)
+        return close.item(Bool.self)
+    }
+}
