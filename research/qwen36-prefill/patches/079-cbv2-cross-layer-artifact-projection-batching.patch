+    /// Fold gathered historical projections, then execute the changing suffix
+    /// through this layer's ordinary projections and recurrence. Only history
+    /// is cross-layer independent; suffix rows remain sequential.
+    func cbv2ForwardFrontierFromProjectedArtifactHistory(
+        _ frontierInputs: MLXArray,
+        history: Qwen35GDNArtifactProjection,
+        modelLayerIndex: Int,
+        recurrentState: [CBv2RecurrentStateEvaluation]
+    ) -> MLXArray {
+        let B = frontierInputs.dim(0)
+        let frontierTokenCount = frontierInputs.dim(1)
+        precondition(
+            frontierTokenCount > 0
+                && history.qkv.ndim == 3
+                && history.qkv.dim(0) == B
+                && history.qkv.dim(1) > 0,
+            "Qwen35 projected frontier requires nonempty history and suffix")
+
+        let (initialConv, initialSSM) = cbv2InputState(
+            inputs: frontierInputs,
+            modelLayerIndex: modelLayerIndex,
+            recurrentState: recurrentState)
+        let prefix = processChunk(
+            qkv: history.qkv,
+            a: history.a,
+            b: history.b,
+            convState: initialConv,
+            ssmState: initialSSM,
+            mask: nil)
+
+        let frontierQKV = inProjQKV(frontierInputs)
+        let frontierB = inProjB(frontierInputs)
+        let frontierA = inProjA(frontierInputs)
+        let frontier = processChunk(
+            qkv: frontierQKV,
+            a: frontierA,
+            b: frontierB,
+            convState: prefix.newConvState,
+            ssmState: prefix.newSsmState,
+            mask: nil)
+        cbv2Stage(
+            conv: frontier.newConvState,
+            ssm: frontier.newSsmState,
+            modelLayerIndex: modelLayerIndex,
+            recurrentState: recurrentState,
+            operation: "batched-projection-frontier-state-river")
+
+        let z = inProjZ(frontierInputs)
+            .reshaped(B, frontierTokenCount, numVHeads, headVDim)
+        let normedOut = norm(frontier.out, gate: z)
+        return outProj(normedOut.reshaped(B, frontierTokenCount, -1))
+    }
