{
  "version": 1,
  "ignore_patterns": [
    "**/*_test.go",
    "**/Tests/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "rules": [
    {
      "name": "HTTP and API contracts",
      "source_patterns": [
        "coordinator/api/server.go",
        "coordinator/api/routes.go",
        "coordinator/api/types/**",
        "coordinator/api/*handler*.go"
      ],
      "docs_any_of": [
        "docs/reference/api-contracts.md"
      ]
    },
    {
      "name": "telemetry",
      "source_patterns": [
        "coordinator/telemetry/**",
        "coordinator/datadog/**",
        "coordinator/api/*telemetry*.go",
        "coordinator/api/*metrics*.go",
        "coordinator/api/observation/**",
        "provider-swift/Sources/ProviderCore/Telemetry/**",
        "console-ui/src/lib/telemetry*"
      ],
      "docs_any_of": [
        "docs/reference/telemetry-inventory.md",
        "docs/reference/telemetry-schema.md",
        "docs/architecture/telemetry.md"
      ]
    },
    {
      "name": "protocol messages",
      "source_patterns": [
        "coordinator/protocol/**",
        "provider-swift/Sources/ProviderCore/Protocol/**"
      ],
      "docs_any_of": [
        "docs/reference/protocol-messages.md"
      ]
    },
    {
      "name": "warm-pool and scheduling",
      "source_patterns": [
        "coordinator/registry/warm_pool*.go",
        "coordinator/registry/scheduler.go",
        "coordinator/registry/model_loading.go",
        "coordinator/registry/model_commands.go",
        "coordinator/registry/admission/**",
        "coordinator/registry/selection/**",
        "coordinator/api/warm_pool*.go"
      ],
      "docs_any_of": [
        "docs/architecture/scheduling.md",
        "docs/architecture/routing.md"
      ]
    },
    {
      "name": "configuration",
      "source_patterns": [
        "coordinator/config/**",
        "coordinator/app/*config*.go",
        "coordinator/app/routing.go",
        "coordinator/app/runtime_policy.go",
        "coordinator/app/release_policy.go",
        "coordinator/env/**",
        "coordinator/registry/config.go",
        "coordinator/registry/autopilot_config.go",
        "provider-swift/Sources/ProviderCore/Config/**",
        "coordinator/registry/autopilot/config.go"
      ],
      "docs_any_of": [
        "docs/reference/configuration.md"
      ]
    },
    {
      "name": "storage schema",
      "source_patterns": [
        "coordinator/store/postgres.go",
        "coordinator/store/*migration*.go",
        "coordinator/store/migrations/**",
        "coordinator/store/postgres/migrations.go",
        "coordinator/store/postgres/*schema*.go",
        "coordinator/store/postgres/migrations/**"
      ],
      "docs_any_of": [
        "docs/architecture/storage.md"
      ]
    },
    {
      "name": "provider release",
      "source_patterns": [
        ".github/workflows/release-swift.yml",
        "coordinator/api/releases/**",
        "scripts/install.sh",
        "provider-swift/Sources/ProviderCore/ProviderCore.swift"
      ],
      "docs_any_of": [
        "docs/operations/provider-release.md"
      ]
    },
    {
      "name": "model autopilot",
      "source_patterns": [
        "coordinator/registry/autopilot/**",
        "coordinator/registry/autopilot*.go",
        "coordinator/api/autopilot*.go",
        "coordinator/api/autopilot/**",
        "provider-swift/Sources/ProviderCore/Autopilot/**",
        "provider-swift/Sources/darkbloom/Autopilot/**",
        "provider-swift/Sources/darkbloom/Start/StartCommand+Autopilot.swift"
      ],
      "docs_any_of": [
        "docs/architecture/model-autopilot.md",
        "docs/operations/model-autopilot.md"
      ]
    },
    {
      "name": "coordinator ownership",
      "source_patterns": [
        "coordinator/api/*/owner.go",
        "coordinator/api/*/*/owner.go",
        "coordinator/app/app.go",
        "coordinator/app/lifecycle.go",
        "coordinator/store/memory/memory.go",
        "coordinator/store/postgres/postgres.go"
      ],
      "docs_any_of": [
        "docs/developer/navigation.md",
        "docs/architecture/components/coordinator.md"
      ]
    },
    {
      "name": "provider SSD prefix cache",
      "source_patterns": [
        "provider-swift/Sources/ProviderCore/KVCacheSSD/**",
        "provider-swift/Sources/ProviderCore/Inference/PrefixCache/**"
      ],
      "docs_any_of": [
        "docs/reference/ssd-kv-cache.md",
        "docs/architecture/prefix-cache.md"
      ]
    }
  ]
}
