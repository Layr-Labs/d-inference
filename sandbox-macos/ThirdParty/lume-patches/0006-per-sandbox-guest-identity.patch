+@Test("an identity rejects a tenant that collides with the bootstrap account")
+func identityRejectsCollisions() {
+    let bootstrap = GuestIdentity.defaultBootstrap
+
+    // A shared uid would not fail loudly: the uid check runs per account, so
+    // the second write would quietly overwrite the first and the tenant would
+    // inherit the administrator's rights.
+    #expect(throws: GuestIdentity.ValidationError.self) {
+        _ = try GuestIdentity(
+            bootstrap: bootstrap,
+            tenant: GuestUser(
+                username: "tenant",
+                realName: "tenant",
+                password: "",
+                uid: bootstrap.uid,
+                gid: "20"
+            )
+        )
+    }
+    #expect(throws: GuestIdentity.ValidationError.self) {
+        _ = try GuestIdentity(
+            bootstrap: bootstrap,
+            tenant: GuestUser(
+                username: bootstrap.username,
+                realName: "tenant",
+                password: "",
+                uid: "502",
+                gid: "20"
+            )
+        )
+    }
+}
+
+@Test("an identity accepts a distinct unprivileged tenant")
+func identityAcceptsDistinctTenant() throws {
+    let identity = try GuestIdentity(
+        bootstrap: GuestIdentity.defaultBootstrap,
+        tenant: GuestUser(
+            username: "sandbox",
+            realName: "sandbox",
+            password: "",
+            uid: "502",
+            gid: "20"
+        )
+    )
+    #expect(identity.tenant?.username == "sandbox")
+    #expect(identity.tenant?.homeDirectory == "/Users/sandbox")
+    // The tenant carries no login credential; it exists to be run as, not
+    // logged into.
+    #expect(identity.tenant?.password.isEmpty == true)
+}
+
+@Test("an identity rejects malformed accounts")
+func identityRejectsMalformedAccounts() {
+    #expect(throws: GuestIdentity.ValidationError.self) {
+        _ = try GuestIdentity(
+            bootstrap: GuestUser(
+                username: "", realName: "x", password: "p", uid: "501", gid: "20"
+            )
+        )
+    }
+    #expect(throws: GuestIdentity.ValidationError.self) {
+        _ = try GuestIdentity(
+            bootstrap: GuestUser(
+                username: "Bad Name", realName: "x", password: "p", uid: "501", gid: "20"
+            )
+        )
+    }
+    #expect(throws: GuestIdentity.ValidationError.self) {
+        _ = try GuestIdentity(
+            bootstrap: GuestUser(
+                username: "ok", realName: "x", password: "p", uid: "0", gid: "20"
+            )
+        )
+    }
+    // The bootstrap account must be able to log in; the tenant must not need to.
+    #expect(throws: GuestIdentity.ValidationError.self) {
+        _ = try GuestIdentity(
+            bootstrap: GuestUser(
+                username: "ok", realName: "x", password: "", uid: "501", gid: "20"
+            )
+        )
+    }
+}
