@@ -0,0 +1,65 @@
+import Darwin
+import Foundation
+import Testing
+@testable import lume
+
+@Suite("Darkbloom private guest bridge")
+struct DarkbloomGuestBridgeTests {
+    @Test func rejectsPublicParentAndPreservesExistingSocketPath() throws {
+        let root = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".dbg-\(UUID())")
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o755])
+        defer { try? FileManager.default.removeItem(at: root) }
+        let path = root.appendingPathComponent("s").path
+        #expect(throws: (any Error).self) { _ = try DarkbloomGuestBridge(path: path, connect: { _ in }) }
+        #expect(chmod(root.path, 0o700) == 0)
+        try Data("preserve".utf8).write(to: URL(fileURLWithPath: path))
+        #expect(throws: (any Error).self) { _ = try DarkbloomGuestBridge(path: path, connect: { _ in }) }
+        #expect(try Data(contentsOf: URL(fileURLWithPath: path)) == Data("preserve".utf8))
+    }
+
+    @Test func pendingConnectStopsAndLateCallbackDoesNotRetainAnOpenClient() throws {
+        let root = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".dbg-\(UUID())")
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: root) }
+        let path = root.appendingPathComponent("s").path, delayed = DelayedConnect()
+        let bridge = try DarkbloomGuestBridge(path: path) { delayed.capture($0) }
+        defer { bridge.stop() }
+        var metadata = stat()
+        #expect(lstat(path, &metadata) == 0 && metadata.st_mode & 0o777 == 0o600)
+        let client = socket(AF_UNIX, SOCK_STREAM, 0)
+        #expect(client >= 0)
+        defer { close(client) }
+        var address = sockaddr_un()
+        address.sun_family = sa_family_t(AF_UNIX)
+        address.sun_len = UInt8(MemoryLayout<sockaddr_un>.size)
+        withUnsafeMutableBytes(of: &address.sun_path) { $0.copyBytes(from: Array(path.utf8) + [0]) }
+        let status = withUnsafePointer(to: &address) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) { Darwin.connect(client, $0, socklen_t(MemoryLayout<sockaddr_un>.size)) }
+        }
+        #expect(status == 0)
+        #expect(delayed.started.wait(timeout: .now() + 2) == .success)
+        bridge.stop()
+        delayed.take()?(.failure(POSIXError(.ECONNRESET)))
+        var timeout = timeval(tv_sec: 2, tv_usec: 0), byte: UInt8 = 0
+        setsockopt(client, SOL_SOCKET, SO_RCVTIMEO, &timeout, socklen_t(MemoryLayout<timeval>.size))
+        #expect(read(client, &byte, 1) == 0)
+        for _ in 0..<100 {
+            if !FileManager.default.fileExists(atPath: path) { break }
+            usleep(10_000)
+        }
+        #expect(!FileManager.default.fileExists(atPath: path))
+        bridge.stop()
+    }
+
+    private final class DelayedConnect: @unchecked Sendable {
+        let started = DispatchSemaphore(value: 0)
+        private let lock = NSLock()
+        private var callback: (@Sendable (Result<DarkbloomGuestEndpoint, Error>) -> Void)?
+        func capture(_ callback: @escaping @Sendable (Result<DarkbloomGuestEndpoint, Error>) -> Void) {
+            lock.withLock { self.callback = callback }; started.signal()
+        }
+        func take() -> (@Sendable (Result<DarkbloomGuestEndpoint, Error>) -> Void)? {
+            lock.withLock { defer { callback = nil }; return callback }
+        }
+    }
+}
