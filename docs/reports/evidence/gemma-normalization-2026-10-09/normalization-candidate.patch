diff --git a/Tests/MLXLMTests/Kernel/LLM/Gemma4KVNormalizationTests.swift b/Tests/MLXLMTests/Kernel/LLM/Gemma4KVNormalizationTests.swift
new file mode 100644
index 0000000..6aa758f
--- /dev/null
+++ b/Tests/MLXLMTests/Kernel/LLM/Gemma4KVNormalizationTests.swift
@@ -0,0 +1,54 @@
+import MLX
+import Testing
+
+@testable import MLXLLM
+
+extension KernelTests {
+
+    @Suite("Gemma4 shared-projection RMS rounding", .serialized)
+    struct Gemma4KVNormalizationTests {
+        private func assertNativeBits(_ actual: MLXArray, _ expected: MLXArray) {
+            #expect(actual.dtype == expected.dtype)
+            let bits: DType = actual.dtype.size == 4 ? .uint32 : .uint16
+            #expect(
+                arrayEqual(
+                    actual.view(dtype: bits), expected.view(dtype: bits)
+                ).item(Bool.self))
+        }
+
+        @Test func reuseMatchesNativeRoundingAcrossDevicesAndDtypes() {
+            for device: Device in [.cpu, .gpu] {
+                Device.withDefaultDevice(device) {
+                    for dtype: DType in [.float16, .bfloat16, .float32] {
+                        for width in [32, 256, 512] {
+                            let raw = sin(
+                                MLXArray(0 ..< (4 * 17 * 2 * width)).asType(.float32) * 0.17
+                            ).reshaped([4, 17, 2, width]).asType(dtype)
+                            // Nonuniform scales exercise rounding that a unit or
+                            // power-of-two norm weight would fail to distinguish.
+                            let weight = (cos(MLXArray(0 ..< width).asType(.float32) * 0.31) * 1.7)
+                                .asType(dtype)
+                            let candidate = gemma4NormalizeSharedProjection(
+                                raw, keyWeight: weight, eps: 1e-6)
+                            let nativeKeys = MLXFast.rmsNorm(raw, weight: weight, eps: 1e-6)
+                            let nativeValues = MLXFast.rmsNorm(raw, weight: .mlxNone, eps: 1e-6)
+                            assertNativeBits(candidate.keys, nativeKeys)
+                            assertNativeBits(candidate.values, nativeValues)
+                        }
+                    }
+                }
+            }
+        }
+
+        @Test func mixedWeightDtypeKeepsNativePromotion() {
+            for dtype: DType in [.float16, .bfloat16] {
+                let raw = sin(MLXArray(0 ..< 1_024).asType(.float32) * 0.17)
+                    .reshaped([1, 1, 2, 512]).asType(dtype)
+                let weight = cos(MLXArray(0 ..< 512).asType(.float32) * 0.13)
+                let candidate = gemma4NormalizeSharedProjection(raw, keyWeight: weight, eps: 1e-6)
+                let native = MLXFast.rmsNorm(raw, weight: weight, eps: 1e-6)
+                assertNativeBits(candidate.keys, native)
+            }
+        }
+    }
+}
