# Post-v0.7.12 safe rollout defaults. refresh-env preserves custom values and
# migrates only explicitly listed historical defaults.
EIGENINFERENCE_CACHE_ROUTING_MODE=off
EIGENINFERENCE_CACHE_ROUTING_PERCENT=1
EIGENINFERENCE_CACHE_ROUTING_MAX_PLAN_QPS=1
EIGENINFERENCE_CACHE_ROUTING_TTL=10m
EIGENINFERENCE_CACHE_ROUTING_MAX_HOLDERS=4
EIGENINFERENCE_CACHE_ROUTING_MAX_DISCOUNT_MS=1000
EIGENINFERENCE_CACHE_ROUTING_MAX_COST_FRACTION=0.35
EIGENINFERENCE_PROMPT_SIDECAR_ENABLED=true
EIGENINFERENCE_PROMPT_SIDECAR_BINARY=/usr/local/bin/promptsidecar
EIGENINFERENCE_PROMPT_SIDECAR_SOCKET=/run/darkbloom/promptsidecar.sock
EIGENINFERENCE_PROMPT_SIDECAR_ARTIFACT_ROOT=/mnt/disks/userdata/prompt-contracts
EIGENINFERENCE_PROMPT_SIDECAR_ARTIFACT_BASE_URL=https://models.darkbloom.ai
EIGENINFERENCE_PROMPT_SIDECAR_ARTIFACT_TIMEOUT_MS=120000
EIGENINFERENCE_PROMPT_SIDECAR_PROVISION_WORKERS=2
EIGENINFERENCE_PROMPT_SIDECAR_PROVISION_MAX_MODELS=128
EIGENINFERENCE_PROMPT_SIDECAR_HEADER_TIMEOUT_MS=1000
EIGENINFERENCE_PROMPT_SIDECAR_TIMEOUT_MS=1000
EIGENINFERENCE_PROMPT_SIDECAR_HEALTH_TIMEOUT_MS=250
EIGENINFERENCE_PROMPT_SIDECAR_PRELOAD_TIMEOUT_MS=120000
EIGENINFERENCE_PROMPT_SIDECAR_STARTUP_TIMEOUT_MS=120000
EIGENINFERENCE_PROMPT_SIDECAR_HEALTH_INTERVAL_MS=1000
EIGENINFERENCE_PROMPT_SIDECAR_HEALTH_FAILURE_THRESHOLD=5
EIGENINFERENCE_PROMPT_SIDECAR_SHUTDOWN_TIMEOUT_MS=2000
EIGENINFERENCE_PROMPT_SIDECAR_RESTART_MIN_MS=100
EIGENINFERENCE_PROMPT_SIDECAR_RESTART_MAX_MS=5000
EIGENINFERENCE_PROMPT_SIDECAR_RESTART_WINDOW_MS=60000
EIGENINFERENCE_PROMPT_SIDECAR_RESTART_MAX_IN_WINDOW=3
EIGENINFERENCE_PROMPT_SIDECAR_RESTART_COOLDOWN_MS=30000
EIGENINFERENCE_PROMPT_SIDECAR_STDERR_MAX_BYTES=16384
EIGENINFERENCE_PROMPT_SIDECAR_MAX_BODY_BYTES=4194304
EIGENINFERENCE_PROMPT_SIDECAR_MAX_CONCURRENCY=4
EIGENINFERENCE_PROMPT_SIDECAR_MAX_CONNECTIONS=64
EIGENINFERENCE_PROMPT_SIDECAR_MAX_LOADED_CONTRACTS=8
EIGENINFERENCE_PROMPT_SIDECAR_MAX_TOKENS=1048576
EIGENINFERENCE_PROMPT_SIDECAR_MEMORY_LIMIT_MIB=1024
EIGENINFERENCE_MEDIA_FETCH_ENABLED=true

# v0.8.0 cold-start solo decode rates, chip-CLASS scoped (build-id[@Family|Tier]).
# The TPS registry is in-memory and restart-wiped, so without this the quality
# cap falls to the model-agnostic sqrt(memory_bandwidth) proxy on every restart.
# It is also the upper bound on cross-class solo-median transfer. Keep the
# unqualified entries conservative: they apply to every class not named here.
EIGENINFERENCE_MODEL_SOLO_TPS_SEED=gemma-4-26b-qat-4bit=14,gemma-4-26b-qat-4bit@M4|Max=70,gpt-oss-20b=30,gpt-oss-20b@M4|Max=70
