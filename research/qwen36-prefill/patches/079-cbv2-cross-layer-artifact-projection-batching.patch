new file mode 100644
index 0000000..631518b
--- /dev/null
+++ b/Libraries/MLXLLM/Models/Qwen35ArtifactProjectionBatch.swift
@@ -0,0 +1,540 @@
+import MLX
+import MLXNN
+
+/// Raw state-producing projections for one skipped Gated DeltaNet layer.
+/// Values are shaped `[batch, history, output]`, exactly like the corresponding
+/// per-layer `QuantizedLinear` calls before convolution/recurrent processing.
+struct Qwen35GDNArtifactProjection {
+    let qkv: MLXArray
+    let a: MLXArray
+    let b: MLXArray
+}
+
+/// Raw K/V projections for one skipped full-attention layer. K normalization
+/// and RoPE remain layer-local because they consume layer-specific modules and
+/// cache offsets.
+struct Qwen35AttentionArtifactProjection {
+    let keys: MLXArray
+    let values: MLXArray
+}
+
+enum Qwen35ArtifactProjection {
+    case gdn(Qwen35GDNArtifactProjection)
+    case attention(Qwen35AttentionArtifactProjection)
+}
+
+struct Qwen35PreparedArtifactProjectionBatch {
+    let layerIndices: [Int]
+    let projections: [Int: Qwen35ArtifactProjection]
+    let estimatedTransientBytes: Int
+}
+
+/// Immutable gathered-QMM weight bank for the five same-shape Qwen artifact
+/// families: GDN qkv/a/b and attention k/v.
+///
+/// This object is deliberately not an `MLXNN.Module`: its stacked arrays are
+/// execution views, not trainable/checkpoint parameters. Source module weights
+/// remain untouched and remain the only named model parameters.
+final class Qwen35ArtifactProjectionWeightBank {
+    private struct QuantizedFamily {
+        let modelLayerIndices: [Int]
+        let ordinalByModelLayer: [Int: Int]
+        let weights: MLXArray
+        let scales: MLXArray
+        let biases: MLXArray?
+        let groupSize: Int
+        let bits: Int
+        let mode: QuantizationMode
+        let inputDimensions: Int
+        let outputDimensions: Int
+        let stackedByteCount: Int
+
+        init?(_ sources: [(modelLayerIndex: Int, linear: Linear)]) {
+            guard
+                !sources.isEmpty,
+                let first = sources.first?.linear as? QuantizedLinear,
+                first.bias == nil,
+                first.weight.dtype == .uint32
+            else {
+                return nil
+            }
+
+            let shape = first.shape
+            let firstHasBiases = first.biases != nil
+            var quantized: [QuantizedLinear] = []
+            quantized.reserveCapacity(sources.count)
+            var sourceBytes = 0
+
+            for source in sources {
+                guard
+                    let linear = source.linear as? QuantizedLinear,
+                    linear.bias == nil,
+                    linear.weight.dtype == .uint32,
+                    linear.shape == shape,
+                    linear.weight.shape == first.weight.shape,
+                    linear.scales.shape == first.scales.shape,
+                    (linear.biases != nil) == firstHasBiases,
+                    linear.biases?.shape == first.biases?.shape,
+                    linear.groupSize == first.groupSize,
+                    linear.bits == first.bits,
+                    linear.mode.rawValue == first.mode.rawValue,
+                    let weightBytes = Self.byteCount(linear.weight),
+                    let scaleBytes = Self.byteCount(linear.scales),
+                    let withWeight = Self.checkedAdd(sourceBytes, weightBytes),
+                    let withScales = Self.checkedAdd(withWeight, scaleBytes)
+                else {
+                    return nil
+                }
+                if let biases = linear.biases {
+                    guard
+                        let biasBytes = Self.byteCount(biases),
+                        let withBiases = Self.checkedAdd(withScales, biasBytes)
+                    else {
+                        return nil
+                    }
+                    sourceBytes = withBiases
+                } else {
+                    sourceBytes = withScales
+                }
+                quantized.append(linear)
+            }
+
+            let modelLayerIndices = sources.map(\.modelLayerIndex)
+            let ordinalByModelLayer = Dictionary(
+                uniqueKeysWithValues: sources.enumerated().map {
+                    ($0.element.modelLayerIndex, $0.offset)
+                })
+            guard ordinalByModelLayer.count == sources.count else { return nil }
+
+            self.modelLayerIndices = modelLayerIndices
+            self.ordinalByModelLayer = ordinalByModelLayer
+            self.weights = stacked(quantized.map(\.weight), axis: 0)
+            self.scales = stacked(quantized.map(\.scales), axis: 0)
+            if firstHasBiases {
+                self.biases = stacked(quantized.compactMap(\.biases), axis: 0)
+            } else {
+                self.biases = nil
+            }
+            self.groupSize = first.groupSize
+            self.bits = first.bits
+            self.mode = first.mode
+            self.inputDimensions = shape.1
+            self.outputDimensions = shape.0
+            self.stackedByteCount = sourceBytes
+        }
+
+        func project(
+            _ inputRows: MLXArray,
+            modelLayerIndices: [Int],
+            batchSize: Int,
+            tokenCount: Int
+        ) -> [MLXArray]? {
+            guard
+                batchSize > 0,
+                tokenCount > 0,
+                let rowsPerLayer = Self.checkedMultiply(batchSize, tokenCount),
+                inputRows.shape == [
+                    modelLayerIndices.count,
+                    rowsPerLayer,
+                    inputDimensions,
+                ]
+            else {
+                return nil
+            }
+
+            var indices: [Int32] = []
+            indices.reserveCapacity(modelLayerIndices.count)
+            for modelLayerIndex in modelLayerIndices {
+                guard
+                    let ordinal = ordinalByModelLayer[modelLayerIndex],
+                    let ordinal32 = Int32(exactly: ordinal)
+                else {
+                    return nil
+                }
+                indices.append(ordinal32)
+            }
+
+            // One index selects one whole `[B * history, hidden]` matrix.
+            // Keeping M intact is the mechanism: Metal dispatches one
+            // matrix-level gathered QMM over the layer family instead of
+            // degrading the history rectangle into per-token QMV work.
+            let projected = gatherQuantizedMM(
+                inputRows,
+                weights,
+                scales: scales,
+                biases: biases,
+                rhsIndices: MLXArray(indices),
+                transpose: true,
+                groupSize: groupSize,
+                bits: bits,
+                mode: mode,
+                sortedIndices: true)
+                .reshaped(
+                    modelLayerIndices.count,
+                    batchSize,
+                    tokenCount,
+                    outputDimensions)
+
+            return modelLayerIndices.indices.map { ordinal in
+                projected[
+                    ordinal ..< (ordinal + 1),
+                    0..., 0..., 0...
+                ].squeezed(axis: 0)
+            }
+        }
+
+        private static func byteCount(_ array: MLXArray) -> Int? {
+            checkedMultiply(array.size, array.dtype.size)
+        }
+
+        private static func checkedMultiply(_ lhs: Int, _ rhs: Int) -> Int? {
+            let (value, overflow) = lhs.multipliedReportingOverflow(by: rhs)
+            return overflow ? nil : value
+        }
+
+        private static func checkedAdd(_ lhs: Int, _ rhs: Int) -> Int? {
+            let (value, overflow) = lhs.addingReportingOverflow(rhs)
+            return overflow ? nil : value
+        }
+    }
+
+    private let layerByModelIndex: [Int: Qwen35DecoderLayer]
+    private let gdnLayerIndices: Set<Int>
+    private let attentionLayerIndices: Set<Int>
+    private let gdnQKV: QuantizedFamily
+    private let gdnA: QuantizedFamily
+    private let gdnB: QuantizedFamily
+    private let attentionK: QuantizedFamily
+    private let attentionV: QuantizedFamily
+
+    let stackedWeightBytes: Int
+
+    init?(
+        layers: [Qwen35DecoderLayer],
+        maximumStackedWeightBytes: Int
+    ) {
+        guard !layers.isEmpty, maximumStackedWeightBytes > 0 else {
+            return nil
+        }
+
+        let indexed = Array(layers.enumerated())
+        let gdnSources: [(modelLayerIndex: Int, layer: Qwen35GatedDeltaNet)] =
+            indexed.compactMap { entry in
+                guard let linear = entry.element.linearAttn else { return nil }
+                return (entry.offset, linear)
+            }
+        let attentionSources: [
+            (modelLayerIndex: Int, layer: Qwen35Attention)
+        ] = indexed.compactMap { entry in
+            guard let attention = entry.element.selfAttn else { return nil }
+            return (entry.offset, attention)
+        }
+        guard
+            !gdnSources.isEmpty,
+            !attentionSources.isEmpty,
+            let gdnQKV = QuantizedFamily(gdnSources.map {
+                ($0.modelLayerIndex, $0.layer.inProjQKV)
+            }),
+            let gdnA = QuantizedFamily(gdnSources.map {
+                ($0.modelLayerIndex, $0.layer.inProjA)
+            }),
+            let gdnB = QuantizedFamily(gdnSources.map {
+                ($0.modelLayerIndex, $0.layer.inProjB)
+            }),
+            let attentionK = QuantizedFamily(attentionSources.map {
+                ($0.modelLayerIndex, $0.layer.kProj)
+            }),
+            let attentionV = QuantizedFamily(attentionSources.map {
+                ($0.modelLayerIndex, $0.layer.vProj)
+            }),
+            gdnQKV.modelLayerIndices == gdnA.modelLayerIndices,
+            gdnQKV.modelLayerIndices == gdnB.modelLayerIndices,
+            attentionK.modelLayerIndices == attentionV.modelLayerIndices,
+            gdnQKV.inputDimensions == gdnA.inputDimensions,
+            gdnQKV.inputDimensions == gdnB.inputDimensions,
+            gdnQKV.inputDimensions == attentionK.inputDimensions,
+            attentionK.inputDimensions == attentionV.inputDimensions
+        else {
+            return nil
+        }
+
+        var stackedBytes = 0
+        for family in [gdnQKV, gdnA, gdnB, attentionK, attentionV] {
+            guard let next = Self.checkedAdd(
+                stackedBytes, family.stackedByteCount)
+            else {
+                return nil
+            }
+            stackedBytes = next
+        }
+        guard stackedBytes <= maximumStackedWeightBytes else {
+            return nil
+        }
+
+        self.layerByModelIndex = Dictionary(
+            uniqueKeysWithValues: indexed.map { ($0.offset, $0.element) })
+        self.gdnLayerIndices = Set(gdnSources.map(\.modelLayerIndex))
+        self.attentionLayerIndices = Set(
+            attentionSources.map(\.modelLayerIndex))
+        self.gdnQKV = gdnQKV
+        self.gdnA = gdnA
+        self.gdnB = gdnB
+        self.attentionK = attentionK
+        self.attentionV = attentionV
+        self.stackedWeightBytes = stackedBytes
+    }
+
+    /// Select a budget-safe prefix of one consecutive skipped-layer run,
+    /// construct every same-family projection graph for that prefix, and
+    /// return layer-addressable artifacts for sequential recurrence/KV use.
+    func prepare(
+        hiddenHistory: MLXArray,
+        candidateLayerIndices: [Int],
+        maximumTransientBytes: Int
+    ) -> Qwen35PreparedArtifactProjectionBatch? {
+        guard
+            hiddenHistory.ndim == 3,
+            hiddenHistory.dim(0) > 0,
+            hiddenHistory.dim(1) > 0,
+            hiddenHistory.dim(2) == gdnQKV.inputDimensions,
+            !candidateLayerIndices.isEmpty,
+            maximumTransientBytes > 0
+        else {
+            return nil
+        }
+
+        let batchSize = hiddenHistory.dim(0)
+        let tokenCount = hiddenHistory.dim(1)
+        let dtypeSize = hiddenHistory.dtype.size
+        var selected: [Int] = []
+        var estimatedBytes = 0
+        var gdnCount = 0
+        var attentionCount = 0
+
+        for modelLayerIndex in candidateLayerIndices {
+            let outputDimensions: Int
+            if gdnLayerIndices.contains(modelLayerIndex) {
+                guard let sum = Self.checkedSum([
+                    gdnQKV.inputDimensions,
+                    gdnQKV.outputDimensions,
+                    gdnA.outputDimensions,
+                    gdnB.outputDimensions,
+                ]) else {
+                    return nil
+                }
+                outputDimensions = sum
+            } else if attentionLayerIndices.contains(modelLayerIndex) {
+                guard let sum = Self.checkedSum([
+                    attentionK.inputDimensions,
+                    attentionK.outputDimensions,
+                    attentionV.outputDimensions,
+                ]) else {
+                    return nil
+                }
+                outputDimensions = sum
+            } else {
+                return nil
+            }
+            guard
+                let elementCount = Self.checkedProduct([
+                    batchSize, tokenCount, outputDimensions,
+                ]),
+                let layerBytes = Self.checkedMultiply(
+                    elementCount, dtypeSize),
+                let nextBytes = Self.checkedAdd(
+                    estimatedBytes, layerBytes)
+            else {
+                return nil
+            }
+            if nextBytes > maximumTransientBytes {
+                break
+            }
+            selected.append(modelLayerIndex)
+            estimatedBytes = nextBytes
+            if gdnLayerIndices.contains(modelLayerIndex) {
+                gdnCount += 1
+            } else {
+                attentionCount += 1
+            }
+        }
+
+        // A one-layer gather only adds packing overhead. Leave it on the
+        // established per-layer path unless at least one family crosses layers.
+        guard
+            !selected.isEmpty,
+            gdnCount >= 2 || attentionCount >= 2
+        else {
+            return nil
+        }
+
+        var projections: [Int: Qwen35ArtifactProjection] = [:]
+        projections.reserveCapacity(selected.count)
+
+        let selectedGDN = selected.filter { gdnLayerIndices.contains($0) }
+        if !selectedGDN.isEmpty {
+            guard
+                let normalized = normalizedRows(
+                    hiddenHistory, modelLayerIndices: selectedGDN),
+                let qkv = gdnQKV.project(
+                    normalized,
+                    modelLayerIndices: selectedGDN,
+                    batchSize: batchSize,
+                    tokenCount: tokenCount),
+                let a = gdnA.project(
+                    normalized,
+                    modelLayerIndices: selectedGDN,
+                    batchSize: batchSize,
+                    tokenCount: tokenCount),
+                let b = gdnB.project(
+                    normalized,
+                    modelLayerIndices: selectedGDN,
+                    batchSize: batchSize,
+                    tokenCount: tokenCount)
+            else {
+                return nil
+            }
+            for ordinal in selectedGDN.indices {
+                projections[selectedGDN[ordinal]] = .gdn(
+                    Qwen35GDNArtifactProjection(
+                        qkv: qkv[ordinal],
+                        a: a[ordinal],
+                        b: b[ordinal]))
+            }
+        }
+
+        let selectedAttention = selected.filter {
+            attentionLayerIndices.contains($0)
+        }
+        if !selectedAttention.isEmpty {
+            guard
+                let normalized = normalizedRows(
+                    hiddenHistory, modelLayerIndices: selectedAttention),
+                let keys = attentionK.project(
+                    normalized,
+                    modelLayerIndices: selectedAttention,
+                    batchSize: batchSize,
+                    tokenCount: tokenCount),
+                let values = attentionV.project(
+                    normalized,
+                    modelLayerIndices: selectedAttention,
+                    batchSize: batchSize,
+                    tokenCount: tokenCount)
+            else {
+                return nil
+            }
+            for ordinal in selectedAttention.indices {
+                projections[selectedAttention[ordinal]] = .attention(
+                    Qwen35AttentionArtifactProjection(
+                        keys: keys[ordinal],
+                        values: values[ordinal]))
+            }
+        }
+
+        guard projections.count == selected.count else { return nil }
+        return Qwen35PreparedArtifactProjectionBatch(
+            layerIndices: selected,
+            projections: projections,
+            estimatedTransientBytes: estimatedBytes)
+    }
+
+    /// Pure arithmetic seam used by the memory-budget regression. Includes
+    /// one normalized hidden rectangle per layer and every raw artifact output.
+    static func estimatedTransientBytes(
+        batchSize: Int,
+        historyTokenCount: Int,
+        hiddenSize: Int,
+        gdnLayerCount: Int,
+        gdnQKVDimensions: Int,
+        gdnAuxDimensions: Int,
+        attentionLayerCount: Int,
+        attentionKVDimensions: Int,
+        dtypeSize: Int
+    ) -> Int? {
+        guard
+            batchSize > 0,
+            historyTokenCount > 0,
+            hiddenSize > 0,
+            gdnLayerCount >= 0,
+            gdnQKVDimensions >= 0,
+            gdnAuxDimensions >= 0,
+            attentionLayerCount >= 0,
+            attentionKVDimensions >= 0,
+            dtypeSize > 0,
+            let doubledGDNAux = checkedMultiply(2, gdnAuxDimensions),
+            let doubledAttentionKV = checkedMultiply(
+                2, attentionKVDimensions),
+            let gdnWidth = checkedSum([
+                hiddenSize, gdnQKVDimensions, doubledGDNAux,
+            ]),
+            let attentionWidth = checkedSum([
+                hiddenSize, doubledAttentionKV,
+            ]),
+            let gdnElements = checkedProduct([
+                batchSize, historyTokenCount, gdnLayerCount, gdnWidth,
+            ]),
+            let attentionElements = checkedProduct([
+                batchSize, historyTokenCount,
+                attentionLayerCount, attentionWidth,
+            ]),
+            let elements = checkedAdd(gdnElements, attentionElements)
+        else {
+            return nil
+        }
+        return checkedMultiply(elements, dtypeSize)
+    }
+
+    private func normalizedRows(
+        _ hiddenHistory: MLXArray,
+        modelLayerIndices: [Int]
+    ) -> MLXArray? {
+        guard
+            let rowsPerLayer = Self.checkedMultiply(
+                hiddenHistory.dim(0), hiddenHistory.dim(1))
+        else {
+            return nil
+        }
+        var rows: [MLXArray] = []
+        rows.reserveCapacity(modelLayerIndices.count)
+        for modelLayerIndex in modelLayerIndices {
+            guard let layer = layerByModelIndex[modelLayerIndex] else {
+                return nil
+            }
+            rows.append(
+                layer.inputLayerNorm(hiddenHistory)
+                    .reshaped(rowsPerLayer, hiddenHistory.dim(2)))
+        }
+        return stacked(rows, axis: 0)
+    }
+
+    private static func checkedProduct(_ factors: [Int]) -> Int? {
+        var value = 1
+        for factor in factors {
+            guard let next = checkedMultiply(value, factor) else {
+                return nil
+            }
+            value = next
+        }
+        return value
+    }
+
+    private static func checkedSum(_ values: [Int]) -> Int? {
+        var total = 0
+        for value in values {
+            guard let next = checkedAdd(total, value) else {
+                return nil
+            }
+            total = next
+        }
+        return total
+    }
+
+    private static func checkedMultiply(_ lhs: Int, _ rhs: Int) -> Int? {
+        let (value, overflow) = lhs.multipliedReportingOverflow(by: rhs)
+        return overflow ? nil : value
+    }
+
+    private static func checkedAdd(_ lhs: Int, _ rhs: Int) -> Int? {
+        let (value, overflow) = lhs.addingReportingOverflow(rhs)
+        return overflow ? nil : value
+    }
+}
diff --git a/Libraries/MLXLLM/Models/Qwen35ArtifactProjectionBatchPolicy.swift b/Libraries/MLXLLM/Models/Qwen35ArtifactProjectionBatchPolicy.swift
new file mode 100644
index 0000000..3b6af77
--- /dev/null
+++ b/Libraries/MLXLLM/Models/Qwen35ArtifactProjectionBatchPolicy.swift
@@ -0,0 +1,96 @@
+import Foundation
+
+/// Default-off resource policy for cross-layer artifact projection batching.
+///
+/// The suffix-frontier path leaves historical hidden rows unchanged across
+/// skipped layers. When explicitly armed, those independent projection
+/// families may share gathered quantized-matmul launches. The policy bounds
+/// both the lazy transient graph and the one-time immutable weight stacks.
+public struct Qwen35ArtifactProjectionBatchPolicy: Equatable, Sendable {
+    public static let enabledEnvironmentKey =
+        "DARKBLOOM_QWEN35_PREFILL_ARTIFACT_PROJECTION_BATCH"
+    public static let transientMiBEnvironmentKey =
+        "DARKBLOOM_QWEN35_PREFILL_ARTIFACT_PROJECTION_BATCH_MIB"
+
+    /// E51 B1x512 has 320 historical rows. At the 35B target geometry, all
+    /// skipped-layer normalized inputs and qkv/a/b/k/v outputs total
+    /// 186.68 MiB, so 192 MiB admits one cross-layer batch with 5.32 MiB of
+    /// headroom. Larger rectangles are split at layer boundaries.
+    public static let defaultMaximumTransientMiB = 192
+    public static let minimumTransientMiB = 16
+    public static let maximumTransientMiB = 512
+
+    /// The 40-layer 4-bit affine target needs about 283 MiB for packed
+    /// qkv/a/b/k/v weights plus scales and quantization biases. Refuse other
+    /// geometries/precisions that exceed this bound instead of silently
+    /// creating an unsafe persistent duplicate.
+    public static let maximumStackedWeightBytes = 320 * 1_024 * 1_024
+
+    /// Gather-QMM may choose a different reduction association from one
+    /// quantizedMM per layer. Raw artifact projections must remain within
+    /// these bounds relative to the sequential quantized reference.
+    public static let artifactRelativeTolerance = 1e-4
+    public static let artifactAbsoluteTolerance = 1e-5
+
+    public static let disabled = Qwen35ArtifactProjectionBatchPolicy()
+
+    public let isEnabled: Bool
+    public let maximumTransientBytes: Int
+
+    private init(
+        isEnabled: Bool = false,
+        maximumTransientBytes: Int = 0
+    ) {
+        self.isEnabled = isEnabled
+        self.maximumTransientBytes = maximumTransientBytes
+    }
+
+    /// Resolve process-start knobs. The enable flag is mandatory and strict;
+    /// an invalid byte budget disables the whole batching mechanism while
+    /// leaving the established sequential suffix-frontier path available.
+    public static func fromEnvironment(
+        _ environment: [String: String] = ProcessInfo.processInfo.environment
+    ) -> Qwen35ArtifactProjectionBatchPolicy {
+        guard
+            let rawEnabled = environment[enabledEnvironmentKey],
+            parseEnabled(rawEnabled)
+        else {
+            return .disabled
+        }
+
+        let maximumMiB: Int
+        if let rawMiB = environment[transientMiBEnvironmentKey] {
+            guard
+                let parsed = Int(
+                    rawMiB.trimmingCharacters(in: .whitespacesAndNewlines)),
+                (minimumTransientMiB ... maximumTransientMiB).contains(parsed)
+            else {
+                return .disabled
+            }
+            maximumMiB = parsed
+        } else {
+            maximumMiB = defaultMaximumTransientMiB
+        }
+
+        let (bytes, overflow) = maximumMiB.multipliedReportingOverflow(
+            by: 1_024 * 1_024)
+        guard !overflow else { return .disabled }
+        return Qwen35ArtifactProjectionBatchPolicy(
+            isEnabled: true,
+            maximumTransientBytes: bytes)
+    }
+
+    public var descriptor: String {
+        guard isEnabled else { return "disabled" }
+        return "gather_qmm=1;transient_mib=\(maximumTransientBytes / (1_024 * 1_024))"
+    }
+
+    private static func parseEnabled(_ raw: String) -> Bool {
+        switch raw.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() {
+        case "1", "true", "yes", "on":
+            true
+        default:
+            false
+        }
+    }
+}
diff --git a/Tests/MLXLMTests/Qwen35ArtifactProjectionBatchTests.swift b/Tests/MLXLMTests/Qwen35ArtifactProjectionBatchTests.swift
