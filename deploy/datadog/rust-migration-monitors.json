    "name": "[Rust migration] Availability error ratio by environment",
    "type": "query alert",
    "query": "sum(last_5m):sum:d_inference.rust.http.requests{service:d-inference-coordinator,env IN (development,production),status_class:5xx} by {env}.as_count() / sum:d_inference.rust.http.requests{service:d-inference-coordinator,env IN (development,production)} by {env}.as_count() > 0.05",
    "message": "Rust coordinator 5xx availability budget exceeded. Follow docs/operations/rust-coordinator-observability.md#availability.",
