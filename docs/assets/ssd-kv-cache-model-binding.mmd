flowchart TD
    A["Inference request<br/>verified model aggregate hash<br/>verified prompt contract"] --> B["Compute scoped canonical<br/>256-token block chain"]
    B --> C["Probe encrypted SSD index<br/>darkbloom/kv3/modelKey"]
    C --> MB{"Validate DBK3 binding<br/>model hash + contract ID<br/>layout epoch + block shape"}
    MB -->|"mismatch"| REJ1["Drop index entry<br/>cold prefill"]
    MB -->|"match"| DEC["Unwrap DEK and<br/>AES-256-GCM decrypt"]
    DEC --> AUTH{"AAD and chunk tags valid?"}
    AUTH -->|"no"| REJ2["Delete corrupt owned file<br/>cold prefill"]
    AUTH -->|"yes"| SEED["Stage exact block run<br/>engine recomputes required suffix"]

    classDef guard fill:#7c2d12,stroke:#fb923c,stroke-width:3px,color:#fff
    classDef reject fill:#450a0a,stroke:#ef4444,color:#fff
    classDef safe fill:#064e3b,stroke:#34d399,color:#fff
    class MB,AUTH guard
    class REJ1,REJ2 reject
    class SEED,DEC safe
