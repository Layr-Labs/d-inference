diff --git a/libs/lume/src/Unattended/GuestAgentInstall.swift b/libs/lume/src/Unattended/GuestAgentInstall.swift
new file mode 100644
index 0000000..cc2a088
--- /dev/null
+++ b/libs/lume/src/Unattended/GuestAgentInstall.swift
@@ -0,0 +1,209 @@
+import Foundation
+
+/// A guest-side agent baked into the installed macOS data volume, plus the
+/// LaunchDaemon that starts it.
+///
+/// Baking happens at the template layer on purpose. `lume clone` is an APFS
+/// clonefile of the whole VM directory, so an agent installed once into a base
+/// image appears in every clone at no per-clone cost and with no per-clone
+/// step that could fail.
+///
+/// The install is deliberately split across two privilege domains, because
+/// neither half can do the other's job. The offline patcher can write bytes at
+/// any mode into the mounted data volume but cannot set an owner: there is no
+/// `chown` anywhere in this source tree except one line of guest-side shell.
+/// The first-boot finalization script runs as root and already does exactly
+/// that `chown root:wheel` and a `launchctl enable`, so it takes ownership and
+/// enablement. This type carries the facts both halves need.
+struct GuestAgentInstall: Equatable, Sendable {
+    enum ValidationError: Error, Equatable, CustomStringConvertible {
+        case executableMissing(String)
+        case executableEmpty(String)
+        case absoluteInstallPath(String)
+        case emptyField(String)
+        case invalidPort(UInt32)
+        case invalidLabel(String)
+
+        var description: String {
+            switch self {
+            case .executableMissing(let path):
+                return "guest agent executable not found at \(path)"
+            case .executableEmpty(let path):
+                return "guest agent executable is empty at \(path)"
+            case .absoluteInstallPath(let path):
+                return
+                    "guest install path must be relative to the data volume, got \(path)"
+            case .emptyField(let name):
+                return "guest agent \(name) must not be empty"
+            case .invalidPort(let port):
+                return "guest agent port must be non-zero, got \(port)"
+            case .invalidLabel(let label):
+                return "guest agent launchd label is not well formed: \(label)"
+            }
+        }
+    }
+
+    /// Host path of the executable to copy in.
+    let executableURL: URL
+
+    /// Where it lands inside the guest, relative to the data volume root, so
+    /// it can be joined to the mount point without escaping it.
+    let installPath: String
+
+    /// launchd job label, also the plist filename.
+    let label: String
+
+    /// Account the daemon runs as. The unprivileged tenant, never the
+    /// bootstrap administrator: an agent running as the administrator could
+    /// rewrite the control path supervising it, which is the whole reason the
+    /// two accounts were split.
+    let runAsUsername: String
+
+    /// Directory the daemon's stdout and stderr are redirected to.
+    ///
+    /// It must be writable by `runAsUsername`. launchd opens these paths **as
+    /// the job's user** before the program runs, so a path under `/var/log`
+    /// fails the job with `EX_CONFIG` (78), respawns it forever, and writes no
+    /// log at all — the diagnostic that would explain the failure is the exact
+    /// thing that cannot be created. Measured on a real guest: 45 respawns and
+    /// climbing, with an empty log directory.
+    let logDirectory: String
+
+    /// vsock port the agent binds. Must match the host's `guestChannelPort`.
+    let port: UInt32
+
+    /// Value for `DARKBLOOM_GUEST_IMAGE_ID`, which the host compares against
+    /// the handshake. Every clone of a template shares it, which is correct:
+    /// it identifies the image, not the sandbox.
+    let imageID: String
+
+    /// Whether the baked agent will run commands at all.
+    ///
+    /// Off unless asked for, so an image becomes executable deliberately. The
+    /// agent reports it in its handshake, which is how a host decides whether
+    /// to route commands over the channel or fall back to SSH -- so an image
+    /// baked before this existed keeps working, over SSH, with no version
+    /// negotiation anywhere.
+    let executionEnabled: Bool
+
+    var installedAbsolutePath: String { "/" + installPath }
+    var daemonPlistPath: String { "Library/LaunchDaemons/\(label).plist" }
+    var logPath: String { "\(logDirectory)/\(label).log" }
+
+    /// Where `logDirectory` actually lives on the mounted data volume.
+    ///
+    /// `/var`, `/etc` and `/tmp` are symlinks into `private/` on a running
+    /// macOS system, but the mounted volume has no such links -- the real
+    /// directories are `private/var` and friends, which is why every other
+    /// path in the patcher is written that way. Creating the directory at the
+    /// guest's spelling puts it somewhere the guest cannot see, and the only
+    /// symptom is a first-boot `chown` failing on a path that looks correct.
+    var logDirectoryVolumePath: String {
+        Self.volumeRelativePath(logDirectory)
+    }
+
+    /// Rewrites a guest absolute path to its location on the mounted volume.
+    static func volumeRelativePath(_ guestPath: String) -> String {
+        let trimmed = String(guestPath.drop(while: { $0 == "/" }))
+        for linked in ["var", "etc", "tmp"] {
+            if trimmed == linked || trimmed.hasPrefix(linked + "/") {
+                return "private/" + trimmed
+            }
+        }
+        return trimmed
+    }
+
+    init(
+        executableURL: URL,
+        installPath: String = GuestAgentInstall.defaultInstallPath,
+        label: String = GuestAgentInstall.defaultLabel,
+        runAsUsername: String,
+        logDirectory: String = GuestAgentInstall.defaultLogDirectory,
+        port: UInt32,
+        imageID: String,
+        executionEnabled: Bool = false
+    ) throws {
+        guard !installPath.isEmpty, !installPath.hasPrefix("/") else {
+            throw ValidationError.absoluteInstallPath(installPath)
+        }
+        guard !runAsUsername.isEmpty else {
+            throw ValidationError.emptyField("run-as username")
+        }
+        guard !imageID.isEmpty else {
+            throw ValidationError.emptyField("image id")
+        }
+        guard !logDirectory.isEmpty, logDirectory.hasPrefix("/") else {
+            throw ValidationError.emptyField("log directory")
+        }
+        guard port > 0 else {
+            throw ValidationError.invalidPort(port)
+        }
+        guard Self.isWellFormedLabel(label) else {
+            throw ValidationError.invalidLabel(label)
+        }
+
+        let attributes = try? FileManager.default.attributesOfItem(
+            atPath: executableURL.path
+        )
+        guard let attributes else {
+            throw ValidationError.executableMissing(executableURL.path)
+        }
+        guard (attributes[.size] as? NSNumber)?.intValue ?? 0 > 0 else {
+            throw ValidationError.executableEmpty(executableURL.path)
+        }
+
+        self.executableURL = executableURL
+        self.installPath = installPath
+        self.label = label
+        self.runAsUsername = runAsUsername
+        self.logDirectory = logDirectory
+        self.port = port
+        self.imageID = imageID
+        self.executionEnabled = executionEnabled
+    }
+
+    static let defaultInstallPath = "usr/local/libexec/darkbloom-guest-agent"
+    static let defaultLabel = "dev.darkbloom.guest-agent"
+    /// Under `/var/db` rather than `/var/log`: see `logDirectory`.
+    static let defaultLogDirectory = "/var/db/darkbloom"
+    static let imageIDEnvironmentVariable = "DARKBLOOM_GUEST_IMAGE_ID"
+    /// The agent enables execution only on an exact "1", so a malformed value
+    /// leaves it refusing rather than running.
+    static let executionEnvironmentVariable = "DARKBLOOM_GUEST_ALLOW_EXECUTION"
+
+    /// A reverse-DNS-ish label, which is what `launchctl` addresses jobs by.
+    static func isWellFormedLabel(_ label: String) -> Bool {
+        guard !label.isEmpty, label.count <= 128 else { return false }
+        guard !label.hasPrefix("."), !label.hasSuffix(".") else { return false }
+        // Swift.Set qualified deliberately: lume defines its own `Set` command
+        // type, which shadows the standard library's here.
+        let allowed = Swift.Set<Character>(
+            "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-_"
+        )
+        return label.allSatisfy { allowed.contains($0) }
+            && label.contains(Character("."))
+    }
+
+    /// The LaunchDaemon job definition.
+    ///
+    /// `KeepAlive` is not optional. The agent binds vsock as the very first
+    /// thing it does and exits on failure with no retry, so a start that races
+    /// the virtio device leaves the job dead forever unless launchd restarts
+    /// it.
+    func daemonPlist() -> [String: Any] {
+        [
+            "Label": label,
+            "ProgramArguments": [installedAbsolutePath, String(port)],
+            "UserName": runAsUsername,
+            "RunAtLoad": true,
+            "KeepAlive": true,
+            "ThrottleInterval": 1,
+            "EnvironmentVariables": [
+                Self.imageIDEnvironmentVariable: imageID,
+                Self.executionEnvironmentVariable: executionEnabled ? "1" : "0",
+            ],
+            "StandardOutPath": logPath,
+            "StandardErrorPath": logPath,
+        ]
+    }
+}
