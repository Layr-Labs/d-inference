      "body": {"kind": "sse", "minimum_events": 2, "done": true, "content_matches": "content", "response_model": "trace_expected"}
    },
    "sent_unknown": {
      "statuses": [200],
      "headers": {"content-type": "application/json"},
      "body": {"kind": "json", "required": ["/object", "/choices/0"], "response_model": "trace_expected"},
      "implementation_overrides": {
        "rust": {
          "statuses": [499],
          "body": {"kind": "json", "required": ["/error"]}
