+    @Test func gatherSortScatterInverseExactlyMatchesLegacySecondSort() {
+        let topK = 8
+        let hidden = 4
+
+        // Cover the sorted-dispatch threshold, an irregular assignment
+        // count, and the target 2,048-token / 16,384-assignment shape.
+        for tokens in [8, 17, 2_048] {
+            let assignments = tokens * topK
+            let indices = MLXArray(
+                (0 ..< assignments).map {
+                    UInt32(($0 * 37 + ($0 / topK) * 11 + tokens) % 256)
+                }
+            ).reshaped(tokens, topK)
+            let x = MLXArray(0 ..< tokens * hidden)
+                .asType(.float32).reshaped(tokens, hidden)
+
+            let (_, _, inverseOrder) = gatherSort(
+                x: MLX.expandedDimensions(x, axes: [-2, -3]),
+                indices: indices)
+
+            // The removed implementation was `argSort(order)`. Keep it as
+            // the independent oracle and require exact integer equality.
+            let order = argSort(indices.flattened())
+            let legacyInverseOrder = argSort(order)
+
+            // Pin the actual consumer contract too: indexing sorted rows by
+            // the returned inverse restores original assignment order.
+            let original = MLXArray(0 ..< assignments * hidden)
+                .asType(.int32).reshaped(assignments, hidden)
+            let restored = scatterUnsort(x: original[order], invOrder: inverseOrder)
+            eval(inverseOrder, legacyInverseOrder, restored)
+
+            #expect(MLX.all(inverseOrder .== legacyInverseOrder).item(Bool.self))
+            #expect(MLX.all(restored .== original).item(Bool.self))
+        }
+    }
