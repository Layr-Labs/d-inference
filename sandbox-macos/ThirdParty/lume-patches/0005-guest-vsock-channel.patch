diff --git a/libs/lume/tests/GuestChannelCapabilityTests.swift b/libs/lume/tests/GuestChannelCapabilityTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..6557493fc65a67014ea0f9d7ac2a76519604fee8
--- /dev/null
+++ b/libs/lume/tests/GuestChannelCapabilityTests.swift
@@ -0,0 +1,148 @@
+import Darwin
+import Foundation
+import Testing
+
+@testable import lume
+
+private enum GuestChannelTestError: Error {
+  case socketPair
+  case pipe
+  case receiveFailed(Int32)
+  case noDescriptorReceived
+}
+
+private func makeGuestSocketPair() throws -> (owner: Int32, child: Int32) {
+  var descriptors = [Int32](repeating: -1, count: 2)
+  guard socketpair(AF_UNIX, SOCK_STREAM, 0, &descriptors) == 0 else {
+    throw GuestChannelTestError.socketPair
+  }
+  return (descriptors[0], descriptors[1])
+}
+
+private func aligned(_ size: Int) -> Int {
+  (size + 3) & ~3
+}
+
+/// Mirror of the sender's control-message geometry, written independently so
+/// the test would catch a sender that silently changed layout.
+private func receiveDescriptor(from socket: Int32) throws -> Int32 {
+  let headerSpace = aligned(MemoryLayout<cmsghdr>.size)
+  var control = [UInt8](repeating: 0, count: headerSpace + aligned(MemoryLayout<Int32>.size))
+  var payload: UInt8 = 0
+
+  let received: Int = control.withUnsafeMutableBytes { controlBuffer -> Int in
+    guard let controlBase = controlBuffer.baseAddress else { return -1 }
+    return withUnsafeMutablePointer(to: &payload) { payloadPointer -> Int in
+      var vector = iovec(
+        iov_base: UnsafeMutableRawPointer(payloadPointer),
+        iov_len: 1
+      )
+      return withUnsafeMutablePointer(to: &vector) { vectorPointer -> Int in
+        var message = msghdr()
+        message.msg_iov = vectorPointer
+        message.msg_iovlen = 1
+        message.msg_control = controlBase
+        message.msg_controllen = socklen_t(controlBuffer.count)
+        return recvmsg(socket, &message, 0)
+      }
+    }
+  }
+
+  guard received == 1 else {
+    throw GuestChannelTestError.receiveFailed(errno)
+  }
+
+  return try control.withUnsafeBytes { controlBuffer -> Int32 in
+    guard let controlBase = controlBuffer.baseAddress else {
+      throw GuestChannelTestError.noDescriptorReceived
+    }
+    let header = controlBase.assumingMemoryBound(to: cmsghdr.self)
+    guard header.pointee.cmsg_level == SOL_SOCKET,
+      header.pointee.cmsg_type == SCM_RIGHTS
+    else {
+      throw GuestChannelTestError.noDescriptorReceived
+    }
+    return
+      controlBase
+      .advanced(by: headerSpace)
+      .assumingMemoryBound(to: Int32.self)
+      .pointee
+  }
+}
+
+@Test("guest channel hands a working descriptor to the broker")
+func guestChannelSendsUsableDescriptor() throws {
+  let pair = try makeGuestSocketPair()
+  defer { close(pair.owner) }
+
+  let capability = try GuestChannelCapability(
+    fileDescriptor: pair.child,
+    port: 8888
+  )
+  #expect(capability.port == 8888)
+
+  var pipeDescriptors = [Int32](repeating: -1, count: 2)
+  guard pipe(&pipeDescriptors) == 0 else {
+    throw GuestChannelTestError.pipe
+  }
+  let readEnd = pipeDescriptors[0]
+  let writeEnd = pipeDescriptors[1]
+  defer {
+    close(readEnd)
+    close(writeEnd)
+  }
+
+  try capability.send(descriptor: readEnd)
+
+  let receivedDescriptor = try receiveDescriptor(from: pair.owner)
+  defer { close(receivedDescriptor) }
+  #expect(receivedDescriptor >= 0)
+  #expect(receivedDescriptor != readEnd)
+
+  // The received descriptor must refer to the same pipe, not a copy of the
+  // number: a byte written to the original write end has to read back out.
+  var outgoing: UInt8 = 0x42
+  #expect(write(writeEnd, &outgoing, 1) == 1)
+  var incoming: UInt8 = 0
+  #expect(read(receivedDescriptor, &incoming, 1) == 1)
+  #expect(incoming == 0x42)
+}
+
+@Test("guest channel sending fails after the capability is closed")
+func guestChannelRejectsSendAfterClose() throws {
+  let pair = try makeGuestSocketPair()
+  defer { close(pair.owner) }
+
+  let capability = try GuestChannelCapability(
+    fileDescriptor: pair.child,
+    port: 8888
+  )
+  capability.close()
+
+  var pipeDescriptors = [Int32](repeating: -1, count: 2)
+  guard pipe(&pipeDescriptors) == 0 else {
+    throw GuestChannelTestError.pipe
+  }
+  defer {
+    close(pipeDescriptors[0])
+    close(pipeDescriptors[1])
+  }
+
+  #expect(throws: (any Error).self) {
+    try capability.send(descriptor: pipeDescriptors[0])
+  }
+}
+
+@Test("guest channel rejects a reserved descriptor number")
+func guestChannelRejectsReservedDescriptor() {
+  #expect(throws: (any Error).self) {
+    _ = try GuestChannelCapability(fileDescriptor: STDERR_FILENO, port: 8888)
+  }
+}
+
+@Test("guest channel is absent without broker environment")
+func guestChannelAbsentWithoutEnvironment() throws {
+  unsetenv(GuestChannelCapability.environmentVariable)
+  unsetenv(GuestChannelCapability.portEnvironmentVariable)
+  #expect(try GuestChannelCapability.inherited() == nil)
+}
