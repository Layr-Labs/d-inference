diff --git a/libs/lume/tests/GuestAgentInstallTests.swift b/libs/lume/tests/GuestAgentInstallTests.swift
index f6c55f3..9aa9aa9 100644
--- a/libs/lume/tests/GuestAgentInstallTests.swift
+++ b/libs/lume/tests/GuestAgentInstallTests.swift
@@ -256,3 +256,43 @@ func isolatedNetworkModeAttachesNothing() throws {
     #expect(try BaseVirtualizationService.createNetworkDeviceConfiguration(
         macAddress: "aa:bb:cc:dd:ee:ff", networkMode: .nat) != nil)
 }
+
+@Test("the gateway mode round-trips and refuses to fall back")
+func gatewayNetworkModeRoundTrips() throws {
+    #expect(NetworkMode.parse("gateway") == NetworkMode.gateway)
+    #expect(NetworkMode.gateway.description == "gateway")
+    #expect(NetworkMode.gateway.configString == "gateway")
+
+    // The other modes keep their spellings.
+    #expect(NetworkMode.parse("none") == NetworkMode.isolated)
+    #expect(NetworkMode.parse("nat") == NetworkMode.nat)
+    #expect(NetworkMode.parse("gatewayx") == nil)
+}
+
+@Test("a gateway descriptor must be a datagram socket")
+func gatewayCapabilityRejectsAStreamSocket() throws {
+    // The attachment treats one datagram as exactly one Ethernet frame, so a
+    // stream socket would be accepted here and then deliver corrupt frames --
+    // a failure that looks like a broken guest rather than a wrong socket.
+    var pair: [Int32] = [0, 0]
+    #expect(socketpair(AF_UNIX, SOCK_STREAM, 0, &pair) == 0)
+    defer { close(pair[0]); close(pair[1]) }
+
+    setenv(NetworkGatewayCapability.environmentVariable, "\(pair[0])", 1)
+    defer { unsetenv(NetworkGatewayCapability.environmentVariable) }
+    #expect(throws: (any Error).self) {
+        _ = try NetworkGatewayCapability.inheritedDescriptor()
+    }
+
+    var datagramPair: [Int32] = [0, 0]
+    #expect(socketpair(AF_UNIX, SOCK_DGRAM, 0, &datagramPair) == 0)
+    defer { close(datagramPair[0]); close(datagramPair[1]) }
+    setenv(NetworkGatewayCapability.environmentVariable, "\(datagramPair[0])", 1)
+    #expect(try NetworkGatewayCapability.inheritedDescriptor() == datagramPair[0])
+}
+
+@Test("no inherited descriptor means no gateway, not a silent NAT")
+func gatewayWithoutADescriptorIsRefused() throws {
+    unsetenv(NetworkGatewayCapability.environmentVariable)
+    #expect(try NetworkGatewayCapability.inheritedDescriptor() == nil)
+}
