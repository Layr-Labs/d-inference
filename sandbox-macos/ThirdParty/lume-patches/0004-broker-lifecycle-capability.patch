+private func makeBrokerLifecycleCapability()
+  throws -> (owner: Int32, capability: BrokerLifecycleCapability)
+{
+  var descriptors = [Int32](repeating: -1, count: 2)
+  guard socketpair(AF_UNIX, SOCK_STREAM, 0, &descriptors) == 0 else {
+    throw POSIXError(.EIO)
+  }
+  do {
+    return (
+      descriptors[0],
+      try BrokerLifecycleCapability(fileDescriptor: descriptors[1])
+    )
+  } catch {
+    Darwin.close(descriptors[0])
+    Darwin.close(descriptors[1])
+    throw error
+  }
+}
