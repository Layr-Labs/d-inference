{
  "version": 1,
  "ignore_patterns": [
    "**/Tests/**/*.swift",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "rules": [
    {
      "name": "provider protocol",
      "source_patterns": ["provider-swift/Sources/ProviderCore/Protocol/**", "provider-swift/Tests/ProviderCoreTests/Fixtures/Protocol/**"],
      "docs_any_of": ["docs/reference/protocol-messages.md"]
    },
    {
      "name": "provider telemetry",
      "source_patterns": ["provider-swift/Sources/ProviderCore/Telemetry/**", "provider-swift/Sources/ProviderCore/Protocol/*Profile*", "provider-swift/Sources/ProviderCore/Protocol/Telemetry*", "console-ui/src/lib/telemetry-types.ts"],
      "docs_any_of": ["docs/reference/telemetry-schema.md", "docs/architecture/telemetry.md"]
    },
    {
      "name": "provider configuration",
      "source_patterns": ["provider-swift/Sources/ProviderCore/Config/**", "provider-swift/Sources/darkbloom/**"],
      "docs_any_of": ["docs/reference/configuration.md", "docs/provider/cli-reference.md"]
    },
    {
      "name": "native inference",
      "source_patterns": ["libs/**", "provider-swift/Sources/ProviderCore/Inference/**", "provider-swift/Sources/ProviderCore/MiMo/**"],
      "docs_any_of": ["docs/architecture/inference.md", "docs/architecture/native-block-inference.md"]
    },
    {
      "name": "provider memory and capacity",
      "source_patterns": ["provider-swift/Sources/ProviderCore/Inference/Memory/**", "provider-swift/Sources/ProviderCore/Inference/Performance/**", "scripts/serving_performance/**"],
      "docs_any_of": ["docs/architecture/hardware-support.md", "docs/developer/serving-performance-qualification.md"]
    },
    {
      "name": "provider SSD prefix cache",
      "source_patterns": ["provider-swift/Sources/ProviderCore/KVCacheSSD/**", "provider-swift/Sources/ProviderCore/Inference/PrefixCache/**"],
      "docs_any_of": ["docs/reference/ssd-kv-cache.md", "docs/architecture/prefix-cache.md"]
    },
    {
      "name": "cache storage privacy",
      "source_patterns": ["provider-swift/Sources/ProviderCore/KVCacheSSD/Cache*", "provider-swift/Sources/ProviderCore/KVCacheSSD/SSDNoFollowIO.swift", "provider-swift/Sources/ProviderCore/KVCacheSSD/*Key*", "provider-swift/Sources/ProviderCore/KVCacheSSD/*WriteBudget*", "provider-swift/Sources/ProviderCore/Config/CacheSettings.swift", "provider-swift/Sources/darkbloom/Cache/**"],
      "docs_any_of": ["docs/provider/cache-storage.md", "docs/architecture/security/encryption.md"]
    },
    {
      "name": "provider privacy and trust",
      "source_patterns": ["provider-swift/Sources/ProviderCore/Security/**", "provider-swift/Sources/ProviderCore/Crypto/**", "provider-swift/Sources/ProviderAppAttest/**", "scripts/prepare-app-attest-entitlements.py", "provider-swift/entitlements*.plist"],
      "docs_any_of": ["docs/architecture/security/encryption.md", "docs/architecture/security/attestation.md", "docs/architecture/security/identity-binding.md", "docs/architecture/security/provider-trust.md", "docs/provider/attestation.md", "docs/threat-model.yaml"]
    },
    {
      "name": "provider model manifests",
      "source_patterns": ["provider-swift/Sources/ProviderCoreFoundation/**", "provider-swift/Sources/ProviderCore/Models/**", "provider-swift/Sources/darkbloom-publish/**", "scripts/publish-model*", "scripts/preposition-rollback-build.sh"],
      "docs_any_of": ["docs/reference/model-registry-format.md", "docs/architecture/model-registry.md", "docs/operations/model-migration.md", "docs/operations/model-revisions.md"]
    },
    {
      "name": "provider release",
      "source_patterns": [".github/workflows/release-swift.yml", ".github/workflows/provider-release*.yml", ".github/workflows/provider-signing-validation.yml", ".github/actions/provider-release-build/**", "provider-swift/Sources/ProviderCore/ProviderCore.swift", "scripts/install.sh", "scripts/admin.sh", "scripts/check-release-version.sh", "scripts/resolve-provider-release.sh", "scripts/provider-release*", "scripts/provider_release*", "scripts/provider-signing-validation.py", "scripts/prepare-provider-release-toolchain.sh"],
      "docs_any_of": ["docs/operations/provider-release.md"]
    },
    {
      "name": "provider Autopilot",
      "source_patterns": ["provider-swift/Sources/ProviderCore/Autopilot/**", "provider-swift/Sources/darkbloom/Autopilot/**", "provider-swift/Sources/darkbloom/Start/StartCommand+Autopilot.swift"],
      "docs_any_of": ["docs/architecture/model-autopilot.md"]
    },
    {
      "name": "provider local API",
      "source_patterns": ["provider-swift/Sources/ProviderCore/Server/**", "provider-swift/Sources/darkbloom/Local*"],
      "docs_any_of": ["docs/provider/direct-mode.md", "docs/reference/protocol-messages.md"]
    },
    {
      "name": "public fixtures and qualification",
      "source_patterns": ["fixtures/**", "provider-swift/Tests/ProviderCoreTests/Fixtures/**", "scripts/verify*prompt*", "scripts/prepare-mimo*", "scripts/generate*prompt*", "scripts/qualify*", "provider-swift/Tests/test_protocol_fixture_resources.py"],
      "docs_any_of": ["docs/developer/test.md", "docs/developer/mimo-prompt-fixtures.md", "docs/developer/serving-performance-qualification.md"]
    },
    {
      "name": "build and test tooling",
      "source_patterns": ["Makefile", "mise.toml", ".githooks/**", ".github/dependabot.yml", ".github/workflows/ci.yml", ".github/workflows/component-changes.yml", ".github/actions/provider-ci-build/**", "scripts/ci-component-paths.py", "scripts/test-ci-component-paths.py", "scripts/docs-*", "scripts/test-docs-*", "scripts/run-*", "scripts/stage-*", "scripts/fetch-metallib.sh", "scripts/provider-ci-cache.py", "provider-swift/Package.swift", ".gitmodules"],
      "docs_any_of": ["docs/developer/build.md", "docs/developer/test.md"]
    },
    {
      "name": "landing",
      "source_patterns": ["landing/src/**", "landing/package*.json", "landing/next.config.*", "landing/vercel.json", ".github/workflows/landing.yml"],
      "docs_any_of": ["landing/README.md", "docs/developer/build.md", "docs/developer/test.md"]
    },
    {
      "name": "retained console",
      "source_patterns": ["console-ui/src/**", "console-ui/package*.json", "console-ui/next.config.*", "console-ui/tsconfig.json", "console-ui/vercel.json"],
      "docs_any_of": ["docs/architecture/components/console-ui.md", "docs/reference/configuration.md"]
    },
    {
      "name": "console protocol fixtures",
      "source_patterns": ["coordinator/tests/protocol/testdata/paged_footprint_wire.json", "coordinator/tests/protocol/testdata/process_memory_wire.json"],
      "docs_any_of": ["docs/developer/test.md", "docs/reference/protocol-messages.md"]
    },
    {
      "name": "repository ownership",
      "source_patterns": ["AGENTS.md", "CONTRIBUTING.md", ".agents/skills/darkbloom-contributor/**"],
      "docs_any_of": ["docs/developer/navigation.md"]
    }
  ]
}
