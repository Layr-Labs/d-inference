diff --git a/libs/lume/tests/BrokerLifecycleCapabilityTests.swift b/libs/lume/tests/BrokerLifecycleCapabilityTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..f0a4b6fd773abe2cfc60b22a82b214c29c3f8522
--- /dev/null
+++ b/libs/lume/tests/BrokerLifecycleCapabilityTests.swift
@@ -0,0 +1,84 @@
+import Darwin
+import Dispatch
+import Foundation
+import Testing
+
+@testable import lume
+
+private enum BrokerCapabilityTestError: Error {
+  case socketPair
+}
+
+private final class CapabilityFailStopProbe: @unchecked Sendable {
+  private let lock = NSLock()
+  private var count = 0
+  private var mainThread = false
+
+  var fireCount: Int {
+    lock.withLock { count }
+  }
+
+  var firedOnMainThread: Bool {
+    lock.withLock { mainThread }
+  }
+
+  func fire() {
+    lock.withLock {
+      count += 1
+      mainThread = mainThread || Thread.isMainThread
+    }
+  }
+}
+
+private func makeBrokerSocketPair() throws -> (owner: Int32, child: Int32) {
+  var descriptors = [Int32](repeating: -1, count: 2)
+  guard socketpair(AF_UNIX, SOCK_STREAM, 0, &descriptors) == 0 else {
+    throw BrokerCapabilityTestError.socketPair
+  }
+  return (descriptors[0], descriptors[1])
+}
+
+@Test("an endpoint closed before monitoring latches a broker stop request")
+func immediateBrokerEndpointClosureIsSticky() throws {
+  let descriptors = try makeBrokerSocketPair()
+  Darwin.close(descriptors.owner)
+  let capability = try BrokerLifecycleCapability(
+    fileDescriptor: descriptors.child,
+    failStopDeadline: .seconds(30),
+    failStopAction: {})
+  let requested = DispatchSemaphore(value: 0)
+
+  capability.installStopHandler {
+    requested.signal()
+  }
+
+  #expect(requested.wait(timeout: .now() + 2) == .success)
+  #expect(capability.isStopRequested)
+  capability.cancelFailStopAfterNoStartProof()
+}
+
+@MainActor
+@Test("broker fail-stop fires without MainActor progress")
+func brokerFailStopDoesNotDependOnMainActorProgress() throws {
+  let descriptors = try makeBrokerSocketPair()
+  Darwin.close(descriptors.owner)
+  let probe = CapabilityFailStopProbe()
+  let capability = try BrokerLifecycleCapability(
+    fileDescriptor: descriptors.child,
+    failStopDeadline: .milliseconds(50),
+    failStopAction: { probe.fire() })
+
+  Darwin.usleep(150_000)
+
+  #expect(capability.isStopRequested)
+  #expect(probe.fireCount == 1)
+  #expect(!probe.firedOnMainThread)
+}
+
+private extension NSLock {
+  func withLock<T>(_ operation: () -> T) -> T {
+    lock()
+    defer { unlock() }
+    return operation()
+  }
+}
