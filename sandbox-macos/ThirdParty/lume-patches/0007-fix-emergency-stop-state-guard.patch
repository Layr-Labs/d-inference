+@MainActor
+@Test("a live guest whose stop fails still fail-stops")
+func liveGuestWithFailingStopStillFailStops() async throws {
+    let (root, context) = try makeEmergencyStopTestDirectory()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    let service = MockVMVirtualizationService()
+    var failStopReasons: [VMOwnerFailStopReason] = []
+    let vm = makeCapturingVM(context: context, service: service) {
+        failStopReasons.append($0)
+    }
+
+    let runTask = Task {
+        try await vm.run(displayMode: .none, sharedDirectories: [], mount: nil)
+    }
+    try await waitUntilReady { service.state == .running }
+
+    // The guest is Running, the stop is refused, and nothing else will take it
+    // down. This is the case the fail-stop exists for and it must not be
+    // weakened by the fix: narrowing the guard must not mean tolerating a
+    // guest that really is still alive.
+    await service.configure(
+        shouldFail: true,
+        error: VMError.internalError("deterministic stop failure"))
+    runTask.cancel()
+    _ = try? await runTask.value
+
+    #expect(failStopReasons.count == 1, "a live guest with a failed stop must fail closed")
+    #expect(service.state == .running)
+}
