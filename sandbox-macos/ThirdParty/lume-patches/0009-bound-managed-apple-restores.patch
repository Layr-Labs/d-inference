diff --git a/libs/lume/tests/MacOSInstallationOperationTests.swift b/libs/lume/tests/MacOSInstallationOperationTests.swift
new file mode 100644
index 0000000..e0d07d6
--- /dev/null
+++ b/libs/lume/tests/MacOSInstallationOperationTests.swift
@@ -0,0 +1,137 @@
+import Foundation
+import Testing
+@testable import lume
+
+private final class FakeMacOSInstallation: MacOSInstallationDriver, @unchecked Sendable {
+    let progress = Progress(totalUnitCount: 1)
+    let starts: AsyncStream<Void>
+    let cancellations: AsyncStream<Void>
+    private let startSignal: AsyncStream<Void>.Continuation
+    private let cancelSignal: AsyncStream<Void>.Continuation
+    private let lock = NSLock()
+    private var callback: (@Sendable (Result<Void, Error>) -> Void)?
+    private var startCount = 0
+    private var cancelCount = 0
+    private var cancelledBeforeStart = false
+    var synchronousCompletion = false
+
+    init() {
+        (starts, startSignal) = AsyncStream.makeStream(of: Void.self)
+        (cancellations, cancelSignal) = AsyncStream.makeStream(of: Void.self)
+        progress.cancellationHandler = { [weak self] in self?.cancelled() }
+    }
+    func install(completion: @escaping @Sendable (Result<Void, Error>) -> Void) {
+        lock.lock(); startCount += 1; callback = completion; lock.unlock()
+        startSignal.yield(())
+        if synchronousCompletion { completion(.success(())) }
+    }
+    private func cancelled() {
+        lock.lock(); cancelCount += 1; cancelledBeforeStart = startCount == 0; lock.unlock()
+        cancelSignal.yield(())
+    }
+    func complete(_ result: Result<Void, Error>) {
+        lock.lock(); let callback = callback; lock.unlock(); callback?(result)
+    }
+    var facts: (starts: Int, cancels: Int, prematureCancel: Bool) {
+        lock.lock(); defer { lock.unlock() }; return (startCount, cancelCount, cancelledBeforeStart)
+    }
+}
+
+@Test("restore cancellation before installation never cancels unstarted Progress")
+func restoreCancelBeforeInstallation() async {
+    let driver = FakeMacOSInstallation()
+    let operation = MacOSInstallationOperation(queue: DispatchQueue(label: "restore-before"), makeDriver: { driver })
+    operation.requestCancellation()
+    do { try await operation.run(); Issue.record("cancelled operation succeeded") }
+    catch { #expect(error is CancellationError) }
+    #expect(driver.facts.starts == 0 && driver.facts.cancels == 0)
+}
+
+@Test("broker restore cancellation waits for installer completion before returning")
+func restoreCancellationWaitsForInstallerCompletion() async throws {
+    let driver = FakeMacOSInstallation()
+    let operation = MacOSInstallationOperation(queue: DispatchQueue(label: "restore-active"), makeDriver: { driver })
+    let task = Task { try await operation.run() }
+    var started = driver.starts.makeAsyncIterator(); await started.next()
+    operation.requestCancellation(); operation.requestCancellation()
+    var cancelled = driver.cancellations.makeAsyncIterator(); await cancelled.next()
+    #expect(driver.facts.cancels == 1 && !driver.facts.prematureCancel)
+    let returnedEarly = await withTaskGroup(of: Bool.self) { group in
+        group.addTask { _ = await task.result; return true }
+        group.addTask { try? await Task.sleep(for: .milliseconds(20)); return false }
+        let first = await group.next() ?? true
+        driver.complete(.success(()))
+        group.cancelAll()
+        while await group.next() != nil {}
+        return first
+    }
+    #expect(!returnedEarly, "cancellation must wait for the framework completion callback")
+    do { try await task.value; Issue.record("cancelled operation succeeded") }
+    catch { #expect(error is CancellationError) }
+}
+
+@Test("Swift task cancellation uses the same installer Progress path")
+func restoreTaskCancellationCancelsProgress() async throws {
+    let driver = FakeMacOSInstallation()
+    let operation = MacOSInstallationOperation(queue: DispatchQueue(label: "restore-task"), makeDriver: { driver })
+    let task = Task { try await operation.run() }
+    var started = driver.starts.makeAsyncIterator(); await started.next(); task.cancel()
+    var cancelled = driver.cancellations.makeAsyncIterator(); await cancelled.next()
+    #expect(driver.facts.cancels == 1 && !driver.facts.prematureCancel)
+    driver.complete(.failure(CancellationError()))
+    do { try await task.value; Issue.record("cancelled task succeeded") }
+    catch { #expect(error is CancellationError) }
+}
+
+@Test("completed restore never cancels installer Progress afterward")
+func restoreCompletionPrecedesLateCancellation() async throws {
+    let driver = FakeMacOSInstallation(); driver.synchronousCompletion = true
+    let queue = DispatchQueue(label: "restore-complete")
+    let operation = MacOSInstallationOperation(queue: queue, makeDriver: { driver })
+    try await operation.run(); operation.requestCancellation(); queue.sync {}
+    #expect(driver.facts.starts == 1 && driver.facts.cancels == 0)
+}
+
+@Test("installer creation failure preserves the error without starting Progress")
+func restoreDriverCreationFailure() async {
+    struct Failure: Error {}
+    let operation = MacOSInstallationOperation(queue: DispatchQueue(label: "restore-factory"), makeDriver: { throw Failure() })
+    do { try await operation.run(); Issue.record("failed factory succeeded") }
+    catch { #expect(error is Failure) }
+}
+
+@Test("managed restore rejects partial authority, tenant profiles and unattended setup")
+@MainActor
+func managedRestoreInvocationIsRawAndFullyAuthorized() throws {
+    #expect(try ManagedRestoreContext.validateInvocation(profile: nil, os: "macOS", unattended: true,
+        hasAuthority: false, hasLifecycle: false, hasDeviceProfile: false) == false)
+    #expect(try ManagedRestoreContext.validateInvocation(profile: "apple-v1", os: "macOS", unattended: false,
+        hasAuthority: true, hasLifecycle: true, hasDeviceProfile: false))
+    for (profile, os, unattended, authority, lifecycle, device) in [
+        (Optional("apple-v1"), "linux", false, true, true, false),
+        (Optional("apple-v1"), "macOS", true, true, true, false),
+        (Optional("apple-v1"), "macOS", false, false, true, false),
+        (Optional("apple-v1"), "macOS", false, true, false, false),
+        (Optional("apple-v1"), "macOS", false, true, true, true),
+        (nil, "macOS", false, true, true, false),
+        (Optional("unknown"), "macOS", false, true, true, false),
+    ] {
+        #expect(throws: (any Error).self) {
+            try ManagedRestoreContext.validateInvocation(profile: profile, os: os, unattended: unattended,
+                hasAuthority: authority, hasLifecycle: lifecycle, hasDeviceProfile: device)
+        }
+    }
+}
+
+@Test("installer owner remains retained and files protected until stopped proof")
+@MainActor
+func managedRestoreRequiresStoppedProofBeforeCleanup() {
+    let proof = ManagedRestoreCleanupProof()
+    weak var observed: NSObject?
+    do { let owner = NSObject(); observed = owner; proof.retain(owner) }
+    #expect(observed != nil && !proof.isSafeToRemove)
+    // Framework completion or a failed stop does not call recordStopped.
+    #expect(observed != nil && !proof.isSafeToRemove)
+    proof.recordStopped()
+    #expect(observed == nil && proof.isSafeToRemove)
+}
