#!/usr/bin/env bash
#
# Pre-commit hook for d-inference.
# Checks formatting on staged files only. Skips checks when no relevant files are staged.
#
# Install: git config core.hooksPath .githooks
#

set -euo pipefail

FAILED=0

# Check staged Go bytes, including partially staged files and paths with spaces.
# Working-tree formatting can differ from the exact blob about to be committed.
while IFS= read -r -d '' file; do
    if ! formatting=$(git show ":$file" | gofmt -d); then
        echo "ERROR: Could not check staged Go file: $file" >&2
        FAILED=1
    elif [ -n "$formatting" ]; then
        echo "ERROR: Staged Go file needs formatting: $file" >&2
        echo "Run gofmt -w on the file and stage the formatted changes." >&2
        FAILED=1
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- \
    'coordinator/**.go' 'e2e/**.go')

# ---------------------------------------------------------------------------
# TypeScript — next lint in console-ui/ if any .ts/.tsx files are staged
# ---------------------------------------------------------------------------
TS_FILES=$(git diff --cached --name-only --diff-filter=ACM -- 'console-ui/**.ts' 'console-ui/**.tsx' | grep -E '\.(ts|tsx)$' || true)

if [ -n "$TS_FILES" ]; then
    echo ">> Checking TypeScript lint (eslint)..."
    if ! (cd console-ui && npx eslint src/ 2>/dev/null); then
        echo ""
        echo "ERROR: TypeScript lint errors in console-ui/."
        echo ""
        echo "Fix with:  cd console-ui && npx eslint --fix src/"
        echo ""
        FAILED=1
    fi
fi

# ---------------------------------------------------------------------------
# Swift — skipped (no standard enforced formatter)
# ---------------------------------------------------------------------------

if [ "$FAILED" -ne 0 ]; then
    echo "Pre-commit checks failed. Please fix the issues above and try again."
    exit 1
fi
