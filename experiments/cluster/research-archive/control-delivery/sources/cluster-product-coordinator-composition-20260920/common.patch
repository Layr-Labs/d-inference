+			m := f.read(t, rank, protocol.TypeNativePairMeshReply)
+			b, _ := m.PayloadBytes()
+			value, e := protocol.DecodeNativePairMeshPacket(b, digest, uint8(rank), round, true)
+			if e != nil || !bytes.Equal(value, append(meshValue(0, round), meshValue(1, round)...)) {
