@@ -0,0 +1,100 @@
+import Foundation
+
+enum VMStopError: Error, Equatable {
+    case callbackTimedOut
+    case terminalStateUnproven
+}
+
+/// All callers await one native operation. Cancelling a caller cannot cancel
+/// the stop or authorize another framework transition while it is in flight.
+@MainActor
+final class VMStopCoordinator {
+    private let timeoutSeconds: TimeInterval
+    private var attempt: VMStopAttempt?
+
+    init(timeoutSeconds: TimeInterval = 15) {
+        self.timeoutSeconds = timeoutSeconds
+    }
+
+    func stop(
+        operation: (@escaping @Sendable (Result<Void, Error>) -> Void) -> Void
+    ) async throws {
+        let current: VMStopAttempt
+        if let existing = attempt, !existing.nativeFailed {
+            current = existing
+        } else {
+            current = VMStopAttempt(timeoutSeconds: timeoutSeconds)
+            attempt = current
+            operation { current.complete($0) }
+        }
+        do {
+            try await current.wait()
+        } catch {
+            // An expired waiter is not a completed native stop. Keep its
+            // attempt so retries cannot issue another overlapping VZ.stop.
+            if current.nativeFailed, attempt === current { attempt = nil }
+            throw error
+        }
+    }
+}
+
+private final class VMStopAttempt: @unchecked Sendable {
+    private let lock = NSLock()
+    private var nativeResult: Result<Void, Error>?
+    private var expired = false
+    private var waiters: [CheckedContinuation<Void, Error>] = []
+    private var deadline: DispatchWorkItem?
+
+    init(timeoutSeconds: TimeInterval) {
+        let deadline = DispatchWorkItem { [weak self] in self?.expire() }
+        self.deadline = deadline
+        DispatchQueue.global(qos: .userInitiated).asyncAfter(
+            deadline: .now() + timeoutSeconds, execute: deadline)
+    }
+
+    var nativeFailed: Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        if case .failure = nativeResult { return true }
+        return false
+    }
+
+    func wait() async throws {
+        // No cancellation handler: stopping the VM is required even after
+        // every original caller has been cancelled.
+        try await withCheckedThrowingContinuation { continuation in
+            lock.lock()
+            let result = nativeResult ?? (expired ? .failure(VMStopError.callbackTimedOut) : nil)
+            if let result {
+                lock.unlock()
+                continuation.resume(with: result)
+            } else {
+                waiters.append(continuation)
+                lock.unlock()
+            }
+        }
+    }
+
+    func complete(_ result: Result<Void, Error>) {
+        lock.lock()
+        guard nativeResult == nil else { lock.unlock(); return }
+        nativeResult = result
+        let pending = waiters
+        waiters.removeAll()
+        let deadline = self.deadline
+        self.deadline = nil
+        lock.unlock()
+        deadline?.cancel()
+        pending.forEach { $0.resume(with: result) }
+    }
+
+    private func expire() {
+        lock.lock()
+        guard nativeResult == nil, !expired else { lock.unlock(); return }
+        expired = true
+        let pending = waiters
+        waiters.removeAll()
+        lock.unlock()
+        pending.forEach { $0.resume(throwing: VMStopError.callbackTimedOut) }
+    }
+}
