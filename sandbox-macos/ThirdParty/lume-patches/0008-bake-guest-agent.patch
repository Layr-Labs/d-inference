+@MainActor
+@Test("the finalization script actually contains the agent commands")
+func finalizationScriptSplicesTheAgentBlock() throws {
+    let (root, binary) = try makeExecutable()
+    defer { try? FileManager.default.removeItem(at: root) }
+    let install = try makeInstall(executable: binary)
+
+    let script = UnattendedInstaller.guestFinalizationScript(
+        for: GuestIdentity.defaultBootstrap,
+        agent: install
+    )
+
+    // Every existing test checks the command builder in isolation or the
+    // script with no agent. Nothing checked that the two are joined, which is
+    // the only thing that makes the agent's ownership correct on a real guest.
+    #expect(script.contains("chown root:wheel /usr/local/libexec/darkbloom-guest-agent"))
+    #expect(script.contains("chown root:wheel /Library/LaunchDaemons/\(install.label).plist"))
+    #expect(script.contains("chown sandbox \(install.logDirectory)"))
+    #expect(script.contains("launchctl enable system/\(install.label)"))
+    // The marker stat has to stay last: the installer asserts on its output.
+    let marker = try #require(script.range(of: "MARKER_OWNER"))
+    let chown = try #require(script.range(of: "chown root:wheel /usr/local/libexec"))
+    #expect(chown.lowerBound < marker.lowerBound)
+}
