#!/usr/bin/env bash
#
# Pre-push hook for d-inference.
# Runs the same checks as CI before pushing to catch failures locally.
#
# Install: git config core.hooksPath .githooks
#

set -euo pipefail

FAILED=0

# Inspect every pushed ref. New branches compare commits absent from the remote,
# not the commit against the clean working tree (which reports no changes).
REMOTE="$1"
CHANGED_FILES=$(
    while read -r local_ref local_sha remote_ref remote_sha; do
        if [[ "$local_sha" =~ ^0+$ ]]; then
            continue  # deleting branch
        fi
        if [[ "$remote_sha" =~ ^0+$ ]]; then
            git rev-list "$local_sha" --not "--remotes=$REMOTE" |
                git diff-tree --stdin --no-commit-id --name-only --root -r -m || exit 1
        else
            git diff --name-only "$remote_sha" "$local_sha" || exit 1
        fi
    done
)

HAS_GO=$(echo "$CHANGED_FILES" | grep -q '^coordinator/' && echo 1 || echo 0)
HAS_TS=$(echo "$CHANGED_FILES" | grep -q '^console-ui/' && echo 1 || echo 0)

# ---------------------------------------------------------------------------
# Go — formatting + tests
# ---------------------------------------------------------------------------
if [ "$HAS_GO" = "1" ]; then
    echo ">> [pre-push] Go formatting check..."
    if ! UNFORMATTED=$(cd coordinator && gofmt -l .); then
        echo "ERROR: Go formatting check could not run."
        FAILED=1
    elif [ -n "$UNFORMATTED" ]; then
        echo "ERROR: Unformatted Go files:"
        echo "$UNFORMATTED" | sed 's/^/  /'
        echo "Fix with: cd coordinator && gofmt -w ."
        FAILED=1
    fi

    echo ">> [pre-push] Go tests..."
    # API packages live directly under coordinator; run the full package set.
    if ! (cd coordinator && go test ./... 2>&1 | tail -15); then
        echo "ERROR: Go tests failed."
        FAILED=1
    fi
fi

# ---------------------------------------------------------------------------
# TypeScript — lint + build
# ---------------------------------------------------------------------------
if [ "$HAS_TS" = "1" ]; then
    echo ">> [pre-push] TypeScript lint check..."
    if ! (cd console-ui && npx eslint --quiet src/ 2>&1 | tail -10); then
        echo "ERROR: TypeScript lint failed. Fix with: cd console-ui && npx eslint --fix src/"
        FAILED=1
    fi

    echo ">> [pre-push] Next.js build check..."
    if ! (cd console-ui && npm run build 2>&1 | tail -10); then
        echo "ERROR: Next.js build failed."
        FAILED=1
    fi
fi

if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo "Pre-push checks failed. Fix the issues above before pushing."
    exit 1
fi

echo ">> [pre-push] All checks passed."
