+    func testEngineMarksSuffixWhenItCrossesAnIntermediateChunkBoundary() async throws {
+        let base = TinyTestModel.make(seed: hiddenSeed)
+        let model = CBv2SuffixFrontierRecordingModel(base, tokenCount: 10)
+        // Prompt 22 / chunk 8 => [0,8), [8,16), [16,22). The final ten
+        // rows start at 12, so four belong to the second (intermediate)
+        // chunk and six belong to the terminal chunk.
+        let prompt = makePromptTokens(length: 22, seed: 701)
+        let engine = makeEngine(model: model, base: base, prefillChunkSize: 8)
+
+        let collected = await cbv2SchedCollect(
+            try engine.submit(
+                CBv2Request(
+                    id: CBv2RequestID(1), promptTokens: prompt,
+                    sampling: .init(temperature: 0), maxTokens: 4)))
+        await engine.shutdown()
+        XCTAssertEqual(collected.finishReason, .length)
+
+        let prefills = model.log.compactMap { entry -> CBv2PrefillCall? in
+            if case .prefill(let call) = entry { return call }
+            return nil
+        }
+        XCTAssertEqual(prefills.map(\.tokenShape), [[1, 8], [1, 8], [1, 6]])
+        XCTAssertEqual(
+            prefills.map(\.requirement),
+            [
+                .evaluationOnly,
+                .evaluationOnlyWithFullDepthSuffix(tokenCount: 4),
+                .lastPositionLogitsWithFullDepthSuffix(tokenCount: 6),
+            ])
+    }
