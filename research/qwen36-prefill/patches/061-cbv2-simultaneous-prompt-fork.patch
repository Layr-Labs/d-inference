@@ -0,0 +1,147 @@
+import MLX
+import XCTest
+
+@testable import MLXLMCommon
+
+final class CBv2PromptForkPrimitiveTests: XCTestCase {
+    func testExperimentDefaultsOffAndRecognizesOnlyExplicitOptIn() {
+        XCTAssertFalse(CBv2PromptForkExperiment.environmentEnabled([:]))
+        XCTAssertFalse(
+            CBv2PromptForkExperiment.environmentEnabled([
+                CBv2PromptForkExperiment.environmentKey: "disabled"
+            ]))
+        XCTAssertTrue(
+            CBv2PromptForkExperiment.environmentEnabled([
+                CBv2PromptForkExperiment.environmentKey: " YES "
+            ]))
+    }
+
+    func testPlannerBuildsDeepestCompatibleSharedPrefixCohort() {
+        let common = [2, 3, 5, 7]
+        let candidates = [
+            CBv2PromptForkCandidate(
+                id: CBv2RequestID(1), promptTokens: common + [11, 13],
+                priority: 0, cacheSalt: "scope-a"),
+            CBv2PromptForkCandidate(
+                id: CBv2RequestID(2), promptTokens: common + [17, 19],
+                priority: 0, cacheSalt: "scope-a"),
+            CBv2PromptForkCandidate(
+                id: CBv2RequestID(3), promptTokens: common + [23, 29],
+                priority: 0, cacheSalt: "scope-b"),
+            CBv2PromptForkCandidate(
+                id: CBv2RequestID(4), promptTokens: common + [31, 37],
+                priority: 1, cacheSalt: "scope-a"),
+        ]
+
+        let plans = CBv2PromptForkPlanner.plan(candidates, minimumTokens: 2)
+
+        XCTAssertEqual(plans.count, 1)
+        XCTAssertEqual(plans[0].leader, CBv2RequestID(1))
+        XCTAssertEqual(plans[0].followers, [CBv2RequestID(2)])
+        XCTAssertEqual(plans[0].forkTokens, common.count)
+    }
+
+    func testContiguousKVForkCreatesIndependentRegisteredRows() throws {
+        let kinds = CBv2PromptForkHarness.layerKinds
+        let backend = CBv2ContiguousKVBackend(
+            config: .init(bytesCapacity: 1 << 20, kvDType: .float32))
+        let donor = try backend.makeSequenceState(
+            layerKinds: kinds, promptLength: 3, maxLength: 8)
+        let keys = MLXArray([Float(1), 2, 3]).reshaped([1, 1, 3, 1])
+        let values = MLXArray([Float(11), 12, 13]).reshaped([1, 1, 3, 1])
+        _ = donor[0]!.update(keys: keys, values: values)
+        eval(donor[0]!.snapshot().keys, donor[0]!.snapshot().values)
+
+        let snapshot = try backend.makeForkSnapshot(
+            of: donor, layerKinds: kinds)
+        XCTAssertEqual(snapshot.tokenCount, 3)
+        XCTAssertEqual(
+            snapshot.layers[0]!.keys.asArray(Float.self),
+            [1, 2, 3])
+
+        let first = try backend.makeSequenceState(
+            forking: snapshot, layerKinds: kinds, maxLength: 8)
+        let second = try backend.makeSequenceState(
+            forking: snapshot, layerKinds: kinds, maxLength: 8)
+        XCTAssertEqual(first[0]!.absoluteOffset, 3)
+        XCTAssertEqual(second[0]!.absoluteOffset, 3)
+        XCTAssertGreaterThan(backend.bytesReserved, 0)
+
+        _ = first[0]!.update(
+            keys: MLXArray([Float(4)]).reshaped([1, 1, 1, 1]),
+            values: MLXArray([Float(14)]).reshaped([1, 1, 1, 1]))
+        eval(first[0]!.snapshot().keys, second[0]!.snapshot().keys)
+        XCTAssertEqual(first[0]!.absoluteOffset, 4)
+        XCTAssertEqual(second[0]!.absoluteOffset, 3)
+        XCTAssertEqual(donor[0]!.absoluteOffset, 3)
+        XCTAssertEqual(
+            second[0]!.snapshot().values.asArray(Float.self),
+            [11, 12, 13])
+
+        backend.release(first)
+        backend.release(second)
+        backend.release(donor)
+        XCTAssertEqual(backend.bytesInUse, 0)
+        XCTAssertEqual(backend.bytesReserved, 0)
+    }
+
+    func testContiguousKVForkRejectsMalformedPublicSnapshot() {
+        let kinds = CBv2PromptForkHarness.layerKinds
+        let backend = CBv2ContiguousKVBackend(
+            config: .init(bytesCapacity: 1 << 20, kvDType: .float32))
+        let malformed = CBv2KVForkSnapshot(
+            tokenCount: 3,
+            layers: [(
+                keys: MLXArray.zeros([1, 2, 3, 1], dtype: .float32),
+                values: MLXArray.zeros([1, 2, 3, 1], dtype: .float32),
+                offset: 3
+            )])
+
+        XCTAssertThrowsError(
+            try backend.makeSequenceState(
+                forking: malformed, layerKinds: kinds, maxLength: 8))
+        XCTAssertEqual(backend.bytesInUse, 0)
+        XCTAssertEqual(backend.bytesReserved, 0)
+    }
+
+    func testRecurrentSnapshotRestoresIndependentRequestOwners() throws {
+        let spec = CBv2RecurrentStateSpec(layers: [
+            CBv2RecurrentLayerStateSpec(
+                modelLayerIndex: 0,
+                convShape: [1, 1, 1], convDType: .float32,
+                ssmShape: [1, 1, 1, 1], ssmDType: .float32)
+        ])
+        let donor = try CBv2RecurrentRequestState(spec: spec)
+        let donorEvaluation = try donor.bind()
+        try donorEvaluation.stage(
+            modelLayerIndex: 0,
+            conv: MLXArray([Float(7)]).reshaped([1, 1, 1]),
+            ssm: MLXArray([Float(17)]).reshaped([1, 1, 1, 1]))
+        _ = try donorEvaluation.evaluate()
+        try donorEvaluation.commit()
+
+        let snapshot = try donor.snapshotVisibleState(detaching: false)
+        XCTAssertEqual(snapshot.byteCount, 8)
+        let first = try CBv2RecurrentRequestState(restoring: snapshot)
+        let second = try CBv2RecurrentRequestState(restoring: snapshot)
+
+        let firstEvaluation = try first.bind()
+        try firstEvaluation.stage(
+            modelLayerIndex: 0,
+            conv: MLXArray([Float(9)]).reshaped([1, 1, 1]),
+            ssm: MLXArray([Float(19)]).reshaped([1, 1, 1, 1]))
+        _ = try firstEvaluation.evaluate()
+        try firstEvaluation.commit()
+
+        XCTAssertEqual(
+            first.state(modelLayerIndex: 0)!.conv!.item(Float.self), 9)
+        XCTAssertEqual(
+            second.state(modelLayerIndex: 0)!.conv!.item(Float.self), 7)
+        XCTAssertEqual(
+            donor.state(modelLayerIndex: 0)!.conv!.item(Float.self), 7)
+
+        try first.release()
+        try second.release()
+        try donor.release()
+    }
+}
diff --git a/Tests/MLXLMTests/CBv2PromptForkTestSupport.swift b/Tests/MLXLMTests/CBv2PromptForkTestSupport.swift
new file mode 100644
index 0000000..e623149
--- /dev/null
+++ b/Tests/MLXLMTests/CBv2PromptForkTestSupport.swift
@@ -0,0 +1,226 @@
+import Foundation
+import MLX
+
+@testable import MLXLMCommon
+
+final class CBv2PromptForkForwardGate: @unchecked Sendable {
+    private let lock = NSLock()
+    private var isOpen = false
+    private var entries = 0
+    private let release = DispatchSemaphore(value: 0)
+
+    func waitIfClosed() {
+        lock.lock()
+        let shouldWait = !isOpen
+        if shouldWait { entries += 1 }
+        lock.unlock()
+        guard shouldWait else { return }
+        _ = release.wait(timeout: .now() + 10)
+    }
+
+    var entryCount: Int {
+        lock.lock()
+        defer { lock.unlock() }
+        return entries
+    }
+
+    /// Release one blocked forward while keeping the next forward gated.
+    func advance() {
+        release.signal()
+    }
+
+    /// Release the current forward and leave all later forwards unblocked.
+    func open() {
+        lock.lock()
+        isOpen = true
+        lock.unlock()
+        release.signal()
+    }
+}
+
+/// Tiny hybrid model whose recurrent scalar is the exact sum of every token
+/// consumed so far. Its greedy logits depend on that scalar, so a missing or
+/// aliased recurrent fork changes the emitted token checksum immediately.
+final class CBv2PromptForkFixtureModel:
+    CBv2RecurrentSteppableModel, CBv2PackedPrefillSteppableModel,
+    @unchecked Sendable
+{
+    let vocabSize = 31
+    let gate: CBv2PromptForkForwardGate?
+    private let lock = NSLock()
+    private var forwardShapesStorage: [[Int]] = []
+
+    init(gate: CBv2PromptForkForwardGate? = nil) {
+        self.gate = gate
+    }
+
+    var cbv2Capabilities: CBv2ModelCapabilities {
+        var capabilities = CBv2ModelCapabilities.initialRecurrentTarget
+        capabilities.supportsPackedPrefill = true
+        capabilities.supportsPromptStateForking = true
+        return capabilities
+    }
+
+    let recurrentStateSpec: CBv2RecurrentStateSpec? = CBv2RecurrentStateSpec(layers: [
+        CBv2RecurrentLayerStateSpec(
+            modelLayerIndex: 0,
+            convShape: [1, 1, 1], convDType: .float32,
+            ssmShape: [1, 1, 1, 1], ssmDType: .float32)
+    ])
+
+    var supportsPackedPrefill: Bool { true }
+
+    var forwardShapes: [[Int]] {
+        lock.lock()
+        defer { lock.unlock() }
+        return forwardShapesStorage
+    }
+
+    var tokenCellsExecuted: Int {
+        forwardShapes.reduce(0) { total, shape in
+            total + shape[0] * shape[1]
+        }
+    }
+
+    func forward(tokens: MLXArray, caches: [CBv2AttendingLayerCache]) -> MLXArray {
+        preconditionFailure("prompt-fork fixture requires recurrent forward")
+    }
+
+    func prefill(
+        tokens: MLXArray,
+        inputEmbeddings: MLXArray?,
+        caches: [CBv2AttendingLayerCache],
+        requirement: CBv2PrefillRequirement
+    ) -> MLXArray {
+        preconditionFailure("recurrent prompt-fork fixture bypasses the non-recurrent seam")
+    }
+
+    func forward(
+        tokens: MLXArray,
+        caches: [CBv2AttendingLayerCache],
+        recurrentState: [CBv2RecurrentStateEvaluation]
+    ) -> MLXArray {
+        gate?.waitIfClosed()
+        lock.lock()
+        forwardShapesStorage.append(tokens.shape)
+        lock.unlock()
+
+        let batch = tokens.dim(0)
+        let length = tokens.dim(1)
+        precondition(recurrentState.count == batch)
+        let tokenValues = tokens.asType(.float32)
+        let kv = tokenValues[0..., .newAxis, 0..., .newAxis]
+        for cache in caches {
+            _ = cache.updateAndAttend(
+                queries: kv, keys: kv, values: kv, scale: 1, sinks: nil)
+        }
+
+        let previousRows = recurrentState.map { evaluation -> MLXArray in
+            (evaluation.inputState(modelLayerIndex: 0)?.conv
+                ?? MLXArray.zeros([1, 1, 1], dtype: .float32))
+                .reshaped([1, 1])
+        }
+        let previous =
+            previousRows.count == 1
+            ? previousRows[0]
+            : concatenated(previousRows, axis: 0)
+        let cumulative = cumsum(tokenValues, axis: 1) + previous
+        for (index, evaluation) in recurrentState.enumerated() {
+            let final = cumulative[index ..< index + 1, length - 1 ..< length]
+            try! evaluation.stage(
+                modelLayerIndex: 0,
+                conv: final.reshaped([1, 1, 1]),
+                ssm: final.reshaped([1, 1, 1, 1]))
+        }
+
+        let targets =
+            ((cumulative.asType(.int32) + Int32(1)) % Int32(vocabSize))
+            .asType(.float32)
+        let vocabulary = MLXArray((0 ..< vocabSize).map(Float.init))
+            .reshaped([1, 1, vocabSize])
+        let distance = vocabulary - targets[0..., 0..., .newAxis]
+        return -(distance * distance)
+    }
+}
+
+final class CBv2PromptForkHarness {
+    static let layerKinds = [
+        CBv2LayerKind(
+            attention: .full, headDim: 1, kvHeads: 1, queryHeads: 1)
+    ]
+
+    let model: CBv2PromptForkFixtureModel
+    let backend: CBv2ContiguousKVBackend
+    let engine: EngineV2
+
+    init(
+        enabled: Bool,
+        batchSize: Int,
+        chunkSize: Int = 2,
+        gate: CBv2PromptForkForwardGate? = nil,
+        enqueueDelayForTesting: TimeInterval = 0
+    ) {
+        model = CBv2PromptForkFixtureModel(gate: gate)
+        backend = CBv2ContiguousKVBackend(
+            config: .init(bytesCapacity: 8 << 20, kvDType: .float32))
+        engine = EngineV2(
+            model: model,
+            layerKinds: Self.layerKinds,
+            backend: backend,
+            cacheProvider: CBv2LayerCacheBank(layerKinds: Self.layerKinds),
+            sampler: CBv2GreedySampler(),
+            schedulerConfig: .init(
+                maxConcurrentRequests: batchSize,
+                maxBatchedTokensPerStep: max(batchSize * chunkSize, batchSize),
+                prefillChunkSize: chunkSize,
+                maxWaiting: max(8, batchSize * 2)),
+            loopConfig: .init(idleRecheckInterval: 0.1),
+            admissionConfig: .init(
+                watermarkFraction: 0, elementBytes: 4,
+                fixedBytesPerRequest: 0),
+            promptForkConfig: .init(
+                enabled: enabled, minimumPrefixTokens: 1))
+        engine.loopForTesting.enqueueStartDelayForTesting = enqueueDelayForTesting
+    }
+}
+
+struct CBv2PromptForkCollected: Sendable {
+    var tokens: [Int] = []
+    var finishReason: CBv2FinishReason?
+    var usage: CBv2Usage?
+}
+
+func cbv2PromptForkCollectAll(
+    _ streams: [(CBv2RequestID, AsyncStream<CBv2Event>)]
+) async -> [CBv2RequestID: CBv2PromptForkCollected] {
+    await withTaskGroup(
+        of: (CBv2RequestID, CBv2PromptForkCollected).self,
+        returning: [CBv2RequestID: CBv2PromptForkCollected].self
+    ) { group in
+        for (id, stream) in streams {
+            group.addTask {
+                var collected = CBv2PromptForkCollected()
+                for await event in stream {
+                    switch event {
+                    case .delta(_, let tokens, _):
+                        collected.tokens.append(contentsOf: tokens)
+                    case .finished(let reason, let usage):
+                        collected.finishReason = reason
+                        collected.usage = usage
+                        return (id, collected)
+                    }
+                }
+                return (id, collected)
+            }
+        }
+        var output: [CBv2RequestID: CBv2PromptForkCollected] = [:]
+        for await (id, collected) in group { output[id] = collected }
+        return output
+    }
+}
+
+func cbv2PromptForkChecksum(_ tokens: [Int]) -> UInt64 {
+    tokens.reduce(UInt64(0xcbf2_9ce4_8422_2325)) { hash, token in
+        (hash ^ UInt64(bitPattern: Int64(token))) &* 0x0000_0100_0000_01b3
+    }
+}
