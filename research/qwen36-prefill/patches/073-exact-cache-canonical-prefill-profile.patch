+        XCTAssertEqual(disabled.usage?.prefixCacheOutcome, .skippedPolicy)
+        XCTAssertEqual(stack.model.prefillShapes, [[1, 4], [1, 4], [1, 2]])
+
+        stack.model.resetPrefillShapes()
+        let miss = await cbv2SchedCollect(
+            try stack.engine.submit(request(
+                id: 2,
+                promptTokens: donorPrompt,
+                maxTokens: 1)))
+        XCTAssertEqual(miss.finishReason, .length)
+        XCTAssertEqual(miss.usage?.prefixCacheOutcome, .miss)
+        XCTAssertEqual(stack.model.prefillShapes, [[1, 4], [1, 4], [1, 2]])
+
+        stack.model.resetPrefillShapes()
+        let suffixPrompt = Array(donorPrompt.prefix(8)) + [12, 13, 14, 15, 16, 17]
+        let hit = await cbv2SchedCollect(
