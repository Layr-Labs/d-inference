From b78dbc0de22e025fcc66cbd62e99a37ace964af7 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 24 Aug 2026 06:06:56 +0000
Subject: [PATCH] perf(mlx): dequantize quantized weights in float32

---
 Source/Cmlx/mlx-generated/fp_quantized.cpp    |  7 +-
 .../Cmlx/mlx-generated/fp_quantized_nax.cpp   |  7 +-
 .../Cmlx/mlx-generated/metal/fp_quantized.h   |  7 +-
 .../mlx-generated/metal/fp_quantized_nax.h    |  7 +-
 Source/Cmlx/mlx-generated/metal/quantized.h   | 73 +++++++-------
 .../Cmlx/mlx-generated/metal/quantized_nax.h  | 73 +++++++-------
 Source/Cmlx/mlx-generated/quantized.cpp       | 73 +++++++-------
 Source/Cmlx/mlx-generated/quantized_nax.cpp   | 73 +++++++-------
 Tests/MLXTests/FloatDequantizationTests.swift | 97 +++++++++++++++++++
 9 files changed, 273 insertions(+), 144 deletions(-)
 create mode 100644 Tests/MLXTests/FloatDequantizationTests.swift

diff --git a/Source/Cmlx/mlx-generated/fp_quantized.cpp b/Source/Cmlx/mlx-generated/fp_quantized.cpp
index ebb20e9..4fea886 100644
--- a/Source/Cmlx/mlx-generated/fp_quantized.cpp
+++ b/Source/Cmlx/mlx-generated/fp_quantized.cpp
@@ -286,11 +286,12 @@ inline void qouter(const thread uint8_t* w, U x, U scale, thread U* result) {
 
 template <typename U, int bits>
 inline void dequantize(uint8_t w, U scale, threadgroup U* w_local) {
+  const float s = float(scale);
   if constexpr (bits == 4) {
-    w_local[0] = scale * Dequantize<4, U>{}(w);
-    w_local[1] = scale * Dequantize<4, U>{}(w >> 4);
+    w_local[0] = static_cast<U>(s * Dequantize<4, float>{}(w));
+    w_local[1] = static_cast<U>(s * Dequantize<4, float>{}(w >> 4));
   } else {
-    w_local[0] = scale * Dequantize<8, U>{}(w);
+    w_local[0] = static_cast<U>(s * Dequantize<8, float>{}(w));
   }
 }
 
diff --git a/Source/Cmlx/mlx-generated/fp_quantized_nax.cpp b/Source/Cmlx/mlx-generated/fp_quantized_nax.cpp
