{
  "title": "Darkbloom Rust Coordinator Migration - Prod",
  "description": "Production Rust coordinator migration gates. Runbook: docs/operations/rust-coordinator-observability.md",
  "layout_type": "ordered",
  "notify_list": [],
  "template_variables": [
    {"name": "env", "prefix": "env", "default": "production"},
    {"name": "service", "prefix": "service", "default": "d-inference-coordinator"}
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "## Production cutover gates\nDo not bypass ownership, checksum, quiescence, or rollback-guard alerts. Metric tags are constrained by `rust-metrics-allowlist.json`.",
        "background_color": "red",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Availability, request status, and budget misses",
        "requests": [
          {"q": "sum:d_inference.rust.http.requests{$env,$service} by {status_class}.as_count()", "display_type": "bars"},
          {"q": "sum:d_inference.rust.http.stage.budget_exceeded{$env,$service} by {stage}.as_count()", "display_type": "bars"}
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "p95 / p99 parse, reserve, prepare, start",
        "requests": [
          {"q": "avg:d_inference.rust.http.stage.duration_ms.95percentile{$env,$service,stage:parse}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.99percentile{$env,$service,stage:parse}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.95percentile{$env,$service,stage:reserve}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.99percentile{$env,$service,stage:reserve}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.95percentile{$env,$service,stage:prepare}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.99percentile{$env,$service,stage:prepare}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.95percentile{$env,$service,stage:start}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.99percentile{$env,$service,stage:start}", "display_type": "line"}
        ],
        "yaxis": {"label": "milliseconds", "min": "0", "scale": "linear", "include_zero": true}
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "p95 / p99 TTFT, chunk, settle",
        "requests": [
          {"q": "avg:d_inference.rust.http.stage.duration_ms.95percentile{$env,$service,stage:ttft}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.99percentile{$env,$service,stage:ttft}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.95percentile{$env,$service,stage:chunk}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.99percentile{$env,$service,stage:chunk}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.95percentile{$env,$service,stage:settle}", "display_type": "line"},
          {"q": "avg:d_inference.rust.http.stage.duration_ms.99percentile{$env,$service,stage:settle}", "display_type": "line"}
        ],
        "yaxis": {"label": "milliseconds", "min": "0", "scale": "linear", "include_zero": true}
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Auth and fleet admission",
        "requests": [
          {"q": "sum:d_inference.rust.auth.attempts{$env,$service} by {kind,outcome}.as_count()", "display_type": "bars"},
          {"q": "sum:d_inference.rust.fleet.admission{$env,$service} by {outcome,reason}.as_count()", "display_type": "bars"}
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Provider sessions, trust, and version floor",
        "requests": [
          {"q": "max:d_inference.rust.provider.sessions{$env,$service}", "display_type": "line"},
          {"q": "sum:d_inference.rust.provider.trust{$env,$service} by {trust,outcome}.as_count()", "display_type": "bars"},
          {"q": "sum:d_inference.rust.provider.version{$env,$service} by {provider_version,outcome}.as_count()", "display_type": "bars"}
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Writer pressure, sent_unknown, timeout, and byte-pipe overflow",
        "requests": [
          {"q": "avg:d_inference.rust.writer.queue.items.95percentile{$env,$service} by {lane}", "display_type": "line"},
          {"q": "avg:d_inference.rust.writer.queue.bytes.95percentile{$env,$service} by {lane}", "display_type": "line"},
          {"q": "sum:d_inference.rust.writer.delivery{$env,$service} by {lane,outcome}.as_count()", "display_type": "bars"},
          {"q": "sum:d_inference.rust.writer.timeout{$env,$service} by {lane,kind}.as_count()", "display_type": "bars"},
          {"q": "sum:d_inference.rust.byte_pipe.overflow{$env,$service} by {kind}.as_count()", "display_type": "bars"}
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Durable states and oldest age",
        "requests": [
          {"q": "max:d_inference.rust.jobs.state{$env,$service} by {kind,state}", "display_type": "line"},
          {"q": "max:d_inference.rust.outbox.state{$env,$service} by {kind,state}", "display_type": "line"},
          {"q": "max:d_inference.rust.fee.state{$env,$service} by {kind,state}", "display_type": "line"},
          {"q": "max:d_inference.rust.jobs.age_seconds{$env,$service} by {kind,state}", "display_type": "line"}
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Ledger, recovery, and Stripe ambiguity",
        "requests": [
          {"q": "sum:d_inference.rust.ledger.transition{$env,$service} by {operation,outcome}.as_count()", "display_type": "bars"},
          {"q": "sum:d_inference.rust.ledger.ambiguous_commit{$env,$service} by {operation}.as_count()", "display_type": "bars"},
          {"q": "sum:d_inference.rust.recovery.action{$env,$service} by {kind,operation,outcome}.as_count()", "display_type": "bars"},
          {"q": "sum:d_inference.rust.billing.external_unknown{$env,$service,source:stripe}.as_count()", "display_type": "bars"}
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Ownership, schema checksum, drain, quiescence, rollback guard",
        "requests": [
          {"q": "min:d_inference.rust.ownership.healthy{$env,$service}", "display_type": "line"},
          {"q": "max:d_inference.rust.ownership.epoch{$env,$service}", "display_type": "line"},
          {"q": "max:d_inference.rust.schema.version{$env,$service} by {schema}", "display_type": "line"},
          {"q": "min:d_inference.rust.schema.checksum_valid{$env,$service}", "display_type": "line"},
          {"q": "max:d_inference.rust.drain.state{$env,$service} by {mode}", "display_type": "line"},
          {"q": "min:d_inference.rust.quiescent{$env,$service}", "display_type": "line"},
          {"q": "min:d_inference.rust.rollback_guard{$env,$service,mode:go_fallback}", "display_type": "line"}
        ]
      }
    }
  ]
}
