diff --git a/libs/lume/src/VM/BrokerLifecycleCapability.swift b/libs/lume/src/VM/BrokerLifecycleCapability.swift
new file mode 100644
index 00000000..98f5ae48
--- /dev/null
+++ b/libs/lume/src/VM/BrokerLifecycleCapability.swift
@@ -0,0 +1,203 @@
+import Darwin
+import Dispatch
+import Foundation
+
+/// A pre-spawn descriptor whose peer is owned by the sandbox broker.
+///
+/// Peer closure is the control message. EOF is sticky, so a request made
+/// before VM registration or lock acquisition cannot be lost.
+final class BrokerLifecycleCapability: @unchecked Sendable {
+    static let environmentVariable = "DARKBLOOM_LUME_LIFECYCLE_FD"
+
+    typealias StopHandler = @Sendable () -> Void
+
+    private let endpoint: Endpoint
+    private let state = State()
+    private let source: DispatchSourceRead
+
+    static func inherited() throws -> BrokerLifecycleCapability? {
+        guard let value = ProcessInfo.processInfo.environment[
+            environmentVariable
+        ] else {
+            return nil
+        }
+        unsetenv(environmentVariable)
+        guard let descriptor = Int32(value),
+              descriptor > STDERR_FILENO
+        else {
+            throw VMError.internalError(
+                "Invalid broker lifecycle capability"
+            )
+        }
+        return try BrokerLifecycleCapability(fileDescriptor: descriptor)
+    }
+
+    init(fileDescriptor: Int32) throws {
+        guard fileDescriptor > STDERR_FILENO,
+              fcntl(fileDescriptor, F_GETFD) >= 0
+        else {
+            throw VMError.internalError(
+                "Invalid broker lifecycle capability"
+            )
+        }
+        let descriptorFlags = fcntl(fileDescriptor, F_GETFD)
+        let statusFlags = fcntl(fileDescriptor, F_GETFL)
+        guard descriptorFlags >= 0,
+              statusFlags >= 0,
+              fcntl(
+                  fileDescriptor,
+                  F_SETFD,
+                  descriptorFlags | FD_CLOEXEC
+              ) == 0,
+              fcntl(
+                  fileDescriptor,
+                  F_SETFL,
+                  statusFlags | O_NONBLOCK
+              ) == 0
+        else {
+            throw VMError.internalError(
+                "Could not secure broker lifecycle capability"
+            )
+        }
+
+        let endpoint = Endpoint(fileDescriptor: fileDescriptor)
+        self.endpoint = endpoint
+        source = DispatchSource.makeReadSource(
+            fileDescriptor: fileDescriptor,
+            queue: DispatchQueue(
+                label:
+                    "com.trycua.lume.broker-lifecycle.\(UUID().uuidString)"
+            )
+        )
+        source.setEventHandler { [weak self] in
+            self?.consumeControlEvent()
+        }
+        source.setCancelHandler {
+            endpoint.close()
+        }
+        source.resume()
+        consumeControlEvent()
+    }
+
+    deinit {
+        source.cancel()
+    }
+
+    var isStopRequested: Bool {
+        consumeControlEvent()
+        return state.isStopRequested
+    }
+
+    func installStopHandler(_ handler: @escaping StopHandler) {
+        state.install(handler)
+    }
+
+    func clearStopHandler() {
+        state.clearHandler()
+    }
+
+    private func consumeControlEvent() {
+        guard !state.isStopRequested else {
+            return
+        }
+        var byte: UInt8 = 0
+        while true {
+            let count = endpoint.readByte(into: &byte)
+            if count == 0 {
+                state.requestStop()
+                source.cancel()
+                return
+            }
+            if count > 0 {
+                // The protocol uses EOF only. Unexpected data fails safe.
+                state.requestStop()
+                source.cancel()
+                return
+            }
+            if errno == EINTR {
+                continue
+            }
+            if errno == EAGAIN || errno == EWOULDBLOCK {
+                return
+            }
+            state.requestStop()
+            source.cancel()
+            return
+        }
+    }
+
+    private final class Endpoint: @unchecked Sendable {
+        private let lock = NSLock()
+        private var fileDescriptor: Int32
+
+        init(fileDescriptor: Int32) {
+            self.fileDescriptor = fileDescriptor
+        }
+
+        func readByte(into byte: inout UInt8) -> Int {
+            lock.withLock {
+                guard fileDescriptor >= 0 else {
+                    errno = EBADF
+                    return -1
+                }
+                return Darwin.read(fileDescriptor, &byte, 1)
+            }
+        }
+
+        func close() {
+            let descriptor = lock.withLock {
+                let descriptor = fileDescriptor
+                fileDescriptor = -1
+                return descriptor
+            }
+            if descriptor >= 0 {
+                Darwin.close(descriptor)
+            }
+        }
+    }
+
+    private final class State: @unchecked Sendable {
+        private let lock = NSLock()
+        private var stopRequested = false
+        private var handler: StopHandler?
+
+        var isStopRequested: Bool {
+            lock.withLock { stopRequested }
+        }
+
+        func install(_ handler: @escaping StopHandler) {
+            let invokeImmediately = lock.withLock {
+                self.handler = handler
+                return stopRequested
+            }
+            if invokeImmediately {
+                handler()
+            }
+        }
+
+        func clearHandler() {
+            lock.withLock {
+                handler = nil
+            }
+        }
+
+        func requestStop() {
+            let handler = lock.withLock {
+                guard !stopRequested else {
+                    return nil as StopHandler?
+                }
+                stopRequested = true
+                return self.handler
+            }
+            handler?()
+        }
+    }
+}
+
+private extension NSLock {
+    func withLock<T>(_ operation: () -> T) -> T {
+        lock()
+        defer { unlock() }
+        return operation()
+    }
+}
