+@Test("the default identity is the historical single-account layout")
+func defaultIdentityIsUnchanged() throws {
+    // An ordinary `lume create` must behave exactly as before.
+    let identity = try GuestIdentity()
+    #expect(identity.bootstrap.username == "lume")
+    #expect(identity.bootstrap.password == "lume")
+    #expect(identity.bootstrap.uid == "501")
+    #expect(identity.tenant == nil)
+    #expect(GuestIdentity.legacy.tenant == nil)
+    #expect(GuestIdentity.legacy.bootstrap == GuestIdentity.defaultBootstrap)
+}
