+++ b/Libraries/MLXLLM/Models/Qwen35PrefillMoERoutingPolicy.swift
@@ -0,0 +1,114 @@
+import Foundation
+
+/// Default-off research policy for reducing Qwen3.5 routed-expert work during
+/// multi-token prompt forwards. Decode-shaped calls and unlabelled MoE blocks
+/// always retain the checkpoint's configured top-k.
+public struct Qwen35PrefillMoERoutingPolicy: Equatable, Sendable {
+    public static let topKEnvironmentKey = "DARKBLOOM_QWEN35_PREFILL_MOE_TOP_K"
+    public static let fullLayersEnvironmentKey =
+        "DARKBLOOM_QWEN35_PREFILL_MOE_FULL_LAYERS"
+
+    public static let disabled = Qwen35PrefillMoERoutingPolicy()
+
+    public let reducedTopK: Int?
+    public let fullTopKLayers: Set<Int>
+
+    public init(
+        reducedTopK: Int? = nil,
+        fullTopKLayers: Set<Int> = []
+    ) {
+        self.reducedTopK = reducedTopK
+        self.fullTopKLayers = fullTopKLayers
+    }
+
+    /// Resolve the process-start experiment knobs. Any malformed or
+    /// non-reducing setting fails closed to the checkpoint's original policy.
+    public static func fromEnvironment(
+        _ environment: [String: String] = ProcessInfo.processInfo.environment,
+        modelTopK: Int,
+        layerCount: Int
+    ) -> Qwen35PrefillMoERoutingPolicy {
+        guard
+            modelTopK > 1,
+            layerCount > 0,
+            let rawTopK = environment[topKEnvironmentKey],
+            let reducedTopK = Int(rawTopK.trimmingCharacters(in: .whitespaces)),
+            reducedTopK > 0,
+            reducedTopK < modelTopK
+        else {
+            return .disabled
+        }
+
+        let rawLayers = environment[fullLayersEnvironmentKey] ?? ""
+        guard let fullLayers = parseLayerSet(rawLayers, layerCount: layerCount) else {
+            return .disabled
+        }
+        return Qwen35PrefillMoERoutingPolicy(
+            reducedTopK: reducedTopK,
+            fullTopKLayers: fullLayers)
+    }
+
+    /// The expert count for one MoE invocation.
+    ///
+    /// `sequenceLength == 1` covers ordinary and continuously-batched decode.
+    /// A missing layer index covers MTP and any standalone block construction;
+    /// neither is changed by this prefill-only experiment.
+    public func routedTopK(
+        layerIndex: Int?,
+        sequenceLength: Int,
+        modelTopK: Int
+    ) -> Int {
+        guard
+            let reducedTopK,
+            let layerIndex,
+            sequenceLength > 1,
+            !fullTopKLayers.contains(layerIndex)
+        else {
+            return modelTopK
+        }
+        return min(reducedTopK, modelTopK)
+    }
+
+    public var descriptor: String {
+        guard let reducedTopK else { return "disabled" }
+        let layers = fullTopKLayers.sorted().map(String.init).joined(separator: ",")
+        return "top_k=\(reducedTopK);full_layers=\(layers)"
+    }
+
+    private static func parseLayerSet(
+        _ raw: String,
+        layerCount: Int
+    ) -> Set<Int>? {
+        let value = raw.trimmingCharacters(in: .whitespaces)
+        guard !value.isEmpty else { return [] }
+
+        var result: Set<Int> = []
+        for part in value.split(separator: ",", omittingEmptySubsequences: false) {
+            let term = part.trimmingCharacters(in: .whitespaces)
+            guard !term.isEmpty else { return nil }
+
+            let bounds = term.split(separator: "-", omittingEmptySubsequences: false)
+            switch bounds.count {
+            case 1:
+                guard let layer = Int(bounds[0]), (0 ..< layerCount).contains(layer) else {
+                    return nil
+                }
+                result.insert(layer)
+            case 2:
+                guard
+                    let lower = Int(bounds[0]),
+                    let upper = Int(bounds[1]),
+                    lower <= upper,
+                    lower >= 0,
+                    upper < layerCount
+                else {
+                    return nil
+                }
+                result.formUnion(lower ... upper)
+            default:
+                return nil
+            }
+        }
+        return result
+    }
+}
