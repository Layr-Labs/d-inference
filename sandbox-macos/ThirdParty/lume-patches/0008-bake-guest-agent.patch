+@Test("an agent install rejects inputs that would silently misinstall")
+func installRejectsBadInputs() throws {
+    let (root, binary) = try makeExecutable()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    // An absolute install path would escape the mount point when joined.
+    #expect(throws: GuestAgentInstall.ValidationError.self) {
+        _ = try GuestAgentInstall(
+            executableURL: binary,
+            installPath: "/usr/local/libexec/agent",
+            runAsUsername: "sandbox",
+            port: 8888,
+            imageID: "img"
+        )
+    }
+    // An empty image id would advertise "" and fail every host-side check.
+    #expect(throws: GuestAgentInstall.ValidationError.self) {
+        _ = try makeInstall(executable: binary, imageID: "")
+    }
+    #expect(throws: GuestAgentInstall.ValidationError.self) {
+        _ = try makeInstall(executable: binary, port: 0)
+    }
+    #expect(throws: GuestAgentInstall.ValidationError.self) {
+        _ = try makeInstall(executable: binary, runAs: "")
+    }
+    // A missing binary must fail at construction, not at write time inside a
+    // mounted disk image.
+    #expect(throws: GuestAgentInstall.ValidationError.self) {
+        _ = try makeInstall(
+            executable: root.appendingPathComponent("absent"))
+    }
+    // A zero-byte binary is a build that silently produced nothing.
+    let empty = root.appendingPathComponent("empty")
+    try Data().write(to: empty)
+    #expect(throws: GuestAgentInstall.ValidationError.self) {
+        _ = try makeInstall(executable: empty)
+    }
+}
