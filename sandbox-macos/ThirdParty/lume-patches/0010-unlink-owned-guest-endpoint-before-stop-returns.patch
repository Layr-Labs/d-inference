index fc4918d..ce35161 100644
--- a/libs/lume/tests/DarkbloomGuestBridgeTests.swift
+++ b/libs/lume/tests/DarkbloomGuestBridgeTests.swift
@@ -5,6 +5,33 @@ import Testing
 
 @Suite("Darkbloom private guest bridge")
 struct DarkbloomGuestBridgeTests {
+    @Test func stopRemovesEndpointBeforeReturningAndAllowsImmediateRebind() throws {
+        let root = URL(fileURLWithPath: "/private/tmp").appendingPathComponent(".dbg-\(UUID())")
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: root) }
+        let path = root.appendingPathComponent("s").path
+        for _ in 0..<32 {
+            let bridge = try DarkbloomGuestBridge(path: path, connect: { _ in })
+            bridge.stop()
+            var metadata = stat()
+            #expect(lstat(path, &metadata) == -1 && errno == ENOENT)
+            bridge.stop()
+        }
+    }
+
+    @Test func stopPreservesAReplacementAtTheOldEndpointName() throws {
+        let root = URL(fileURLWithPath: "/private/tmp").appendingPathComponent(".dbg-\(UUID())")
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: root) }
+        let path = root.appendingPathComponent("s")
+        let bridge = try DarkbloomGuestBridge(path: path.path, connect: { _ in })
+        #expect(unlink(path.path) == 0)
+        let replacement = Data("preserve replacement".utf8)
+        try replacement.write(to: path, options: .withoutOverwriting)
+        bridge.stop()
+        #expect(try Data(contentsOf: path) == replacement)
+    }
+
     @Test func rejectsPublicParentAndPreservesExistingSocketPath() throws {
         let root = URL(fileURLWithPath: "/private/tmp").appendingPathComponent(".dbg-\(UUID())")
         try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o755])
