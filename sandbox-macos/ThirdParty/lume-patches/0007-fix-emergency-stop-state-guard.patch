+@MainActor
+@Test("a stop that throws while teardown is under way does not fail-stop")
+func stopThrowingMidTeardownDoesNotFailStop() async throws {
+    let (root, context) = try makeEmergencyStopTestDirectory()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    let service = MockVMVirtualizationService()
+    var failStopReasons: [VMOwnerFailStopReason] = []
+    let vm = makeCapturingVM(
+        context: context,
+        service: service,
+        terminalTimeout: .seconds(2)
+    ) { failStopReasons.append($0) }
+
+    let runTask = Task {
+        try await vm.run(displayMode: .none, sharedDirectories: [], mount: nil)
+    }
+    try await waitUntilReady { service.state == .running }
+
+    // The emergency stop reports failure with the guest already on its way
+    // down. Deciding from a single state read here is what killed the owner
+    // process over a dying guest; the bounded wait has to be the arbiter.
+    service.failNextStopWhileTeardownProceeds()
+    runTask.cancel()
+    _ = try? await runTask.value
+
+    #expect(
+        failStopReasons.isEmpty,
+        "a guest that reached terminal during the wait must not fail-stop")
+    #expect(service.state == .stopped)
+}
