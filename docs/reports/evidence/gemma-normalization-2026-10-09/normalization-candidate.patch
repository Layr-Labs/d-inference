index 0000000..afc9a1f
--- /dev/null
+++ b/Libraries/MLXLLM/Models/Gemma4KVNormalization.swift
@@ -0,0 +1,17 @@
+import MLX
+
+/// Gemma's `attention_k_eq_v` global layers normalize one projection twice.
+/// The pinned native RMS operator rounds the unweighted normalization to the
+/// output dtype before multiplying the learned scale, on both CPU and Metal.
+/// Reusing V therefore preserves K's bits when raw and weight dtypes match.
+/// Mixed dtypes retain the native weighted operator's promotion and rounding.
+func gemma4NormalizeSharedProjection(
+    _ raw: MLXArray, keyWeight: MLXArray, eps: Float
+) -> (keys: MLXArray, values: MLXArray) {
+    let values = MLXFast.rmsNorm(raw, weight: .mlxNone, eps: eps)
+    let keys =
+        raw.dtype == keyWeight.dtype
+        ? values * keyWeight
+        : MLXFast.rmsNorm(raw, weight: keyWeight, eps: eps)
+    return (keys, values)
+}
