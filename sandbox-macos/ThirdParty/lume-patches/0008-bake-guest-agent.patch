+@Test("the daemon is restarted, because the agent fail-fasts on bind")
+func daemonKeepsTheAgentAlive() throws {
+    let (root, binary) = try makeExecutable()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    let plist = try makeInstall(executable: binary).daemonPlist()
+
+    // The agent binds vsock as its very first act and exits on failure with no
+    // retry, so a start that races the virtio device would otherwise leave the
+    // job dead for the life of the VM.
+    #expect(plist["KeepAlive"] as? Bool == true)
+    #expect(plist["RunAtLoad"] as? Bool == true)
+}
