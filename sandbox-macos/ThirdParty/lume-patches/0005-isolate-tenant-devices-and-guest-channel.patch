diff --git a/libs/lume/src/Virtualization/DarkbloomDevicePolicy.swift b/libs/lume/src/Virtualization/DarkbloomDevicePolicy.swift
new file mode 100644
index 000000000..6e68f1175
--- /dev/null
+++ b/libs/lume/src/Virtualization/DarkbloomDevicePolicy.swift
@@ -0,0 +1,94 @@
+import Darwin
+import Foundation
+import Virtualization
+
+/// The isolated profile is selected only by the broker. It has no IP network
+/// or host peripherals; ordinary image preparation keeps upstream behavior.
+enum DarkbloomDevicePolicyError: Error { case invalidConfiguration(String) }
+
+enum DarkbloomDevicePolicy {
+    static let environmentKey = "DARKBLOOM_VM_PROFILE"
+    static let isolatedProfile = "isolated-v1"
+
+    static func isIsolated(environment: [String: String] = ProcessInfo.processInfo.environment) throws -> Bool {
+        guard let profile = environment[environmentKey] else { return false }
+        guard profile == isolatedProfile else { throw invalid("unknown Darkbloom device profile") }
+        return true
+    }
+
+    static func validateInvocation(hasBrokerLifecycle: Bool, detached: Bool,
+                                   displayDisabled: Bool, vncDisabled: Bool,
+                                   clipboard: Bool, recovery: Bool,
+                                   sharedDirectoryCount: Int, usbCount: Int,
+                                   networkOverride: Bool, control: Path?, disks: [Path]?,
+                                   environment: [String: String] = ProcessInfo.processInfo.environment) throws {
+        guard try isIsolated(environment: environment) else { return }
+        guard hasBrokerLifecycle, !detached, displayDisabled, vncDisabled,
+              !clipboard, !recovery, sharedDirectoryCount == 0, usbCount == 0,
+              !networkOverride, control != nil, disks?.count == 1 else {
+            throw invalid("isolated VMs require broker lifecycle, disabled display/VNC, one read-only control disk and one workspace; host shares, networking, USB, recovery and clipboard are forbidden")
+        }
+    }
+
+    static func validateStorage(boot: Path, control: Path?, disks: [Path]?) throws {
+        guard let control, let disks, disks.count == 1 else { throw invalid("missing isolated storage") }
+        let workspace = disks[0]
+        let directory = control.url.deletingLastPathComponent()
+        guard control.url.lastPathComponent == "control.cdr",
+              workspace.url.lastPathComponent == "workspace.cdr",
+              directory.lastPathComponent == ".darkbloom-guest",
+              workspace.url.deletingLastPathComponent() == directory,
+              directory.deletingLastPathComponent() == boot.url.deletingLastPathComponent()
+        else { throw invalid("isolated disks must belong to the VM private guest directory") }
+        try DarkbloomPrivatePath.openDirectory(directory.path).withDescriptor { _ in }
+        var identities = Swift.Set<String>()
+        for (path, mode) in [(boot, Optional<mode_t>.none), (control, mode_t(0o400)), (workspace, mode_t(0o600))] {
+            guard path.url.standardizedFileURL.resolvingSymlinksInPath().path == path.path else {
+                throw invalid("isolated disk path must be canonical")
+            }
+            let descriptor = open(path.path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC)
+            guard descriptor >= 0 else { throw invalid("isolated disk unavailable") }
+            defer { close(descriptor) }
+            var metadata = stat()
+            guard fstat(descriptor, &metadata) == 0, metadata.st_mode & S_IFMT == S_IFREG,
+                  metadata.st_uid == geteuid(), metadata.st_nlink == 1,
+                  metadata.st_mode & 0o022 == 0,
+                  mode.map({ metadata.st_mode & 0o777 == $0 }) ?? true,
+                  metadata.st_size > 0, metadata.st_size % 512 == 0,
+                  identities.insert("\(metadata.st_dev):\(metadata.st_ino)").inserted
+            else { throw invalid("invalid or aliased isolated disk") }
+            try DarkbloomPrivatePath.requireNoACL(descriptor)
+        }
+    }
+
+    @MainActor
+    static func apply(to configuration: VZVirtualMachineConfiguration,
+                      context: VMVirtualizationServiceContext,
+                      environment: [String: String] = ProcessInfo.processInfo.environment) throws {
+        guard try isIsolated(environment: environment) else { return }
+        guard context.sharedDirectories?.isEmpty != false,
+              context.usbMassStoragePaths?.isEmpty != false, !context.recoveryMode,
+              context.networkMode == .nat else { throw invalid("forbidden isolated device configuration") }
+        try validateStorage(boot: context.diskPath, control: context.mount, disks: context.additionalDiskPaths)
+        guard configuration.storageDevices.count == 3 else { throw invalid("isolated VM requires exactly three block devices") }
+        let expected = [(context.diskPath, false), (context.mount!, true), (context.additionalDiskPaths![0], false)]
+        for (device, requirement) in zip(configuration.storageDevices, expected) {
+            guard let block = device as? VZVirtioBlockDeviceConfiguration,
+                  let attachment = block.attachment as? VZDiskImageStorageDeviceAttachment,
+                  attachment.url == requirement.0.url, attachment.isReadOnly == requirement.1 else {
+                throw invalid("isolated block device permissions or identity differ")
+            }
+        }
+        configuration.networkDevices = []
+        configuration.audioDevices = []
+        configuration.consoleDevices = []
+        configuration.serialPorts = []
+        configuration.directorySharingDevices = []
+        configuration.keyboards = []
+        configuration.pointingDevices = []
+        if #available(macOS 15.0, *) { configuration.usbControllers = [] }
+        configuration.socketDevices = [VZVirtioSocketDeviceConfiguration()]
+    }
+
+    private static func invalid(_ message: String) -> DarkbloomDevicePolicyError { .invalidConfiguration(message) }
+}
diff --git a/libs/lume/src/Virtualization/DarkbloomGuestBridge.swift b/libs/lume/src/Virtualization/DarkbloomGuestBridge.swift
new file mode 100644
index 000000000..90e3ba8d9
--- /dev/null
+++ b/libs/lume/src/Virtualization/DarkbloomGuestBridge.swift
@@ -0,0 +1,128 @@
+import Darwin
+import Foundation
+import Virtualization
+
+/// Private broker socket to one fixed guest-control port. The byte stream is
+/// authenticated by the guest protocol; this bridge owns no tenant credentials.
+final class DarkbloomGuestBridge: @unchecked Sendable {
+    static let socketEnvironmentKey = "DARKBLOOM_GUEST_SOCKET"
+    typealias Connector = @Sendable (@escaping @Sendable (Result<DarkbloomGuestEndpoint, Error>) -> Void) -> Void
+    private let lock = NSLock()
+    private var stopped = false
+    private var listenerOpen = true
+    private var clients: [UUID: DarkbloomGuestClient] = [:]
+    private let listener: Int32
+    private let parent: Int32
+    private let name: String
+    private let pathIdentity: stat
+    private let connect: Connector
+    private let slots = DispatchSemaphore(value: 4)
+
+    convenience init(path: String, handle: BaseVirtualizationService.VirtualMachineHandle) throws {
+        try self.init(path: path) { completion in
+            handle.queue.async {
+                guard let device = handle.machine.socketDevices.first as? VZVirtioSocketDevice else {
+                    completion(.failure(DarkbloomDevicePolicyError.invalidConfiguration("missing guest socket device")))
+                    return
+                }
+                device.connect(toPort: 7777) { result in completion(result.map(DarkbloomGuestEndpoint.init)) }
+            }
+        }
+    }
+
+    init(path: String, connect: @escaping Connector) throws {
+        guard path.hasPrefix("/"), path.utf8.count < 104, !path.contains("\0") else { throw POSIXError(.EINVAL) }
+        let url = URL(fileURLWithPath: path)
+        let directory = try DarkbloomPrivatePath.openDirectory(url.deletingLastPathComponent().path)
+        let parent = directory.descriptor
+        var successful = false
+        defer { if !successful { close(parent) } }
+        let fd = socket(AF_UNIX, SOCK_STREAM, 0)
+        guard fd >= 0 else { throw POSIXError(.ENFILE) }
+        defer { if !successful { close(fd) } }
+        guard fcntl(fd, F_SETFD, FD_CLOEXEC) == 0,
+              fcntl(fd, F_SETFL, O_NONBLOCK) == 0 else { throw POSIXError(.EIO) }
+        var address = sockaddr_un()
+        address.sun_family = sa_family_t(AF_UNIX)
+        address.sun_len = UInt8(MemoryLayout<sockaddr_un>.size)
+        withUnsafeMutableBytes(of: &address.sun_path) { $0.copyBytes(from: Array(path.utf8) + [0]) }
+        let bound = withUnsafePointer(to: &address) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+                Darwin.bind(fd, $0, socklen_t(MemoryLayout<sockaddr_un>.size))
+            }
+        }
+        guard bound == 0 else { throw POSIXError(.EADDRINUSE) }
+        var metadata = stat()
+        guard fstatat(parent, url.lastPathComponent, &metadata, AT_SYMLINK_NOFOLLOW) == 0,
+              metadata.st_mode & S_IFMT == S_IFSOCK, metadata.st_uid == geteuid(), metadata.st_nlink == 1 else {
+            throw POSIXError(.EIO)
+        }
+        let identity = metadata
+        defer {
+            if !successful {
+                Self.unlinkOwned(parent: parent, name: url.lastPathComponent, identity: identity)
+            }
+        }
+        guard fchmodat(parent, url.lastPathComponent, 0o600, AT_SYMLINK_NOFOLLOW) == 0,
+              listen(fd, 4) == 0 else { throw POSIXError(.EIO) }
+        self.listener = fd; self.parent = parent; self.name = url.lastPathComponent
+        self.pathIdentity = identity; self.connect = connect
+        successful = true
+        DispatchQueue(label: "io.darkbloom.guest.accept").async { [self] in acceptConnections() }
+    }
+
+    func stop() {
+        let pending = lock.withLock {
+            stopped = true
+            if listenerOpen { _ = shutdown(listener, SHUT_RDWR) }
+            return Array(clients.values)
+        }
+        pending.forEach { $0.stop() }
+    }
+
+    private func acceptConnections() {
+        defer {
+            lock.withLock { listenerOpen = false; close(listener) }
+            Self.unlinkOwned(parent: parent, name: name, identity: pathIdentity)
+            close(parent)
+        }
+        while !lock.withLock({ stopped }) {
+            var event = pollfd(fd: listener, events: Int16(POLLIN), revents: 0)
+            let ready = poll(&event, 1, 100)
+            if ready < 0 { if errno == EINTR { continue }; stop(); return }
+            if ready == 0 { continue }
+            guard event.revents & Int16(POLLIN) != 0 else { stop(); return }
+            let descriptor = accept(listener, nil, nil)
+            if descriptor < 0 { continue }
+            var peerUID: uid_t = 0, peerGID: gid_t = 0
+            guard fcntl(descriptor, F_SETFD, FD_CLOEXEC) == 0,
+                  getpeereid(descriptor, &peerUID, &peerGID) == 0, peerUID == geteuid(),
+                  slots.wait(timeout: .now()) == .success else { close(descriptor); continue }
+            let id = UUID(), slots = slots
+            let client = DarkbloomGuestClient(descriptor: descriptor) { [weak self] in
+                self?.lock.withLock { _ = self?.clients.removeValue(forKey: id) }
+                slots.signal()
+            }
+            let accepted = lock.withLock {
+                guard !stopped else { return false }
+                clients[id] = client
+                return true
+            }
+            guard accepted else { client.stop(); return }
+            connect { result in client.connected(result) }
+            DispatchQueue.global(qos: .utility).asyncAfter(deadline: .now() + 10) { [weak self, weak client] in
+                // Stop accepting after a wedged framework callback. Releasing
+                // slots and continually retrying could retain unbounded callbacks.
+                if client?.isConnecting == true { self?.stop() }
+            }
+        }
+    }
+
+    private static func unlinkOwned(parent: Int32, name: String, identity: stat) {
+        var current = stat()
+        if fstatat(parent, name, &current, AT_SYMLINK_NOFOLLOW) == 0,
+           current.st_dev == identity.st_dev, current.st_ino == identity.st_ino {
+            _ = unlinkat(parent, name, 0)
+        }
+    }
+}
diff --git a/libs/lume/src/Virtualization/DarkbloomGuestClient.swift b/libs/lume/src/Virtualization/DarkbloomGuestClient.swift
new file mode 100644
index 000000000..66c7e1dc0
--- /dev/null
+++ b/libs/lume/src/Virtualization/DarkbloomGuestClient.swift
@@ -0,0 +1,78 @@
+import Darwin
+import Foundation
+import Virtualization
+
+/// VZ owns its descriptor. Tests use the same lifetime wrapper with a socketpair
+/// owner; this type never closes a descriptor owned by Virtualization.framework.
+final class DarkbloomGuestEndpoint: @unchecked Sendable {
+    let descriptor: Int32
+    private let owner: AnyObject
+    init(descriptor: Int32, owner: AnyObject) { self.descriptor = descriptor; self.owner = owner }
+    convenience init(_ connection: VZVirtioSocketConnection) {
+        self.init(descriptor: connection.fileDescriptor, owner: connection)
+    }
+}
+
+/// One accepted descriptor and exactly one capacity slot. Pending-connect
+/// cancellation closes immediately; an active relay owns close until it exits.
+/// A late VZ callback cannot operate on an already-reused client descriptor.
+final class DarkbloomGuestClient: @unchecked Sendable {
+    enum Phase { case connecting, relaying, closed }
+    private let lock = NSLock()
+    private var phase = Phase.connecting
+    private var stopping = false
+    private var endpoint: DarkbloomGuestEndpoint?
+    private let descriptor: Int32
+    private let onFinish: @Sendable () -> Void
+
+    init(descriptor: Int32, onFinish: @escaping @Sendable () -> Void) {
+        self.descriptor = descriptor; self.onFinish = onFinish
+    }
+
+    var isConnecting: Bool { lock.withLock { phase == .connecting } }
+    var isStopping: Bool { lock.withLock { stopping } }
+
+    func stop() {
+        let finished = lock.withLock {
+            stopping = true
+            switch phase {
+            case .connecting:
+                phase = .closed
+                close(descriptor)
+                return true
+            case .relaying:
+                _ = shutdown(descriptor, SHUT_RDWR)
+                if let endpoint { _ = shutdown(endpoint.descriptor, SHUT_RDWR) }
+                return false
+            case .closed: return false
+            }
+        }
+        if finished { onFinish() }
+    }
+
+    func connected(_ result: Result<DarkbloomGuestEndpoint, Error>) {
+        guard case .success(let connection) = result else { stop(); return }
+        let accepted = lock.withLock {
+            guard phase == .connecting, !stopping else { return false }
+            phase = .relaying
+            endpoint = connection
+            return true
+        }
+        guard accepted else { return }
+        DispatchQueue.global(qos: .utility).async { [self] in
+            DarkbloomGuestRelay.run(client: descriptor, guest: connection.descriptor,
+                                   shouldStop: { self.isStopping })
+            finishRelay()
+            withExtendedLifetime(connection) {}
+        }
+    }
+
+    private func finishRelay() {
+        lock.withLock {
+            phase = .closed
+            close(descriptor)
+            endpoint = nil
+        }
+        onFinish()
+    }
+}
diff --git a/libs/lume/src/Virtualization/DarkbloomGuestRelay.swift b/libs/lume/src/Virtualization/DarkbloomGuestRelay.swift
new file mode 100644
index 000000000..fd4791d4b
--- /dev/null
+++ b/libs/lume/src/Virtualization/DarkbloomGuestRelay.swift
@@ -0,0 +1,70 @@
+import Darwin
+import Foundation
+
+/// A bounded full-duplex byte relay. EOF is directional: bytes already read are
+/// flushed before forwarding FIN. POLLHUP never discards a buffered last frame.
+enum DarkbloomGuestRelay {
+    static func run(client: Int32, guest: Int32, timeoutNanoseconds: UInt64 = 960_000_000_000,
+                    shouldStop: @Sendable () -> Bool = { false }) {
+        var noSignal: Int32 = 1
+        for fd in [client, guest] {
+            let flags = fcntl(fd, F_GETFL)
+            guard flags >= 0,
+                  setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &noSignal, socklen_t(MemoryLayout<Int32>.size)) == 0,
+                  fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0 else { return }
+        }
+        var toClient = Data(), toGuest = Data()
+        var clientEOF = false, guestEOF = false
+        var clientFinished = false, guestFinished = false
+        let started = DispatchTime.now().uptimeNanoseconds
+        var bytes = [UInt8](repeating: 0, count: 65_536)
+        while !shouldStop(), DispatchTime.now().uptimeNanoseconds - started < timeoutNanoseconds {
+            if clientEOF && toGuest.isEmpty && !guestFinished {
+                _ = shutdown(guest, SHUT_WR)
+                guestFinished = true
+            }
+            if guestEOF && toClient.isEmpty && !clientFinished {
+                _ = shutdown(client, SHUT_WR)
+                clientFinished = true
+            }
+            if clientFinished && guestFinished { return }
+            let clientInterest = (!clientEOF && toGuest.isEmpty ? Int16(POLLIN) : 0)
+                | (!toClient.isEmpty ? Int16(POLLOUT) : 0)
+            let guestInterest = (!guestEOF && toClient.isEmpty ? Int16(POLLIN) : 0)
+                | (!toGuest.isEmpty ? Int16(POLLOUT) : 0)
+            var events = [
+                pollfd(fd: clientInterest == 0 ? -1 : client, events: clientInterest, revents: 0),
+                pollfd(fd: guestInterest == 0 ? -1 : guest, events: guestInterest, revents: 0),
+            ]
+            let count = poll(&events, 2, 100)
+            if count < 0 { if errno == EINTR { continue }; return }
+            if shouldStop() { return }
+            for index in 0...1 {
+                let event = events[index]
+                guard event.fd >= 0 else { continue }
+                if event.revents & Int16(POLLNVAL | POLLERR) != 0 { return }
+                // A hung-up reader can still contain bytes. Read through EOF,
+                // including when poll reports HUP without the IN bit.
+                if event.events & Int16(POLLIN) != 0,
+                   event.revents & Int16(POLLIN | POLLHUP) != 0 {
+                    let size = read(event.fd, &bytes, bytes.count)
+                    if size == 0 {
+                        if index == 0 { clientEOF = true } else { guestEOF = true }
+                    } else if size < 0 {
+                        if errno != EAGAIN && errno != EINTR { return }
+                    } else if index == 0 { toGuest = Data(bytes.prefix(size)) }
+                    else { toClient = Data(bytes.prefix(size)) }
+                }
+                if event.revents & Int16(POLLOUT) != 0 {
+                    let pending = index == 0 ? toClient : toGuest
+                    let size = pending.withUnsafeBytes { write(event.fd, $0.baseAddress, $0.count) }
+                    if size < 0 {
+                        if errno != EAGAIN && errno != EINTR { return }
+                    } else if size == 0 { return }
+                    else if index == 0 { toClient.removeFirst(size) }
+                    else { toGuest.removeFirst(size) }
+                }
+            }
+        }
+    }
+}
diff --git a/libs/lume/src/Virtualization/DarkbloomPrivatePath.swift b/libs/lume/src/Virtualization/DarkbloomPrivatePath.swift
new file mode 100644
index 000000000..cb3fe0369
--- /dev/null
+++ b/libs/lume/src/Virtualization/DarkbloomPrivatePath.swift
@@ -0,0 +1,42 @@
+import Darwin
+import Foundation
+
+struct DarkbloomPrivateDirectory {
+    let descriptor: Int32
+    func withDescriptor<T>(_ body: (Int32) throws -> T) rethrows -> T {
+        defer { close(descriptor) }
+        return try body(descriptor)
+    }
+}
+
+enum DarkbloomPrivatePath {
+    static func openDirectory(_ path: String) throws -> DarkbloomPrivateDirectory {
+        let url = URL(fileURLWithPath: path)
+        guard path.hasPrefix("/"), !path.contains("\0"),
+              url.standardizedFileURL.resolvingSymlinksInPath().path == path else {
+            throw DarkbloomDevicePolicyError.invalidConfiguration("noncanonical private directory")
+        }
+        let descriptor = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW)
+        guard descriptor >= 0 else { throw POSIXError(.ENOENT) }
+        var valid = false
+        defer { if !valid { close(descriptor) } }
+        var metadata = stat()
+        guard fstat(descriptor, &metadata) == 0, metadata.st_mode & S_IFMT == S_IFDIR,
+              metadata.st_uid == geteuid(), metadata.st_mode & 0o777 == 0o700 else {
+            throw DarkbloomDevicePolicyError.invalidConfiguration("unsafe private directory")
+        }
+        try requireNoACL(descriptor)
+        valid = true
+        return DarkbloomPrivateDirectory(descriptor: descriptor)
+    }
+
+    static func requireNoACL(_ descriptor: Int32) throws {
+        errno = 0
+        guard let acl = acl_get_fd_np(descriptor, ACL_TYPE_EXTENDED) else {
+            if errno == ENOENT { return }
+            throw POSIXError(POSIXErrorCode(rawValue: errno) ?? .EIO)
+        }
+        acl_free(UnsafeMutableRawPointer(acl))
+        throw DarkbloomDevicePolicyError.invalidConfiguration("extended ACL on private authority")
+    }
+}
