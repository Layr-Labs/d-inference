diff --git a/libs/lume/tests/GuestAgentInstallTests.swift b/libs/lume/tests/GuestAgentInstallTests.swift
index ee43d62..f6c55f3 100644
--- a/libs/lume/tests/GuestAgentInstallTests.swift
+++ b/libs/lume/tests/GuestAgentInstallTests.swift
@@ -234,3 +234,25 @@ func finalizationScriptSplicesTheAgentBlock() throws {
     let chown = try #require(script.range(of: "chown root:wheel /usr/local/libexec"))
     #expect(chown.lowerBound < marker.lowerBound)
 }
+
+@MainActor
+@Test("an isolated guest gets no network device at all")
+func isolatedNetworkModeAttachesNothing() throws {
+    // Round-trips through the same string the config persists, so a VM stored
+    // as isolated comes back isolated.
+    #expect(NetworkMode.parse("none") == NetworkMode.isolated)
+    #expect(NetworkMode.isolated.description == "none")
+    #expect(NetworkMode.isolated.configString == "none")
+
+    // The existing modes are untouched.
+    #expect(NetworkMode.parse("nat") == NetworkMode.nat)
+    #expect(NetworkMode.parse("bridged") == NetworkMode.bridged(interface: nil))
+    #expect(NetworkMode.parse("nonsense") == nil)
+
+    // No device, rather than a device with a dead attachment: there is nothing
+    // for a guest to bring up.
+    #expect(try BaseVirtualizationService.createNetworkDeviceConfiguration(
+        macAddress: "aa:bb:cc:dd:ee:ff", networkMode: .isolated) == nil)
+    #expect(try BaseVirtualizationService.createNetworkDeviceConfiguration(
+        macAddress: "aa:bb:cc:dd:ee:ff", networkMode: .nat) != nil)
+}
