+// EngineLoopV2+PromptFork.swift
+//
+// Finalized-boundary integration for the default-off simultaneous prompt
+// fork experiment. Followers never share mutable request wrappers: they are
+// parked at zero progress, then receive independently registered KV and
+// recurrent state before ordinary scheduling can see them again.
+
+import Foundation
+
+extension EngineLoopV2 {
+    /// Detect cohorts before planning. A running, still-prefilling row wins
+    /// leader selection over waiters so a near-simultaneous arrival can join
+    /// work that has started but has not crossed the chosen boundary.
+    func preparePromptForkCohorts() {
+        guard promptFork.isActive else { return }
+        attachPromptForkFollowers()
+
+        let records = scheduler.running + scheduler.waiting
+        let candidates = records.compactMap {
+            rec -> CBv2PromptForkCandidate? in
+            guard promptForkCandidateEligible(rec),
+                promptFork.cohortsByLeader[rec.id] == nil,
+                promptFork.leaderByFollower[rec.id] == nil
+            else { return nil }
+            return CBv2PromptForkCandidate(
+                id: rec.id,
+                promptTokens: rec.request.promptTokens,
+                priority: rec.request.priority,
+                cacheSalt: rec.request.cacheSalt)
+        }
+
+        for plan in CBv2PromptForkPlanner.plan(
+            candidates, minimumTokens: promptFork.minimumTokens)
+        {
+            guard promptFork.cohortsByLeader[plan.leader] == nil,
+                promptFork.leaderByFollower[plan.leader] == nil,
+                let leader = scheduler.record(for: plan.leader),
+                promptForkCandidateEligible(leader),
+                leader.numComputedTokens <= plan.forkTokens,
+                plan.forkTokens < leader.request.promptTokens.count
+            else { continue }
+
+            var parked: [CBv2RequestID] = []
+            for id in plan.followers {
+                guard promptFork.leaderByFollower[id] == nil,
+                    let follower = scheduler.record(for: id),
+                    promptForkFollowerEligible(follower, boundary: plan.forkTokens),
+                    scheduler.parkPromptForkFollower(id)
+                else { continue }
+                parked.append(id)
+            }
+            guard !parked.isEmpty else { continue }
+
+            leader.promptForkBoundary = plan.forkTokens
+            promptFork.cohortsByLeader[leader.id] = CBv2PromptForkCohort(
+                leader: leader.id, followers: parked, forkTokens: plan.forkTokens)
+            for id in parked { promptFork.leaderByFollower[id] = leader.id }
+            promptFork.recordFormed()
+        }
+    }
+
+    /// Clone every cohort whose leader has reached its exact, committed
+    /// boundary. Called only after the prior in-flight step finalized.
+    func forkReadyPromptForkCohorts() {
+        guard promptFork.isActive else { return }
+        for leaderID in Array(promptFork.cohortsByLeader.keys) {
+            guard let cohort = promptFork.cohortsByLeader[leaderID],
+                let leader = scheduler.record(for: leaderID)
+            else {
+                abandonPromptForkCohort(leaderID, countLiveFollowersAsFallback: true)
+                continue
+            }
+            if leader.numComputedTokens > cohort.forkTokens
+                || leader.generatedTokenCount > 0
+            {
+                abandonPromptForkCohort(leaderID, countLiveFollowersAsFallback: true)
+                continue
+            }
+            guard leader.numComputedTokens == cohort.forkTokens else { continue }
+            forkPromptCohort(cohort, leader: leader)
+        }
+    }
+
+    /// Remove prompt-fork dependency edges before ordinary request teardown.
+    /// A cancelled leader releases its live followers to cold prefill; a
+    /// cancelled follower simply leaves the still-viable cohort.
+    func promptForkRequestWillFinish(_ id: CBv2RequestID) {
+        guard promptFork.isActive else { return }
+        if promptFork.cohortsByLeader[id] != nil {
+            abandonPromptForkCohort(id, countLiveFollowersAsFallback: true)
+            return
+        }
+        guard let leaderID = promptFork.leaderByFollower.removeValue(forKey: id),
+            var cohort = promptFork.cohortsByLeader[leaderID]
+        else { return }
+        cohort.followers.removeAll { $0 == id }
+        if cohort.followers.isEmpty {
+            promptFork.cohortsByLeader.removeValue(forKey: leaderID)
+            scheduler.record(for: leaderID)?.promptForkBoundary = nil
+            promptFork.recordAbandoned()
+        } else {
+            promptFork.cohortsByLeader[leaderID] = cohort
+        }
+    }
+
+    private func promptForkCandidateEligible(_ rec: CBv2ScheduledRequest) -> Bool {
+        guard !rec.cancelRequested, !rec.isPaused, !rec.isPromptForkFollower,
+            rec.pendingSamples == 0, rec.generatedTokenCount == 0,
+            rec.request.prefixCacheEnabled,
+            rec.request.multimodal == nil,
+            rec.request.positionState == nil,
+            rec.prefixReusePlan == nil,
+            exactFrontierLogits[rec.id] == nil,
+            rec.request.promptTokens.count > promptFork.minimumTokens
+        else { return false }
+
+        switch rec.status {
+        case .waiting:
+            return rec.numComputedTokens == 0
+                && kvStates[rec.id] == nil
+                && recurrentStates[rec.id] == nil
+        case .running:
+            return rec.numComputedTokens < rec.request.promptTokens.count
+        case .preempted, .finished(_):
+            return false
+        }
+    }
+
+    private func promptForkFollowerEligible(
+        _ rec: CBv2ScheduledRequest, boundary: Int
+    ) -> Bool {
+        rec.status == .waiting
+            && rec.numComputedTokens == 0
+            && rec.pendingSamples == 0
+            && !rec.cancelRequested
+            && !rec.isPromptForkFollower
+            && rec.request.prefixCacheEnabled
+            && rec.request.multimodal == nil
+            && rec.request.positionState == nil
+            && rec.prefixReusePlan == nil
+            && rec.request.promptTokens.count > boundary
+            && kvStates[rec.id] == nil
+            && recurrentStates[rec.id] == nil
+    }
+
+    /// Admit arrivals into an already-planned cohort when they share the
+    /// cohort's exact boundary and the leader has not crossed it.
+    private func attachPromptForkFollowers() {
+        guard !promptFork.cohortsByLeader.isEmpty else { return }
+        let waiting = scheduler.waiting
+        for leader in scheduler.running + scheduler.waiting {
+            guard var cohort = promptFork.cohortsByLeader[leader.id],
+                leader.numComputedTokens <= cohort.forkTokens
+            else { continue }
+            let prefix = leader.request.promptTokens.prefix(cohort.forkTokens)
+            for follower in waiting {
+                guard promptFork.leaderByFollower[follower.id] == nil,
+                    follower.id != leader.id,
+                    follower.request.priority == leader.request.priority,
+                    follower.request.cacheSalt == leader.request.cacheSalt,
+                    promptForkFollowerEligible(follower, boundary: cohort.forkTokens),
+                    follower.request.promptTokens.starts(with: prefix),
+                    scheduler.parkPromptForkFollower(follower.id)
+                else { continue }
+                cohort.followers.append(follower.id)
+                promptFork.leaderByFollower[follower.id] = leader.id
+            }
+            promptFork.cohortsByLeader[leader.id] = cohort
+        }
+    }
+
+    private func forkPromptCohort(
+        _ cohort: CBv2PromptForkCohort,
+        leader: CBv2ScheduledRequest
+    ) {
+        guard let forkingBackend = backend as? any CBv2ExactKVForkingBackend,
+            let leaderKV = kvStates[leader.id],
+            let leaderRecurrent = recurrentStates[leader.id],
+            leader.pendingSamples == 0
+        else {
+            abandonPromptForkCohort(leader.id, countLiveFollowersAsFallback: true)
+            return
+        }
+
+        let kvSnapshot: CBv2KVForkSnapshot
+        let recurrentSnapshot: CBv2RecurrentStateSnapshot
+        do {
+            kvSnapshot = try forkingBackend.makeForkSnapshot(
+                of: leaderKV, layerKinds: layerKinds)
+            guard kvSnapshot.tokenCount == cohort.forkTokens else {
+                throw CBv2KVError.backendIneligible(
+                    reason: "leader KV does not match prompt-fork boundary")
+            }
+            recurrentSnapshot = try leaderRecurrent.snapshotVisibleState(detaching: false)
+        } catch {
+            abandonPromptForkCohort(leader.id, countLiveFollowersAsFallback: true)
+            return
+        }
+
+        var forked: [CBv2RequestID] = []
+        var fallbackRows = 0
+        var logicalBytes = 0
+        for followerID in cohort.followers {
+            guard let follower = scheduler.record(for: followerID),
+                follower.isPromptForkFollower
+            else { continue }
+
+            var reserved = false
+            var clonedKV: [CBv2SequenceKV?]?
+            var clonedRecurrent: CBv2RecurrentRequestState?
+            do {
+                try capacity?.reserve(
+                    id: followerID, additionalTokens: cohort.forkTokens)
+                reserved = capacity != nil
+
+                let maxLength =
+                    follower.request.promptTokens.count + max(follower.request.maxTokens, 1)
+                let state = try forkingBackend.makeSequenceState(
+                    forking: kvSnapshot,
+                    layerKinds: layerKinds,
+                    maxLength: maxLength)
+                clonedKV = state
+
+                let recurrent = try CBv2RecurrentRequestState(restoring: recurrentSnapshot)
+                clonedRecurrent = recurrent
+                let existingRecurrentBytes = recurrentStates.values.reduce(0) {
+                    cbv2PromptForkSaturatingAdd($0, $1.byteCount)
+                }
+                let combined = cbv2PromptForkSaturatingAdd(
+                    backend.bytesReserved,
+                    cbv2PromptForkSaturatingAdd(existingRecurrentBytes, recurrent.byteCount))
+                guard combined <= backend.bytesCapacity else {
+                    throw CBv2KVError.capacityExhausted(
+                        needed: recurrent.byteCount,
+                        available: max(
+                            0,
+                            backend.bytesCapacity - backend.bytesReserved
+                                - existingRecurrentBytes))
+                }
+
+                kvStates[followerID] = state
+                recurrentStates[followerID] = recurrent
+                guard scheduler.activatePromptForkFollower(
+                    followerID, computedTokens: cohort.forkTokens)
+                else {
+                    kvStates.removeValue(forKey: followerID)
+                    recurrentStates.removeValue(forKey: followerID)
+                    throw CBv2RecurrentStateError.lifecycleViolation(
+                        "prompt-fork follower activation lost its parked record")
+                }
+                clonedKV = nil
+                clonedRecurrent = nil
+                forked.append(followerID)
+                let followerKVBytes = state.reduce(0) {
+                    cbv2PromptForkSaturatingAdd($0, $1?.byteCount ?? 0)
+                }
+                logicalBytes = cbv2PromptForkSaturatingAdd(
+                    logicalBytes,
+                    cbv2PromptForkSaturatingAdd(followerKVBytes, recurrent.byteCount))
+            } catch {
+                if let state = clonedKV { backend.release(state) }
+                if let recurrent = clonedRecurrent {
+                    do { try recurrent.release() } catch {
+                        preconditionFailure(
+                            "CBv2 prompt-fork recurrent cleanup failed: \(error)")
+                    }
+                }
+                if reserved {
+                    capacity?.unreserve(id: followerID, tokens: cohort.forkTokens)
+                }
+                scheduler.abandonPromptForkFollower(followerID)
+                fallbackRows += 1
+            }
+        }
+
+        leader.promptForkBoundary = nil
+        promptFork.cohortsByLeader.removeValue(forKey: leader.id)
+        for id in cohort.followers { promptFork.leaderByFollower.removeValue(forKey: id) }
+        promptFork.recordFallback(rows: fallbackRows)
+        if forked.isEmpty {
+            promptFork.recordAbandoned()
+        } else {
+            promptFork.recordFork(
+                followers: forked.count,
+                tokensSaved: cbv2PromptForkSaturatingMultiply(
+                    cohort.forkTokens, forked.count),
+                logicalBytes: logicalBytes)
+            promptFork.onForkForTesting?(leader.id, forked, cohort.forkTokens)
+        }
+    }
+
+    private func abandonPromptForkCohort(
+        _ leaderID: CBv2RequestID,
+        countLiveFollowersAsFallback: Bool
+    ) {
+        guard let cohort = promptFork.cohortsByLeader.removeValue(forKey: leaderID)
+        else { return }
+        scheduler.record(for: leaderID)?.promptForkBoundary = nil
+        var fallbackRows = 0
+        for id in cohort.followers {
+            promptFork.leaderByFollower.removeValue(forKey: id)
+            if scheduler.record(for: id) != nil {
+                scheduler.abandonPromptForkFollower(id)
+                fallbackRows += 1
+            }
+        }
+        if countLiveFollowersAsFallback {
+            promptFork.recordFallback(rows: fallbackRows)
+        }
+        promptFork.recordAbandoned()
+    }
+}
+
+private func cbv2PromptForkSaturatingAdd(_ lhs: Int, _ rhs: Int) -> Int {
+    let (sum, overflow) = lhs.addingReportingOverflow(rhs)
+    return overflow ? Int.max : sum
+}
+
+private func cbv2PromptForkSaturatingMultiply(_ lhs: Int, _ rhs: Int) -> Int {
+    let (product, overflow) = lhs.multipliedReportingOverflow(by: rhs)
+    return overflow ? Int.max : product
+}
