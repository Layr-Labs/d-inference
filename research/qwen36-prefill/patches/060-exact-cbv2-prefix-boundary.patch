+// ExactPrefixCacheV2.swift
+//
+// Default-off RAM cache for exact full-prompt boundaries of hybrid
+// attention + recurrent CBv2 models. Unlike the historical KV-only prefix
+// cache, an entry is atomic: full-attention K/V, every recurrent layer's
+// conv/SSM state, the model position, and prompt-frontier logits.
+
+import CryptoKit
+import Foundation
+import MLX
+
+/// Build a storage-owning graph node without changing a single tensor bit.
+///
+/// `array + 0` looks like a copy but is arithmetic: signed zero and NaN
+/// payloads are not covered by that contract. A full slice update copies the
+/// source bytes into a fresh destination and stays lazy until the donor
+/// step's ordinary `asyncEval`.
+enum CBv2ExactSnapshotStorage {
+    static func detached(_ array: MLXArray) -> MLXArray {
+        var result = MLXArray.zeros(array.shape, dtype: array.dtype)
+        result[.ellipsis] = array
+        return result
+    }
+}
+
+public struct CBv2ExactPrefixCacheConfig: Sendable, Equatable {
+    /// Verified model/weight/tokenizer identity. Production folds the weight // pragma: allowlist secret
+    /// root and prompt-contract digest into this string.
+    public var modelIdentity: String
+    /// Execution policy identity (backend, dtype, and snapshot format).
+    public var policyIdentity: String
+    /// Default authenticated cache scope. A request `cacheSalt` replaces it.
+    public var scopeID: String
+    /// Hard resident-byte ceiling. Entries larger than the ceiling are
+    /// refused; successful donations enforce LRU eviction immediately.
+    public var maxBytes: Int
+
+    public init(
+        modelIdentity: String,
+        policyIdentity: String = "cbv2-exact-full-prompt-v1",
+        scopeID: String = "",
+        maxBytes: Int
+    ) {
+        precondition(!modelIdentity.isEmpty, "exact prefix cache requires model identity")
+        precondition(!policyIdentity.isEmpty, "exact prefix cache requires policy identity")
+        precondition(maxBytes >= 0, "exact prefix cache budget must be nonnegative")
+        self.modelIdentity = modelIdentity
+        self.policyIdentity = policyIdentity
+        self.scopeID = scopeID
+        self.maxBytes = maxBytes
+    }
+}
+
+public struct CBv2ExactPrefixCacheStats: Sendable, Equatable {
+    public var hits: Int
+    public var misses: Int
+    public var tokensSaved: Int
+    public var donations: Int
+    public var donationsDropped: Int
+    public var evictions: Int
+    public var entryCount: Int
+    public var bytesInUse: Int
+}
+
+/// One storage-owning full-attention layer at an exact boundary.
+public struct CBv2ExactAttentionSnapshot: @unchecked Sendable {
+    public let keys: MLXArray
+    public let values: MLXArray
+    public let offset: Int
+    public let byteCount: Int
+
+    public init(
+        keys: MLXArray, values: MLXArray, offset: Int, detaching: Bool = false
+    ) throws {
+        guard offset > 0,
+            keys.ndim == 4, values.ndim == 4,
+            keys.dim(0) == 1, values.dim(0) == 1,
+            keys.dim(2) == offset, values.dim(2) == offset
+        else {
+            throw CBv2RecurrentStateError.lifecycleViolation(
+                "exact attention snapshot does not cover its model position")
+        }
+        let storedKeys = detaching ? CBv2ExactSnapshotStorage.detached(keys) : keys
+        let storedValues = detaching ? CBv2ExactSnapshotStorage.detached(values) : values
+        let (bytes, overflow) = storedKeys.nbytes.addingReportingOverflow(storedValues.nbytes)
+        guard !overflow else { throw CBv2RecurrentStateError.byteCountOverflow }
+        self.keys = storedKeys
+        self.values = storedValues
+        self.offset = offset
+        self.byteCount = bytes
+    }
+
+}
+
+/// Atomic, immutable full-prompt boundary. `attention` is aligned to the
+/// engine's compact CBv2 layer layout; recurrent layers live in
+/// `recurrentState` under their original model-layer indices.
+public struct CBv2ExactPrefixSnapshot: @unchecked Sendable {
+    public let tokenCount: Int
+    public let modelPosition: Int
+    public let attention: [CBv2ExactAttentionSnapshot?]
+    public let recurrentState: CBv2RecurrentStateSnapshot
+    /// Exact logits after the final prompt token, normalized to `[vocab]`.
+    public let frontierLogits: MLXArray
+    public let byteCount: Int
+
+    public init(
+        tokenCount: Int,
+        modelPosition: Int,
+        attention: [CBv2ExactAttentionSnapshot?],
+        recurrentState: CBv2RecurrentStateSnapshot,
+        frontierLogits: MLXArray,
+        detachingFrontier: Bool = false
+    ) throws {
+        guard tokenCount > 0, modelPosition == tokenCount else {
+            throw CBv2RecurrentStateError.lifecycleViolation(
+                "exact prefix snapshot must be a full-prompt model boundary")
+        }
+        let frontier: MLXArray
+        switch frontierLogits.ndim {
+        case 1:
+            frontier = frontierLogits
+        case 2 where frontierLogits.dim(0) == 1:
+            frontier = frontierLogits[0]
+        default:
+            throw CBv2RecurrentStateError.lifecycleViolation(
+                "exact prefix frontier logits must be [vocab] or [1, vocab]")
+        }
+        guard frontier.dim(0) > 0 else {
+            throw CBv2RecurrentStateError.lifecycleViolation(
+                "exact prefix frontier logits cannot be empty")
+        }
+        let storedFrontier =
+            detachingFrontier
+            ? CBv2ExactSnapshotStorage.detached(frontier)
+            : frontier
+
+        var bytes = recurrentState.byteCount
+        for snapshot in attention {
+            guard let snapshot else { continue }
+            let (sum, overflow) = bytes.addingReportingOverflow(snapshot.byteCount)
+            guard !overflow else { throw CBv2RecurrentStateError.byteCountOverflow }
+            bytes = sum
+        }
+        let (total, overflow) = bytes.addingReportingOverflow(storedFrontier.nbytes)
+        guard !overflow else { throw CBv2RecurrentStateError.byteCountOverflow }
+
+        self.tokenCount = tokenCount
+        self.modelPosition = modelPosition
+        self.attention = attention
+        self.recurrentState = recurrentState
+        self.frontierLogits = storedFrontier
+        self.byteCount = total
+    }
+
+    /// Every detached root that must ride the donor prefill's `asyncEval`.
+    public var evaluationArrays: [MLXArray] {
+        var arrays: [MLXArray] = []
+        arrays.reserveCapacity(attention.count * 2 + recurrentState.layers.count * 2 + 1)
+        for snapshot in attention {
+            guard let snapshot else { continue }
+            arrays.append(snapshot.keys)
+            arrays.append(snapshot.values)
+        }
+        arrays.append(contentsOf: recurrentState.evaluationArrays)
+        arrays.append(frontierLogits)
+        return arrays
+    }
+}
+
+/// Additive exact-state surface. It extends `CBv2PrefixCache` so existing
+/// engine construction stays source-compatible, while the engine can require
+/// this stronger contract before enabling recurrent prefix reuse.
+public protocol CBv2ExactStatePrefixCache: CBv2PrefixCache {
+    func lookupExact(
+        requestID: CBv2RequestID,
+        tokens: [Int],
+        layerKinds: [CBv2LayerKind],
+        recurrentStateSpec: CBv2RecurrentStateSpec,
+        cacheSalt: String?
+    ) -> CBv2ExactPrefixSnapshot?
+
+    /// Ownership transfer of a fully materialized immutable snapshot.
+    func donateExact(
+        requestID: CBv2RequestID,
+        tokens: [Int],
+        snapshot: CBv2ExactPrefixSnapshot,
+        layerKinds: [CBv2LayerKind],
+        cacheSalt: String?)
+
+    /// Cheap pre-copy budget gate. False means an entry cannot survive the
+    /// cache's hard budget even with every other entry evicted.
+    func acceptsExactDonation(byteCount: Int) -> Bool
+}
+
+/// Thread-safe exact full-prompt RAM cache with deterministic LRU.
+public final class ExactPrefixCacheV2: CBv2ExactStatePrefixCache, @unchecked Sendable {
+    private final class Entry {
+        let key: Data
+        let snapshot: CBv2ExactPrefixSnapshot
+        let bytes: Int
+        var lastAccess: UInt64
+        var refInUse = 0
+
+        init(
+            key: Data, snapshot: CBv2ExactPrefixSnapshot, lastAccess: UInt64
+        ) {
+            self.key = key
+            self.snapshot = snapshot
+            self.bytes = snapshot.byteCount
+            self.lastAccess = lastAccess
+        }
+    }
+
+    public let config: CBv2ExactPrefixCacheConfig
+
+    private let lock = NSLock()
+    private var entries: [Data: Entry] = [:]
+    private var tick: UInt64 = 0
+    private var residentBytes = 0
+    private var hitCount = 0
+    private var missCount = 0
+    private var savedTokens = 0
+    private var donationCount = 0
+    private var droppedDonationCount = 0
+    private var evictionCount = 0
+
+    public init(config: CBv2ExactPrefixCacheConfig) {
+        self.config = config
+    }
+
+    // MARK: Exact-state lookup/donation
+
+    public func lookupExact(
+        requestID _: CBv2RequestID,
+        tokens: [Int],
+        layerKinds: [CBv2LayerKind],
+        recurrentStateSpec: CBv2RecurrentStateSpec,
+        cacheSalt: String?
+    ) -> CBv2ExactPrefixSnapshot? {
+        guard let key = key(tokens: tokens, cacheSalt: cacheSalt) else {
+            recordMiss()
+            return nil
+        }
+        lock.lock()
+        defer { lock.unlock() }
+        guard let entry = entries[key],
+            entry.snapshot.tokenCount == tokens.count,
+            entry.snapshot.modelPosition == tokens.count,
+            entry.snapshot.attention.count == layerKinds.count,
+            entry.snapshot.recurrentState.spec == recurrentStateSpec,
+            Self.layoutMatches(snapshot: entry.snapshot, layerKinds: layerKinds)
+        else {
+            missCount = Self.saturatingAdd(missCount, 1)
+            return nil
+        }
+        tick &+= 1
+        entry.lastAccess = tick
+        entry.refInUse += 1
+        hitCount = Self.saturatingAdd(hitCount, 1)
+        savedTokens = Self.saturatingAdd(savedTokens, tokens.count)
+        return entry.snapshot
+    }
+
+    public func donateExact(
+        requestID _: CBv2RequestID,
+        tokens: [Int],
+        snapshot: CBv2ExactPrefixSnapshot,
+        layerKinds: [CBv2LayerKind],
+        cacheSalt: String?
+    ) {
+        guard snapshot.tokenCount == tokens.count,
+            snapshot.modelPosition == tokens.count,
+            snapshot.attention.count == layerKinds.count,
+            Self.layoutMatches(snapshot: snapshot, layerKinds: layerKinds),
+            acceptsExactDonation(byteCount: snapshot.byteCount),
+            let key = key(tokens: tokens, cacheSalt: cacheSalt)
+        else {
+            lock.lock()
+            droppedDonationCount = Self.saturatingAdd(droppedDonationCount, 1)
+            lock.unlock()
+            return
+        }
+
+        lock.lock()
+        defer { lock.unlock() }
+        if let existing = entries[key] {
+            tick &+= 1
+            existing.lastAccess = tick
+            return
+        }
+        // Make room BEFORE publishing the entry. Pinned adopters may prevent
+        // eviction; in that case the donation is refused rather than letting
+        // resident bytes cross the configured hard ceiling.
+        evictLocked(toFit: config.maxBytes - snapshot.byteCount)
+        guard residentBytes <= config.maxBytes - snapshot.byteCount else {
+            droppedDonationCount = Self.saturatingAdd(droppedDonationCount, 1)
+            return
+        }
+        let (newResidentBytes, overflow) = residentBytes.addingReportingOverflow(
+            snapshot.byteCount)
+        guard !overflow, newResidentBytes <= config.maxBytes else {
+            droppedDonationCount = Self.saturatingAdd(droppedDonationCount, 1)
+            return
+        }
+        tick &+= 1
+        let entry = Entry(key: key, snapshot: snapshot, lastAccess: tick)
+        entries[key] = entry
+        residentBytes = newResidentBytes
+        donationCount = Self.saturatingAdd(donationCount, 1)
+    }
+
+    public func acceptsExactDonation(byteCount: Int) -> Bool {
+        byteCount >= 0 && byteCount <= config.maxBytes
+    }
+
+    // MARK: Adoption pin lifecycle
+
+    public func endAdoption(tokens: [Int], matched: Int) {
+        endAdoption(tokens: tokens, matched: matched, cacheSalt: nil)
+    }
+
+    public func endAdoption(tokens: [Int], matched: Int, cacheSalt: String?) {
+        guard matched == tokens.count, let key = key(tokens: tokens, cacheSalt: cacheSalt) else {
+            return
+        }
+        lock.lock()
+        defer { lock.unlock() }
+        guard let entry = entries[key] else { return }
+        entry.refInUse = max(0, entry.refInUse - 1)
+        if residentBytes > config.maxBytes {
+            evictLocked(toFit: config.maxBytes)
+        }
+    }
+
+    // MARK: Historical KV-only protocol (intentionally unavailable)
+
+    public func lookup(
+        tokens _: [Int], layerKinds _: [CBv2LayerKind]
+    ) -> (matched: Int, prefix: [(keys: MLXArray, values: MLXArray, offset: Int)?])? {
+        nil
+    }
+
+    public func donate(
+        tokens _: [Int], state _: [CBv2SequenceKV?], layerKinds _: [CBv2LayerKind]
+    ) {}
+
+    public func donate(
+        tokens _: [Int],
+        snapshots _: [(keys: MLXArray, values: MLXArray, offset: Int)?],
+        layerKinds _: [CBv2LayerKind]
+    ) {}
+
+    // MARK: Accounting and eviction
+
+    public func evict(toFit byteBudget: Int) {
+        lock.lock()
+        defer { lock.unlock() }
+        evictLocked(toFit: max(0, byteBudget))
+    }
+
+    public var bytesInUse: Int {
+        lock.lock()
+        defer { lock.unlock() }
+        return residentBytes
+    }
+
+    public func stats() -> CBv2ExactPrefixCacheStats {
+        lock.lock()
+        defer { lock.unlock() }
+        return CBv2ExactPrefixCacheStats(
+            hits: hitCount,
+            misses: missCount,
+            tokensSaved: savedTokens,
+            donations: donationCount,
+            donationsDropped: droppedDonationCount,
+            evictions: evictionCount,
+            entryCount: entries.count,
+            bytesInUse: residentBytes)
+    }
+
+    private func evictLocked(toFit budget: Int) {
+        while residentBytes > budget {
+            guard
+                let victim = entries.values
+                    .filter({ $0.refInUse == 0 })
+                    .min(by: { $0.lastAccess < $1.lastAccess })
+            else { return }
+            entries.removeValue(forKey: victim.key)
+            residentBytes -= victim.bytes
+            evictionCount = Self.saturatingAdd(evictionCount, 1)
+        }
+    }
+
+    // MARK: Key and layout contracts
+
+    private func recordMiss() {
+        lock.lock()
+        missCount = Self.saturatingAdd(missCount, 1)
+        lock.unlock()
+    }
+
+    private func key(tokens: [Int], cacheSalt: String?) -> Data? {
+        guard !tokens.isEmpty,
+            tokens.count <= Int(UInt32.max),
+            tokens.allSatisfy({ $0 >= 0 && UInt64($0) <= UInt64(UInt32.max) })
+        else { return nil }
+        let model = Data(config.modelIdentity.utf8)
+        let policy = Data(config.policyIdentity.utf8)
+        let scope = Data((cacheSalt ?? config.scopeID).utf8)
+        guard model.count <= Int(UInt32.max),
+            policy.count <= Int(UInt32.max),
+            scope.count <= Int(UInt32.max)
+        else { return nil }
+
+        var input = Data("darkbloom.cbv2-exact-prefix.v1".utf8)
+        Self.appendLengthPrefixed(model, to: &input)
+        Self.appendLengthPrefixed(policy, to: &input)
+        Self.appendLengthPrefixed(scope, to: &input)
+        Self.appendUInt32(UInt32(tokens.count), to: &input)
+        for token in tokens {
+            Self.appendUInt32(UInt32(token), to: &input)
+        }
+        return Data(SHA256.hash(data: input))
+    }
+
+    private static func layoutMatches(
+        snapshot: CBv2ExactPrefixSnapshot, layerKinds: [CBv2LayerKind]
+    ) -> Bool {
+        guard snapshot.attention.count == layerKinds.count else { return false }
+        var owningFullLayers = 0
+        for (index, kind) in layerKinds.enumerated() {
+            // v1 is intentionally Qwen-shaped: full-attention storage only.
+            // Sliding-window restore remains on the historical replay path.
+            guard kind.sharesKVWithLayer == nil, case .full = kind.attention,
+                let attention = snapshot.attention[index],
+                attention.offset == snapshot.modelPosition,
+                attention.keys.dim(1) == kind.kvHeads,
+                attention.values.dim(1) == kind.kvHeads,
+                attention.keys.dim(3) == kind.headDim,
+                attention.values.dim(3) == kind.headDim
+            else { return false }
+            owningFullLayers += 1
+        }
+        return owningFullLayers > 0
+    }
+
+    private static func appendLengthPrefixed(_ value: Data, to output: inout Data) {
+        appendUInt32(UInt32(value.count), to: &output)
+        output.append(value)
+    }
+
+    private static func appendUInt32(_ value: UInt32, to output: inout Data) {
+        var bigEndian = value.bigEndian
+        withUnsafeBytes(of: &bigEndian) { output.append(contentsOf: $0) }
+    }
+
+    private static func saturatingAdd(_ lhs: Int, _ rhs: Int) -> Int {
+        let (sum, overflow) = lhs.addingReportingOverflow(rhs)
+        return overflow ? Int.max : sum
+    }
+}
