@@ -0,0 +1,33 @@
+import Darwin
+import Foundation
+import Testing
+@testable import lume
+
+@Suite("Darkbloom canonical private paths")
+struct DarkbloomPrivatePathTests {
+    @Test func systemTemporaryAliasAndCanonicalPathAreBothAccepted() throws {
+        let name = "darkbloom-alias-\(UUID().uuidString)"
+        let canonical = "/private/tmp/" + name
+        let alias = "/tmp/" + name
+        try FileManager.default.createDirectory(atPath: canonical, withIntermediateDirectories: false,
+                                                attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(atPath: canonical) }
+        #expect(DarkbloomPrivatePath.canonicalPath(alias) == canonical)
+        #expect(DarkbloomPrivatePath.canonicalPath(canonical) == canonical)
+        try DarkbloomPrivatePath.openDirectory(alias).withDescriptor { _ in }
+        try DarkbloomPrivatePath.openDirectory(canonical).withDescriptor { _ in }
+    }
+
+    @Test func arbitraryDirectorySymlinksAndTraversalAreRejected() throws {
+        let root = "/private/tmp/darkbloom-path-\(UUID().uuidString)"
+        try FileManager.default.createDirectory(atPath: root, withIntermediateDirectories: false,
+                                                attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(atPath: root) }
+        try FileManager.default.createDirectory(atPath: root + "/real", withIntermediateDirectories: false,
+                                                attributes: [.posixPermissions: 0o700])
+        try FileManager.default.createSymbolicLink(atPath: root + "/alias", withDestinationPath: root + "/real")
+        #expect(DarkbloomPrivatePath.canonicalPath(root + "/alias") == nil)
+        #expect(DarkbloomPrivatePath.canonicalPath(root + "/real/../real") == nil)
+        #expect(throws: (any Error).self) { try DarkbloomPrivatePath.openDirectory(root + "/alias").withDescriptor { _ in } }
+    }
+}
