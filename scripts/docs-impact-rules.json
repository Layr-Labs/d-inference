        "coordinator/internal/registry/connectiontime/**",
        "coordinator/internal/registry/capacityquote/**",
        "coordinator/internal/registry/performance/**",
        "coordinator/internal/registry/warmplan/**",
        "coordinator/internal/registry/swapplan/**",
        "coordinator/internal/registry/pendingload/**",
        "coordinator/internal/registry/reservation/**",
        "coordinator/internal/registry/serviceretirement/**",
        "coordinator/internal/registry/queuewait/**",
        "coordinator/internal/registry/providerwrite/**",
        "coordinator/internal/registry/writertransport/**",
        "coordinator/internal/registry/writedeadline/**",
