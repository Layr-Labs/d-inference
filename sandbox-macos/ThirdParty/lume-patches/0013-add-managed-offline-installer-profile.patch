diff --git a/libs/lume/tests/DarkbloomInstallerDevicePolicyTests.swift b/libs/lume/tests/DarkbloomInstallerDevicePolicyTests.swift
new file mode 100644
index 0000000..653bf1c
--- /dev/null
+++ b/libs/lume/tests/DarkbloomInstallerDevicePolicyTests.swift
@@ -0,0 +1,130 @@
+import Darwin
+import Foundation
+import Testing
+import Virtualization
+@testable import lume
+
+@Suite("Darkbloom managed offline installer devices")
+@MainActor
+struct DarkbloomInstallerDevicePolicyTests {
+    private let environment = [DarkbloomDevicePolicy.environmentKey: DarkbloomDevicePolicy.installerProfile]
+
+    @Test func installerHasOnlyItsBootDiskAndNoHostOrGuestBridgeDevices() throws {
+        let fixture = try Fixture(), config = try fixture.configuration()
+        config.networkDevices = [VZVirtioNetworkDeviceConfiguration()]
+        config.audioDevices = [VZVirtioSoundDeviceConfiguration()]
+        config.consoleDevices = [VZVirtioConsoleDeviceConfiguration()]
+        config.serialPorts = [VZVirtioConsoleDeviceSerialPortConfiguration()]
+        config.directorySharingDevices = [VZVirtioFileSystemDeviceConfiguration(tag: "unwanted")]
+        config.keyboards = [VZUSBKeyboardConfiguration()]
+        config.pointingDevices = [VZUSBScreenCoordinatePointingDeviceConfiguration()]
+        config.socketDevices = [VZVirtioSocketDeviceConfiguration()]
+        if #available(macOS 15.0, *) { config.usbControllers = [VZXHCIControllerConfiguration()] }
+        try DarkbloomDevicePolicy.apply(to: config, context: fixture.context(), environment: environment)
+        #expect(config.storageDevices.count == 1)
+        let attachment = (config.storageDevices[0] as? VZVirtioBlockDeviceConfiguration)?.attachment as? VZDiskImageStorageDeviceAttachment
+        #expect(attachment?.url == fixture.boot.url && attachment?.isReadOnly == false)
+        #expect(config.networkDevices.isEmpty && config.audioDevices.isEmpty && config.consoleDevices.isEmpty)
+        #expect(config.serialPorts.isEmpty && config.directorySharingDevices.isEmpty)
+        #expect(config.keyboards.isEmpty && config.pointingDevices.isEmpty && config.socketDevices.isEmpty)
+        if #available(macOS 15.0, *) { #expect(config.usbControllers.isEmpty) }
+    }
+
+    @Test func installerRequiresBrokerAndRejectsEveryExtraDeviceOrStorageOverride() throws {
+        let fixture = try Fixture()
+        for violation in 0..<12 {
+            #expect(throws: DarkbloomDevicePolicyError.self) {
+                try DarkbloomDevicePolicy.validateInvocation(hasBrokerLifecycle: violation != 0,
+                    detached: violation == 1, displayDisabled: violation != 2, vncDisabled: violation != 3,
+                    clipboard: violation == 4, recovery: violation == 5,
+                    sharedDirectoryCount: violation == 6 ? 1 : 0, usbCount: violation == 7 ? 1 : 0,
+                    networkOverride: violation == 8, control: violation == 9 ? fixture.boot : nil,
+                    disks: violation == 10 ? [fixture.boot] : [], storageOverride: violation == 11,
+                    environment: environment)
+            }
+        }
+        for disks: [Path]? in [nil, []] {
+            try DarkbloomDevicePolicy.validateInvocation(hasBrokerLifecycle: true, detached: false,
+                displayDisabled: true, vncDisabled: true, clipboard: false, recovery: false,
+                sharedDirectoryCount: 0, usbCount: 0, networkOverride: false, control: nil,
+                disks: disks, environment: environment)
+        }
+    }
+
+    @Test func installerRejectsWrongBlockPermissionsAndDeviceCount() throws {
+        let fixture = try Fixture()
+        for kind in 0..<3 {
+            let config = try fixture.configuration(readOnly: kind == 0)
+            if kind == 1 { config.storageDevices = [] }
+            if kind == 2 { config.storageDevices.append(config.storageDevices[0]) }
+            #expect(throws: DarkbloomDevicePolicyError.self) {
+                try DarkbloomDevicePolicy.apply(to: config, context: fixture.context(), environment: environment)
+            }
+        }
+    }
+
+    @Test func installerStorageRejectsSharedModeLinksAndAdditionalMedia() throws {
+        let fixture = try Fixture()
+        func check() throws {
+            try DarkbloomDevicePolicy.validateManagedStorage(boot: fixture.boot, control: nil, disks: nil, environment: environment)
+        }
+        try check()
+        #expect(chmod(fixture.boot.path, 0o644) == 0)
+        #expect(throws: DarkbloomDevicePolicyError.self) { try check() }
+        #expect(chmod(fixture.boot.path, 0o600) == 0)
+        let alias = fixture.root.appendingPathComponent("alias.img")
+        #expect(link(fixture.boot.path, alias.path) == 0)
+        #expect(throws: DarkbloomDevicePolicyError.self) { try check() }
+        #expect(unlink(alias.path) == 0)
+        try check()
+        #expect(throws: DarkbloomDevicePolicyError.self) {
+            try DarkbloomDevicePolicy.validateManagedStorage(boot: fixture.boot, control: fixture.boot, disks: nil, environment: environment)
+        }
+        #expect(throws: DarkbloomDevicePolicyError.self) {
+            try DarkbloomDevicePolicy.validateManagedStorage(boot: fixture.boot, control: nil, disks: [fixture.boot], environment: environment)
+        }
+    }
+
+    @Test func installerRequiresMacOSAndManagedAuthorityButNeverGuestBridge() throws {
+        #expect(try DarkbloomDevicePolicy.isManagedOffline(environment: environment))
+        #expect(try !DarkbloomDevicePolicy.isIsolated(environment: environment))
+        try DarkbloomDevicePolicy.validateOperatingSystem("macOS", environment: environment)
+        for os in ["linux", "unknown", ""] {
+            #expect(throws: DarkbloomDevicePolicyError.self) {
+                try DarkbloomDevicePolicy.validateOperatingSystem(os, environment: environment)
+            }
+        }
+        let tenant = [DarkbloomDevicePolicy.environmentKey: DarkbloomDevicePolicy.isolatedProfile]
+        #expect(try DarkbloomDevicePolicy.isManagedOffline(environment: tenant))
+        #expect(try DarkbloomDevicePolicy.isIsolated(environment: tenant))
+        #expect(try !DarkbloomDevicePolicy.isManagedOffline(environment: [:]))
+        #expect(throws: DarkbloomDevicePolicyError.self) {
+            try DarkbloomDevicePolicy.isManagedOffline(environment: [DarkbloomDevicePolicy.environmentKey: "installer-v2"])
+        }
+    }
+
+    private final class Fixture {
+        let root: URL
+        let boot: Path
+        init() throws {
+            root = URL(fileURLWithPath: "/private/tmp").appendingPathComponent(".db-installer-\(UUID().uuidString)")
+            try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+            boot = Path(root.appendingPathComponent("disk.img").path)
+            guard FileManager.default.createFile(atPath: boot.path, contents: Data(repeating: 0, count: 512),
+                attributes: [.posixPermissions: 0o600]) else { throw POSIXError(.EIO) }
+        }
+        deinit { try? FileManager.default.removeItem(at: root) }
+        func configuration(readOnly: Bool = false) throws -> VZVirtualMachineConfiguration {
+            let config = VZVirtualMachineConfiguration()
+            config.storageDevices = [VZVirtioBlockDeviceConfiguration(attachment:
+                try VZDiskImageStorageDeviceAttachment(url: boot.url, readOnly: readOnly))]
+            return config
+        }
+        func context() -> VMVirtualizationServiceContext {
+            .init(cpuCount: 2, memorySize: 4 << 30, display: "1024x768", sharedDirectories: nil,
+                mount: nil, hardwareModel: nil, machineIdentifier: nil, macAddress: "02:00:00:00:00:01",
+                diskPath: boot, nvramPath: Path(root.appendingPathComponent("nvram.bin").path),
+                recoveryMode: false, usbMassStoragePaths: nil, additionalDiskPaths: nil, networkMode: .nat)
+        }
+    }
+}
