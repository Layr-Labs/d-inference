diff --git a/Libraries/MLXLLM/Models/Qwen35CBv2PrefillLayerPolicy.swift b/Libraries/MLXLLM/Models/Qwen35CBv2PrefillLayerPolicy.swift
new file mode 100644
index 0000000..7122d7a
--- /dev/null
+++ b/Libraries/MLXLLM/Models/Qwen35CBv2PrefillLayerPolicy.swift
@@ -0,0 +1,125 @@
+import Foundation
+
+/// The Qwen target phases that traverse the CBv2 decoder stack.
+///
+/// Keeping this explicit prevents a multi-token MTP verify from being
+/// mistaken for prefill based on tensor shape.
+public enum Qwen35CBv2ForwardPhase: Equatable, Sendable {
+    case prefill
+    case decode
+    case mtp
+}
+
+/// Default-off fixed-layer experiment for Qwen3.5/3.6 CBv2 prefill.
+///
+/// A stride keeps zero-based layers `0, stride, 2*stride, ...`; the optional
+/// explicit list/ranges are unioned with those layers. Decode and MTP always
+/// execute every layer regardless of the resolved prefill set.
+public struct Qwen35CBv2PrefillLayerPolicy: Equatable, Sendable {
+    public static let keepStrideEnvironmentKey =
+        "DARKBLOOM_QWEN35_CBV2_PREFILL_KEEP_STRIDE"
+    public static let keepLayersEnvironmentKey =
+        "DARKBLOOM_QWEN35_CBV2_PREFILL_KEEP_LAYERS"
+
+    public static let disabled = Qwen35CBv2PrefillLayerPolicy()
+
+    public let layerCount: Int
+    public let keepStride: Int?
+    public let explicitKeepLayers: Set<Int>
+    public let keptLayers: Set<Int>
+    public let isEnabled: Bool
+
+    private init(
+        layerCount: Int = 0,
+        keepStride: Int? = nil,
+        explicitKeepLayers: Set<Int> = [],
+        keptLayers: Set<Int> = [],
+        isEnabled: Bool = false
+    ) {
+        self.layerCount = layerCount
+        self.keepStride = keepStride
+        self.explicitKeepLayers = explicitKeepLayers
+        self.keptLayers = keptLayers
+        self.isEnabled = isEnabled
+    }
+
+    /// Resolve the process-start experiment knobs.
+    ///
+    /// Neither key means disabled. If either present key is empty, malformed,
+    /// or out of range, the entire policy fails closed to all layers.
+    public static func fromEnvironment(
+        _ environment: [String: String] = ProcessInfo.processInfo.environment,
+        layerCount: Int
+    ) -> Qwen35CBv2PrefillLayerPolicy {
+        let rawStride = environment[keepStrideEnvironmentKey]
+        let rawLayers = environment[keepLayersEnvironmentKey]
+        guard rawStride != nil || rawLayers != nil, layerCount > 0 else {
+            return .disabled
+        }
+
+        var keptLayers: Set<Int> = []
+        var keepStride: Int?
+        if let rawStride {
+            let value = rawStride.trimmingCharacters(in: .whitespacesAndNewlines)
+            guard
+                let stride = Int(value),
+                (1 ... layerCount).contains(stride)
+            else {
+                return .disabled
+            }
+            keepStride = stride
+            keptLayers.formUnion(Swift.stride(from: 0, to: layerCount, by: stride))
+        }
+
+        var explicitKeepLayers: Set<Int> = []
+        if let rawLayers {
+            guard
+                let parsed = Qwen35LayerSelectionParser.parse(
+                    rawLayers, layerCount: layerCount, allowsEmpty: false)
+            else {
+                return .disabled
+            }
+            explicitKeepLayers = parsed
+            keptLayers.formUnion(parsed)
+        }
+
+        guard !keptLayers.isEmpty else { return .disabled }
+        return Qwen35CBv2PrefillLayerPolicy(
+            layerCount: layerCount,
+            keepStride: keepStride,
+            explicitKeepLayers: explicitKeepLayers,
+            keptLayers: keptLayers,
+            isEnabled: true)
+    }
+
+    /// Whether one model layer executes for this explicitly supplied phase.
+    ///
+    /// Unknown indices and every non-prefill phase fail closed to execution.
+    public func shouldExecute(
+        layerIndex: Int,
+        phase: Qwen35CBv2ForwardPhase
+    ) -> Bool {
+        guard
+            isEnabled,
+            phase == .prefill,
+            (0 ..< layerCount).contains(layerIndex)
+        else {
+            return true
+        }
+        return keptLayers.contains(layerIndex)
+    }
+
+    public var skippedLayers: Set<Int> {
+        guard isEnabled else { return [] }
+        return Set(0 ..< layerCount).subtracting(keptLayers)
+    }
+
+    public var descriptor: String {
+        guard isEnabled else { return "disabled" }
+        let keep = keptLayers.sorted().map(String.init).joined(separator: ",")
+        let skip = skippedLayers.sorted().map(String.init).joined(separator: ",")
+        let stride = keepStride.map(String.init) ?? "none"
+        let explicit = explicitKeepLayers.sorted().map(String.init).joined(separator: ",")
+        return "keep=\(keep);skip=\(skip);stride=\(stride);list=\(explicit)"
+    }
+}
diff --git a/Libraries/MLXLLM/Models/Qwen35LayerSelectionParser.swift b/Libraries/MLXLLM/Models/Qwen35LayerSelectionParser.swift
new file mode 100644
index 0000000..08d7eb0
--- /dev/null
+++ b/Libraries/MLXLLM/Models/Qwen35LayerSelectionParser.swift
@@ -0,0 +1,50 @@
+import Foundation
+
+/// Strict parser shared by Qwen3.5/3.6 layer-scoped research policies.
+///
+/// Layer indices are zero-based. Terms are comma-separated indices or closed
+/// ranges (`0,3-5,39`). Any malformed or out-of-range term invalidates the
+/// entire policy so callers can fail closed to the checkpoint behavior.
+enum Qwen35LayerSelectionParser {
+    static func parse(
+        _ raw: String,
+        layerCount: Int,
+        allowsEmpty: Bool
+    ) -> Set<Int>? {
+        guard layerCount > 0 else { return nil }
+
+        let value = raw.trimmingCharacters(in: .whitespacesAndNewlines)
+        if value.isEmpty {
+            return allowsEmpty ? [] : nil
+        }
+
+        var result: Set<Int> = []
+        for part in value.split(separator: ",", omittingEmptySubsequences: false) {
+            let term = part.trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !term.isEmpty else { return nil }
+
+            let bounds = term.split(separator: "-", omittingEmptySubsequences: false)
+            switch bounds.count {
+            case 1:
+                guard let layer = Int(bounds[0]), (0 ..< layerCount).contains(layer) else {
+                    return nil
+                }
+                result.insert(layer)
+            case 2:
+                guard
+                    let lower = Int(bounds[0]),
+                    let upper = Int(bounds[1]),
+                    lower <= upper,
+                    lower >= 0,
+                    upper < layerCount
+                else {
+                    return nil
+                }
+                result.formUnion(lower ... upper)
+            default:
+                return nil
+            }
+        }
+        return result
+    }
+}
