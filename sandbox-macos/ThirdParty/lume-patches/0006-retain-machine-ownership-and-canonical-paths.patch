@@ -0,0 +1,128 @@
+import Darwin
+import Foundation
+
+/// Pins machine-exclusive ownership in the actual VM process. Process lifetime
+/// retention is deliberate: an inconclusive stop must not release this lock
+/// before the broker-lifecycle fail-stop has terminated the remaining VM owner.
+@MainActor
+enum DarkbloomRuntimeAuthority {
+    static let environmentVariable = "DARKBLOOM_HOST_RUNTIME_FD"
+    static let inheritedDescriptor: Int32 = 4
+    static let authorityDirectory = "/Library/Application Support/Darkbloom/runtime"
+    private static var retainedLease: DarkbloomRuntimeLease?
+
+    static func retainInheritedIfIsolated() throws {
+        guard try DarkbloomDevicePolicy.isIsolated() else { return }
+        if let retainedLease { try retainedLease.validate(); return }
+        guard ProcessInfo.processInfo.environment[environmentVariable] == String(inheritedDescriptor) else {
+            throw DarkbloomDevicePolicyError.invalidConfiguration("isolated VM requires inherited machine ownership")
+        }
+        unsetenv(environmentVariable)
+        retainedLease = try DarkbloomRuntimeLease(
+            adopting: inheritedDescriptor, authorityDirectory: authorityDirectory
+        )
+    }
+}
+
+final class DarkbloomRuntimeLease {
+    private let descriptor: Int32
+    private let directory: String
+    private let owner: uid_t
+    private let group: gid_t
+    private let testing: Bool
+    private let directoryIdentity: stat
+
+    /// Path/owner injection exists only for unit fixtures. Production has no
+    /// command-line or environment override for its root-provisioned authority.
+    init(adopting descriptor: Int32, authorityDirectory: String,
+         testOwner: uid_t? = nil, testGroup: gid_t? = nil) throws {
+        var adopted = false
+        defer { if !adopted { close(descriptor) } }
+        self.descriptor = descriptor
+        directory = authorityDirectory
+        owner = testOwner ?? 0
+        testing = testOwner != nil
+        if let testGroup { group = testGroup }
+        else {
+            guard let entry = getgrnam("darkbloom_runtime"), entry.pointee.gr_gid != 0 else {
+                throw Self.invalid()
+            }
+            group = entry.pointee.gr_gid
+        }
+        let parent = try Self.openDirectory(directory, owner: owner, testing: testing)
+        defer { close(parent) }
+        directoryIdentity = try Self.metadata(parent)
+        try Self.validate(descriptor, parent: parent, owner: owner, group: group)
+        while flock(descriptor, LOCK_EX | LOCK_NB) != 0 {
+            if errno == EINTR { continue }
+            throw Self.invalid()
+        }
+        let flags = fcntl(descriptor, F_GETFD)
+        guard flags >= 0, fcntl(descriptor, F_SETFD, flags | FD_CLOEXEC) == 0 else {
+            throw Self.invalid()
+        }
+        adopted = true
+    }
+
+    deinit { close(descriptor) } // Never LOCK_UN: the broker/other VMs share this open description.
+
+    func validate() throws {
+        let parent = try Self.openDirectory(directory, owner: owner, testing: testing)
+        defer { close(parent) }
+        let current = try Self.metadata(parent)
+        guard current.st_dev == directoryIdentity.st_dev, current.st_ino == directoryIdentity.st_ino else {
+            throw Self.invalid()
+        }
+        try Self.validate(descriptor, parent: parent, owner: owner, group: group)
+    }
+
+    private static func validate(_ descriptor: Int32, parent: Int32, owner: uid_t, group: gid_t) throws {
+        let held = try metadata(descriptor)
+        var named = stat()
+        guard held.st_mode & S_IFMT == S_IFREG, held.st_mode & 0o777 == 0o660,
+              held.st_uid == owner, held.st_gid == group, held.st_nlink == 1, held.st_size == 0,
+              fstatat(parent, "ownership.lock", &named, AT_SYMLINK_NOFOLLOW) == 0,
+              named.st_dev == held.st_dev, named.st_ino == held.st_ino else { throw invalid() }
+        try DarkbloomPrivatePath.requireNoACL(descriptor)
+    }
+
+    private static func openDirectory(_ original: String, owner: uid_t, testing: Bool) throws -> Int32 {
+        let normalized = URL(fileURLWithPath: original).standardizedFileURL.path
+        let alias = ["/var", "/tmp"].contains { normalized == $0 || normalized.hasPrefix($0 + "/") }
+        guard original.hasPrefix("/"), !original.contains("\0"),
+              original == normalized || (alias && original == "/private" + normalized) else { throw invalid() }
+        let path = alias ? "/private" + normalized : original
+        let components = path.split(separator: "/").map(String.init)
+        guard !components.isEmpty else { throw invalid() }
+        var descriptor = open("/", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
+        guard descriptor >= 0 else { throw invalid() }
+        do {
+            for (index, component) in components.enumerated() {
+                let next = openat(descriptor, component, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
+                guard next >= 0 else { throw invalid() }
+                do {
+                    let info = try metadata(next)
+                    let fixtureTemporary = testing && index < components.count - 1
+                        && info.st_uid == 0 && info.st_mode & mode_t(S_ISTXT) != 0
+                    guard info.st_mode & S_IFMT == S_IFDIR,
+                          info.st_uid == 0 || (testing && info.st_uid == owner),
+                          info.st_mode & 0o022 == 0 || fixtureTemporary else { throw invalid() }
+                    try DarkbloomPrivatePath.requireNoACL(next)
+                } catch { close(next); throw error }
+                close(descriptor)
+                descriptor = next
+            }
+            return descriptor
+        } catch { close(descriptor); throw error }
+    }
+
+    private static func metadata(_ descriptor: Int32) throws -> stat {
+        var metadata = stat()
+        guard fstat(descriptor, &metadata) == 0 else { throw invalid() }
+        return metadata
+    }
+
+    private static func invalid() -> DarkbloomDevicePolicyError {
+        .invalidConfiguration("inherited machine runtime ownership is missing, occupied or unsafe")
+    }
+}
