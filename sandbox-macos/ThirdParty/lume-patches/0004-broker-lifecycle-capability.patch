@@ -1,3 +1,5 @@
+import Darwin
+import Dispatch
 import Foundation
 import Testing

@@ -7,6 +9,72 @@ private enum PresenterTestError: Error {
   case showFailed
 }

+private func makeBrokerLifecycleCapability(
+  failStopDeadline: DispatchTimeInterval = .seconds(30),
+  failStopAction: @escaping @Sendable () -> Void = {}
+)
+  throws -> (owner: Int32, capability: BrokerLifecycleCapability)
+{
+  var descriptors = [Int32](repeating: -1, count: 2)
+  guard socketpair(AF_UNIX, SOCK_STREAM, 0, &descriptors) == 0 else {
+    throw POSIXError(.EIO)
+  }
+  do {
+    return (
+      descriptors[0],
+      try BrokerLifecycleCapability(
+        fileDescriptor: descriptors[1],
+        failStopDeadline: failStopDeadline,
+        failStopAction: failStopAction)
+    )
+  } catch {
+    Darwin.close(descriptors[0])
+    Darwin.close(descriptors[1])
+    throw error
+  }
+}
+
+private final class BrokerFailStopProbe: @unchecked Sendable {
+  private let lock = NSLock()
+  private let fired = DispatchSemaphore(value: 0)
+  private var count = 0
+  private var firedOnMainThread = false
+
+  var fireCount: Int {
+    lock.withLock { count }
+  }
+
+  var didFireOnMainThread: Bool {
+    lock.withLock { firedOnMainThread }
+  }
+
+  func fire() {
+    lock.withLock {
+      count += 1
+      firedOnMainThread = firedOnMainThread || Thread.isMainThread
+    }
+    fired.signal()
+  }
+
+  func waitForFire() async -> Bool {
+    await Task.detached {
+      self.waitForFireSynchronously()
+    }.value
+  }
