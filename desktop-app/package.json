{
  "name": "darkbloom-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The Darkbloom desktop frontend",
  "author": "Darkbloom",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/assets.mjs && node scripts/dev.mjs",
    "build": "node scripts/assets.mjs && tsc --noEmit && vite build && node scripts/build.mjs",
    "test": "node scripts/assets.mjs && vitest run",
    "package": "npm run build && electron-builder --mac --dir --publish never",
    "dist": "npm run build && electron-builder --mac --publish never",
    "format": "prettier --write src scripts tests *.ts *.json",
    "lint": "prettier --check src scripts tests *.ts *.json"
  },
  "build": {
    "appId": "io.darkbloom.desktop",
    "productName": "Darkbloom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "bootstrap",
        "filter": [
          "install-runtime.sh"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.0",
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "resources/icon.icns"
    },
    "publish": {
      "provider": "github",
      "owner": "Layr-Labs",
      "repo": "d-inference",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "type": "module"
}
