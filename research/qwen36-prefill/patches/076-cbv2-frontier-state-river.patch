index 0000000000000000000000000000000000000000..7498bd77dd8177cb484c48c14ed2df6cc6b391a6
--- /dev/null
+++ b/Tests/MLXLMTests/Qwen35FrontierStateRiverLayerTests.swift
@@ -0,0 +1,147 @@
+import MLX
+import MLXRandom
+import Testing
+
+@testable import MLXLLM
+@testable import MLXLMCommon
+
+@Suite("Qwen frontier state river layer artifacts")
+struct Qwen35FrontierStateRiverLayerTests {
+    @Test func attentionCommitsHistoryAndFrontierKVExactlyOnce() throws {
+        let config = try TinyArtifactQwen.configuration(hiddenLayers: 4)
+        let kind = try #require(config.cbv2LayerKinds.first)
+        let batchSize = 2
+        let length = 5
+        MLXRandom.seed(0xF1_0A)
+        let layer = Qwen35DecoderLayer(config, layerIdx: 3)
+        let input = MLXRandom.normal([batchSize, length, config.hiddenSize])
+        let actual = TinyArtifactQwen.batchCache(
+            kind: kind, batchSize: batchSize, promptLength: length)
+        let reference = TinyArtifactQwen.batchCache(
+            kind: kind, batchSize: batchSize, promptLength: length)
+        let scalarPositions = MLXArray((0 ..< length).map(Int32.init))
+            .reshaped([1, 1, length])
+        let positions = broadcast(scalarPositions, to: [3, batchSize, length])
+        eval(layer, input, positions)
+
+        let river = try #require(layer.cbv2PrefillFrontierStateRiver(
+            input,
+            modelLayerIndex: 3,
+            attentionCache: actual.0,
+            recurrentState: [],
+            positionIds: positions,
+            usePrefillMoERoutingPolicy: false))
+        let full = layer.cbv2Forward(
+            input,
+            modelLayerIndex: 3,
+            attentionCache: reference.0,
+            recurrentState: [],
+            positionIds: positions)
+        eval([river, full] + actual.0.innerState() + reference.0.innerState())
+
+        #expect(
+            TinyArtifactQwen.identical(
+                river[0..., 0 ..< (length - 1), 0...],
+                input[0..., 0 ..< (length - 1), 0...]),
+            "historical hidden rows must pass through")
+        #expect(
+            TinyArtifactQwen.close(
+                river[0..., (length - 1) ..< length, 0...],
+                full[0..., (length - 1) ..< length, 0...]),
+            "the frontier must execute the complete skipped attention layer")
+
+        for (actualRow, referenceRow) in zip(actual.1, reference.1) {
+            let actualSnapshot = actualRow.snapshot()
+            let referenceSnapshot = referenceRow.snapshot()
+            eval(
+                actualSnapshot.keys, actualSnapshot.values,
+                referenceSnapshot.keys, referenceSnapshot.values)
+            #expect(actualSnapshot.offset == length)
+            #expect(referenceSnapshot.offset == length)
+            #expect(TinyArtifactQwen.close(
+                actualSnapshot.keys, referenceSnapshot.keys))
+            #expect(TinyArtifactQwen.close(
+                actualSnapshot.values, referenceSnapshot.values))
+        }
+        #expect(actual.0.offset == length, "the final token must not be committed twice")
+        #expect(
+            TinyArtifactQwen.identical(
+                actual.0.positionOffsets,
+                MLXArray(Array(repeating: Int32(length), count: batchSize))))
+    }
+
+    @Test func gdnStagesOnlyThePostFrontierState() throws {
+        let config = try TinyArtifactQwen.configuration(hiddenLayers: 4)
+        let spec = TinyArtifactQwen.recurrentSpec(config, layers: [0])
+        let batchSize = 2
+        let length = 5
+        MLXRandom.seed(0xF1_6D)
+        let layer = Qwen35DecoderLayer(config, layerIdx: 0)
+        let input = MLXRandom.normal([batchSize, length, config.hiddenSize])
+        eval(layer, input)
+
+        let actualStates = try (0 ..< batchSize).map { _ in
+            try CBv2RecurrentRequestState(spec: spec)
+        }
+        let stateOnlyStates = try (0 ..< batchSize).map { _ in
+            try CBv2RecurrentRequestState(spec: spec)
+        }
+        let fullStates = try (0 ..< batchSize).map { _ in
+            try CBv2RecurrentRequestState(spec: spec)
+        }
+        let actualTransactions = try actualStates.map { try $0.bind() }
+        let stateOnlyTransactions = try stateOnlyStates.map { try $0.bind() }
+        let fullTransactions = try fullStates.map { try $0.bind() }
+
+        let river = try #require(layer.cbv2PrefillFrontierStateRiver(
+            input,
+            modelLayerIndex: 0,
+            attentionCache: nil,
+            recurrentState: actualTransactions,
+            positionIds: nil,
+            usePrefillMoERoutingPolicy: false))
+        layer.linearAttn!.cbv2UpdateStateOnly(
+            layer.inputLayerNorm(input),
+            modelLayerIndex: 0,
+            recurrentState: stateOnlyTransactions)
+        let full = layer.cbv2Forward(
+            input,
+            modelLayerIndex: 0,
+            attentionCache: nil,
+            recurrentState: fullTransactions)
+
+        let actualRoots = try actualTransactions.flatMap { try $0.evaluate() }
+        let stateOnlyRoots = try stateOnlyTransactions.flatMap { try $0.evaluate() }
+        let fullRoots = try fullTransactions.flatMap { try $0.evaluate() }
+        eval([river, full] + actualRoots + stateOnlyRoots + fullRoots)
+        for transaction in actualTransactions { try transaction.commit() }
+        for transaction in stateOnlyTransactions { try transaction.commit() }
+        for transaction in fullTransactions { try transaction.commit() }
+
+        #expect(
+            TinyArtifactQwen.identical(
+                river[0..., 0 ..< (length - 1), 0...],
+                input[0..., 0 ..< (length - 1), 0...]),
+            "historical hidden rows must pass through")
+        #expect(
+            TinyArtifactQwen.close(
+                river[0..., (length - 1) ..< length, 0...],
+                full[0..., (length - 1) ..< length, 0...]),
+            "the frontier must execute the complete skipped GDN layer")
+
+        for row in 0 ..< batchSize {
+            let actual = try #require(actualStates[row].state(modelLayerIndex: 0))
+            let stateOnly = try #require(
+                stateOnlyStates[row].state(modelLayerIndex: 0))
+            let full = try #require(fullStates[row].state(modelLayerIndex: 0))
+            #expect(TinyArtifactQwen.identical(
+                try #require(actual.conv), try #require(stateOnly.conv)))
+            #expect(TinyArtifactQwen.close(
+                try #require(actual.ssm), try #require(stateOnly.ssm)))
+            #expect(TinyArtifactQwen.identical(
+                try #require(actual.conv), try #require(full.conv)))
+            #expect(TinyArtifactQwen.close(
+                try #require(actual.ssm), try #require(full.ssm)))
+        }
+    }
+}
diff --git a/Tests/MLXLMTests/Qwen35FrontierStateRiverTransactionTests.swift b/Tests/MLXLMTests/Qwen35FrontierStateRiverTransactionTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..3d61fca6e19926e5de5493c7cc2e2b210143ca17
--- /dev/null
+++ b/Tests/MLXLMTests/Qwen35FrontierStateRiverTransactionTests.swift
@@ -0,0 +1,261 @@
+import MLX
+import MLXRandom
+import Testing
+
+@testable import MLXLLM
+@testable import MLXLMCommon
+
+@Suite("Qwen frontier state river transactions")
+struct Qwen35FrontierStateRiverTransactionTests {
+    private struct BatchFixture {
+        let caches: [CBv2LayerCache]
+        let rows: [[CBv2FullSequenceKV]]
+        let recurrent: [CBv2RecurrentRequestState]
+    }
+
+    private struct RecurrentLayerSnapshot {
+        let layerIndex: Int
+        let conv: MLXArray
+        let ssm: MLXArray
+    }
+
+    private struct KVSnapshot {
+        let keys: MLXArray
+        let values: MLXArray
+        let offset: Int
+    }
+
+    private func makeBatchFixture(
+        config: Qwen35TextConfiguration,
+        batchSize: Int,
+        promptLength: Int
+    ) throws -> BatchFixture {
+        let pairs = config.cbv2LayerKinds.map {
+            TinyArtifactQwen.batchCache(
+                kind: $0,
+                batchSize: batchSize,
+                promptLength: promptLength)
+        }
+        let recurrent = try (0 ..< batchSize).map { _ in
+            try CBv2RecurrentRequestState(
+                spec: config.cbv2RecurrentStateSpec(activationDType: .float32))
+        }
+        return BatchFixture(
+            caches: pairs.map(\.0),
+            rows: pairs.map(\.1),
+            recurrent: recurrent)
+    }
+
+    private func execute(
+        model: Qwen35TextModelInner,
+        fixture: BatchFixture,
+        tokens: MLXArray,
+        phase: Qwen35CBv2ForwardPhase
+    ) throws -> [CBv2RecurrentStateEvaluation] {
+        let transactions = try fixture.recurrent.map { try $0.bind() }
+        let caches: [any CBv2AttendingLayerCache] = fixture.caches.map { $0 }
+        let hidden = model.cbv2Forward(
+            tokens,
+            caches: caches,
+            recurrentState: transactions,
+            phase: phase)
+        let roots = try transactions.flatMap { try $0.evaluate() }
+        eval([hidden] + roots + fixture.caches.flatMap { $0.innerState() })
+        #expect(!roots.isEmpty)
+        return transactions
+    }
+
+    private func promptChunk(
+        batchSize: Int,
+        length: Int,
+        seed: Int
+    ) -> MLXArray {
+        let values = (0 ..< batchSize).flatMap { row in
+            (0 ..< length).map { column in
+                Int32(1 + (seed + row * 11 + column * 3) % 63)
+            }
+        }
+        return MLXArray(values).reshaped([batchSize, length])
+    }
+
+    private func recurrentSnapshots(
+        fixture: BatchFixture,
+        layerIndices: [Int]
+    ) throws -> [[RecurrentLayerSnapshot]] {
+        let snapshots = try fixture.recurrent.map { request in
+            try layerIndices.map { layerIndex in
+                let state = try #require(request.state(modelLayerIndex: layerIndex))
+                let conv = try #require(state.conv)
+                let ssm = try #require(state.ssm)
+                return RecurrentLayerSnapshot(
+                    layerIndex: layerIndex,
+                    conv: conv + MLXArray.zeros(conv.shape, dtype: conv.dtype),
+                    ssm: ssm + MLXArray.zeros(ssm.shape, dtype: ssm.dtype))
+            }
+        }
+        eval(snapshots.flatMap { $0 }.flatMap { [$0.conv, $0.ssm] })
+        return snapshots
+    }
+
+    private func survivingKV(
+        rows: [[CBv2FullSequenceKV]],
+        excluding cancelledIndex: Int
+    ) -> [[KVSnapshot]] {
+        let snapshots = rows.map { layerRows in
+            layerRows.enumerated().compactMap { index, row -> KVSnapshot? in
+                guard index != cancelledIndex else { return nil }
+                let snapshot = row.snapshot()
+                eval(snapshot.keys, snapshot.values)
+                return KVSnapshot(
+                    keys: snapshot.keys,
+                    values: snapshot.values,
+                    offset: snapshot.offset)
+            }
+        }
+        return snapshots
+    }
+
+    private func assertFrontierTransactionAndCancellation(
+        batchSize: Int,
+        frontierLength: Int
+    ) throws {
+        let config = try TinyArtifactQwen.configuration()
+        let environment = [
+            Qwen35CBv2PrefillLayerPolicy.enabledEnvironmentKey: "1",
+            Qwen35CBv2PrefillLayerPolicy.fullLayersEnvironmentKey: "0-3",
+        ]
+        let intermediateLength = 3
+        let totalLength = intermediateLength + frontierLength
+        MLXRandom.seed(UInt64(0xB0_00 + batchSize))
+        let model = Qwen35TextModelInner(config, environment: environment)
+        let fixture = try makeBatchFixture(
+            config: config,
+            batchSize: batchSize,
+            promptLength: totalLength)
+        eval(model)
+
+        let intermediate = try execute(
+            model: model,
+            fixture: fixture,
+            tokens: promptChunk(
+                batchSize: batchSize,
+                length: intermediateLength,
+                seed: 5),
+            phase: .prefillIntermediate)
+        for transaction in intermediate { try transaction.commit() }
+        for cacheRows in fixture.rows {
+            #expect(
+                cacheRows.map(\.absoluteOffset)
+                    == Array(repeating: intermediateLength, count: batchSize))
+        }
+
+        let cancelledIndex = batchSize / 2
+        let layerIndices = config.cbv2RecurrentStateSpec().modelLayerIndices
+        let before = try recurrentSnapshots(
+            fixture: fixture,
+            layerIndices: layerIndices)
+
+        let frontier = try execute(
+            model: model,
+            fixture: fixture,
+            tokens: promptChunk(
+                batchSize: batchSize,
+                length: frontierLength,
+                seed: 29),
+            phase: .prefillFrontier)
+
+        // Every layer consumes exactly the intermediate and terminal chunks.
+        // A duplicated full frontier update would report totalLength + 1.
+        for (cache, cacheRows) in zip(fixture.caches, fixture.rows) {
+            #expect(
+                cacheRows.map(\.absoluteOffset)
+                    == Array(repeating: totalLength, count: batchSize))
+            #expect(cache.offset == totalLength)
+            #expect(TinyArtifactQwen.identical(
+                cache.positionOffsets,
+                MLXArray(Array(repeating: Int32(totalLength), count: batchSize))))
+        }
+        let expectedSurvivingKV = survivingKV(
+            rows: fixture.rows,
+            excluding: cancelledIndex)
+
+        for (row, transaction) in frontier.enumerated() {
+            if row == cancelledIndex {
+                try transaction.rollback()
+            } else {
+                try transaction.commit()
+            }
+        }
+
+        // Rollback restores the cancelled row's committed generation. Every
+        // survivor independently commits the post-frontier generation.
+        for row in 0 ..< batchSize {
+            for expected in before[row] {
+                let state = try #require(
+                    fixture.recurrent[row].state(
+                        modelLayerIndex: expected.layerIndex))
+                let conv = try #require(state.conv)
+                let ssm = try #require(state.ssm)
+                if row == cancelledIndex {
+                    #expect(TinyArtifactQwen.identical(conv, expected.conv))
+                    #expect(TinyArtifactQwen.identical(ssm, expected.ssm))
+                } else {
+                    #expect(
+                        !TinyArtifactQwen.identical(conv, expected.conv)
+                            || !TinyArtifactQwen.identical(ssm, expected.ssm),
+                        "surviving recurrent row did not commit frontier state")
+                }
+            }
+        }
+        try fixture.recurrent[cancelledIndex].release()
+        #expect(fixture.recurrent[cancelledIndex].isReleased)
+
+        // Attention cancellation removes only that row. Rows on either side
+        // keep their exact storage and logical offsets.
+        for (layer, cache) in fixture.caches.enumerated() {
+            cache.removeRow(at: cancelledIndex)
+            #expect(cache.rows.count == batchSize - 1)
+            #expect(cache.rows.allSatisfy { $0.absoluteOffset == totalLength })
+            if batchSize == 1 {
+                #expect(cache.positionOffsets.shape == [0])
+            } else {
+                #expect(TinyArtifactQwen.identical(
+                    cache.positionOffsets,
+                    MLXArray(Array(
+                        repeating: Int32(totalLength),
+                        count: batchSize - 1))))
+            }
+
+            for (row, expected) in zip(
+                cache.rows,
+                expectedSurvivingKV[layer])
+            {
+                let actualRow = try #require(row as? CBv2FullSequenceKV)
+                let actual = actualRow.snapshot()
+                eval(actual.keys, actual.values)
+                #expect(actual.offset == expected.offset)
+                #expect(TinyArtifactQwen.identical(actual.keys, expected.keys))
+                #expect(TinyArtifactQwen.identical(actual.values, expected.values))
+            }
+        }
+    }
+
+    @Test func frontierRiverB1TransactionOffsetsAndCancellation() throws {
+        // A one-row terminal chunk exercises the no-history branch.
+        try assertFrontierTransactionAndCancellation(
+            batchSize: 1,
+            frontierLength: 1)
+    }
+
+    @Test func frontierRiverB2TransactionOffsetsAndCancellation() throws {
+        try assertFrontierTransactionAndCancellation(
+            batchSize: 2,
+            frontierLength: 4)
+    }
+
+    @Test func frontierRiverB4TransactionOffsetsAndCancellation() throws {
+        try assertFrontierTransactionAndCancellation(
+            batchSize: 4,
+            frontierLength: 4)
+    }
+}
