        "coordinator/internal/inference/providerwire/**"
      ],
      "docs_any_of": [
        "docs/architecture/cache-aware-routing.md"
      ]
    },
    {
      "name": "component CI routing",
      "source_patterns": [
        ".github/workflows/ci.yml",
        ".github/workflows/component-changes.yml",
        ".github/workflows/integration.yml",
        ".github/workflows/benchmarks.yml",
        "scripts/ci-component-paths.py",
        "scripts/test-ci-component-paths.py"
      ],
      "docs_any_of": [
        "docs/developer/build.md",
        "docs/developer/test.md"
