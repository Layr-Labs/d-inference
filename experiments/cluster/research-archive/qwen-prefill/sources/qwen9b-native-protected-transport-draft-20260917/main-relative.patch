+        XCTAssertThrowsError(try WorkerConfiguration(arguments: ordinary + protection, now: 100))
+        XCTAssertThrowsError(try WorkerConfiguration(arguments: ordinary + bootstrap + Array(protection.prefix(2)), now: 100))
