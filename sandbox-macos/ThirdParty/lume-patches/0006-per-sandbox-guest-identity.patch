+@Test("a missing health check still names the bootstrap account")
+func healthCheckDefaultsToTheBootstrapAccount() throws {
+    let identity = try GuestIdentity(
+        bootstrap: GuestUser(
+            username: "db-xyz789", realName: "x", password: "pw",
+            uid: "501", gid: "20"
+        )
+    )
+    let resolved = UnattendedInstaller.resolveHealthCheck(
+        configured: nil, identity: identity)
+    #expect(resolved.type == "ssh")
+    #expect(resolved.user == "db-xyz789")
+    #expect(resolved.password == "pw")
+}
