+import Foundation
+import XCTest
+
+@testable import MLXLMCommon
+
+final class CBv2PromptForkEngineTests: XCTestCase {
+    func testB2IdenticalPromptForkMatchesColdTokenChecksums() async throws {
+        let prompt = [2, 3, 5, 7, 11, 13, 17, 19, 23]
+        let prompts = [prompt, prompt]
+
+        let control = CBv2PromptForkHarness(
+            enabled: false, batchSize: 2, enqueueDelayForTesting: 0.01)
+        let controlStreams = try submit(prompts: prompts, maxTokens: 6, to: control.engine)
+        let controlResults = await cbv2PromptForkCollectAll(controlStreams)
+        let controlCells = control.model.tokenCellsExecuted
+        let controlActivity = control.engine.promptForkActivity()
+        await control.engine.shutdown()
+
+        XCTAssertFalse(controlActivity.isEnabled)
+        XCTAssertTrue(controlActivity.isSupported)
+        XCTAssertEqual(controlActivity.cohortsFormed, 0)
+
+        let candidate = CBv2PromptForkHarness(
+            enabled: true, batchSize: 2, enqueueDelayForTesting: 0.01)
+        let candidateStreams = try submit(
+            prompts: prompts, maxTokens: 6, to: candidate.engine)
+        let candidateResults = await cbv2PromptForkCollectAll(candidateStreams)
+        let candidateCells = candidate.model.tokenCellsExecuted
+        let activity = candidate.engine.promptForkActivity()
+        await candidate.engine.shutdown()
+
+        for rawID in 1 ... 2 {
+            let id = CBv2RequestID(UInt64(rawID))
+            XCTAssertEqual(controlResults[id]?.finishReason, .length)
+            XCTAssertEqual(candidateResults[id]?.finishReason, .length)
+            XCTAssertEqual(
+                cbv2PromptForkChecksum(candidateResults[id]?.tokens ?? []),
+                cbv2PromptForkChecksum(controlResults[id]?.tokens ?? []))
+        }
+        XCTAssertEqual(activity.cohortsFormed, 1)
+        XCTAssertEqual(activity.cohortsForked, 1)
+        XCTAssertEqual(activity.followerRowsForked, 1)
+        XCTAssertEqual(activity.prefillTokensSaved, prompt.count - 1)
+        XCTAssertEqual(controlCells - candidateCells, activity.prefillTokensSaved)
+        XCTAssertGreaterThan(activity.logicalStateBytesForked, 0)
+    }
+
+    func testB4SharedPrefixForkAccountsEveryRowAndFollowerCanLeave()
+        async throws
+    {
+        let common = [2, 3, 5, 7, 11, 13]
+        let prompts = [
+            common + [17, 19],
+            common + [23, 29],
+            common + [4, 6],
+            common + [8, 10],
+        ]
+        let maxTokens = 6
+
+        let control = CBv2PromptForkHarness(
+            enabled: false, batchSize: 4, enqueueDelayForTesting: 0.01)
+        let controlResults = await cbv2PromptForkCollectAll(
+            try submit(prompts: prompts, maxTokens: maxTokens, to: control.engine))
+        await control.engine.shutdown()
+
+        let candidate = CBv2PromptForkHarness(
+            enabled: true, batchSize: 4, enqueueDelayForTesting: 0.01)
+        let forkRelease = DispatchSemaphore(value: 0)
+        candidate.engine.loopForTesting.promptFork.onForkForTesting = {
+            _, followers, boundary in
+            XCTAssertEqual(followers.count, 3)
+            XCTAssertEqual(boundary, common.count)
+            _ = forkRelease.wait(timeout: .now() + 10)
+        }
+
+        let candidateStreams = try submit(
+            prompts: prompts, maxTokens: maxTokens, to: candidate.engine)
+        let collection = Task {
+            await cbv2PromptForkCollectAll(candidateStreams)
+        }
+        let didFork = await cbv2SchedWait {
+            candidate.engine.promptForkActivity().followerRowsForked == 3
+        }
+        XCTAssertTrue(didFork)
+
+        // The hook holds the engine at the exact post-publication boundary:
+        // every row owns and is charged for common-prefix state, but no suffix
+        // assignment has reserved another token yet.
+        let perRowLedger =
+            candidate.engine.admissionForTesting.allocatedBytes(forTokens: common.count)
+        XCTAssertEqual(
+            candidate.engine.admissionForTesting.bytesReserved,
+            4 * perRowLedger)
+        let maxLength = prompts[0].count + maxTokens
+        let perRowBackendBytes = maxLength * 2 * MemoryLayout<Float>.size
+        XCTAssertEqual(candidate.backend.bytesReserved, 4 * perRowBackendBytes)
+        XCTAssertEqual(
+            candidate.engine.promptForkActivity().logicalStateBytesForked,
+            3 * (perRowBackendBytes + 8))
+
+        // This follower now owns real rows. Cancelling it before the next
+        // finalization exercises in-flight rollback/release while the leader
+        // and two surviving followers continue independently.
+        candidate.engine.cancel(CBv2RequestID(2))
+        forkRelease.signal()
+        let candidateResults = await collection.value
+        let activity = candidate.engine.promptForkActivity()
+        await candidate.engine.shutdown()
+
+        XCTAssertEqual(candidateResults[CBv2RequestID(2)]?.finishReason, .cancelled)
+        for rawID in [1, 3, 4] {
+            let id = CBv2RequestID(UInt64(rawID))
+            XCTAssertEqual(candidateResults[id]?.finishReason, .length)
+            XCTAssertEqual(
+                cbv2PromptForkChecksum(candidateResults[id]?.tokens ?? []),
+                cbv2PromptForkChecksum(controlResults[id]?.tokens ?? []))
+        }
+        XCTAssertEqual(activity.cohortsForked, 1)
+        XCTAssertEqual(activity.followerRowsForked, 3)
+        XCTAssertEqual(activity.prefillTokensSaved, 3 * common.count)
+        XCTAssertEqual(activity.followerRowsFellBack, 0)
+        XCTAssertEqual(candidate.backend.bytesReserved, 0)
+        XCTAssertEqual(candidate.engine.admissionForTesting.bytesReserved, 0)
+    }
+
+    func testFollowerCancellationBeforeBoundaryAbandonsCohortWithoutFork()
+        async throws
+    {
+        let gate = CBv2PromptForkForwardGate()
+        let harness = CBv2PromptForkHarness(
+            enabled: true,
+            batchSize: 2,
+            chunkSize: 2,
+            gate: gate,
+            enqueueDelayForTesting: 0.02)
+        let prompt = [2, 3, 5, 7, 11, 13, 17, 19]
+        let streams = try submit(
+            prompts: [prompt, prompt], maxTokens: 4, to: harness.engine)
+        let collection = Task {
+            await cbv2PromptForkCollectAll(streams)
+        }
+
+        let didForm = await waitForCohortToForm(harness: harness, gate: gate)
+        XCTAssertTrue(didForm)
+        harness.engine.cancel(CBv2RequestID(2))
+        gate.open()
+        let results = await collection.value
+        let activity = harness.engine.promptForkActivity()
+        await harness.engine.shutdown()
+
+        XCTAssertEqual(results[CBv2RequestID(1)]?.finishReason, .length)
+        XCTAssertEqual(results[CBv2RequestID(2)]?.finishReason, .cancelled)
+        XCTAssertEqual(activity.cohortsForked, 0)
+        XCTAssertEqual(activity.cohortsAbandoned, 1)
+        XCTAssertEqual(activity.followerRowsForked, 0)
+        XCTAssertEqual(activity.followerRowsFellBack, 0)
+        XCTAssertEqual(harness.backend.bytesReserved, 0)
+        XCTAssertEqual(harness.engine.admissionForTesting.bytesReserved, 0)
+    }
+
+    func testLeaderCancellationBeforeBoundaryReleasesFollowerToColdPrefill()
+        async throws
+    {
+        let prompt = [2, 3, 5, 7, 11, 13, 17, 19]
+        let control = CBv2PromptForkHarness(enabled: false, batchSize: 1)
+        let controlResults = await cbv2PromptForkCollectAll(
+            try submit(prompts: [prompt], maxTokens: 4, to: control.engine))
+        await control.engine.shutdown()
+
+        let gate = CBv2PromptForkForwardGate()
+        let harness = CBv2PromptForkHarness(
+            enabled: true,
+            batchSize: 2,
+            chunkSize: 2,
+            gate: gate,
+            enqueueDelayForTesting: 0.02)
+        let streams = try submit(
+            prompts: [prompt, prompt], maxTokens: 4, to: harness.engine)
+        let collection = Task {
+            await cbv2PromptForkCollectAll(streams)
+        }
+
+        let didForm = await waitForCohortToForm(harness: harness, gate: gate)
+        XCTAssertTrue(didForm)
+        harness.engine.cancel(CBv2RequestID(1))
+        gate.open()
+        let results = await collection.value
+        let activity = harness.engine.promptForkActivity()
+        await harness.engine.shutdown()
+
+        XCTAssertEqual(results[CBv2RequestID(1)]?.finishReason, .cancelled)
+        XCTAssertEqual(results[CBv2RequestID(2)]?.finishReason, .length)
+        XCTAssertEqual(
+            cbv2PromptForkChecksum(results[CBv2RequestID(2)]?.tokens ?? []),
+            cbv2PromptForkChecksum(controlResults[CBv2RequestID(1)]?.tokens ?? []))
+        XCTAssertEqual(activity.cohortsForked, 0)
+        XCTAssertEqual(activity.cohortsAbandoned, 1)
+        XCTAssertEqual(activity.followerRowsForked, 0)
+        XCTAssertEqual(activity.followerRowsFellBack, 1)
+        XCTAssertEqual(harness.backend.bytesReserved, 0)
+        XCTAssertEqual(harness.engine.admissionForTesting.bytesReserved, 0)
+    }
+
+    /// A freshly-created engine can plan its first request before the second
+    /// enqueue block reaches the scheduler. Drive that already-started leader
+    /// one gated chunk at a time until the waiting follower is visible and the
+    /// cohort forms. The current forward remains blocked on return, preserving
+    /// the pre-boundary cancellation point the tests require.
+    private func waitForCohortToForm(
+        harness: CBv2PromptForkHarness,
+        gate: CBv2PromptForkForwardGate
+    ) async -> Bool {
+        var observedEntries = 0
+        for _ in 0 ..< 4 {
+            let formed = await cbv2SchedWait(timeoutSeconds: 0.1) {
+                harness.engine.promptForkActivity().cohortsFormed == 1
+            }
+            if formed { return true }
+            let previousEntries = observedEntries
+            let entered = await cbv2SchedWait(timeoutSeconds: 1) {
+                gate.entryCount > previousEntries
+            }
+            guard entered else {
+                continue
+            }
+            observedEntries = gate.entryCount
+            if harness.engine.promptForkActivity().cohortsFormed == 1 {
+                return true
+            }
+            gate.advance()
+        }
+        return await cbv2SchedWait(timeoutSeconds: 1) {
+            harness.engine.promptForkActivity().cohortsFormed == 1
+        }
+    }
+
+    private func submit(
+        prompts: [[Int]],
+        maxTokens: Int,
+        to engine: EngineV2
+    ) throws -> [(CBv2RequestID, AsyncStream<CBv2Event>)] {
+        try prompts.enumerated().map { index, prompt in
+            let id = CBv2RequestID(UInt64(index + 1))
+            let stream = try engine.submit(
+                CBv2Request(
+                    id: id,
+                    promptTokens: prompt,
+                    sampling: .init(temperature: 0),
+                    maxTokens: maxTokens,
+                    prefixCacheEnabled: true))
+            return (id, stream)
+        }
+    }
+}
