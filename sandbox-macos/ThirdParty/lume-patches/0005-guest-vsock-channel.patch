diff --git a/libs/lume/src/VM/GuestChannelCapability.swift b/libs/lume/src/VM/GuestChannelCapability.swift
new file mode 100644
index 0000000000000000000000000000000000000000..70a1c793cab62de337485fbba796402d8c9655f6
--- /dev/null
+++ b/libs/lume/src/VM/GuestChannelCapability.swift
@@ -0,0 +1,201 @@
+import Darwin
+import Foundation
+
+/// A pre-spawn descriptor whose peer is owned by the sandbox broker, used to
+/// hand the broker a connected guest vsock descriptor.
+///
+/// Only the process holding the `VZVirtioSocketDevice` can establish a guest
+/// connection, so the broker cannot open one itself. This capability lets the
+/// run process establish it and pass the resulting descriptor out over
+/// `SCM_RIGHTS`. The run process never reads or writes guest payload: once the
+/// descriptor is handed over, the broker owns the conversation.
+final class GuestChannelCapability: @unchecked Sendable {
+    static let environmentVariable = "DARKBLOOM_LUME_GUEST_CHANNEL_FD"
+    static let portEnvironmentVariable = "DARKBLOOM_LUME_GUEST_CHANNEL_PORT"
+
+    /// Single byte accompanying the descriptor. `sendmsg` on a stream socket
+    /// requires a non-empty payload for the control message to be delivered.
+    static let descriptorMessageByte: UInt8 = 0x01
+
+    private let endpoint: Endpoint
+
+    /// Guest vsock port the run process should connect to.
+    let port: UInt32
+
+    static func inherited() throws -> GuestChannelCapability? {
+        let environment = ProcessInfo.processInfo.environment
+        guard let value = environment[environmentVariable] else {
+            return nil
+        }
+        let portValue = environment[portEnvironmentVariable]
+        unsetenv(environmentVariable)
+        unsetenv(portEnvironmentVariable)
+        guard let descriptor = Int32(value),
+              descriptor > STDERR_FILENO,
+              let rawPort = portValue,
+              let port = UInt32(rawPort),
+              port > 0
+        else {
+            throw VMError.internalError(
+                "Invalid guest channel capability"
+            )
+        }
+        return try GuestChannelCapability(
+            fileDescriptor: descriptor,
+            port: port
+        )
+    }
+
+    init(fileDescriptor: Int32, port: UInt32) throws {
+        guard fileDescriptor > STDERR_FILENO,
+              fcntl(fileDescriptor, F_GETFD) >= 0
+        else {
+            throw VMError.internalError(
+                "Invalid guest channel capability"
+            )
+        }
+        let descriptorFlags = fcntl(fileDescriptor, F_GETFD)
+        guard descriptorFlags >= 0,
+              fcntl(
+                  fileDescriptor,
+                  F_SETFD,
+                  descriptorFlags | FD_CLOEXEC
+              ) == 0
+        else {
+            throw VMError.internalError(
+                "Could not secure guest channel capability"
+            )
+        }
+        self.port = port
+        endpoint = Endpoint(fileDescriptor: fileDescriptor)
+    }
+
+    deinit {
+        endpoint.close()
+    }
+
+    /// Hands `descriptor` to the broker. The caller keeps ownership of its own
+    /// copy and is responsible for closing it.
+    func send(descriptor: Int32) throws {
+        try endpoint.send(descriptor: descriptor)
+    }
+
+    func close() {
+        endpoint.close()
+    }
+
+    // MARK: - Control-message geometry
+
+    /// `__DARWIN_ALIGN32`, which the `CMSG_*` macros are defined in terms of.
+    /// The macros themselves are not visible to Swift.
+    private static func aligned(_ size: Int) -> Int {
+        (size + 3) & ~3
+    }
+
+    fileprivate static var headerSpace: Int {
+        aligned(MemoryLayout<cmsghdr>.size)
+    }
+
+    fileprivate static var controlSpace: Int {
+        headerSpace + aligned(MemoryLayout<Int32>.size)
+    }
+
+    fileprivate static var controlLength: Int {
+        headerSpace + MemoryLayout<Int32>.size
+    }
+
+    private final class Endpoint: @unchecked Sendable {
+        private let lock = NSLock()
+        private var fileDescriptor: Int32
+
+        init(fileDescriptor: Int32) {
+            self.fileDescriptor = fileDescriptor
+        }
+
+        func send(descriptor: Int32) throws {
+            var control = [UInt8](
+                repeating: 0,
+                count: GuestChannelCapability.controlSpace
+            )
+            var payload = GuestChannelCapability.descriptorMessageByte
+
+            let failure: Int32 = lock.withLock {
+                guard fileDescriptor >= 0 else {
+                    return EBADF
+                }
+                let socket = fileDescriptor
+                return control.withUnsafeMutableBytes { controlBuffer -> Int32 in
+                    guard let controlBase = controlBuffer.baseAddress else {
+                        return EINVAL
+                    }
+                    let header = controlBase
+                        .assumingMemoryBound(to: cmsghdr.self)
+                    header.pointee.cmsg_len = socklen_t(
+                        GuestChannelCapability.controlLength
+                    )
+                    header.pointee.cmsg_level = SOL_SOCKET
+                    header.pointee.cmsg_type = SCM_RIGHTS
+                    controlBase
+                        .advanced(by: GuestChannelCapability.headerSpace)
+                        .assumingMemoryBound(to: Int32.self)
+                        .pointee = descriptor
+
+                    return withUnsafeMutablePointer(
+                        to: &payload
+                    ) { payloadPointer -> Int32 in
+                        var vector = iovec(
+                            iov_base: UnsafeMutableRawPointer(payloadPointer),
+                            iov_len: 1
+                        )
+                        return withUnsafeMutablePointer(
+                            to: &vector
+                        ) { vectorPointer -> Int32 in
+                            var message = msghdr()
+                            message.msg_iov = vectorPointer
+                            message.msg_iovlen = 1
+                            message.msg_control = controlBase
+                            message.msg_controllen = socklen_t(
+                                controlBuffer.count
+                            )
+                            while true {
+                                let sent = sendmsg(socket, &message, 0)
+                                if sent < 0 {
+                                    if errno == EINTR {
+                                        continue
+                                    }
+                                    return errno
+                                }
+                                return sent == 1 ? 0 : EIO
+                            }
+                        }
+                    }
+                }
+            }
+
+            guard failure == 0 else {
+                throw VMError.internalError(
+                    "Could not hand the guest channel descriptor to the sandbox broker (errno \(failure))"
+                )
+            }
+        }
+
+        func close() {
+            let descriptor = lock.withLock {
+                let descriptor = fileDescriptor
+                fileDescriptor = -1
+                return descriptor
+            }
+            if descriptor >= 0 {
+                Darwin.close(descriptor)
+            }
+        }
+    }
+}
+
+private extension NSLock {
+    func withLock<T>(_ operation: () -> T) -> T {
+        lock()
+        defer { unlock() }
+        return operation()
+    }
+}
