{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkbloom.dev/schemas/qwen-quality-corpus-v1.json",
  "title": "Darkbloom Qwen quality corpus",
  "description": "Input corpus for fixed-weight, benchmark-only Qwen prefill quality runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "description",
    "license",
    "provenance",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "$ref": "#/$defs/identifier"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "prompt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "$ref": "#/$defs/identifier"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        }
      }
    }
  }
}
