+        return try withExtendedLifetime(gate) {
+            var files = [try DistributedInstalledFiles.verify(localOwner.installedDarkbloom,
+                expectedSHA256: ownerSHA256, maximumBytes: 256 * 1024 * 1024, executable: true, deadline: deadline)]
+            for i in 0..<3 {
