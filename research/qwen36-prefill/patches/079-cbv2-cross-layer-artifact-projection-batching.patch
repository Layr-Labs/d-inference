+    /// Return the maximal consecutive artifact run whose attention members
+    /// expose cache-only commitment before any cache/state mutation occurs.
+    private func cbv2ArtifactProjectionCandidateLayerIndices(
+        from startLayerIndex: Int,
+        phase: Qwen35CBv2ForwardPhase,
+        caches: [any CBv2AttendingLayerCache],
+        attentionStorageIndexByLayer: [Int: Int]
+    ) -> [Int] {
+        guard
+            cbv2ArtifactProjectionBatchPolicy.isEnabled,
+            layers.indices.contains(startLayerIndex)
+        else {
+            return []
+        }
+
+        var result: [Int] = []
+        for modelLayerIndex in startLayerIndex ..< layers.count {
+            let mode = cbv2PrefillLayerPolicy.mode(
+                layerIndex: modelLayerIndex, phase: phase)
+            guard mode != .full else { break }
+            let layer = layers[modelLayerIndex]
+            if !layer.isLinear {
+                guard
+                    let storageIndex =
+                        attentionStorageIndexByLayer[modelLayerIndex],
+                    caches.indices.contains(storageIndex),
+                    caches[storageIndex]
+                        is any CBv2KVCommitOnlyLayerCache
+                else {
+                    break
+                }
+            }
+            result.append(modelLayerIndex)
+        }
+        return result
+    }
+
+    /// Quantization replaces placeholder modules after initialization. Build
+    /// and retain immutable stacks only after the first eligible forward; an
+    /// unsupported family or unsafe byte count permanently falls back to the
+    /// sequential E51 projection path for this model instance.
+    private func resolvedCBv2ArtifactProjectionWeightBank()
+        -> Qwen35ArtifactProjectionWeightBank?
+    {
+        guard
+            cbv2ArtifactProjectionBatchPolicy.isEnabled,
+            !cbv2ArtifactProjectionBatchUnavailable
+        else {
+            return nil
+        }
+        if let cbv2ArtifactProjectionWeightBank {
+            return cbv2ArtifactProjectionWeightBank
+        }
+        guard
+            let weightBank = Qwen35ArtifactProjectionWeightBank(
+                layers: layers,
+                maximumStackedWeightBytes:
+                    Qwen35ArtifactProjectionBatchPolicy
+                    .maximumStackedWeightBytes)
+        else {
+            cbv2ArtifactProjectionBatchUnavailable = true
+            FileHandle.standardError.write(Data(
+                "[WARN] Qwen35 artifact projection batching unavailable; "
+                    .appending(
+                        "falling back to sequential immutable projections\n")
+                    .utf8))
+            return nil
+        }
+        cbv2ArtifactProjectionWeightBank = weightBank
+        return weightBank
+    }
 }
 
