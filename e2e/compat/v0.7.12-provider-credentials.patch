+// The released config has only AuthTokenPath; metadata lives beside that token.
+// Replace all inherited overrides. An absent token uses absent files in StateDir
+// so negative auth fixtures cannot fall back to the runner's saved login.
+func providerCredentialEnvironment(base []string, authTokenPath, stateDir string) []string {
+	credentialDir := stateDir
+	if authTokenPath == "" {
+		authTokenPath = filepath.Join(credentialDir, "auth_token")
+	} else {
+		credentialDir = filepath.Dir(authTokenPath)
+	}
+	env := make([]string, 0, len(base)+3)
+	for _, entry := range base {
+		key, _, _ := strings.Cut(entry, "=")
+		switch key {
+		case "DARKBLOOM_AUTH_TOKEN_PATH", "DARKBLOOM_PROVIDER_ACCOUNT_PATH", "DARKBLOOM_PROVIDER_ISSUER_PATH":
+			continue
+		}
+		env = append(env, entry)
+	}
+	return append(env,
+		"DARKBLOOM_AUTH_TOKEN_PATH="+authTokenPath,
+		"DARKBLOOM_PROVIDER_ACCOUNT_PATH="+filepath.Join(credentialDir, "provider_account"),
+		"DARKBLOOM_PROVIDER_ISSUER_PATH="+filepath.Join(credentialDir, "provider_issuer"),
+	)
+}
