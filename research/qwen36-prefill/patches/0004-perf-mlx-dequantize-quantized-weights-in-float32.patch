diff --git a/Tests/MLXTests/FloatDequantizationTests.swift b/Tests/MLXTests/FloatDequantizationTests.swift
new file mode 100644
index 0000000..8fba45b
--- /dev/null
+++ b/Tests/MLXTests/FloatDequantizationTests.swift
@@ -0,0 +1,97 @@
+// Copyright © 2026 Eigen Labs.
+
+import MLX
+import XCTest
+
+#if canImport(Metal)
+
+final class FloatDequantizationTests: XCTestCase {
+    override class func setUp() {
+        setDefaultDevice()
+    }
+
+    func testBFloat16AffineQMMDequantizesInFloat32() {
+        let groupSize = 64
+        let bits = 4
+        let m = 32
+        let n = 32
+        let k = 64
+        let packedK = k * bits / 32
+
+        // For code=15, BF16 multiply/add rounds each weight to -1.71875.
+        // Float32 arithmetic followed by one BF16 store rounds it to
+        // -1.7109375. A 64-element dot with ones distinguishes the paths:
+        // -110.0 before the upstream change and -109.5 after it.
+        let scale = 0.0185546875
+        let bias = -1.9921875
+        let expectedValue = -109.5
+        let packedCode = MLXArray([UInt32.max])
+
+        let weights = broadcast(
+            packedCode.reshaped([1, 1]), to: [n, packedK])
+        let scales = full(
+            [n, k / groupSize], values: scale
+        ).asType(.bfloat16)
+        let biases = full(
+            [n, k / groupSize], values: bias
+        ).asType(.bfloat16)
+        let x = ones([m, k], dtype: .bfloat16)
+        let expected = full(
+            [m, n], values: expectedValue
+        ).asType(.bfloat16)
+
+        let actual = quantizedMM(
+            x,
+            weights,
+            scales: scales,
+            biases: biases,
+            transpose: true,
+            groupSize: groupSize,
+            bits: bits,
+            mode: .affine
+        )
+        eval(actual, expected)
+        XCTAssertTrue(equal(actual, expected).all().item(Bool.self))
+
+        // Exercise the sorted-RHS gather route used by MoE prefill. The
+        // existing SortedGatherQuantizedMMTests cover the exact Qwen E=256
+        // K/N geometries and expert-tile selector.
+        let expertCount = 2
+        let assignments = 32
+        let expertWeights = broadcast(
+            packedCode.reshaped([1, 1, 1]),
+            to: [expertCount, n, packedK]
+        )
+        let expertScales = full(
+            [expertCount, n, k / groupSize], values: scale
+        ).asType(.bfloat16)
+        let expertBiases = full(
+            [expertCount, n, k / groupSize], values: bias
+        ).asType(.bfloat16)
+        let expertIndices = MLXArray(
+            Array(repeating: Int32(0), count: assignments / 2)
+                + Array(repeating: Int32(1), count: assignments / 2)
+        ).asType(.uint32)
+        let gatherX = ones([assignments, 1, k], dtype: .bfloat16)
+        let gatherExpected = full(
+            [assignments, 1, n], values: expectedValue
+        ).asType(.bfloat16)
+
+        let gatherActual = gatherQuantizedMM(
+            gatherX,
+            expertWeights,
+            scales: expertScales,
+            biases: expertBiases,
+            rhsIndices: expertIndices,
+            transpose: true,
+            groupSize: groupSize,
+            bits: bits,
+            mode: .affine,
+            sortedIndices: true
+        )
+        eval(gatherActual, gatherExpected)
+        XCTAssertTrue(equal(gatherActual, gatherExpected).all().item(Bool.self))
+    }
+}
+
+#endif
