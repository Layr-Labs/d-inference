+    /// Connects to a listening guest vsock port and returns the host-side
+    /// descriptor.
+    ///
+    /// The connection can only be established from the process holding the
+    /// `VZVirtioSocketDevice`, and every framework call has to happen on the
+    /// machine's own queue, so both are done here rather than by the caller.
+    /// Ownership of the returned descriptor transfers to the caller: the
+    /// `VZVirtioSocketConnection` is closed before returning so the descriptor
+    /// is the only remaining reference.
+    func connectGuestPort(_ port: UInt32) async throws -> Int32 {
+        let handle = virtualMachineHandle
+        return try await withCheckedThrowingContinuation {
+            (continuation: CheckedContinuation<Int32, Error>) in
+            handle.queue.async {
+                guard let device = handle.machine.socketDevices
+                    .compactMap({ $0 as? VZVirtioSocketDevice })
+                    .first
+                else {
+                    continuation.resume(
+                        throwing: VMError.internalError(
+                            "VM has no virtio socket device"
+                        )
+                    )
+                    return
+                }
+                device.connect(toPort: port) { result in
+                    switch result {
+                    case .success(let connection):
+                        let descriptor = dup(connection.fileDescriptor)
+                        connection.close()
+                        if descriptor < 0 {
+                            continuation.resume(
+                                throwing: VMError.internalError(
+                                    "Could not duplicate guest channel descriptor"
+                                )
+                            )
+                        } else {
+                            continuation.resume(returning: descriptor)
+                        }
+                    case .failure(let error):
+                        continuation.resume(throwing: error)
+                    }
+                }
+            }
+        }
+    }
