+                let expectedBytes = try prepared.selected.reduce(0) {
+                    try LayerAttentionStateLayout.sum($0, $1.source.layout.byteCount)
+                }
+                let layout = actual.map { "\($0.0):\($0.1.dtype):\($0.1.shape)" }.sorted().joined(separator: "\n")
