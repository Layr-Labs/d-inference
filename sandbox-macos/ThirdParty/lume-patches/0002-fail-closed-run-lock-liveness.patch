+private func makePipe() throws -> [Int32] {
+    var descriptors = [Int32](repeating: -1, count: 2)
+    let result = descriptors.withUnsafeMutableBufferPointer {
+        Darwin.pipe($0.baseAddress!)
+    }
+    guard result == 0 else {
+        throw LockChildError.systemCall("pipe", errno)
+    }
+    return descriptors
+}
+
+private func runLockChild(
+    mode: LockChildMode,
+    configPath: UnsafePointer<CChar>,
+    ownerLockPath: UnsafePointer<CChar>,
+    readyDescriptor: Int32,
+    releaseDescriptor: Int32
+) -> Never {
+    signal(SIGINT, SIG_DFL)
+    signal(SIGTERM, SIG_DFL)
+
+    var signalMask = sigset_t()
+    sigemptyset(&signalMask)
+    sigaddset(&signalMask, SIGINT)
+    sigaddset(&signalMask, SIGTERM)
+    pthread_sigmask(SIG_UNBLOCK, &signalMask, nil)
+
+    let configDescriptor = Darwin.open(
+        configPath,
+        mode == .owner
+            ? O_RDWR | O_CLOEXEC | O_NOFOLLOW
+            : O_RDONLY | O_CLOEXEC | O_NOFOLLOW
+    )
+    var ownerDescriptor: Int32 = -1
+    var setupSucceeded = configDescriptor >= 0
+
+    if setupSucceeded && mode == .owner {
+        ownerDescriptor = Darwin.open(
+            ownerLockPath,
+            O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW,
+            mode_t(S_IRUSR | S_IWUSR)
+        )
+        setupSucceeded = ownerDescriptor >= 0
+            && flock(configDescriptor, LOCK_EX | LOCK_NB) == 0
+        if setupSucceeded {
+            var lock = flock()
+            lock.l_type = Int16(F_WRLCK)
+            lock.l_whence = Int16(SEEK_SET)
+            lock.l_start = 0
+            lock.l_len = 0
+            setupSucceeded =
+                fcntl(ownerDescriptor, F_SETLK, &lock) == 0
+        }
+    }
+
+    var ready: UInt8 = setupSucceeded ? 1 : 0
+    _ = Darwin.write(readyDescriptor, &ready, 1)
+    Darwin.close(readyDescriptor)
+
+    if setupSucceeded {
+        var release: UInt8 = 0
+        while Darwin.read(releaseDescriptor, &release, 1) == -1
+            && errno == EINTR
+        {}
+    }
+
+    if ownerDescriptor >= 0 {
+        Darwin.close(ownerDescriptor)
+    }
+    if configDescriptor >= 0 {
+        Darwin.close(configDescriptor)
+    }
+    Darwin.close(releaseDescriptor)
+    Darwin._exit(setupSucceeded ? 0 : 1)
+}
+
+private func spawnLockChild(
+    mode: LockChildMode,
+    configPath: String,
+    ownerLockPath: String
+) throws -> LockTestChild {
+    let readyPipe = try makePipe()
+    let releasePipe = try makePipe()
+    let configCString = Array(configPath.utf8CString)
+    let ownerLockCString = Array(ownerLockPath.utf8CString)
+
+    let processIdentifier = configCString.withUnsafeBufferPointer { config in
+        ownerLockCString.withUnsafeBufferPointer { ownerLock -> pid_t in
+            let child = fork()
+            if child == 0 {
+                Darwin.close(readyPipe[0])
+                Darwin.close(releasePipe[1])
+                runLockChild(
+                    mode: mode,
+                    configPath: config.baseAddress!,
+                    ownerLockPath: ownerLock.baseAddress!,
+                    readyDescriptor: readyPipe[1],
+                    releaseDescriptor: releasePipe[0])
+            }
+            return child
+        }
+    }
+
+    Darwin.close(readyPipe[1])
+    Darwin.close(releasePipe[0])
+    guard processIdentifier > 0 else {
+        let savedErrno = errno
+        Darwin.close(readyPipe[0])
+        Darwin.close(releasePipe[1])
+        throw LockChildError.systemCall("fork", savedErrno)
+    }
+
+    let child = LockTestChild(
+        processIdentifier: processIdentifier,
+        releaseDescriptor: releasePipe[1])
+    var ready: UInt8 = 0
+    let readyCount = Darwin.read(readyPipe[0], &ready, 1)
+    Darwin.close(readyPipe[0])
+    guard readyCount == 1, ready == 1 else {
+        child.terminate()
+        throw LockChildError.setupFailed
+    }
+    return child
+}
