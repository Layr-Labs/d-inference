+            let salt = name.utf8.reduce(0) { ($0 + Int($1)) % 31 }
+            let data = (0..<old.size).map { i -> Float in
+                if name.hasSuffix("A_log") { return -1 }
+                if name.contains("norm") { return 1 + Float((i + salt) % 5) * 0.02 }
