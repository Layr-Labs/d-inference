diff --git a/libs/lume/tests/GuestAgentInstallTests.swift b/libs/lume/tests/GuestAgentInstallTests.swift
new file mode 100644
index 0000000..ee43d62
--- /dev/null
+++ b/libs/lume/tests/GuestAgentInstallTests.swift
@@ -0,0 +1,236 @@
+import Foundation
+import Testing
+
+@testable import lume
+
+private func makeExecutable(bytes: Int = 32) throws -> (URL, URL) {
+    let root = FileManager.default.temporaryDirectory
+        .appendingPathComponent(UUID().uuidString)
+    try FileManager.default.createDirectory(
+        at: root, withIntermediateDirectories: true)
+    let binary = root.appendingPathComponent("darkbloom-guest-agent")
+    try Data(repeating: 0x7f, count: bytes).write(to: binary)
+    return (root, binary)
+}
+
+private func makeInstall(
+    executable: URL,
+    runAs: String = "sandbox",
+    logDirectory: String = GuestAgentInstall.defaultLogDirectory,
+    port: UInt32 = 8888,
+    imageID: String = "base-image-1",
+    executionEnabled: Bool = false
+) throws -> GuestAgentInstall {
+    try GuestAgentInstall(
+        executableURL: executable,
+        runAsUsername: runAs,
+        logDirectory: logDirectory,
+        port: port,
+        imageID: imageID,
+        executionEnabled: executionEnabled
+    )
+}
+
+@Test("the daemon runs as the tenant and carries the image id")
+func daemonPlistNamesTheTenantAndImage() throws {
+    let (root, binary) = try makeExecutable()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    let plist = try makeInstall(executable: binary).daemonPlist()
+
+    #expect(plist["UserName"] as? String == "sandbox")
+    #expect(plist["Label"] as? String == GuestAgentInstall.defaultLabel)
+    let environment = plist["EnvironmentVariables"] as? [String: String]
+    #expect(environment?[GuestAgentInstall.imageIDEnvironmentVariable] == "base-image-1")
+    let arguments = plist["ProgramArguments"] as? [String]
+    #expect(arguments?.first == "/usr/local/libexec/darkbloom-guest-agent")
+    #expect(arguments?.last == "8888")
+}
+
+@Test("an image is only made executable when asked")
+func executionIsOffUnlessRequested() throws {
+    let (root, binary) = try makeExecutable()
+    defer { try? FileManager.default.removeItem(at: root) }
+
+    // Off is the default, so an image becomes executable deliberately rather
+    // than by forgetting an argument.
+    let refusing = try makeInstall(executable: binary).daemonPlist()
+    let refusingEnvironment = refusing["EnvironmentVariables"] as? [String: String]
+    #expect(refusingEnvironment?[GuestAgentInstall.executionEnvironmentVariable] == "0")
+
+    let serving = try makeInstall(executable: binary, executionEnabled: true)
+        .daemonPlist()
+    let servingEnvironment = serving["EnvironmentVariables"] as? [String: String]
+    #expect(servingEnvironment?[GuestAgentInstall.executionEnvironmentVariable] == "1")
+
+    // The image id keeps its own slot either way; the two are independent.
+    #expect(servingEnvironment?[GuestAgentInstall.imageIDEnvironmentVariable]
+        == "base-image-1")
+}
