+@MainActor
+private func makeLivenessFixture(
+    named name: String
+) throws -> (storage: URL, directory: VMDirectory, vm: MockVM) {
+    let storage = FileManager.default.temporaryDirectory
+        .appendingPathComponent(UUID().uuidString)
+    let directory = VMDirectory(
+        Path(storage.path).directory(name))
+    try FileManager.default.createDirectory(
+        at: directory.dir.url,
+        withIntermediateDirectories: true)
+    try Data(repeating: 0, count: 1024)
+        .write(to: directory.diskPath.url)
+    try Data(repeating: 0, count: 1024)
+        .write(to: directory.nvramPath.url)
+
+    var config = try VMConfig(
+        os: "mock-os",
+        cpuCount: 1,
+        memorySize: 1024,
+        diskSize: 1024,
+        display: "1024x768")
+    config.setMacAddress("00:11:22:33:44:55")
+    try directory.saveConfig(config)
+
+    let context = VMDirContext(
+        dir: directory,
+        config: config,
+        home: Home(fileManager: .default),
+        storage: storage.path)
+    let vm = MockVM(
+        vmDirContext: context,
+        virtualizationServiceFactory: {
+            _ in MockVMVirtualizationService()
+        },
+        vncServiceFactory: {
+            MockVNCService(vmDirectory: $0)
+        })
+    return (storage, directory, vm)
+}
+
+private func identity(
+    for child: LockTestChild,
+    in directory: VMDirectory
+) throws -> RunSessionIdentity {
+    guard let process = RunLockProcessIdentity.read(
+              processIdentifier: child.processIdentifier),
+          let config = RunLockFileIdentity(
+              path: directory.configPath.path),
+          let ownerLock = RunLockFileIdentity(
+              path: directory.runOwnerLockPath.path)
+    else {
+        throw LockChildError.setupFailed
+    }
+    return RunSessionIdentity(
+        process: process,
+        files: RunLockFilesIdentity(
+            config: config,
+            ownerLock: ownerLock))
+}
+
+@MainActor
+private func expectLivenessInconclusive(
+    named expectedName: String,
+    operation: @MainActor () async throws -> Void
+) async {
+    do {
+        try await operation()
+        Issue.record(
+            "Expected liveness-inconclusive failure")
+    } catch VMError.livenessInconclusive(let name) {
+        #expect(name == expectedName)
+    } catch {
+        Issue.record(
+            "Expected liveness-inconclusive failure, got \(error)")
+    }
+}
