+    /// Normalize, RoPE-transform, and commit cross-layer gathered K/V
+    /// projections. The gathered values are raw `kProj`/`vProj` outputs, so
+    /// cache bytes and offset advancement follow the ordinary artifact path.
+    func cbv2CommitKVOnly(
+        _ projection: Qwen35AttentionArtifactProjection,
+        cache: any CBv2KVCommitOnlyLayerCache,
+        positionIds: MLXArray? = nil
+    ) {
+        let B = projection.keys.dim(0)
+        let L = projection.keys.dim(1)
+        precondition(
+            projection.keys.ndim == 3
+                && projection.values.ndim == 3
+                && projection.values.dim(0) == B
+                && projection.values.dim(1) == L,
+            "Qwen35 projected K/V history shape mismatch")
+        var keys = kNorm(
+            projection.keys.reshaped(B, L, kvHeads, -1))
+            .transposed(0, 2, 1, 3)
+        let values = projection.values
+            .reshaped(B, L, kvHeads, -1)
+            .transposed(0, 2, 1, 3)
+
+        if let positionIds {
+            keys = mrope.applyKeys(keys, positionIds: positionIds)
+        } else {
+            let offsets = cache.positionOffsets + 0
+            keys = rope(keys, offset: offsets)
+        }
+        cache.commitKVOnly(keys: keys, values: values)
+    }
 }
 
