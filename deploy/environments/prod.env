# Production coordinator — runs on a Google Compute Engine VM.
# Non-secret configuration only. Secrets live in Google Secret Manager.
# This file is a reference for reviewers diffing prod vs dev behavior.

ENVIRONMENT=prod
DINF_COORDINATOR_BINARY=go
GO_FALLBACK_REQUIRED=true
EIGENINFERENCE_COORDINATOR_OWNERSHIP_ENABLED=true
EIGENINFERENCE_RUST_FULL_SURFACE_ENABLED=true
COORDINATOR_URL=https://api.darkbloom.dev
COORDINATOR_WS_URL=wss://api.darkbloom.dev/ws/provider
CONSOLE_URL=https://console.darkbloom.dev
BASE_URL=https://api.darkbloom.dev

# Trust & attestation
MIN_TRUST=hardware
MDM_ENABLED=true

# Billing. The legacy mnemonic name now derives only the coordinator X25519 key.
BILLING_MOCK=false

# Release distribution
R2_BUCKET=d-inf-app
APPLE_TEAM_ID=SLDQ2GJ6TL
APPLE_SIGNING_IDENTITY=Developer ID Application: Eigen Labs, Inc. (SLDQ2GJ6TL)

# GCP serving topology
GCP_PROJECT=darkbloom-mainnet
GCP_REGION=us-east4
GCP_ZONE=us-east4-a
ARTIFACT_REGISTRY_REPO=us-east4-docker.pkg.dev/darkbloom-mainnet/coordinator
GCE_INSTANCE=darkbloom-coordinator
GCE_DATA_MOUNT=/mnt/disks/userdata
SERVING_CONTAINER=d-inference-coordinator
RECOVERY_MODE=offline-mutually-exclusive

# Fleet
PROVIDER_VERSION_GATE=latest
