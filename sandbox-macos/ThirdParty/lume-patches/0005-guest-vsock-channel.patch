@@ -1534,6 +1549,55 @@ class VM {
         fatalError("Must be implemented by subclass")
     }
 
+    /// How long to keep trying to reach the guest agent's vsock port before
+    /// giving up. Generous because a cold macOS guest can take minutes to
+    /// reach the point where the agent is listening.
+    private static let guestChannelConnectTimeout: TimeInterval = 600
+    private static let guestChannelRetryDelay: UInt64 = 500_000_000
+
+    /// Establishes the guest channel and hands the descriptor to the broker.
+    ///
+    /// Failure is logged, never thrown: a VM that boots fine but has no agent
+    /// listening is a valid state, and the broker decides what to do about it.
+    private func handOverGuestChannel(
+        service: VMVirtualizationService,
+        capability: GuestChannelCapability
+    ) async {
+        let deadline = Date().addingTimeInterval(Self.guestChannelConnectTimeout)
+        var lastError: String = "not attempted"
+        while Date() < deadline {
+            if Task.isCancelled {
+                return
+            }
+            do {
+                let descriptor = try await service.connectGuestPort(
+                    capability.port
+                )
+                defer { close(descriptor) }
+                try capability.send(descriptor: descriptor)
+                Logger.info(
+                    "Handed guest channel to sandbox broker",
+                    metadata: [
+                        "name": vmDirContext.name,
+                        "port": "\(capability.port)",
+                    ])
+                return
+            } catch {
+                lastError = "\(error)"
+                try? await Task.sleep(
+                    nanoseconds: Self.guestChannelRetryDelay
+                )
+            }
+        }
+        Logger.error(
+            "Guest channel never became available",
+            metadata: [
+                "name": vmDirContext.name,
+                "port": "\(capability.port)",
+                "error": lastError,
+            ])
+    }
+
