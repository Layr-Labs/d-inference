    "isolated-pilot": {
      "environment": "isolated",
      "authorization_max_age_seconds": 172800,
      "requires": [],
      "reports": {
        "load": {
          "maximum_age_seconds": 604800
        },
        "differential": {
          "maximum_age_seconds": 604800
        },
        "fault": {
          "maximum_age_seconds": 604800,
          "required_boundary_count": 21,
          "required_coverage": [
            "bounded_backpressure",
            "exactly_one_disposition",
            "historical_ack",
            "no_double_money_mutation",
            "no_failover_after_auth",
            "preauthorization_failover_only",
            "quiescence_ownership_fencing",
            "same_lease_recovery"
          ]
        }
      }
    },
    "sampled-shadow-replay": {
      "environment": "isolated",
      "authorization_max_age_seconds": 172800,
      "requires": [
        "isolated-pilot"
      ],
      "reports": {
        "route_trace": {
          "maximum_age_seconds": 86400,
          "mode": "sampled_shadow",
          "minimum_observed_route_ratio": 0.01,
          "minimum_routed_requests": 1000,
          "maximum_error_ratio": 0.02,
          "maximum_latency_p95_ms": 30000,
          "ownership_mode": "observe_only_no_owner"
        }
      }
    },
    "rollback-drill": {
      "environment": "isolated",
      "authorization_max_age_seconds": 172800,
      "requires": [
        "sampled-shadow-replay"
      ],
      "reports": {
        "rollback_drill": {
          "maximum_age_seconds": 604800,
          "coverage_script_path": "scripts/rehearse-coordinator-rollback.sh",
